{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/1.4.0/schema.json",
  "displayName": "Timeline",
  "name": "caseTimeline",
  "options": {
    "targetVisualNames": [
      "problems",
      "people",
      "relationships",
      "timeline",
      "replies"
    ],
    "applyOnlyToTargetVisuals": true,
    "suppressData": true,
    "suppressActiveSection": true
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "case",
    "sections": {
      "case": {
        "visualContainers": {
          "problems": {
            "singleVisual": {
              "visualType": "tableEx",
              "display": {
                "mode": "hidden"
              }
            }
          },
          "people": {
            "singleVisual": {
              "visualType": "tableEx",
              "display": {
                "mode": "hidden"
              }
            }
          },
          "relationships": {
            "singleVisual": {
              "visualType": "tableEx",
              "display": {
                "mode": "hidden"
              }
            }
          },
          "timeline": {
            "singleVisual": {
              "visualType": "tableEx"
            }
          },
          "replies": {
            "singleVisual": {
              "visualType": "tableEx",
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  }
}
