{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/bookmark/1.4.0/schema.json",
  "displayName": "Sections",
  "name": "cardsSections",
  "options": {
    "targetVisualNames": [
      "completeness",
      "correctness",
      "compliance",
      "checks"
    ],
    "applyOnlyToTargetVisuals": true,
    "suppressData": true,
    "suppressActiveSection": true
  },
  "explorationState": {
    "version": "1.3",
    "activeSection": "cards",
    "sections": {
      "cards": {
        "visualContainers": {
          "completeness": {
            "singleVisual": {
              "visualType": "tableEx"
            }
          },
          "correctness": {
            "singleVisual": {
              "visualType": "tableEx"
            }
          },
          "compliance": {
            "singleVisual": {
              "visualType": "tableEx"
            }
          },
          "checks": {
            "singleVisual": {
              "visualType": "tableEx",
              "display": {
                "mode": "hidden"
              }
            }
          }
        }
      }
    }
  }
}
