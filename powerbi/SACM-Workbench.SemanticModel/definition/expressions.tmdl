/// GENERATED from tests/sample-record.ts. The day the samples were recorded.
expression SampleDate = #date(2026, 11, 11)
	queryGroup: Packed

/// GENERATED from samples/ by npm run powerbi:generate. The invented sample reports, as their bytes in base64, with the name they would have in the SharePoint folder.
expression SampleFiles =
		#table(type table [FileName = text, Base64 = text], {
			{"2026-11-04_cmdb_ci-sample-earlier.csv", ""},
			{"2026-11-04_cmdb_rel_ci-sample-earlier.csv", ""},
			{"2026-11-04_solusi-contracts-sample-earlier.csv", ""},
			{"2026-11-11_cmdb_ci-sample.csv", ""},
			{"2026-11-11_cmdb_rel_ci-sample.csv", ""},
			{"2026-11-11_epo-systems-sample.csv", ""},
			{"2026-11-11_servicenow-contracts-sample.csv", ""},
			{"2026-11-11_solusi-contracts-sample.csv", ""}
		})
	queryGroup: Packed

/// GENERATED from src/app/state/store.ts (D158) and tools/powerbi/email.ts (rowsInEmail, D314). The range and the default of each number setting.
expression SettingRanges = Json.Document("{""reminderDays"":{""min"":1,""max"":30,""default"":3},""maxReminders"":{""min"":0,""max"":10,""default"":2},""staleDays"":{""min"":1,""max"":60,""default"":3},""exceptionMonths"":{""min"":1,""max"":36,""default"":6},""underRetirementDays"":{""min"":1,""max"":730,""default"":90},""readyDays"":{""min"":1,""max"":730,""default"":90},""rowsInEmail"":{""min"":1,""max"":100,""default"":10}}")
	queryGroup: Packed

/// GENERATED from powerbi/samples/state/. The invented lists of the team's state (journal, replies, settings, team), as their bytes in base64, read when StateMode is Sample (D291).
expression StateFiles =
		#table(type table [FileName = text, Base64 = text], {
			{"journal.csv", ""},
			{"replies.csv", ""},
			{"settings.csv", ""},
			{"team.csv", "VGl0bGUsRW1haWwsQWN0aXZlCkFsZXggRXhhbXBsZSxhbGV4QGV4YW1wbGUuY29tLFllcwpTYW0gRXhhbXBsZSxzYW1AZXhhbXBsZS5jb20sWWVzCk1heCBNYW5hZ2VyLG1heEBleGFtcGxlLmNvbSxObwo="}
		})
	queryGroup: Packed

/// GENERATED from tools/powerbi/history.ts (D291). The four lists of the team's state: the name of the SharePoint list, the sample file and the columns.
expression StateLists = Json.Document("{""journal"":{""list"":""SACM Journal"",""file"":""journal.csv"",""columns"":[""Title"",""At"",""By"",""ByName"",""Type"",""Keys"",""Text"",""Ref"",""To"",""Cc"",""Subject"",""Kind"",""Channel"",""Person"",""Reason"",""ReviewOn"",""RetireOn"",""CheckId"",""CiKey"",""CiName"",""Items""]},""replies"":{""list"":""SACM Replies"",""file"":""replies.csv"",""columns"":[""Title"",""From"",""Received"",""Subject"",""Body""]},""settings"":{""list"":""SACM Settings"",""file"":""settings.csv"",""columns"":[""Title"",""Value""]},""team"":{""list"":""SACM Team"",""file"":""team.csv"",""columns"":[""Title"",""Email"",""Active""]}}")
	queryGroup: Packed

/// GENERATED from package.json. The version of the Workbench.
expression WorkbenchVersion = "0.52.0"
	queryGroup: Packed

/// The 128 ASCII characters, as a list made once: Text.Remove(text, AsciiCharacters) = "" when a text is ASCII only.
expression AsciiCharacters = List.Buffer(List.Transform(List.Numbers(0, 128), Character.FromNumber))
	queryGroup: Reading

/// The numbers of the team's settings from the list SACM Settings (D158, D291): the working days before a reminder is due, how many reminders before an escalation, the days before a report is old, the months to the review date of a decision to stop following, and the days a CI may stay Under retirement or Ready (build B8, D308). A value that is not a whole number in its range (SettingRanges) is not used: the default is, as the app does. The Settings screen of the Power App adds a row for each change and never changes one, so the last row of a setting counts (the list is read oldest first).
expression CaseRules =
		let
		    rows = Table.ToRecords(fnStateList("settings")),
		    value = (key as text) as number =>
		        let
		            range = Record.Field(SettingRanges, key),
		            found = List.Last(List.Select(rows, (row) => row[Title] = key), null),
		            raw = if found = null then "" else Text.Trim(found[Value]),
		            digits = if Text.StartsWith(raw, "-") then Text.Middle(raw, 1) else raw,
		            number = if digits <> "" and Text.Remove(digits, {"0".."9"}) = "" then Number.FromText(raw, "en-US") else null
		        in
		            if number <> null and number >= range[min] and number <= range[max] then number else range[default]
		in
		    [
		        ReminderDays = value("reminderDays"), MaxReminders = value("maxReminders"), StaleDays = value("staleDays"),
		        ExceptionMonths = value("exceptionMonths"), UnderRetirementDays = value("underRetirementDays"), ReadyDays = value("readyDays")
		    ]
	queryGroup: Reading

/// The day the cases are worked out for (an exception that ends, a planned retirement date): the day the samples were recorded in Sample mode, else the day of the refresh. What depends on today between two refreshes (a reminder due, a report too old) is DAX, with the measure Today.
expression CaseToday = if SourceMode = "Sample" then SampleDate else DateTime.Date(DateTime.LocalNow())
	queryGroup: Reading

/// For the answer key only (tools/powerbi/parity.ts; build B7): the first message of a Teams chat about every open case of each card, as tests/recorded/teams-messages.txt records them (no journal, no person chosen, the reference SACM-CHAT-<check>). No table reads it; the workflow Power BI evaluates it.
expression ChatsRecorded =
		let
		    cases = List.Select(fnCases(CheckRun, [Events = {}, Replies = {}]), (item) => item[State] = "open"),
		    byCheck = fnGroupBy(cases, (item) => item[CheckId])
		in
		    #table(type table [CheckId = text, Chat = text],
		        List.Transform(Record.FieldNames(byCheck), (id) => {id, fnChatMessage(Record.Field(byCheck, id), MessageSettings, "SACM-CHAT-" & id, "")}))
	queryGroup: Reading

/// What the cases of each check offer (build B6, D294), by check id: the kind of its card page (src/app/view/cards.ts, cardKind; plan §6.1) and the words and marks of its playbook that change the actions of the Power App: askAfterReview (a line to check that SACM can hand to the owner), askWhenUnsure (a fix list line SACM cannot fix alone), markWord ("deleted": the line is marked deleted, not fixed) and retirementDate (the owner can give a planned retirement date).
expression CheckPlaybooks =
		let
		    packs = List.Transform(Json.Document(CheckFiles), (file) => file[pack]),
		    entry = (pack as record) as record =>
		        let
		            playbook = Record.FieldOrDefault(pack, "playbook", []),
		            kind = if List.Contains(Record.FieldOrDefault(playbook, "audience", {}), "procurement") then "mailbox"
		                else if Record.FieldOrDefault(playbook, "path", "") = "mapping" then "mapping"
		                else if Record.FieldOrDefault(pack, "reviewOnly", false) = true then "review"
		                else if Record.FieldOrDefault(playbook, "path", "") = "sacm-fix" then "fix"
		                else "owners"
		        in
		            [
		                Kind = kind, AskAfterReview = Record.FieldOrDefault(playbook, "askAfterReview", ""), AskWhenUnsure = Record.FieldOrDefault(playbook, "askWhenUnsure", ""),
		                MarkWord = Record.FieldOrDefault(playbook, "markWord", "fixed"), RetirementDate = Record.FieldOrDefault(playbook, "retirementDate", false) = true
		            ]
		in
		    Record.FromList(List.Transform(packs, entry), List.Transform(packs, (pack) => pack[id]))
	queryGroup: Reading

/// For the answer key only (tools/powerbi/parity.ts; build B7): the drafts of the samples as tests/recorded/messages.txt records them, with no journal and no replies, every open case written about (tests/sample-record.ts). No table reads it; the workflow Power BI evaluates it and compares it with the recorded messages byte for byte, the references and the name of the manager put in. Html, Csv, Summary, EmailSubject and First: the emails of fnEmailTemplate (D313), compared with tests/recorded/emails/.
expression DraftsRecorded =
		let
		    run = CheckRun,
		    cases = List.Select(fnCases(run, [Events = {}, Replies = {}]), (item) => item[State] = "open"),
		    drafts = fnDrafts(cases, MessageSettings),
		    emails = List.Buffer(fnEmailTemplate(drafts, MessageSettings))
		in
		    #table(type table [Ref = text, Kind = text, To = text, Cc = text, Subject = text, Keys = text, NewKeys = text, PartIndex = Int64.Type, PartCount = Int64.Type, CiCount = Int64.Type, CheckIds = text, Plain = text, Body = text,
		            Html = text, Csv = text, Summary = text, EmailSubject = text, First = Int64.Type],
		        List.Transform(List.Positions(drafts), (at) => let draft = drafts{at}, email = emails{at} in {draft[Ref], draft[Kind], draft[To], draft[Cc], draft[Subject], Text.Combine(draft[Keys], " "), Text.Combine(draft[NewKeys], " "),
		            draft[PartIndex], draft[PartCount], draft[CiCount], Text.Combine(draft[CheckIds], " "), draft[Plain], draft[Body],
		            email[Html], email[Csv], email[Summary], email[Subject], email[First]}))
	queryGroup: Reading

/// For the answer key only (tools/powerbi/parity.ts; build D4, D314): the emails of the samples as DraftsRecorded makes them, but with at most 2 CIs per message and 2 lines per table, so that the joined parts of a long message and the attached file are compared too, with tests/recorded/emails/split/ (tests/sample-record.ts). No table reads it.
expression EmailsSplit =
		let
		    run = CheckRun,
		    cases = List.Select(fnCases(run, [Events = {}, Replies = {}]), (item) => item[State] = "open"),
		    settings = MessageSettings & [MaxCis = 2, RowsInEmail = 2],
		    drafts = fnDrafts(cases, settings),
		    emails = List.Buffer(fnEmailTemplate(drafts, settings))
		in
		    #table(type table [Keys = text, PartIndex = Int64.Type, PartCount = Int64.Type, Html = text, Csv = text, Summary = text, EmailSubject = text, First = Int64.Type],
		        List.Transform(List.Positions(drafts), (at) => let draft = drafts{at}, email = emails{at} in
		            {Text.Combine(draft[Keys], " "), draft[PartIndex], draft[PartCount], email[Html], email[Csv], email[Summary], email[Subject], email[First]}))
	queryGroup: Reading

/// A report with no header and no row: the readers turn it into an empty table with all their columns.
expression EmptyRead =
		let
		    sheet = [Name = "", RawHeaders = {}, Headers = {}, Rows = #table({}, {})]
		in
		    [Format = "", Sheets = {sheet}, Headers = {}, RawHeaders = {}, Rows = sheet[Rows]]
	queryGroup: Reading

/// A date plus a number of working days, Monday to Friday (src/core/shared/dates.ts, addBusinessDays): Friday plus 1 is Monday. When a reminder is due (D39).
expression fnAddBusinessDays =
		(start as date, days as number) as date =>
		    List.Accumulate(List.Numbers(1, days), start, (day, step) =>
		        let next = Date.AddDays(day, 1), weekday = Date.DayOfWeek(next, Day.Monday) in
		        if weekday >= 5 then Date.AddDays(next, 7 - weekday) else next)
	queryGroup: Reading

/// "the CI below", "the CIs below", "the contract below" (src/core/messages/messages.ts, belowWords; build B7). `items`: the cases of a message or of one of its parts (fnDrafts), each with its Fact.
expression fnBelowWords =
		(items as list) as text =>
		    let
		        count = List.Count(List.Distinct(List.Transform(items, (item) => item[Fact][CiKey]))),
		        noun = if List.AllTrue(List.Transform(items, (item) => Record.FieldOrDefault(item[Fact], "Contract", null) <> null)) then "contract" else "CI"
		    in
		        "the " & noun & (if count = 1 then "" else "s") & " below"
	queryGroup: Reading

/// A class as label or table name, as its class id ("Application Service" and cmdb_ci_service_auto are service_instance). Anything else keeps its own name in lower case with "_" for spaces (src/core/sources/ci/ci-report.ts, canonicalClass).
expression fnCanonicalClass =
		(value as text) as text =>
		    let
		        text = Text.Lower(Text.Trim(value), "en-US"),
		        aliases = ReadingRules[classAliases],
		        found = List.Select(Record.FieldNames(aliases), (id) => List.Contains(Record.Field(aliases, id), text))
		    in
		        if List.IsEmpty(found) then Text.Combine(List.Select(Text.SplitAny(text, " #(tab)#(cr)#(lf)"), each _ <> ""), "_") else found{0}
	queryGroup: Reading

/// The part CapabilitySheet of the table Run (D284), which the DAX table CapabilitySheet shows (src/core/mapping/capability-sheet.ts, D205): every Business Capability of the newest CI report with its status, the capabilities above and below it, the Business Processes below, its description, tags, people and hidden characters, sorted by name. For the talks with Enterprise Architecture and Process Management: the table's Export data gives the file. Empty without a Relationship report (the page says so). `run` is CheckRun (null when no CI report is loaded).
expression fnCapabilitySheetPart =
		(run as nullable record) as table =>
		    let
		        graph = if run = null then null else run[Graph],
		        columns = if run = null then {} else run[Columns],
		        culture = Comparer.FromCulture("en-US"),
		        namesOf = (nodes as list) as text => Text.Combine(List.Sort(List.Distinct(List.Transform(nodes, (node) => node[Name])), culture), ", "),
		        linked = (ci as record, direction as text, cls as text) as list =>
		            let edges = Record.FieldOrDefault(if direction = "up" then graph[Up] else graph[Down], ci[Key], {}) in
		            List.Select(List.Transform(edges, (edge) => if direction = "up" then edge[Parent] else edge[Child]), (other) => other[Cls] = cls),
		        personOf = (ci as record, role as text) as text =>
		            let person = fnPerson(ci, role, columns), shown = if person = null then "" else if person[Name] <> "" then person[Name] else person[Email] in
		            if shown = "" then "" else shown & (if person[Active] = false then " (inactive)" else ""),
		        capabilities = if graph = null then {} else List.Select(run[Cis], (ci) => ci[Class] = "business_capability"),
		        // Buffered: each row reads it by position, and a lazy sorted list would be sorted again for each row.
		        sorted = List.Buffer(List.Sort(capabilities, (a, b) => let byName = culture(a[Name], b[Name]) in if byName <> 0 then byName else culture(a[Key], b[Key]))),
		        row = (position as number) as list =>
		            let ci = sorted{position} in
		            {
		                ci[Name], ci[Status], namesOf(linked(ci, "up", "business_capability")), namesOf(linked(ci, "down", "business_capability")),
		                namesOf(linked(ci, "down", "business_process")), ci[Description], Text.Combine(ci[TagList], ", "), personOf(ci, "owned_by"), personOf(ci, "managed_by"),
		                Text.Combine(ci[HiddenCharacters], ", "), position + 1
		            }
		    in
		        #table(
		            type table [Name = text, Status = text, CapabilitiesAbove = text, CapabilitiesBelow = text, ProcessesBelow = text, Description = text, Tags = text,
		                OwnedBy = text, ManagedBy = text, HiddenCharacters = text, Order = Int64.Type],
		            List.Transform(List.Positions(sorted), row))
	queryGroup: Reading

/// The text with its first character in upper case (as the details of a finding are shown).
expression fnCapital = (value as text) as text => Text.Upper(Text.Start(value, 1), "en-US") & Text.Middle(value, 1)
	queryGroup: Reading

/// What the Power App offers on a case (build B6, D294), as the case panel of the HTML app does (src/app/screens/case/CasePanel.tsx; the answer key is tools/powerbi/actions.ts). `item`: Key, CheckId, InLatest, State (how the case is listed, "" when the newest report no longer shows it), FactState (the state of its finding), Closed, Status, Timeline (its events, oldest first), Stopped (it is not followed up), RetireOn (text), Class and Mapping (the reasons of a case of the mapping backlog). Gives Actions ("id=Label|id=Label" in the order of AppActions: the actions of scope line that apply), ActionWords (the labels, "Note · Status"), Stages ("id=Label|…", the stages of a case of the mapping backlog) and StageId (its stage: the last stage event of its class, else the first stage). A case the newest report no longer shows is known by its key only: Note, and Follow again when it is not followed up.
expression fnCaseActions =
		(item as record) as record =>
		    let
		        book = Record.FieldOrDefault(CheckPlaybooks, item[CheckId], [Kind = "owners", AskAfterReview = "", AskWhenUnsure = "", MarkWord = "fixed", RetirementDate = false]),
		        config = fnReference("reference/mapping-backlog"),
		        state = item[State],
		        closed = item[Closed],
		        timeline = item[Timeline],
		        lastText = (kind as text) as text => let found = List.Last(List.Select(timeline, (event) => event[Type] = kind), null) in if found = null then "" else found[Text],
		        ownerAsked = lastText("reviewed") = "Ask the owner",
		        processMissing = lastText("no-process") = "yes",
		        sacmFix = book[Kind] = "fix" and not (book[AskWhenUnsure] <> "" and ownerAsked),
		        openWork = not closed and (state = "open" or state = "review"),
		        mapping = item[InLatest] and book[Kind] = "mapping" and config <> null,
		        rule = if config = null then null else Record.FieldOrDefault(config, "processMissing", null),
		        canMark = mapping and rule <> null and List.Contains(rule[classes], item[Class]) and List.AnyTrue(List.Transform(item[Mapping], (reason) => List.Contains(rule[rules], reason))),
		        reviewAsk = not closed and book[AskAfterReview] <> "" and state = "review",
		        reviewBack = not closed and book[AskAfterReview] <> "" and state <> "review" and item[FactState] = "review",
		        unsure = not closed and state = "open" and book[AskWhenUnsure] <> "",
		        // The button of an askWhenUnsure line: the words after the last ": ", with a capital ("…: ask the owner" → "Ask the owner").
		        unsureWords =
		            let
		                text = book[AskWhenUnsure],
		                at = Text.PositionOf(text, ": ", Occurrence.Last),
		                rest = if at < 0 then text else Text.Middle(text, at + 2)
		            in
		                Text.Upper(Text.Start(rest, 1), "en-GB") & Text.Middle(rest, 1),
		        on = [
		            note = true,
		            status = openWork and not sacmFix,
		            request = openWork and not sacmFix,
		            assign = openWork,
		            stop = openWork and not sacmFix,
		            #"follow-again" = item[Stopped],
		            fixed = sacmFix and not closed and state = "open" and item[Status] <> "Fixed",
		            #"undo-fixed" = sacmFix and not closed and state = "open" and item[Status] = "Fixed",
		            #"ask-owner" = reviewAsk or (unsure and not ownerAsked),
		            #"back-to-sacm" = reviewBack or (unsure and ownerAsked),
		            retirement = item[InLatest] and not closed and book[RetirementDate] and (state = "open" or item[RetireOn] <> ""),
		            stage = mapping and not closed,
		            #"no-process" = canMark and not closed and not processMissing,
		            #"no-process-undo" = canMark and not closed and processMissing
		        ],
		        labelOf = (action as record) as text =>
		            if action[id] = "fixed" and book[MarkWord] = "deleted" then "Deleted"
		            else if action[id] = "ask-owner" and reviewAsk then book[AskAfterReview]
		            else if action[id] = "ask-owner" and unsure then unsureWords
		            else action[label],
		        chosen = List.Select(AppActions[actions], (action) => action[scope] = "line" and Record.FieldOrDefault(on, action[id], false)),
		        stages = if mapping then fnStages(config, item[Class]) else {},
		        stageIds = List.Transform(stages, (stage) => stage[Id]),
		        marks = List.Select(timeline, (event) => event[Type] = "stage" and List.Contains(stageIds, event[Text]))
		    in
		        [
		            Actions = Text.Combine(List.Transform(chosen, (action) => action[id] & "=" & labelOf(action)), "|"),
		            ActionWords = Text.Combine(List.Transform(chosen, labelOf), " · "),
		            Stages = Text.Combine(List.Transform(stages, (stage) => stage[Id] & "=" & stage[Label]), "|"),
		            StageId = if not mapping or List.IsEmpty(stages) then "" else if List.IsEmpty(marks) then stages{0}[Id] else List.Last(marks)[Text]
		        ]
	queryGroup: Reading

/// The part CaseLines of the table Run (D292), which the DAX table CaseLines shows: one line per case of the newest report (fnCases), with its status (StatusLabel: the word the pages show, "Asked" for Contacted), how it is listed, who has it, the messages, the replies, the decision to stop following it, who marked it fixed and when, when the newest report verified it, and (build B6) who it is about and what the Power App offers on it, and (build B7) who it goes to when its card is shared out. `cases` is fnCases(CheckRun).
expression fnCaseLinesPart =
		(cases as list) as table =>
		    #table(
		        type table [Key = text, CheckId = text, CiKey = text, CiName = text, ClassLabel = text, Field = text, ContactName = text,
		            InLatest = logical, Untested = logical, CiMissing = logical, State = text, StateLabel = text, Status = text, StatusLabel = text,
		            AssignedTo = text, HandoverNote = text, Request = text, Messages = Int64.Type, SentOn = date, LastMessageTo = text, LastRef = text,
		            ReminderFrom = date, Remind = text, Replies = Int64.Type, LastReplyOn = date, ExceptionReason = text, ReviewOn = date,
		            ExceptionEnded = date, RetireOn = date, VerifiedOn = date, FixedBy = text, FixedOn = date, Events = Int64.Type,
		            Person = text, Actions = text, ActionWords = text, Stages = text, StageId = text, ShareTo = text],
		        List.Transform(cases, (item) => {
		            item[Key], item[CheckId], item[CiKey], item[CiName], item[ClassLabel], item[Field], item[ContactName], item[InLatest], item[Untested], item[CiMissing],
		            item[State], item[StateLabel], item[Status], item[StatusLabel], item[AssignedTo], item[HandoverNote], item[Request], item[Messages], item[SentOn], item[LastMessageTo],
		            item[LastRef], item[ReminderFrom], item[Remind], List.Count(item[Replies]), item[LastReplyOn], item[ExceptionReason], item[ReviewOn],
		            item[ExceptionEnded], item[RetireOn], item[VerifiedOn], item[FixedBy], item[FixedOn], item[Events],
		            item[Person], item[Actions], item[ActionWords], item[Stages], item[StageId], item[ShareTo]}))
	queryGroup: Reading

/// The cases of the newest report (D292), as the app works out its cases (src/core/cases/cases.ts, buildCases), from the findings of the newest report, the journal and the replies. A case is every finding of the newest report that is not parked, and every key the journal names that the newest report no longer shows (the team worked on it). Status (DOMAIN-RULES §17): New, Contacted, Answered (a reply after the last message), Fix in progress, Fixed, Not followed up (until its review date), Verified (the newest report contains the CI, tested the check and no longer shows the finding). State: how the case is listed, from the finding (a planned retirement date after today makes it wait; "Ask the owner" makes a finding to check one to solve); "" for a key the newest report no longer shows. Remind: "reminder" or "escalation" once ReminderFrom comes, for a case that was asked and did not answer (D39, D40); the measures compare ReminderFrom with today, so it is right between two refreshes. Every message counts as sent on the day it was recorded (the outbox is the app's, D162). `run` is CheckRun (null when no CI report is loaded). Read by the parts CaseLines and RepliesToRead of the table Run. `given` (build B7): [Events, Replies] instead of the journal and the replies of the team; the answer key gives none, to compare the drafts with the recorded messages (DraftsRecorded). Each case also keeps, for the drafts (fnDrafts): Fact (its finding), MessageEvents (its messages), ReminderDue and OverLimit (as buildCases: asked, no answer, the working days to the reminder passed by CaseToday, and the reminders used or not) and Askable (a line of a fix list with askWhenUnsure only once SACM handed it to the owner, src/app/view/fix-list.ts).
expression fnCases =
		(run as nullable record, optional given as nullable record) as list =>
		    let
		        facts = if run = null then {} else run[Facts],
		        events = if given = null then JournalEvents else given[Events],
		        rules = CaseRules,
		        today = Date.ToText(CaseToday, [Format = "yyyy-MM-dd", Culture = "en-US"]),
		        date = if run = null then null else run[Date],
		        parkedCis = if run = null or run[Parked] = null then [] else run[Parked][KeySet],
		        parkedFields = if run = null or run[Parked] = null then [] else run[Parked][FieldSet],
		        current = fnKeySet(List.Transform(facts, (fact) => fact[Key])),
		        reportCis = fnKeySet(if run = null then {} else List.Transform(run[Cis], (ci) => ci[Key])),
		        tested = fnKeySet(if run = null then {} else run[Tested]),
		        // The events of each key, oldest first; the standing exceptions (no keys, for a check and a CI by name, D86).
		        pairs = List.Combine(List.Transform(events, (event) => List.Transform(event[Keys], (key) => [Key = key, Event = event]))),
		        byKey = fnGroupBy(pairs, (pair) => pair[Key]),
		        eventsOf = (key as text) as list => List.Transform(Record.FieldOrDefault(byKey, key, {}), (pair) => pair[Event]),
		        standing = List.Buffer(List.Select(events, (event) => event[Type] = "exception" and List.IsEmpty(event[Keys]) and event[CiKey] <> "")),
		        covers = (event as record, checkId as text, ciKey as text) as logical =>
		            (event[CheckId] = "*" or event[CheckId] = checkId)
		            and (ciKey = event[CiKey] or Text.StartsWith(ciKey, event[CiKey] & "|") or Text.StartsWith(ciKey, event[CiKey] & "#")),
		        order = (a as record, b as record) as number => let first = Value.Compare(a[At], b[At]) in if first <> 0 then first else Value.Compare(a[Id], b[Id]),
		        repliesByRef = fnGroupBy(if given = null then ReplyItems else given[Replies], (reply) => reply[Ref]),
		        todayDate = CaseToday,
		        // Parts of a key: <check>:<CI key>:<field>; a CI key may hold ":" (a contract), a check id and a field never do.
		        partsOf = (key as text) as record =>
		            let first = Text.PositionOf(key, ":"), last = Text.PositionOf(key, ":", Occurrence.Last) in
		            [CheckId = Text.Start(key, first), CiKey = Text.Middle(key, first + 1, last - first - 1), Field = Text.Middle(key, last + 1)],
		        gone = List.Select(Record.FieldNames(byKey), (key) => not Record.HasFields(current, key) and Text.PositionOf(key, ":") >= 0
		            and Text.PositionOf(key, ":") < Text.PositionOf(key, ":", Occurrence.Last)),
		        goneFacts = List.Transform(gone, (key) => let parts = partsOf(key) in parts & [Key = key, CiName = parts[CiKey], ClassLabel = "", ContactName = "", ContactEmail = "", State = null]),
		        subjects = List.Select(List.Transform(facts, (fact) => fact & [InLatest = true]) & List.Transform(goneFacts, (fact) => fact & [InLatest = false]),
		            (fact) => not Record.HasFields(parkedCis, fact[CiKey]) and not Record.HasFields(parkedFields, fact[CheckId] & ":" & fact[Field])),
		        exceptionWords = {"Waived", "Exception accepted", "Not followed up"},
		        lastText = (timeline as list, kind as text) as text => let found = List.Last(List.Select(timeline, (event) => event[Type] = kind), null) in if found = null then "" else found[Text],
		        dateOf = (value as text) as nullable date => if value = "" then null else Date.FromText(Text.Start(value, 10), [Format = "yyyy-MM-dd", Culture = "en-US"]),
		        line = (fact as record) as record =>
		            let
		                key = fact[Key],
		                own = eventsOf(key),
		                covering = List.Select(standing, (event) => covers(event, fact[CheckId], fact[CiKey])),
		                timeline = List.Buffer(if List.IsEmpty(covering) then own else List.Sort(own & covering, order)),
		                inLatest = fact[InLatest],
		                untested = not inLatest and not Record.HasFields(tested, fact[CheckId] & ":" & fact[Field]),
		                // A contract is not in the CI report: the contract files are complete lists, so a contract gone from a tested check is solved.
		                ciMissing = not inLatest and not Record.HasFields(reportCis, fact[CiKey]) and not Text.StartsWith(fact[CiKey], "contract:"),
		                messages = List.Buffer(List.Select(timeline, (event) => event[Type] = "message")),
		                lastMessage = List.Last(messages, null),
		                replies = List.Buffer(List.Sort(List.Distinct(List.Combine(List.Transform(messages, (message) => Record.FieldOrDefault(repliesByRef, message[Ref], {})))),
		                    (a, b) => Value.Compare(a[Received], b[Received]))),
		                manual = List.Last(List.Select(timeline, (event) => event[Type] = "status" or event[Type] = "exception"), null),
		                asked = if lastMessage = null then "New" else if List.AnyTrue(List.Transform(replies, (reply) => reply[Received] >= lastMessage[At])) then "Answered" else "Contacted",
		                // An exception stands until a manager sets another status or its review date comes; a status stands until a later message.
		                running = manual <> null and manual[Type] = "exception" and (manual[ReviewOn] = "" or manual[ReviewOn] > today),
		                legacy = manual <> null and manual[Type] = "status" and List.Contains(exceptionWords, manual[Text]),
		                exception = if running or legacy then manual else null,
		                ended = if manual <> null and manual[Type] = "exception" and not running then manual[ReviewOn] else "",
		                set = if exception <> null then "Not followed up"
		                    else if manual <> null and manual[Type] = "status" and (lastMessage = null or manual[At] > lastMessage[At]) then manual[Text]
		                    else asked,
		                solved = not inLatest and not untested and not ciMissing,
		                status = if solved and set <> "Not followed up" then "Verified" else set,
		                retirements = List.Select(timeline, (event) => event[Type] = "retirement"),
		                retireOn = if List.IsEmpty(retirements) then "" else List.Last(retirements)[RetireOn],
		                reviewed = List.Select(timeline, (event) => event[Type] = "reviewed"),
		                ownerAsked = not List.IsEmpty(reviewed) and List.Last(reviewed)[Text] = "Ask the owner",
		                factState = fact[State],
		                state = if factState = null then ""
		                    else if factState = "open" then (if retireOn > today then "waiting" else "open")
		                    else if factState = "review" then (if ownerAsked then "open" else "review")
		                    else factState,
		                // A case that waits for its planned retirement date gets no reminder until then.
		                due = not (state = "waiting" and factState = "open"),
		                assignment = List.Last(List.Select(timeline, (event) => event[Type] = "assign" or event[Type] = "handover"), null),
		                sentOn = if lastMessage = null then null else dateOf(lastMessage[At]),
		                closed = status = "Verified" or status = "Not followed up",
		                // What the Power App offers on the case (build B6, D294).
		                actions = fnCaseActions([
		                    Key = key, CheckId = fact[CheckId], InLatest = inLatest, State = state, FactState = if factState = null then "" else factState, Closed = closed,
		                    Status = status, Timeline = timeline, Stopped = exception <> null, RetireOn = retireOn,
		                    Class = Record.FieldOrDefault(fact, "Class", ""), Mapping = Record.FieldOrDefault(fact, "Mapping", {})
		                ]),
		                contactId = Record.FieldOrDefault(fact, "ContactId", ""),
		                reminderFrom = if sentOn = null then null else fnAddBusinessDays(sentOn, rules[ReminderDays]),
		                waited = reminderFrom <> null and reminderFrom <= todayDate,
		                book = Record.FieldOrDefault(CheckPlaybooks, fact[CheckId], [AskWhenUnsure = ""])
		            in
		                [
		                    Key = key, CheckId = fact[CheckId], CiKey = fact[CiKey], CiName = fact[CiName], ClassLabel = fact[ClassLabel], Field = fact[Field],
		                    ContactName = fact[ContactName], InLatest = inLatest, Untested = untested, CiMissing = ciMissing, State = state,
		                    StateLabel = Record.FieldOrDefault([open = "To solve", review = "To check", waiting = "Waiting", known = "Known"], state, ""), Status = status,
		                    StatusLabel = Record.FieldOrDefault([New = "New", Contacted = "Asked", Answered = "Answered", #"Fix in progress" = "In progress", Fixed = "Marked fixed",
		                        #"Not followed up" = "Not followed up", Verified = "Verified"], status, status),
		                    AssignedTo = if assignment = null then "" else if assignment[Type] = "assign" then assignment[Text] else assignment[To],
		                    HandoverNote = if assignment = null or assignment[Type] <> "handover" then "" else assignment[Text],
		                    Request = lastText(timeline, "request"), Messages = List.Count(messages), SentOn = sentOn,
		                    LastMessageTo = if lastMessage = null then "" else lastMessage[To], LastRef = if lastMessage = null then "" else lastMessage[Ref],
		                    ReminderFrom = reminderFrom,
		                    Remind = if due and status = "Contacted" then (if List.Count(messages) <= rules[MaxReminders] then "reminder" else "escalation") else "",
		                    Replies = replies, LastReplyOn = if List.IsEmpty(replies) then null else dateOf(List.Last(replies)[Received]),
		                    ExceptionReason = if exception = null then "" else if legacy then "Set before version 0.12 (no reason)" else exception[Reason],
		                    ReviewOn = if exception = null then null else dateOf(exception[ReviewOn]), ExceptionEnded = dateOf(ended), RetireOn = dateOf(retireOn),
		                    VerifiedOn = if solved then date else null,
		                    FixedBy = if status = "Fixed" and manual <> null then (if manual[ByName] <> "" then manual[ByName] else manual[By]) else "",
		                    FixedOn = if status = "Fixed" and manual <> null then dateOf(manual[At]) else null, Events = List.Count(timeline),
		                    // The last time a manager acted on the case (a status, an exception, a message): a reply before it is read.
		                    Acted = List.Max(List.Transform(List.Select(timeline, (event) => List.Contains({"status", "exception", "message"}, event[Type])), (event) => event[At]), ""),
		                    Closed = closed,
		                    // Who the case is about: the user ID of the person asked, else the email in lower case (as the HTML app knows a person contacted).
		                    Person = if not inLatest then "" else if contactId <> "" then contactId else Text.Lower(fact[ContactEmail], "en-US"),
		                    Actions = actions[Actions], ActionWords = actions[ActionWords], Stages = actions[Stages], StageId = actions[StageId],
		                    // For the drafts (build B7).
		                    Fact = fact, MessageEvents = messages,
		                    ReminderDue = due and status = "Contacted" and List.Count(messages) <= rules[MaxReminders] and waited,
		                    OverLimit = due and status = "Contacted" and List.Count(messages) > rules[MaxReminders] and waited,
		                    ToSolve = not closed and state = "open", Askable = book[AskWhenUnsure] = "" or ownerAsked
		                ],
		        lines = List.Buffer(List.Transform(subjects, line)),
		        // Share out (build B7, D24): the manager a free group of its card goes to, "" otherwise.
		        shareTo = fnShareOut(lines)
		    in
		        List.Buffer(List.Transform(lines, (item) => item & [ShareTo = Record.FieldOrDefault(shareTo, item[Key], "")]))
	queryGroup: Reading

/// Any cell as text, as the HTML app reads it: dates as yyyy-mm-dd hh:mm:ss, true/false, numbers without a thousands separator. An empty cell is "".
expression fnCellText =
		(value as any) as text =>
		    if value = null then ""
		    else if value is text then value
		    else if value is datetime then DateTime.ToText(value, [Format = "yyyy-MM-dd HH:mm:ss", Culture = "en-US"])
		    else if value is date then Date.ToText(value, [Format = "yyyy-MM-dd", Culture = "en-US"]) & " 00:00:00"
		    else if value is logical then (if value then "true" else "false")
		    else if value is number then Number.ToText(value, "G", "en-US")
		    else Text.From(value, "en-US")
	queryGroup: Reading

/// The first message of a Teams chat (src/core/messages/messages.ts, chatMessage; D44, D163; build B7): the same first sentence and ask as the email, written for a chat ({reply} reads "answer in this chat"), with the names of the CIs that `to` (the address of the person asked) is asked about, at most eight and then "and 3 more CIs". With `to` "": every CI. `items`: the cases, each with its Fact; `settings`: MessageSettings; `ref`: the reference, or %%REF%% for the Power App to fill.
expression fnChatMessage =
		(items as list, settings as record, ref as text, to as text, optional checkPacks as nullable list) as text =>
		    let
		        chat = settings & [Channel = "chat"],
		        lower = (value as text) as text => Text.Lower(value, "en-US"),
		        theirs = if to = "" then items else List.Select(items, (item) => lower(fnRecipient(item[Fact], settings)[Email]) = lower(to)),
		        own = if List.IsEmpty(theirs) then items else theirs,
		        packs = if checkPacks <> null then checkPacks else List.Transform(Json.Document(CheckFiles), (file) => file[pack]),
		        pack = if List.IsEmpty(own) then null else List.First(List.Select(packs, (candidate) => candidate[id] = own{0}[Fact][CheckId]), null),
		        message = if pack = null then null else Record.FieldOrDefault(Record.FieldOrDefault(pack, "playbook", []), "message", null)
		    in
		        if message = null then "Hi, this is the SACM team. Reference: " & ref
		        else
		            let
		                mine = List.Select(own, (item) => item[Fact][CheckId] = pack[id]),
		                texts = fnMessageSection(message, mine{0}[Fact][Route], mine, chat),
		                names = List.Sort(List.Distinct(List.Transform(mine, (item) => item[Fact][CiName])), Comparer.FromCulture("en-US")),
		                more = List.Count(names) - 8,
		                noun = if List.AllTrue(List.Transform(mine, (item) => Record.FieldOrDefault(item[Fact], "Contract", null) <> null)) then "more contract" else "more CI",
		                shown = List.Transform(List.FirstN(names, 8), (name) => "- " & name) & (if more > 0 then {"- and " & Text.From(more) & " " & noun & (if more = 1 then "" else "s")} else {})
		            in
		                Text.Combine({"Hi, this is the SACM team. " & texts[Intro][Text]} & shown & {texts[Ask][Text], "Reference: " & ref}, "#(lf)")
	queryGroup: Reading

/// The rules of the relationship model a check runs (relationship-detectors.ts, chosen): those its detector names in `rules`, in the order of the model, else every rule.
expression fnChosenRules =
		(pack as record, rules as list) as list =>
		    let names = Record.FieldOrDefault(pack[detector], "rules", null) in
		    if names = null then rules else List.Select(rules, (rule) => List.Contains(names, rule[id]))
	queryGroup: Reading

/// The columns of a CI report by the names the checks use (src/core/sources/ci/ci-report.ts, `columns`): "supportGroup", "owned_by.active", "target.confidentiality". A check never reports on data the report does not carry.
expression fnCiColumns =
		(read as record) as list =>
		    let
		        specs = ReadingRules[ciColumns],
		        found = fnPickColumns(read, specs)[Found]
		    in
		        List.Transform(List.Select(specs, (spec) => List.Contains(found, spec[column])), (spec) => spec[field])
	queryGroup: Reading

/// How many CIs a CI report has, without reading it all: the rows whose name cell is not empty after trimming, the rule of fnReadCiReport (a row without a name is left out). For the table Runs.
expression fnCiCount =
		(read as record) as number =>
		    let
		        nameSpec = List.First(List.Select(ReadingRules[ciColumns], (spec) => spec[column] = "Name")),
		        nameAt = fnColumnIndex(read[Headers], nameSpec[any], Record.FieldOrDefault(nameSpec, "suffix", false)),
		        sourceColumns = Table.ColumnNames(read[Rows])
		    in
		        if nameAt < 0 or nameAt >= List.Count(sourceColumns) then 0
		        else List.Count(List.Select(Table.Column(read[Rows], sourceColumns{nameAt}), (cell) => Text.Trim(cell) <> ""))
	queryGroup: Reading

/// The text of a CI field a rule reads by its check-file name (src/core/checks/engine.ts, text); "" for any other field.
expression fnCiText =
		(ci as record, field as text) as text =>
		    if field = "description" then ci[Description]
		    else if field = "name" then ci[Name]
		    else if field = "exception_justification" then ci[ExceptionJustification]
		    else if field = "exception_status" then ci[ExceptionStatus]
		    else if field = "support_group" then ci[SupportGroup]
		    else if field = "operational_status" then ci[Status]
		    else ""
	queryGroup: Reading

/// A class in words: "Business Application", "Platform" (relationship-detectors.ts, CLASS_WORDS), else its name with spaces.
expression fnClassWord = (cls as text) as text => Record.FieldOrDefault(ReadingRules[classWords], cls, Text.Replace(cls, "_", " "))
	queryGroup: Reading

/// The place of the first header that is one of `names` (with `suffix`: that ends with one of them); -1 when none.
expression fnColumnIndex =
		(headers as list, names as list, optional suffix as nullable logical) as number =>
		    List.PositionOf(
		        List.Transform(headers, (header) =>
		            if suffix = true then List.AnyTrue(List.Transform(names, (name) => Text.EndsWith(header, name))) else List.Contains(names, header)),
		        true)
	queryGroup: Reading

/// The label of a report column as the report layout names it, for a note: "supported_by.active" is "Supported by (active)", "target.availability" is "Target availability" (src/core/shared/text.ts, columnWord).
expression fnColumnWord =
		(column as text) as text =>
		    let
		        words = ReadingRules[columnWords],
		        dot = Text.PositionOf(column, "."),
		        head = if dot < 0 then column else Text.Start(column, dot),
		        rest = if dot < 0 then "" else Text.Middle(column, dot + 1),
		        role = Record.FieldOrDefault(words[roles], head, null),
		        part = Record.FieldOrDefault(words[parts], rest, Text.Replace(Text.Replace(rest, ".", " "), "_", " ")),
		        spaced = Text.Replace(Text.Replace(column, ".", " "), "_", " "),
		        chars = Text.ToList(spaced),
		        // A space between a lower case letter and the capital after it ("supportGroup" -> "support Group").
		        split = Text.Combine(List.Transform(List.Positions(chars), (at) =>
		            let before = if at > 0 then Character.ToNumber(chars{at - 1}) else 0, code = Character.ToNumber(chars{at}) in
		            if before >= 97 and before <= 122 and code >= 65 and code <= 90 then " " & chars{at} else chars{at})),
		        lower = Text.Lower(split, "en-US")
		    in
		        if Record.HasFields(words[columns], column) then Record.Field(words[columns], column)
		        else if role <> null then (if rest <> "" then role & " (" & part & ")" else role)
		        else if (head = "target" or head = "inherited") and rest <> "" then (if head = "target" then "Target" else "Inherited") & " " & rest
		        else fnCapital(lower)
	queryGroup: Reading

/// The outputs of the parts of a detector as one output: [Findings, Tested, Evaluated, Notes], each a list.
expression fnCombineOutputs =
		(outputs as list) as record =>
		    [
		        Findings = List.Buffer(List.Combine(List.Transform(outputs, (out) => out[Findings]))),
		        Tested = List.Combine(List.Transform(outputs, (out) => out[Tested])),
		        Evaluated = List.Combine(List.Transform(outputs, (out) => out[Evaluated])),
		        Notes = List.Combine(List.Transform(outputs, (out) => out[Notes]))
		    ]
	queryGroup: Reading

/// How often each text is in a list, as a record: the text as the field name, its count as the value (one pass of Table.Group, no list searched per item).
expression fnCountBy =
		(values as list) as record =>
		    let
		        grouped = Table.Group(Table.FromColumns({values}, {"Value"}), {"Value"}, {{"Count", Table.RowCount, Int64.Type}})
		    in
		        Record.FromList(grouped[Count], grouped[Value])
	queryGroup: Reading

/// The text of a report file: UTF-8, else Windows-1252 (as ServiceNow CSV exports can be). A byte order mark is removed.
expression fnDecodeText =
		(content as binary) as text =>
		    let
		        utf8 = Text.FromBinary(content, TextEncoding.Utf8),
		        text = if Text.Contains(utf8, Character.FromNumber(65533)) then Text.FromBinary(content, 1252) else utf8
		    in
		        if Text.StartsWith(text, Character.FromNumber(65279)) then Text.Middle(text, 1) else text
	queryGroup: Reading

/// True when the text is one or more digits 0-9.
expression fnDigits =
		(text as text) as logical =>
		    text <> "" and List.AllTrue(List.Transform(Text.ToList(text), (char) => Text.Contains("0123456789", char)))
	queryGroup: Reading

/// The messages to the people the checks ask (src/core/messages/messages.ts, buildDrafts; build B7, D300): one draft per person, across every card (D34). A person who got a message and did not answer gets a reminder in the thread of the first message (the same reference, D5); their points that were never asked join it as its second part, "New since then" (D161). When the reminders got no answer (OverLimit), the draft goes to the person above: an escalation (D40, D160), with the person asked in copy; when nobody is known, its To is empty and the manager types it in the Power App. A message holds at most MessageWords[maxCis] CIs; a longer one is split into parts (D36). The Procurement mailbox and a team get one message with every table, nobody copied (D98, D195). Building a draft sends nothing. `cases`: the cases to write about, each [Key, Fact (the finding, fnFacts), MessageEvents (its messages, oldest first), OverLimit]; `settings`: MessageSettings. A case nobody can be written to (no address, no message texts) is left out. Each draft: Ref (the reference of the message a reminder answers, "" for a new one), Kind (first, reminder, escalation), To, ToName, Cc ("a; b"), Subject, Body (HTML; every value from a report escaped), Plain (the same as text), Keys and NewKeys (the keys of "New since then"), CheckIds, CiCount, PartIndex, PartCount, About (for an escalation: who did not answer), NobodyAbove, Mailbox, Team, Person (who the draft is about) and Items (its cases). Subject, Body and Plain hold %%REF%% where the reference goes and %%SENDER%% where the name of the manager goes: the Power App fills both when the manager sends (D301). The order of the drafts and of their lines is the one of the HTML app. Layout: the same message as data, part by part, for the email template (fnEmailTemplate, D313), as src/core gives it (Draft.layout): Opening (HTML paragraphs, without Why), Why (the line why they get it, or ""), Sections (each Key, Group, Heading, Title, Lead, Role, Contract, Found, Rows, Ask, Why), FirstName, Cis, Noun, Sender, Signature. `settings` may hold MaxCis: the CIs a message holds before it is split (a test of the template, EmailsSplit).
expression fnDrafts =
		(cases as list, settings as record) as list =>
		    let
		        words = MessageWords,
		        packs = List.Buffer(List.Transform(Json.Document(CheckFiles), (file) => file[pack])),
		        packById = Record.FromList(packs, List.Transform(packs, (pack) => pack[id])),
		        orderById = Record.FromList(List.Positions(packs), List.Transform(packs, (pack) => pack[id])),
		        messageOf = (pack as record) as nullable record => Record.FieldOrDefault(Record.FieldOrDefault(pack, "playbook", []), "message", null),
		        packOf = (fact as record) as nullable record => Record.FieldOrDefault(packById, fact[CheckId], null),
		        procurementId = ReadingRules[procurement][id],
		        compare = Comparer.FromCulture("en-US"),
		        lower = (value as text) as text => Text.Lower(value, "en-US"),
		        textOf = (value as any) as text => if value = null then "" else value,
		        plain = (value as text) as record => [Html = fnHtml(value), Text = value],
		        join = (parts as list, separator as text) as record => [
		            Html = Text.Combine(List.Select(List.Transform(parts, (part) => part[Html]), (value) => value <> ""), separator),
		            Text = Text.Combine(List.Select(List.Transform(parts, (part) => part[Text]), (value) => value <> ""), separator)
		        ],
		        p = (rich as record) as record => [Html = if rich[Html] <> "" then "<p>" & rich[Html] & "</p>" else "", Text = rich[Text]],
		        plural = (count as number, word as text) as text => Text.From(count) & " " & word & (if count = 1 then "" else "s"),
		        andList = (values as list) as text =>
		            if List.Count(values) <= 1 then List.First(values, "") else Text.Combine(List.RemoveLastN(values, 1), ", ") & " and " & List.Last(values),
		        numberWords = {"no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"},
		        times = (count as number) as text => if count = 1 then "once" else (if count >= 0 and count <= 10 then numberWords{count} else Text.From(count)) & " times",
		        firstName = (name as text) as text =>
		            let
		                base = if Text.Contains(name, ",") then Text.Split(name, ","){1} else name,
		                trimmed = Text.Trim(base)
		            in
		                Text.SplitAny(trimmed, " #(tab)#(cr)#(lf)"){0},
		        capital = (value as text) as text => Text.Upper(Text.Start(value, 1), "en-US") & Text.Middle(value, 1),
		        isTeam = (fact as record) as logical => Text.StartsWith(fact[ContactId], "team:"),
		        toMailbox = (fact as record) as logical => fact[ContactId] = procurementId,
		        isContract = (item as record) as logical => Record.FieldOrDefault(item[Fact], "Contract", null) <> null,
		        recipientOf = (fact as record) as record => fnRecipient(fact, settings),
		        // Who gets the escalation: the person above, or the Procurement lead for the mailbox; null when there is nobody.
		        escalationOf = (fact as record, recipient as record) as nullable record =>
		            if toMailbox(fact) then
		                let email = Text.Trim(settings[ProcurementLeadEmail]) in
		                if email = "" then null else [Name = if Text.Trim(settings[ProcurementLeadName]) <> "" then Text.Trim(settings[ProcurementLeadName]) else "Procurement lead", Email = email]
		            else if textOf(fact[EscalateEmail]) = "" or lower(fact[EscalateEmail]) = lower(recipient[Email]) then null
		            else [Name = textOf(fact[EscalateName]), Email = fact[EscalateEmail]],
		        // The kind of problem of a finding of a check with byProblem: the first part of its field.
		        problemOf = (fact as record) as text => Text.Split(fact[Field], "."){0},
		        byProblem = (pack as record) as nullable record => Record.FieldOrDefault(messageOf(pack), "byProblem", null),
		        textsOf = (pack as record, problem as nullable text) as record =>
		            let base = messageOf(pack), own = if problem = null then null else Record.FieldOrDefault(Record.FieldOrDefault(base, "byProblem", []), problem, null) in
		            if own = null then base else base & own,
		        problemOrder = (fact as record) as number =>
		            let kinds = Record.FieldNames(Record.FieldOrDefault(messageOf(packOf(fact)), "byProblem", [])), at = List.PositionOf(kinds, problemOf(fact)) in
		            if at < 0 then List.Count(kinds) else at,
		        sectionKey = (fact as record) as text =>
		            fact[CheckId] & "|" & fact[Route] & "|" & (if byProblem(packOf(fact)) <> null then problemOf(fact) else ""),
		        // The last message a reminder answers: an email if there is one, else a Teams chat.
		        previousOf = (item as record) as nullable record =>
		            let emails = List.Select(item[MessageEvents], (event) => event[Channel] <> "teams") in
		            if List.IsEmpty(emails) then List.Last(item[MessageEvents], null) else List.Last(emails),

		        /* ---------------------------------------------------------- who gets each case */
		        entries = List.Buffer(List.RemoveNulls(List.Transform(cases, (item) =>
		            let
		                fact = item[Fact],
		                recipient = recipientOf(fact),
		                pack = packOf(fact)
		            in
		                if recipient[Email] = "" or pack = null or messageOf(pack) = null then null
		                else
		                    let
		                        previous = previousOf(item),
		                        kind = if previous <> null and previous[Ref] <> "" then "reminder" else "first",
		                        escalate = kind = "reminder" and item[OverLimit],
		                        above = if escalate then escalationOf(fact, recipient) else null,
		                        // The Procurement mailbox without a Procurement lead in Settings: no escalation, the reminder goes again (D147).
		                        final = if escalate and (above <> null or not toMailbox(fact)) then "escalation" else kind,
		                        to = if final = "escalation" then (if above <> null then above else [Name = "", Email = ""]) else recipient,
		                        previousRef = if final = "first" then "" else previous[Ref]
		                    in
		                        [
		                            Item = item, Kind = final, PreviousRef = previousRef, To = to, NobodyAbove = final = "escalation" and above = null,
		                            GroupKey = final & "|" & previousRef & "|" & lower(to[Email]) & "|" & (if final = "escalation" then lower(recipient[Email]) else "")
		                        ]))),
		        grouped = fnGroupBy(entries, (entry) => entry[GroupKey]),
		        groups = List.Buffer(List.Transform(Record.FieldValues(grouped), (members) =>
		            let first = members{0} in [Kind = first[Kind], PreviousRef = first[PreviousRef], To = first[To], NobodyAbove = first[NobodyAbove], Items = List.Transform(members, (entry) => entry[Item])])),
		        // A reminder and the person's new points are one email (D161): a first message joins the person's first reminder.
		        // The first reminder of each address (its position), and the first messages that join each reminder.
		        reminderAt = fnGroupBy(List.Select(List.Positions(groups), (at) => groups{at}[Kind] = "reminder"), (at) => lower(groups{at}[To][Email]) & "|"),
		        reminderFor = (group as record) as number =>
		            if group[Kind] <> "first" or List.AnyTrue(List.Transform(group[Items], (item) => toMailbox(item[Fact]))) then -1
		            else List.First(Record.FieldOrDefault(reminderAt, lower(group[To][Email]) & "|", {}), -1),
		        targets = List.Buffer(List.Transform(groups, reminderFor)),
		        joiners = fnGroupBy(List.Select(List.Positions(groups), (at) => targets{at} >= 0), (at) => Text.From(targets{at})),
		        merged = List.Buffer(List.Transform(List.Positions(groups), (at) =>
		            let
		                group = groups{at},
		                joining = List.Combine(List.Transform(Record.FieldOrDefault(joiners, Text.From(at), {}), (other) => groups{other}[Items]))
		            in
		                if targets{at} >= 0 then group & [Items = {}, Fresh = []]
		                else group & [Items = group[Items] & joining, Fresh = Record.FromList(List.Transform(joining, (item) => true), List.Transform(joining, (item) => item[Key]))])),

		        /* ---------------------------------------------------------- the parts of a message */
		        contractTable = (items as list) as record =>
		            let
		                cells = (item as record) as list => let contract = item[Fact][Contract] in {textOf(contract[Number]), textOf(contract[Name]), textOf(contract[Vendor]), textOf(item[Fact][Detail])},
		                rows = Text.Combine(List.Transform(items, (item) => "<tr>" & Text.Combine(List.Transform(cells(item), (cell) => "<td>" & fnHtml(cell) & "</td>")) & "</tr>"))
		            in
		                [
		                    Html = "<table border=""1"" cellpadding=""6"" cellspacing=""0"" style=""border-collapse:collapse""><tr>"
		                        & Text.Combine(List.Transform(words[contractColumns], (cell) => "<th align=""left"" style=""white-space:nowrap"">" & cell & "</th>")) & "</tr>" & rows & "</table>",
		                    Text = Text.Combine(List.Transform(items, (item) => "- " & Text.Combine(List.Select(cells(item), (cell) => cell <> ""), " · ")), "#(lf)")
		                ],
		        table = (items as list, found as logical) as record =>
		            if List.AllTrue(List.Transform(items, isContract)) then contractTable(items)
		            else
		                let
		                    head = words[columns] & (if found then {"What we found"} else {}),
		                    cells = (item as record) as list =>
		                        let fact = item[Fact] in
		                        {textOf(fact[CiName]), textOf(fact[EpoId]), textOf(fact[ClassLabel]), textOf(fact[OwnedBy]), textOf(fact[ManagedBy]), textOf(fact[Status]), textOf(fact[SupportGroup])}
		                        & (if found then {textOf(fact[Detail])} else {}),
		                    rows = Text.Combine(List.Transform(items, (item) => "<tr>" & Text.Combine(List.Transform(cells(item), (cell) => "<td>" & fnHtml(cell) & "</td>")) & "</tr>")),
		                    line = (item as record) as text =>
		                        let values = cells(item) in
		                        "- " & Text.Combine(List.Select(List.Transform(List.Positions(values), (at) =>
		                            let cell = values{at} in if at >= 3 and at <= 6 and cell <> "" then head{at} & ": " & cell else cell), (cell) => cell <> ""), " · ")
		                in
		                    [
		                        Html = "<table border=""1"" cellpadding=""6"" cellspacing=""0"" style=""border-collapse:collapse""><tr>"
		                            & Text.Combine(List.Transform(head, (cell) => "<th align=""left"" style=""white-space:nowrap"">" & cell & "</th>")) & "</tr>" & rows & "</table>",
		                        Text = Text.Combine(List.Transform(items, line), "#(lf)")
		                    ],
		        // The cells of a line as text (src/core rowCells): those of the table, with "what we found" always last.
		        rowCells = (item as record) as list =>
		            let fact = item[Fact] in
		            if isContract(item) then let contract = fact[Contract] in {textOf(contract[Number]), textOf(contract[Name]), textOf(contract[Vendor]), textOf(fact[Detail])}
		            else {textOf(fact[CiName]), textOf(fact[EpoId]), textOf(fact[ClassLabel]), textOf(fact[OwnedBy]), textOf(fact[ManagedBy]), textOf(fact[Status]), textOf(fact[SupportGroup]), textOf(fact[Detail])},
		        roleColumn = (via as text) as text => if via = "owned by" then "Owned by" else if via = "managed by" then "Managed by" else "",
		        // One part per check and route (and kind of problem): its intro, table, ask and why; and the same as data (Layout, D313).
		        sectionsBody = (items as list, kind as text, sameWhy as logical, group as text) as record =>
		            let
		                bySection = fnGroupBy(items, (item) => sectionKey(item[Fact])),
		                sections = List.Buffer(List.Transform(Record.FieldValues(bySection), (members) =>
		                    let
		                        fact = members{0}[Fact],
		                        pack = packOf(fact),
		                        problem = if byProblem(pack) <> null then problemOf(fact) else null
		                    in
		                        [Key = sectionKey(fact), PackId = pack[id], Problem = problem, Items = members, Texts = fnMessageSection(textsOf(pack, problem), fact[Route], members, settings)])),
		                several = List.Count(sections) > 1,
		                part = (at as number) as record =>
		                    let
		                        chosen = sections{at},
		                        texts = chosen[Texts],
		                        members = chosen[Items],
		                        found = several or List.Count(List.Distinct(List.Transform(members, (item) => item[Fact][Detail]))) > 1
		                            or List.AnyTrue(List.Transform(members, (item) => textOf(item[Fact][Source]) <> "")),
		                        count = if chosen[Problem] <> null then " (" & Text.From(List.Count(members)) & ")" else "",
		                        next = if at + 1 < List.Count(sections) then sections{at + 1} else null,
		                        // The parts of one check with a table per kind of problem share the line "why it matters": it comes once, after the last.
		                        shareWhy = chosen[Problem] <> null and next <> null and next[PackId] = chosen[PackId] and next[Problem] <> null,
		                        lead = join({if kind <> "escalation" and not sameWhy then plain(texts[WhyYou]) else plain(""), texts[Intro]}, " "),
		                        contract = List.AllTrue(List.Transform(members, isContract))
		                    in
		                        [
		                            Body = (if several then {[Html = "<h3 style=""margin:18px 0 6px"">" & texts[Heading][Html] & count & "</h3>", Text = "#(lf)" & Text.Upper(texts[Heading][Text], "en-US") & count]} else {})
		                                & {p(lead), table(members, found)}
		                                & (if kind <> "escalation" then {p(texts[Ask])} else {})
		                                & (if shareWhy then {} else {p(texts[Why])}),
		                            Layout = [
		                                Key = chosen[Key], Group = group, Heading = texts[Heading][Html], Title = texts[Heading][Text], Lead = lead[Html],
		                                Role = roleColumn(textOf(members{0}[Fact][ContactVia])), Contract = contract, Found = found or contract,
		                                Rows = List.Buffer(List.Transform(members, rowCells)), Ask = if kind <> "escalation" then texts[Ask][Html] else "", Why = if shareWhy then "" else texts[Why][Html]
		                            ]
		                        ],
		                done = List.Buffer(List.Transform(List.Positions(sections), part))
		            in
		                [Body = List.Combine(List.Transform(done, (one) => one[Body])), Layout = List.Transform(done, (one) => one[Layout])],
		        // The first contact of these cases, by any channel (F02): its day and whether it was a Teams chat.
		        firstContact = (items as list) as nullable record =>
		            let
		                all = List.Combine(List.Transform(items, (item) => item[MessageEvents])),
		                numbered = List.Transform(List.Positions(all), (at) => [At = textOf(all{at}[At]), Channel = all{at}[Channel], Order = at]),
		                first = List.First(List.Sort(numbered, (a, b) => let byAt = Value.Compare(a[At], b[At]) in if byAt <> 0 then byAt else Value.Compare(a[Order], b[Order])), null),
		                day = if first = null then "" else Text.Start(first[At], 10)
		            in
		                if first <> null and Text.Length(day) = 10 and Text.Remove(day, {"0".."9"}) = "--" and Text.At(day, 4) = "-" and Text.At(day, 7) = "-"
		                then [On = day, Teams = first[Channel] = "teams"] else null,
		        longDate = (day as text) as text => fnLongDate(Date.FromText(day, [Format = "yyyy-MM-dd", Culture = "en-US"])),
		        // The opening of an escalation: who is written to, why, and what we ask.
		        escalationOpening = (items as list, person as record, nobodyAbove as logical) as text =>
		            let
		                below = fnBelowWords(items),
		                fact = items{0}[Fact],
		                attempts = List.Max(List.Transform(items, (item) => List.Count(item[MessageEvents]))),
		                ask = "Could you help us to get an answer, or tell us who else to ask?",
		                asked = if person[Name] <> "" then person[Name] else person[Email],
		                role = if fact[ContactVia] = "managed by" then ", the Managed by person," else "",
		                via = textOf(fact[EscalateVia])
		            in
		                if toMailbox(fact) then
		                    let sentOn = List.Sort(List.Distinct(List.Combine(List.Transform(items, (item) => List.Transform(item[MessageEvents], (event) => Text.Start(event[At], 10)))))) in
		                    "We wrote to the " & (if person[Name] <> "" then person[Name] else "Procurement") & " mailbox (" & person[Email] & ") on "
		                        & andList(List.Transform(List.LastN(sentOn, 3), longDate)) & " about " & below & ", and we have no answer. "
		                        & "You are the Procurement lead. Could you help us to get an answer, or tell us who else to ask?"
		                else if nobodyAbove then "We asked " & asked & " " & times(attempts) & " about " & below & " and got no answer. " & ask
		                else if via = "owner" then "You are the owner (Owned by) of " & below & ". We asked " & asked & role & " " & times(attempts) & " and got no answer. " & ask
		                else if via = "manager of owner" or via = "department head of owner" then
		                    "You are the " & (if via = "manager of owner" then "manager" else "head of the department") & " of the owner (Owned by) of " & below & ". We asked "
		                        & asked & role & " " & times(attempts) & " and got no answer. " & ask
		                else "We asked " & asked & role & " " & times(attempts) & " about " & below & " and got no answer. "
		                    & "You are " & (if via = "department head" then "the head of their department" else "their manager") & " in ServiceNow. " & ask,

		        /* ---------------------------------------------------------- one draft */
		        draftOf = (items as list, group as record, ref as text, index as number, count as number) as record =>
		            let
		                kind = group[Kind],
		                fresh = group[Fresh],
		                person = recipientOf(items{0}[Fact]),
		                to = group[To][Email],
		                addresses = (if kind = "escalation" then {person[Email]} else {}) & List.Combine(List.Transform(items, (item) => item[Fact][Cc])),
		                cc = List.Accumulate(addresses, {}, (known, address) =>
		                    if address = "" or address = null or lower(address) = lower(to) or List.Contains(List.Transform(known, lower), lower(address)) then known else known & {address}),
		                isFresh = (item as record) as logical => Record.HasFields(fresh, item[Key]),
		                still = List.Select(items, (item) => not isFresh(item)),
		                newOnes = List.Select(items, isFresh),
		                two = not List.IsEmpty(still) and not List.IsEmpty(newOnes),
		                // The line "why you" comes once at the top when every part says the same; else each part says it.
		                sameWhy = List.Count(List.Distinct(List.Transform(items, (item) => fnWhyYou(item[Fact][ContactVia], "X")))) = 1,
		                kinds = List.Count(List.Distinct(List.Transform(items, (item) => sectionKey(item[Fact])))),
		                ciCount = List.Count(List.Distinct(List.Transform(items, (item) => item[Fact][CiKey]))),
		                contracts = List.AllTrue(List.Transform(items, isContract)),
		                noun = if contracts then "contract" else "CI",
		                allTeam = List.AllTrue(List.Transform(items, (item) => isTeam(item[Fact]))),
		                // A team is greeted by its name ("Hi Process Management,"), a person by the first name.
		                greeted = if kind <> "escalation" and allTeam then Text.Trim(group[To][Name]) else firstName(group[To][Name]),
		                firstOfStill = firstContact(still),
		                reminderLine =
		                    let
		                        what = if firstOfStill <> null then "A short reminder of our " & (if firstOfStill[Teams] then "Teams message" else "message") & " of " & longDate(firstOfStill[On]) & "."
		                            else "A short reminder.",
		                        below = fnBelowWords(still)
		                    in
		                        if two then what & " The first part below is still open. The second part has new points for you."
		                        else what & " " & capital(below) & " " & (if List.Count(List.Distinct(List.Transform(still, (item) => item[Fact][CiKey]))) = 1 then "is" else "are") & " still open.",
		                why = fnWhyYou(items{0}[Fact][ContactVia], fnBelowWords(items)),
		                opening = {plain("Hi" & (if greeted <> "" then " " & greeted else "") & ",")}
		                    & (if kind = "reminder" then {plain(reminderLine)} else {})
		                    & (if kind = "escalation" then {plain(escalationOpening(items, person, group[NobodyAbove]))} else {})
		                    & (if kind <> "escalation" and sameWhy then {plain(if kinds > 1 then why & " We found " & plural(kinds, "kind") & " of problem." else why)} else {}),
		                // The opening without the line why they get it (Layout): the email template adds that line itself.
		                layoutOpening = List.Transform(List.FirstN(opening, List.Count(opening) - (if kind <> "escalation" and sameWhy then 1 else 0)), (piece) => piece[Html]),
		                heading = (value as text) as record => [Html = "<h2 style=""margin:22px 0 4px;font-size:16px"">" & fnHtml(value) & "</h2>", Text = "#(lf)== " & Text.Upper(value, "en-US") & " =="],
		                stillTitle = if firstOfStill <> null then "Still open (our message of " & longDate(firstOfStill[On]) & ")" else "Still open",
		                halves = List.Buffer(if two then {sectionsBody(still, kind, sameWhy, stillTitle), sectionsBody(newOnes, kind, sameWhy, "New since then")} else {sectionsBody(items, kind, sameWhy, "")}),
		                parts =
		                    if two then {heading(stillTitle)} & halves{0}[Body] & {heading("New since then")} & halves{1}[Body]
		                    else halves{0}[Body],
		                signature = Text.Trim(if settings[Signature] <> "" then settings[Signature] else "SACM team"),
		                body = List.Transform(opening, p) & parts
		                    & {p(plain("When you reply, please keep the reference [" & ref & "] in the subject.")),
		                       [Html = "<p>Thank you,<br>%%SENDER%%<br>" & fnHtml(signature) & "</p>", Text = "Thank you,#(lf)%%SENDER%%#(lf)" & signature]},
		                firstFact = items{0}[Fact],
		                firstPack = packOf(firstFact),
		                only = if kinds = 1 then fnMessageSection(textsOf(firstPack, if byProblem(firstPack) <> null then problemOf(firstFact) else null), firstFact[Route], items, settings)[Heading][Text] else "",
		                onWhat = if ciCount = 1 then firstFact[CiName] else plural(ciCount, noun),
		                topic = if only <> "" then only & " on " & onWhat
		                    else if contracts then plural(ciCount, "contract") & (if ciCount = 1 then " needs" else " need") & " a correction in Solusi"
		                    else plural(ciCount, "CI") & (if ciCount = 1 then " needs" else " need") & " your attention in the CMDB",
		                subjectTopic = if kind = "reminder" then "Reminder: " & topic
		                    else if kind = "escalation" then "No answer on " & plural(ciCount, noun) & " of " & (if person[Name] <> "" then person[Name] else person[Email])
		                    else topic,
		                // The plain text: the parts with an empty line between them, never two.
		                joined = Text.Combine(List.Transform(body, (piece) => piece[Text]), "#(lf)#(lf)"),
		                collapsed = List.Last(List.Generate(() => joined, (value) => value <> null,
		                    (value) => if Text.Contains(value, "#(lf)#(lf)#(lf)") then Text.Replace(value, "#(lf)#(lf)#(lf)", "#(lf)#(lf)") else null)),
		                fact = items{0}[Fact]
		            in
		                [
		                    Ref = if index = 1 then group[PreviousRef] else "", Kind = kind, To = to, ToName = group[To][Name], Cc = Text.Combine(cc, "; "),
		                    Subject = subjectTopic & (if count > 1 then " (part " & Text.From(index) & " of " & Text.From(count) & ")" else "") & " [" & ref & "]",
		                    Body = Text.Combine(List.Transform(body, (piece) => piece[Html])), Plain = Text.Trim(collapsed),
		                    Keys = List.Transform(items, (item) => item[Key]), NewKeys = List.Transform(newOnes, (item) => item[Key]),
		                    CheckIds = List.Distinct(List.Transform(items, (item) => item[Fact][CheckId])), CiCount = ciCount, PartIndex = index, PartCount = count,
		                    About = if kind = "escalation" then (if person[Name] <> "" then person[Name] else person[Email]) else "",
		                    NobodyAbove = kind = "escalation" and group[NobodyAbove],
		                    Mailbox = List.AllTrue(List.Transform(items, (item) => toMailbox(item[Fact]))), Team = allTeam,
		                    Person = if fact[ContactId] <> "" then fact[ContactId] else lower(textOf(fact[ContactEmail])),
		                    Items = items,
		                    Layout = [
		                        Opening = layoutOpening, Why = if kind <> "escalation" and sameWhy then fnHtml(why) else "",
		                        Sections = List.Combine(List.Transform(halves, (half) => half[Layout])), FirstName = textOf(fact[CiName]),
		                        Cis = List.Buffer(List.Distinct(List.Transform(items, (item) => item[Fact][CiKey]))), Noun = noun, Sender = "%%SENDER%%", Signature = signature
		                    ]
		                ],

		        /* ---------------------------------------------------------- every group, sorted and split */
		        draftsOf = (group as record) as list =>
		            let
		                fresh = group[Fresh],
		                // What the lines are sorted by, worked out once per line: new points last, then the order of the checks,
		                // the kind of problem, the route and the name.
		                numbered = List.Buffer(List.Transform(List.Positions(group[Items]), (at) =>
		                    let item = group[Items]{at}, fact = item[Fact] in
		                    [Item = item, Order = at, Fresh = if Record.HasFields(fresh, item[Key]) then 1 else 0, Pack = Record.Field(orderById, fact[CheckId]),
		                        Problem = problemOrder(fact), Route = textOf(fact[Route]), Name = textOf(fact[CiName])])),
		                order = (a as record, b as record) as number =>
		                    let
		                        byFresh = Value.Compare(a[Fresh], b[Fresh]),
		                        byPack = if byFresh <> 0 then byFresh else Value.Compare(a[Pack], b[Pack]),
		                        byProblem = if byPack <> 0 then byPack else Value.Compare(a[Problem], b[Problem]),
		                        byRoute = if byProblem <> 0 then byProblem else compare(a[Route], b[Route]),
		                        byName = if byRoute <> 0 then byRoute else compare(a[Name], b[Name])
		                    in
		                        if byName <> 0 then byName else Value.Compare(a[Order], b[Order]),
		                items = List.Buffer(List.Transform(List.Sort(numbered, order), (entry) => entry[Item])),
		                // Split by CI, never in the middle of a CI; the limit counts for the whole email. A mailbox or a team gets one message.
		                whole = List.AllTrue(List.Transform(items, (item) => toMailbox(item[Fact]) or isTeam(item[Fact]))),
		                limit = Record.FieldOrDefault(settings, "MaxCis", words[maxCis]),
		                count = List.Count(items),
		                chunkIds = if whole then List.Repeat({0}, count)
		                    else List.Buffer(List.Skip(List.Generate(
		                        () => [At = -1, Chunk = 0, Seen = [], Count = 0],
		                        (state) => state[At] < count,
		                        (state) =>
		                            let at = state[At] + 1 in
		                            if at >= count then [At = at, Chunk = state[Chunk], Seen = [], Count = 0]
		                            else
		                                let
		                                    key = items{at}[Fact][CiKey],
		                                    known = Record.HasFields(state[Seen], key)
		                                in
		                                    if not known and state[Count] >= limit then [At = at, Chunk = state[Chunk] + 1, Seen = Record.AddField([], key, true), Count = 1]
		                                    else if known then [At = at, Chunk = state[Chunk], Seen = state[Seen], Count = state[Count]]
		                                    else [At = at, Chunk = state[Chunk], Seen = Record.AddField(state[Seen], key, true), Count = state[Count] + 1],
		                        (state) => state[Chunk]))),
		                chunkCount = if count = 0 then 0 else List.Last(chunkIds) + 1,
		                byChunk = fnGroupBy(List.Transform(List.Positions(items), (at) => [Chunk = Text.From(chunkIds{at}), Item = items{at}]), (entry) => entry[Chunk]),
		                chunks = List.Buffer(List.Transform(Record.FieldValues(byChunk), (entries) => List.Transform(entries, (entry) => entry[Item]))),
		                one = (chunk as number) as record =>
		                    let
		                        members = chunks{chunk},
		                        // A part that holds only new points is a first message of its own.
		                        onlyNew = group[Kind] = "reminder" and List.AllTrue(List.Transform(members, (item) => Record.HasFields(fresh, item[Key]))),
		                        own = if onlyNew then group & [Kind = "first", PreviousRef = "", Fresh = []] else group
		                    in
		                        draftOf(members, own, "%%REF%%", chunk + 1, chunkCount)
		            in
		                if count = 0 then {} else List.Transform(List.Numbers(0, chunkCount), one)
		    in
		        List.Buffer(List.Combine(List.Transform(merged, draftsOf)))
	queryGroup: Reading

/// The part Drafts of the table Run (build B7, D300), which the DAX table Drafts shows: every message ready to send, one row per draft of fnDrafts (one per person across the cards, D34; a long one in parts, D36). A case is written about when it is to solve, a manager may ask its owner (Askable), and it was never asked, or its reminder is due, or its reminders got no answer (ReminderDue, OverLimit): what the Email window of the HTML app offers with "Add the points from other cards" ticked. Keys and NewKeys hold one key per line. Chat: the first message of a Teams chat with the person asked (fnChatMessage). AssignedTo: who has the cases ("Several" when they are not one manager's, "" when nobody has them). FreeKeys: the keys nobody has, which become the sender's when the message goes (D164). Html, Csv, Summary and EmailSubject: the email of fnEmailTemplate (D313, D314), on the first part of a message; "" on its other parts, which are in that email. EmailId: the DraftId of the draft that holds the email (its own on a first part). The Power App "SACM messages" shows the drafts and sends one when a manager presses Send (D301). `cases` is fnCases(CheckRun).
expression fnDraftsPart =
		(cases as list) as table =>
		    let
		        settings = MessageSettings,
		        // The check files read once for every chat (ARCHITECTURE §12, the speed rules).
		        packs = List.Buffer(List.Transform(Json.Document(CheckFiles), (file) => file[pack])),
		        chosen = List.Select(cases, (item) => item[InLatest] and item[ToSolve] and item[Askable] and (item[Messages] = 0 or item[ReminderDue] or item[OverLimit])),
		        drafts = fnDrafts(chosen, settings),
		        emails = List.Buffer(fnEmailTemplate(drafts, settings)),
		        idOf = (at as number) as text => "D" & Text.PadStart(Text.From(at + 1), 4, "0"),
		        kindWords = [first = "Email", reminder = "Reminder", escalation = "Escalation"],
		        assigned = (items as list) as text =>
		            let names = List.Distinct(List.Transform(items, (item) => item[AssignedTo])) in
		            if List.Count(names) = 1 then names{0} else "Several",
		        row = (at as number) as list =>
		            let draft = drafts{at}, email = emails{at} in
		            {
		                idOf(at), draft[Ref], draft[Kind], Record.Field(kindWords, draft[Kind]), draft[To], draft[ToName], draft[Cc],
		                draft[Subject], draft[Body], draft[Plain], fnChatMessage(draft[Items], settings, "%%REF%%", draft[To], packs),
		                Text.Combine(draft[Keys], "#(lf)"), Text.Combine(draft[NewKeys], "#(lf)"), Text.Combine(draft[CheckIds], ", "),
		                draft[CiCount], draft[PartIndex], draft[PartCount], draft[About], draft[NobodyAbove], draft[Mailbox], draft[Team], draft[Person], assigned(draft[Items]),
		                Text.Combine(List.Transform(List.Select(draft[Items], (item) => item[AssignedTo] = ""), (item) => item[Key]), "#(lf)"),
		                email[Html], email[Csv], email[Summary], email[Subject], idOf(email[First])
		            }
		    in
		        #table(
		            type table [DraftId = text, Ref = text, Kind = text, KindLabel = text, To = text, ToName = text, Cc = text, Subject = text, Body = text, Plain = text,
		                Chat = text, Keys = text, NewKeys = text, CheckIds = text, CiCount = Int64.Type, PartIndex = Int64.Type, PartCount = Int64.Type, About = text,
		                NobodyAbove = logical, Mailbox = logical, Team = logical, Person = text, AssignedTo = text,
		                FreeKeys = text, Html = text, Csv = text, Summary = text, EmailSubject = text, EmailId = text],
		            List.Transform(List.Positions(drafts), row))
	queryGroup: Reading

/// The end of the key of a finding about one relationship: <parent key>><type, compared form>><child key> (relationship-detectors.ts, edgeSuffix).
expression fnEdgeSuffix = (edge as record) as text => edge[Parent][Key] & ">" & fnTypeKey(edge[Type]) & ">" & edge[Child][Key]
	queryGroup: Reading

/// The email template (design pass §6, D313, D314; tools/powerbi/email.ts is its answer key): each draft of fnDrafts laid out as an email that reads the same in Outlook for Windows, Outlook on the web, Outlook on a phone and Gmail (tables and inline styles only): a navy band with the reference, "In this email", the numbered parts, clear tables, the box "What we ask" and a footer. It changes no word of fnDrafts: every text comes from the draft's Layout. The parts of a long message (split at MessageWords[maxCis] CIs, D36) are joined into one email; each table shows its first settings[RowsInEmail] lines, then "and N more in the attached file", and the email gets a CSV file with every line (UTF-8 with a BOM). A short email has no file. Below 480 px (a phone) a line of a table becomes a small card. `drafts`: fnDrafts; `settings`: MessageSettings. One record per draft, in the same order: Html, Csv, Summary (the lines of "In this email" as text), Subject (of the email) and First (the position of the draft whose email holds this draft). The first part of a message holds the whole email; its other parts hold "". The texts keep %%REF%% and %%SENDER%%, which the Power App fills when the manager sends (D301).
expression fnEmailTemplate =
		(drafts as list, settings as record) as list =>
		    let
		        style = EmailStyle,
		        C = style[colours],
		        F = "font-family:" & style[font],
		        columnWords = MessageWords[columns],
		        rowsInEmail = settings[RowsInEmail],
		        all = List.Buffer(drafts),
		        ref = "%%REF%%",
		        plural = (count as number, word as text) as text => Text.From(count) & " " & word & (if count = 1 then "" else "s"),
		        // A draft joins the email of the draft before it when both are parts of one message.
		        joins = (at as number) as logical =>
		            at > 0 and
		                (let draft = all{at}, before = all{at - 1} in
		                draft[PartCount] > 1 and before[PartCount] = draft[PartCount] and draft[PartIndex] = before[PartIndex] + 1
		                    and before[Kind] = draft[Kind] and Text.Lower(before[To], "en-US") = Text.Lower(draft[To], "en-US")),
		        starts = List.Buffer(List.Select(List.Positions(all), (at) => not joins(at))),
		        groups = List.Buffer(List.Transform(List.Positions(starts), (n) =>
		            let from = starts{n}, until = if n + 1 < List.Count(starts) then starts{n + 1} else List.Count(all) in List.Numbers(from, until - from))),

		        /* ---------------------------------------------------------- the parts of one email */
		        // Two parts with the same half of a reminder and the same key are one, their lines joined.
		        joinedSections = (members as list) as list =>
		            let
		                flat = List.Buffer(List.Combine(List.Transform(members, (draft) => draft[Layout][Sections]))),
		                idOf = (piece as record) as text => piece[Group] & "|" & piece[Key],
		                ids = List.Distinct(List.Transform(flat, idOf))
		            in
		                List.Buffer(List.Transform(ids, (id) =>
		                    let same = List.Buffer(List.Select(flat, (piece) => idOf(piece) = id)) in
		                    same{0} & [Rows = List.Combine(List.Transform(same, (piece) => piece[Rows])), Found = List.AnyTrue(List.Transform(same, (piece) => piece[Found]))])),
		        cisOf = (members as list) as number => List.Count(List.Distinct(List.Combine(List.Transform(members, (draft) => draft[Layout][Cis])))),
		        // The subject of an email of several parts, as fnDrafts writes a subject, for all its CIs.
		        joinedSubject = (members as list, sections as list) as text =>
		            let
		                first = members{0},
		                layout = first[Layout],
		                ciCount = cisOf(members),
		                kinds = List.Count(List.Distinct(List.Transform(sections, (piece) => piece[Key]))),
		                onWhat = if ciCount = 1 then layout[FirstName] else plural(ciCount, layout[Noun]),
		                topic = if kinds = 1 then sections{0}[Title] & " on " & onWhat
		                    else if layout[Noun] = "contract" then plural(ciCount, "contract") & (if ciCount = 1 then " needs" else " need") & " a correction in Solusi"
		                    else plural(ciCount, "CI") & (if ciCount = 1 then " needs" else " need") & " your attention in the CMDB",
		                full = if first[Kind] = "reminder" then "Reminder: " & topic
		                    else if first[Kind] = "escalation" then "No answer on " & plural(ciCount, layout[Noun]) & " of " & first[About]
		                    else topic
		            in
		                full & " [" & ref & "]",

		        /* ---------------------------------------------------------- the attached file */
		        csvCell = (value as text) as text =>
		            let
		                safe = if List.Contains({"=", "+", "-", "@", "#(tab)", "#(cr)"}, Text.Start(value, 1)) then "'" & value else value
		            in
		                if Text.Contains(safe, ",") or Text.Contains(safe, """") or Text.Contains(safe, "#(cr)") or Text.Contains(safe, "#(lf)")
		                    or Text.StartsWith(safe, " ") or Text.EndsWith(safe, " ")
		                then """" & Text.Replace(safe, """", """""") & """" else safe,
		        csvOf = (sections as list) as text =>
		            let
		                contracts = List.AllTrue(List.Transform(sections, (piece) => piece[Contract])),
		                head = if contracts then {"Part", "Contract number", "Name", "Vendor", "What we found"} else {"Part"} & columnWords & {"What we found"},
		                lines = List.Combine(List.Transform(sections, (piece) => List.Transform(piece[Rows], (cells) =>
		                    if contracts or not piece[Contract] then {piece[Title]} & cells
		                    // A contract in an email about CIs too: its number and name as the name, "Contract" as the class.
		                    else {piece[Title], Text.Combine(List.Select({cells{0}, cells{1}}, (value) => value <> ""), " · "), "", "Contract", "", "", "", "", cells{3}})))
		            in
		                "#(feff)" & Text.Combine(List.Transform({head} & lines, (line) => Text.Combine(List.Transform(line, csvCell), ",")), "#(cr,lf)") & "#(cr,lf)",

		        /* ---------------------------------------------------------- the HTML */
		        row = (rowStyle as text, content as text, fill as text) as text =>
		            "<tr><td" & (if fill <> "" then " bgcolor=""" & fill & """" else "") & " style=""" & rowStyle & """>" & content & "</td></tr>",
		        text14 = F & ";font-size:14px;line-height:21px;color:" & C[ink],
		        cellStyle = "padding:7px 10px;border-bottom:1px solid " & C[line] & ";color:" & C[ink],
		        dash = "<span style=""color:" & C[muted] & """>–</span>",
		        // The columns with one value on every line, above the table.
		        commonLine = (pairs as list) as text =>
		            if List.IsEmpty(pairs) then ""
		            else "<p style=""margin:0 0 6px;" & F & ";font-size:13px;color:" & C[muted] & """>"
		                & Text.Combine(List.Transform(pairs, (pair) => pair{0} & ": <b style=""color:" & C[ink] & ";font-weight:600"">" & fnHtml(pair{1}) & "</b>"), " &nbsp;·&nbsp; ") & "</p>",
		        // The table of a part: the first rowsInEmail lines, then how many more are in the file.
		        tableOf = (piece as record) as text =>
		            let
		                rows = List.Buffer(piece[Rows]),
		                column = (at as number) as list => List.Transform(rows, (cells) => cells{at}),
		                same = (at as number) as logical => List.Count(List.Distinct(column(at))) = 1,
		                empty = (at as number) as logical => List.AllTrue(List.Transform(column(at), (value) => value = "")),
		                // The role of the person asked is always them; an empty column says nothing; one value on every line goes above the table.
		                roles = List.Buffer(List.Transform({3, 4, 5, 6}, (at) =>
		                    let label = columnWords{at} in
		                    if (label = piece[Role] and same(at)) or empty(at) then null
		                    else if same(at) then [Common = {label, rows{0}{at}}]
		                    else [Column = [At = at, Label = label, Wide = false, Name = false]])),
		                columns = List.Buffer(
		                    if piece[Contract] then
		                        List.Transform({0, 1, 2}, (at) => [At = at, Label = {"Contract number", "Name", "Vendor"}{at}, Wide = false, Name = false])
		                        & {[At = 3, Label = "What we found", Wide = true, Name = false]}
		                    else
		                        {[At = 0, Label = columnWords{0}, Wide = false, Name = true]}
		                        & (if empty(1) then {} else {[At = 1, Label = columnWords{1}, Wide = false, Name = false]})
		                        & List.Transform(List.Select(roles, (entry) => entry <> null and Record.HasFields(entry, "Column")), (entry) => entry[Column])
		                        & (if piece[Found] then {[At = 7, Label = "What we found", Wide = true, Name = false]} else {})),
		                common = if piece[Contract] then {} else List.Transform(List.Select(roles, (entry) => entry <> null and Record.HasFields(entry, "Common")), (entry) => entry[Common]),
		                shown = List.Buffer(List.FirstN(rows, rowsInEmail)),
		                more = List.Count(rows) - List.Count(shown),
		                th = (label as text) as text =>
		                    "<th align=""left"" bgcolor=""" & C[head] & """ style=""padding:7px 10px;color:" & C[navy] & ";font-weight:600;border-bottom:1px solid " & C[line] & """>" & label & "</th>",
		                td = (cells as list, col as record, first as logical) as text =>
		                    let
		                        value = cells{col[At]},
		                        content =
		                            if col[Name] then
		                                "<span style=""font-weight:600;color:" & C[ink] & """>" & (if value = "" then "–" else fnHtml(value)) & "</span>"
		                                    & (if cells{2} <> "" then "<br><span style=""color:" & C[muted] & ";font-size:12px"">" & fnHtml(cells{2}) & "</span>" else "")
		                            else if value = "" then dash
		                            else fnHtml(value)
		                    in
		                        "<td valign=""top""" & (if col[Wide] then " width=""45%""" else "") & " style=""" & cellStyle & """"
		                            & (if first then "" else " data-l=""" & col[Label] & """") & ">" & content & "</td>",
		                body = Text.Combine(List.Transform(List.Positions(shown), (at) =>
		                    "<tr bgcolor=""" & (if Number.Mod(at, 2) = 0 then C[surface] else C[zebra]) & """>"
		                        & Text.Combine(List.Transform(List.Positions(columns), (n) => td(shown{at}, columns{n}, n = 0))) & "</tr>")),
		                rest = if more > 0 then "<tr><td colspan=""" & Text.From(List.Count(columns)) & """ style=""padding:8px 10px;color:" & C[muted]
		                    & ";font-style:italic;font-size:13px"">and " & Text.From(more) & " more in the attached file</td></tr>" else ""
		            in
		                commonLine(common) & "<table width=""100%"" cellpadding=""0"" cellspacing=""0"" border=""0"" class=""t"" style=""border-collapse:collapse;" & F
		                    & ";font-size:13px;border:1px solid " & C[line] & """><tr class=""h"">" & Text.Combine(List.Transform(columns, (col) => th(col[Label]))) & "</tr>" & body & rest & "</table>",
		        // One part: its number and heading, the text, the table, what we ask and why it matters.
		        sectionHtml = (piece as record, index as number, numbered as logical) as text =>
		            let
		                heading =
		                    if numbered then
		                        "<table cellpadding=""0"" cellspacing=""0"" border=""0""><tr><td valign=""top"" width=""26""><table cellpadding=""0"" cellspacing=""0"" border=""0""><tr>"
		                            & "<td bgcolor=""" & C[navy] & """ width=""26"" height=""26"" align=""center"" style=""" & F & ";color:" & C[onNavy]
		                            & ";font-size:13px;font-weight:600;border-radius:13px"">" & Text.From(index) & "</td></tr></table></td>"
		                            & "<td style=""padding:2px 0 0 10px;" & F & ";font-size:16px;line-height:22px;font-weight:600;color:" & C[ink] & """>" & piece[Heading] & "</td></tr></table>"
		                    else "<div style=""" & F & ";font-size:16px;font-weight:600;color:" & C[ink] & """>" & piece[Heading] & "</div>"
		            in
		                row("padding:22px 28px 4px", heading, "")
		                    & (if piece[Lead] <> "" then row("padding:4px 28px;" & text14, piece[Lead], "") else "")
		                    & row("padding:6px 28px", tableOf(piece), "")
		                    & (if piece[Ask] <> "" then row("padding:10px 28px 2px", "<table width=""100%"" cellpadding=""0"" cellspacing=""0"" border=""0""><tr><td width=""4"" bgcolor=""" & C[navy] & """></td>"
		                        & "<td bgcolor=""" & C[ask] & """ style=""padding:10px 14px;" & text14 & """><b style=""color:" & C[navy] & """>What we ask</b><br>" & piece[Ask] & "</td></tr></table>", "") else "")
		                    & (if piece[Why] <> "" then row("padding:6px 28px 0;" & F & ";font-size:13px;line-height:19px;color:" & C[muted], "<b>Why it matters:</b> " & piece[Why], "") else ""),
		        // "In this email": the numbered parts and their lines, under the half of a reminder they are in.
		        contents = (sections as list) as text =>
		            let
		                cell = "padding:3px 0;" & F & ";font-size:13px",
		                lines = Text.Combine(List.Transform(List.Positions(sections), (at) =>
		                    let
		                        piece = sections{at},
		                        before = if at = 0 then "" else sections{at - 1}[Group],
		                        head = if piece[Group] <> before then "<tr><td colspan=""2"" style=""padding:" & (if at = 0 then "4" else "8") & "px 0 2px;" & F
		                            & ";font-size:12px;font-weight:600;color:" & C[navy] & """>" & fnHtml(piece[Group]) & "</td></tr>" else ""
		                    in
		                        head & "<tr><td style=""" & cell & ";color:" & C[ink] & """>" & Text.From(at + 1) & ".&nbsp; " & piece[Heading] & "</td><td align=""right"" style="""
		                            & cell & ";color:" & C[muted] & ";white-space:nowrap"">" & plural(List.Count(piece[Rows]), "line") & "</td></tr>"))
		            in
		                row("padding:14px 28px 4px", "<table width=""100%"" cellpadding=""0"" cellspacing=""0"" border=""0"" bgcolor=""" & C[box] & """ style=""border:1px solid " & C[line]
		                    & """><tr><td style=""padding:12px 16px""><div style=""" & F & ";font-size:12px;color:" & C[muted] & ";font-weight:600"">In this email</div>"
		                    & "<table width=""100%"" cellpadding=""0"" cellspacing=""0"" border=""0"">" & lines & "</table></td></tr></table>", ""),
		        // The line at the foot of the email: why they get it.
		        footerOf = (draft as record) as text =>
		            if draft[Kind] = "escalation" then "You get this email because the person ServiceNow names for these records did not answer us. SACM changes ServiceNow only with an answer."
		            else if draft[Mailbox] then "You get this email because Procurement owns the contract data in Solusi. ServiceNow receives your corrections with the next upload."
		            else if draft[Team] then "You get this email because your team is responsible for the record of these CIs. SACM changes ServiceNow only with your answer."
		            else "You get this email because ServiceNow names you for these records. SACM changes ServiceNow only with your answer.",

		        /* ---------------------------------------------------------- one email */
		        emailOf = (members as list) as record =>
		            let
		                first = members{0},
		                layout = first[Layout],
		                sections = joinedSections(members),
		                kinds = List.Count(List.Distinct(List.Transform(sections, (piece) => piece[Key]))),
		                numbered = List.Count(sections) > 1,
		                opening = List.Buffer(layout[Opening] & (if layout[Why] <> "" then {if kinds > 1 then layout[Why] & " We found " & plural(kinds, "kind") & " of problem." else layout[Why]} else {})),
		                long = List.AnyTrue(List.Transform(sections, (piece) => List.Count(piece[Rows]) > rowsInEmail)),
		                csv = if long then csvOf(sections) else "",
		                subject = if List.Count(members) = 1 and first[PartCount] = 1 then first[Subject] else joinedSubject(members, sections),
		                summary = Text.Combine(List.Transform(List.Positions(sections), (at) =>
		                    (if numbered then Text.From(at + 1) & ". " else "") & sections{at}[Title] & " · " & plural(List.Count(sections{at}[Rows]), "line")), "#(lf)"),
		                parts = Text.Combine(List.Transform(List.Positions(sections), (at) =>
		                    let
		                        piece = sections{at},
		                        before = if at = 0 then "" else sections{at - 1}[Group],
		                        head = if piece[Group] <> before then row("padding:26px 28px 0", "<div style=""" & F & ";font-size:13px;font-weight:600;color:" & C[navy]
		                            & ";padding-bottom:6px;border-bottom:1px solid " & C[line] & """>" & fnHtml(piece[Group]) & "</div>", "") else ""
		                    in
		                        head & sectionHtml(piece, at + 1, numbered))),
		                sender = Text.Trim(layout[Sender]),
		                preview = if List.Count(opening) > 1 then opening{1} else "",
		                html = "<!DOCTYPE html><html lang=""en""><head><meta charset=""utf-8""><meta name=""viewport"" content=""width=device-width, initial-scale=1"">"
		                    & "<style>" & style[phone] & "</style></head><body style=""margin:0;padding:0;background:" & C[page] & """>"
		                    & (if preview <> "" then "<div style=""display:none;max-height:0;overflow:hidden;mso-hide:all"">" & preview & "</div>" else "")
		                    & "<table width=""100%"" cellpadding=""0"" cellspacing=""0"" border=""0"" bgcolor=""" & C[page] & """><tr><td align=""center"" style=""padding:16px 8px"">"
		                    & "<table width=""720"" cellpadding=""0"" cellspacing=""0"" border=""0"" bgcolor=""" & C[surface] & """ style=""max-width:720px;width:100%;border:1px solid " & C[line] & """>"
		                    & row("padding:14px 28px", "<table width=""100%"" cellpadding=""0"" cellspacing=""0"" border=""0""><tr><td style=""" & F & ";font-size:15px;font-weight:600;color:" & C[onNavy]
		                        & """>SACM · CMDB data quality</td><td align=""right"" style=""" & F & ";font-size:12px;color:" & C[navyMuted] & """>Ref. " & ref & "</td></tr></table>", C[navy])
		                    & "<tr><td height=""3"" bgcolor=""" & C[deco] & """ style=""font-size:0;line-height:0"">&nbsp;</td></tr>"
		                    & row("padding:22px 28px 0;" & text14, Text.Combine(List.Transform(List.Positions(opening), (at) =>
		                        "<p style=""margin:" & (if at = List.Count(opening) - 1 then "0" else "0 0 10px") & """>" & opening{at} & "</p>")), "")
		                    & (if numbered then contents(sections) else "")
		                    & parts
		                    & row("padding:22px 28px 6px;" & text14, (if csv <> "" then "<b>Attached:</b> " & ref & ".csv, all " & plural(cisOf(members), layout[Noun]) & " and what we found, to open in Excel.<br><br>" else "")
		                        & "When you reply, please keep the reference <b>[" & ref & "]</b> in the subject.", "")
		                    & row("padding:10px 28px 24px;" & text14, "Thank you,<br>" & (if sender <> "" then "<b>" & fnHtml(sender) & "</b><br>" else "") & fnHtml(layout[Signature]), "")
		                    & row("padding:12px 28px;" & F & ";font-size:12px;line-height:17px;color:" & C[muted] & ";border-top:1px solid " & C[line], footerOf(first), C[box])
		                    & "</table></td></tr></table></body></html>"
		            in
		                [Html = html, Csv = csv, Summary = summary, Subject = subject],
		        emails = List.Buffer(List.Transform(groups, (positions) => emailOf(List.Buffer(List.Transform(positions, (at) => all{at}))))),
		        // For each draft: its email (the first part) or nothing (the other parts), and where its email is.
		        groupOf = List.Buffer(List.Combine(List.Transform(List.Positions(groups), (n) => List.Repeat({n}, List.Count(groups{n})))))
		    in
		        List.Transform(List.Positions(all), (at) =>
		            let n = groupOf{at}, start = starts{n} in
		            if at = start then emails{n} & [First = start] else [Html = "", Csv = "", Summary = "", Subject = "", First = start])
	queryGroup: Reading

/// The environment of a Service Instance (src/core/checks/detectors/relationship-detectors.ts, environmentOf): its Environment field, else a trailing word of its name ("Index - TEST"), else production; synonyms count as one (reference/relationship-model, environments). The suffix pattern is "\b(<words>)\)?\s*$": the word is the rest of the trimmed name from where the pattern matches, without the ")" (the generator refuses another form of pattern).
expression fnEnvironment =
		(name as text, field as text, model as record) as text =>
		    let
		        rules = Record.FieldOrDefault(model, "environments", null),
		        trimmed = Text.Trim(name),
		        found = if rules = null then [Index = -1] else fnSearch(rules[suffix], "i", trimmed),
		        rest = if found[Index] < 0 then "" else Text.Middle(trimmed, found[Index]),
		        word = if Text.EndsWith(rest, ")") then Text.Start(rest, Text.Length(rest) - 1) else rest,
		        raw = if Text.Trim(field) <> "" then Text.Trim(field) else if word <> "" then word else "PROD",
		        alias = if rules = null then null else List.First(List.Select(Record.FieldOrDefault(rules, "aliases", {}), (entry) => fnMatches(entry[pattern], "i", raw)), null)
		    in
		        if alias <> null then alias[name] else Text.Upper(raw, "en-US")
	queryGroup: Reading

/// The part Exceptions of the table Run (D292), which the DAX table Exceptions shows (the tab Not followed of the Audit page): every decision to stop following a finding, newest first (src/core/audit/audit.ts, exceptionLines). One line per case (an exception on several cases is listed once per case, because each can end on its own), and one per standing exception (for a check and a CI by name, entered before any finding). State: running (still in force), ended (the review date has passed) or closed (a manager set another status after it). CiName: the CI of the finding in the newest report, else the CI key of the finding. `run` is CheckRun (null when no CI report is loaded).
expression fnExceptionsPart =
		(run as nullable record) as table =>
		    let
		        facts = if run = null then {} else run[Facts],
		        byKey = Record.FromList(facts, List.Transform(facts, (fact) => fact[Key])),
		        today = Date.ToText(CaseToday, [Format = "yyyy-MM-dd", Culture = "en-US"]),
		        isException = (event as record) as logical => event[Type] = "exception"
		            or (event[Type] = "status" and List.Contains({"Waived", "Exception accepted", "Not followed up"}, event[Text])),
		        // The last exception of each target, and whether a status came after it.
		        steps = List.Combine(List.Transform(JournalEvents, (event) =>
		            if event[Type] = "exception" and List.IsEmpty(event[Keys]) and event[CiKey] <> "" then {[Target = (if event[CheckId] = "" then "*" else event[CheckId]) & "|" & event[CiKey], Event = event, Exception = true]}
		            else List.Transform(List.Select(event[Keys], (key) => isException(event) or event[Type] = "status"), (key) => [Target = key, Event = event, Exception = isException(event)]))),
		        // Per target, in the order of the journal: its last exception, and whether a status came after it (speed rule 6:
		        // grouped once, no growing record).
		        byTarget = fnGroupBy(steps, (step) => step[Target]),
		        summaries = List.Buffer(List.RemoveNulls(List.Transform(Record.FieldNames(byTarget), (target) =>
		            let
		                group = List.Buffer(Record.Field(byTarget, target)),
		                lastAt = List.Last(List.Select(List.Positions(group), (at) => group{at}[Exception]), null)
		            in
		                if lastAt = null then null else [Target = target, Event = group{lastAt}[Event], After = lastAt < List.Count(group) - 1]))),
		        state = [
		            Last = Record.FromList(List.Transform(summaries, (item) => item[Event]), List.Transform(summaries, (item) => item[Target])),
		            After = fnKeySet(List.Transform(List.Select(summaries, (item) => item[After]), (item) => item[Target]))
		        ],
		        targets = Record.FieldNames(state[Last]),
		        line = (target as text) as list =>
		            let
		                event = Record.Field(state[Last], target),
		                standing = event[Type] = "exception" and List.IsEmpty(event[Keys]),
		                legacy = event[Type] = "status",
		                fact = if standing then null else Record.FieldOrDefault(byKey, target, null),
		                first = Text.PositionOf(target, ":"),
		                last = Text.PositionOf(target, ":", Occurrence.Last),
		                keyCi = if first < 0 then target else if last > first then Text.Middle(target, first + 1, last - first - 1) else Text.Middle(target, first + 1),
		                checkId = if standing then (if event[CheckId] = "" then "*" else event[CheckId]) else if fact <> null then fact[CheckId] else if first < 0 then target else Text.Start(target, first),
		                ciKey = if standing then event[CiKey] else if fact <> null then fact[CiKey] else keyCi,
		                ciName = if standing then (if event[CiName] <> "" then event[CiName] else event[CiKey]) else if fact <> null then fact[CiName] else keyCi,
		                running = event[ReviewOn] = "" or event[ReviewOn] > today,
		                words = if Record.HasFields(state[After], target) then "closed" else if running then "running" else "ended"
		            in
		                {
		                    target, checkId, ciKey, ciName,
		                    if legacy then "Set before version 0.12 (no reason)" else event[Reason], if legacy then "" else event[Text],
		                    if event[ReviewOn] = "" then null else Date.FromText(event[ReviewOn], [Format = "yyyy-MM-dd", Culture = "en-US"]),
		                    if event[ByName] <> "" then event[ByName] else event[By],
		                    DateTime.FromText(event[At], [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"]), words,
		                    Record.Field([running = "Not followed up", ended = "Followed up again (review date passed)", closed = "Followed up again (a later status)"], words),
		                    standing, legacy
		                },
		        lines = List.Transform(targets, line),
		        sorted = List.Sort(lines, (a, b) =>
		            let byAt = Value.Compare(b{8}, a{8}), byName = Value.Compare(a{3}, b{3}) in
		            if byAt <> 0 then byAt else if byName <> 0 then byName else Value.Compare(a{0}, b{0})),
		        numbered = List.Transform(List.Positions(sorted), (at) => sorted{at} & {at + 1})
		    in
		        #table(
		            type table [Target = text, CheckId = text, CiKey = text, CiName = text, Reason = text, Note = text, ReviewOn = date, ByName = text,
		                At = datetime, State = text, StateLabel = text, Standing = logical, Legacy = logical, Order = Int64.Type],
		            numbered)
	queryGroup: Reading

/// Does the text match the pattern, decided by its fast form (the query PatternForms, D285) when it can, else by the walk (fnRegexTest)? exact, prefix, suffix, contains: the text is one of the words, starts, ends with or holds one of them. only: the length is in range and every character is one of Chars. walk: a quick "no" when the text holds a character a match cannot (Allowed), or does not start or end with a word a match needs (Starts, Ends); then the walk. Lower: the words are lower case, so the text is compared in lower case, and only an ASCII text is decided so (JavaScript's "i" never matches a non-ASCII character to an ASCII one); any other text goes to the walk.
expression fnFastMatch =
		(form as record, tree as list, value as text) as logical =>
		    let
		        kind = form[Kind],
		        lower = form[Lower],
		        usable = not lower or Text.Remove(value, AsciiCharacters) = "",
		        text = if lower then Text.Lower(value, "en-US") else value,
		        oneOf = (words as nullable list, test as function) as logical => words = null or List.AnyTrue(List.Transform(words, test)),
		        words = Record.FieldOrDefault(form, "Words", null),
		        allowed = Record.FieldOrDefault(form, "Allowed", null)
		    in
		        if kind = "only" then
		            Text.Length(value) >= form[Min] and (form[Max] < 0 or Text.Length(value) <= form[Max]) and Text.Remove(value, form[Chars]) = ""
		        else if kind = "walk" then
		            if allowed <> null and Text.Remove(value, allowed) <> "" then false
		            else if usable and not oneOf(Record.FieldOrDefault(form, "Starts", null), (word) => Text.StartsWith(text, word)) then false
		            else if usable and not oneOf(Record.FieldOrDefault(form, "Ends", null), (word) => Text.EndsWith(text, word)) then false
		            else fnRegexTest(tree, value)
		        else if not usable then fnRegexTest(tree, value)
		        else if kind = "exact" then List.Contains(words, text)
		        else if kind = "prefix" then oneOf(words, (word) => Text.StartsWith(text, word))
		        else if kind = "suffix" then oneOf(words, (word) => Text.EndsWith(text, word))
		        else oneOf(words, (word) => Text.Contains(text, word))
	queryGroup: Reading

/// The part Findings of the table Run (D284), which the DAX table Findings shows: one row per finding of the newest CI report (fnCheckRun), with who is asked, how it is listed, where it is fixed and the CI as the message table shows it (DATA-MODEL §3, a fact). Key never changes: <check>:<CI key>:<field>. Group: the findings of one check that go to the same person by the same route, in the same state (one piece of work). Mapping: the reasons of a case of the mapping backlog, by id. EpoCorrection: what EPO already says (fnEpoCorrections). Problem: the kind of problem a line is listed under (a problem of the contract data, a field of the upload check; D146), "" for most checks. `run` is CheckRun (null when no CI report is loaded).
expression fnFindingsPart =
		(run as nullable record) as table =>
		    let
		        facts = if run = null then {} else run[Facts],
		        words = [open = "To solve", review = "To check", waiting = "Waiting", known = "Known"],
		        address = fnServiceNowAddress(ServiceNowAddress),
		        corrections = List.Buffer(if run = null then {} else fnEpoCorrections(facts, run)),
		        fix = (fact as record, part as text) as text => if fact[Fix] = null then "" else Record.FieldOrDefault(fact[Fix], part, ""),
		        row = (fact as record, correction as text) as list =>
		            let
		                person = if fact[ContactId] <> "" then fact[ContactId] else if fact[ContactEmail] <> "" then Text.Lower(fact[ContactEmail], "en-US") else "nobody"
		            in
		                {
		                    run[Date], fact[Key], fact[CheckId], fact[CiKey], fact[CiName], fact[Class], fact[ClassLabel], fact[Field], fact[Severity], fact[Detail],
		                    fact[Module], fact[Route], fact[State], Record.Field(words, fact[State]), fact[StateWhy], fact[Source], fact[Wait], fact[Review],
		                    fact[ContactId], fact[ContactName], fact[ContactEmail], fact[ContactVia],
		                    if fact[ContactName] <> "" then fact[ContactName] & " (" & fact[ContactVia] & ")" else "Nobody to ask",
		                    Text.Combine(fact[Cc], "; "), fact[EscalateName], fact[EscalateEmail], fact[EscalateVia],
		                    fix(fact, "Change"), fix(fact, "Current"), fix(fact, "Set"), fix(fact, "Value"), fix(fact, "RelatedTo"), fix(fact, "Note"),
		                    fact[CheckId] & "|" & fact[Route] & "|" & person & (if fact[State] = "open" then "" else "|" & fact[State]),
		                    fact[EpoId], fact[Status], fact[SupportGroup], fact[OwnedBy], fact[ManagedBy], fact[SupportedBy], Text.Combine(fact[Chips], ", "), Text.Combine(fact[Tags], ", "),
		                    fnServiceNowLink(address, fact[CiName], fact[Class], fix(fact, "RelatedTo")),
		                    Text.Combine(fact[Mapping], ", "), correction, fact[Problem]
		                }
		    in
		        #table(
		            type table [ReportDate = date, Key = text, CheckId = text, CiKey = text, CiName = text, Class = text, ClassLabel = text, Field = text,
		                Severity = text, Detail = text, Module = text, Route = text, State = text, StateLabel = text, StateWhy = text, Source = text, Wait = text,
		                Review = text, ContactId = text, ContactName = text, ContactEmail = text, ContactVia = text, AskWho = text, Cc = text, EscalateName = text,
		                EscalateEmail = text, EscalateVia = text, FixChange = text, FixCurrent = text, FixSet = text, FixValue = text, FixRelatedTo = text, FixNote = text,
		                Group = text, EpoId = text, Status = text, SupportGroup = text, OwnedBy = text, ManagedBy = text, SupportedBy = text, Chips = text, Tags = text,
		                ServiceNowLink = text, Mapping = text, EpoCorrection = text, Problem = text],
		            List.Transform(List.Positions(facts), (at) => row(facts{at}, corrections{at})))
	queryGroup: Reading

/// Is the fix of a finding on this CI made in EPO (src/core/cases/fix-place.ts, fixedInEpo, D122, D123, D187)? A class EPO feeds, or a Service Offering the EPO integration created (fnOfferingOrigin), except the fields and checks that are changed in ServiceNow on such an offering.
expression fnFixedInEpo =
		(ci as record, checkId as text, field as text) as logical =>
		    let
		        synced = Record.FieldOrDefault(ReferenceFiles, "epo-synced-classes", null),
		        offerings = if synced = null then null else Record.FieldOrDefault(synced, "offerings", null),
		        here = Record.FieldOrDefault(offerings, "inServiceNow", [])
		    in
		        if synced = null then false
		        else if List.Contains(Record.FieldOrDefault(synced, "classes", {}), ci[Class]) then true
		        else if fnOfferingOrigin(ci) <> "epo" then false
		        else not List.Contains(Record.FieldOrDefault(here, "fields", {}), field) and not List.Contains(Record.FieldOrDefault(here, "checks", {}), checkId)
	queryGroup: Reading

/// true / false from "true", "yes", "y", "1" / "false", "no", "n", "0" (any case); null for anything else. With strict, "y" and "n" do not count (the contract reports, src/core/sources/contracts/contract-reports.ts).
expression fnFlag =
		(value as text, optional strict as nullable logical) as nullable logical =>
		    let
		        text = Text.Lower(Text.Trim(value), "en-US"),
		        yes = if strict = true then {"true", "yes", "1"} else {"true", "yes", "y", "1"},
		        no = if strict = true then {"false", "no", "0"} else {"false", "no", "n", "0"}
		    in
		        if List.Contains(yes, text) then true else if List.Contains(no, text) then false else null
	queryGroup: Reading

/// The items of a list grouped by a key: a record key -> the items with that key, in the order of the list. The groups are in the order their first item comes. An empty list gives an empty record.
expression fnGroupBy =
		(items as list, keyOf as function) as record =>
		    if List.IsEmpty(items) then []
		    else
		        let
		            // Both columns buffered: a table made of lazy lists is computed again each time it is read (the speed build).
		            buffered = List.Buffer(items),
		            table = Table.FromColumns({List.Buffer(List.Transform(buffered, keyOf)), buffered}, {"Key", "Item"}),
		            grouped = Table.Group(table, {"Key"}, {{"Items", (rows) => rows[Item], type list}})
		        in
		            Record.FromList(grouped[Items], grouped[Key])
	queryGroup: Reading

/// The hidden characters in a name, as readable labels ("zero-width space (U+200B)"), each once, in the order they come (src/core/shared/names.ts, hiddenCharacters). Most names hold none: one native test says so, without a loop.
expression fnHiddenCharacters =
		(name as text) as list =>
		    let
		        entries = ReadingRules[hiddenCharacters],
		        codes = List.Buffer(List.Transform(entries, (entry) => entry[code])),
		        chars = List.Transform(codes, Character.FromNumber),
		        found = List.Select(Text.ToList(name), (char) => List.Contains(codes, Character.ToNumber(char))),
		        labelOf = (char as text) as text =>
		            let entry = List.First(List.Select(entries, (item) => item[code] = Character.ToNumber(char))) in
		            entry[label] & " (U+" & Text.PadStart(Number.ToText(entry[code], "X"), 4, "0") & ")"
		    in
		        if Text.Remove(name, chars) = name then {} else List.Distinct(List.Transform(found, labelOf))
	queryGroup: Reading

/// The part HistoryChecked of the table HistoryRun (D290): what one CI report could verify (checkedIn of src/core/cases/cases.ts). Kind "ci": the key of each CI of the report that is not parked (D179). Kind "part": <check>:<field> of each part of a check the report tested, without the parked fields. A finding of the report before is solved only when the CI is here, its part is here, and the finding is gone (D59, D292). `run` is a run of fnCheckRun.
expression fnHistoryCheckedPart =
		(run as record) as table =>
		    let
		        parkedFields = if run[Parked] = null then [] else run[Parked][FieldSet],
		        cis = List.Transform(Record.FieldNames(run[CheckableKeys]), (key) => {run[Date], "ci", key}),
		        parts = List.Transform(List.Select(run[Tested], (part) => not Record.HasFields(parkedFields, part)), (part) => {run[Date], "part", part})
		    in
		        #table(type table [ReportDate = date, Kind = text, Id = text], cis & parts)
	queryGroup: Reading

/// The part History of the table HistoryRun (D290), which the DAX table History shows: one row per finding of one CI report date, with only what the history pages count (the check, the CI, its class and support group, how it is listed). The trends per card, class and team, new and solved between two reports and the days to fix are counted from it. `run` is a run of fnCheckRun.
expression fnHistoryPart =
		(run as record) as table =>
		    let
		        facts = run[Facts]
		    in
		        #table(
		            type table [ReportDate = date, Key = text, CheckId = text, CiKey = text, CiName = text, Class = text, ClassLabel = text, Field = text,
		                State = text, SupportGroup = text, ContactName = text],
		            List.Transform(facts, (fact) => {
		                run[Date], fact[Key], fact[CheckId], fact[CiKey], fact[CiName], fact[Class], fact[ClassLabel], fact[Field], fact[State],
		                fact[SupportGroup], fact[ContactName]}))
	queryGroup: Reading

/// The "detect data changes" of the incremental refresh of HistoryRun (D290): for one part of the history (the CI reports dated from `start` to `end`), the newest change of a file that its runs read (the files dated from ReadDays days before `start` up to `end`). The service computes a part of the last 7 days again only when this value changed, so a refresh after an action of the team (the journal) or after a new report recomputes no old day, or only the new one. The folder is listed, no file is opened. A file moved out of the folder does not change it: put the right file in.
expression fnHistoryPolling =
		(start as datetime, end as datetime) as datetime =>
		    let
		        from = Date.AddDays(DateTime.Date(start), -ReadDays),
		        to = DateTime.Date(end),
		        files = Table.SelectRows(ReportSourceFiles, each [ReportDate] <> null and [ReportDate] >= from and [ReportDate] < to),
		        changed = List.Max(List.RemoveNulls(files[Modified]), null),
		        // The samples have no time of change: the day they were recorded.
		        newest = List.Max(files[ReportDate], null)
		    in
		        if changed <> null then changed else if newest <> null then DateTime.From(newest) else #datetime(1900, 1, 1, 0, 0, 0)
	queryGroup: Reading

/// Table HistoryRun (hidden, D290): the checks on every CI report dated from `start` (that day or later) to `end` (before that day), each with the other reports dated on or before it, as the rows of five parts: History (the findings), HistoryTested, HistoryNotes, HistoryChecked (what the report could verify) and Runs. The DAX tables of those names split it, as Run is split (D284). Incremental refresh calls it for each part of the history with RangeStart and RangeEnd: keep 24 months, look at the last 7 days and compute again only the days whose files changed (HistoryPolling), so an old report date is computed once, not at every refresh. The pages of the newest report never read it: they read Run, which is always computed in full. Only the files of the ReadDays days before `start` up to `end` are opened. Two CI reports of one day: the last file name is the run of that day.
expression fnHistoryRun =
		(start as datetime, end as datetime) as table =>
		    let
		        from = DateTime.Date(start),
		        to = DateTime.Date(end),
		        files = fnReadFiles(Date.AddDays(from, -ReadDays), to),
		        cis = Table.Buffer(Table.Sort(Table.SelectRows(files, each [Kind] = "ci" and [ReportDate] <> null and [ReportDate] >= from and [ReportDate] < to),
		            {{"ReportDate", Order.Ascending}, {"FileName", Order.Ascending}})),
		        days = List.Buffer(List.Distinct(cis[ReportDate])),
		        runOf = (day as date) as record => fnCheckRun(Table.Last(Table.SelectRows(cis, each [ReportDate] = day)), files),
		        partsOf = (run as record) as list => {
		            {"History", fnHistoryPart(run)}, {"HistoryTested", fnTestedPart(run)}, {"HistoryNotes", fnNotesPart(run)},
		            {"HistoryChecked", fnHistoryCheckedPart(run)}, {"Runs", fnRunsPart(run)}
		        },
		        // Each part with its columns named <Part>.<Column> and a column Part, typed as the calculated table that shows it
		        // (HistoryRunColumnTypes, generated), as in RunRows.
		        prefixed = (part as list) as table =>
		            let
		                name = part{0},
		                rows = part{1},
		                renamed = Table.RenameColumns(rows, List.Transform(Table.ColumnNames(rows), (column) => {column, name & "." & column})),
		                present = Table.ColumnNames(renamed),
		                own = List.Select(HistoryRunColumnTypes, (pair) => List.Contains(present, pair{0}))
		            in
		                Table.AddColumn(Table.TransformColumnTypes(renamed, own), "Part", each name, type text),
		        perDay = List.Transform(days, (day) =>
		            let
		                run = runOf(day),
		                combined = Table.Combine(List.Transform(partsOf(run), prefixed))
		            in
		                Table.AddColumn(combined, "ReportDate", each day, type date)),
		        // With no CI report in the dates, every column is still there, so a refresh of an empty part of the history works.
		        // Each part is typed alone, before the parts are put together (as in RunRows, D307); the empty frame types every column.
		        types = {{"Part", type text}, {"ReportDate", type date}} & HistoryRunColumnTypes,
		        empty = Table.TransformColumnTypes(#table(List.Transform(types, (pair) => pair{0}), {}), types),
		        typed = Table.Combine({empty} & perDay)
		    in
		        Table.ReorderColumns(typed, {"Part", "ReportDate"} & List.Select(Table.ColumnNames(typed), (column) => column <> "Part" and column <> "ReportDate"))
	queryGroup: Reading

/// A text made safe for the HTML of a message (src/core/shared/text.ts, escapeHtml): & < > and " as their entities. Every value from a report is written this way.
expression fnHtml = (value as text) as text => Text.Replace(Text.Replace(Text.Replace(Text.Replace(value, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), """", "&quot;")
	queryGroup: Reading

/// Is the CI in the scope of a check (src/core/checks/engine.ts, runChecks)? Its class is one of scope.classes ("*": every class), and its status is not one of scope.exclude.operational_status. Parked CIs are left out before (fnCheckRun, which tests the scope of each check itself, with the words in compared form once). `ci` has its StatusKey.
expression fnInScope =
		(pack as record, ci as record) as logical =>
		    let
		        scope = pack[scope],
		        excluded = List.Transform(Record.FieldOrDefault(Record.FieldOrDefault(scope, "exclude", []), "operational_status", {}), (word) => fnNameKey(word, ""))
		    in
		        (List.Contains(scope[classes], "*") or List.Contains(scope[classes], ci[Class])) and not List.Contains(excluded, ci[StatusKey])
	queryGroup: Reading

/// Report files: .csv, .xlsx and .txt (the EPO report can come as text), not the lock files Office leaves next to an open file ("~$name.xlsx").
expression fnIsReportFile =
		(name as text) as logical =>
		    let lower = Text.Lower(name, "en-US") in
		    (Text.EndsWith(lower, ".csv") or Text.EndsWith(lower, ".xlsx") or Text.EndsWith(lower, ".txt")) and not Text.StartsWith(name, "~$")
	queryGroup: Reading

/// A key set: a record with one field per distinct key, to test "is this key in there?" fast with Record.HasFields(set, key), instead of List.Contains against a long list, which reads the whole list for every key (and builds a lazy list again each time). Made once, then tested many times (ARCHITECTURE §12, the speed rules).
expression fnKeySet =
		(keys as list) as record =>
		    let distinct = List.Buffer(List.Distinct(keys)) in
		    Record.FromList(List.Repeat({true}, List.Count(distinct)), distinct)
	queryGroup: Reading

/// A text as its letters and digits only, lower case (src/core/sources/epo/epo-report.ts, lettersOf): EPO keeps formatting, ServiceNow plain text, so only the words are compared. M knows no Unicode classes: a letter is a character with an upper and a lower case, a digit is 0 to 9 (letters without case, such as Chinese, are left out).
expression fnLetters =
		(text as text) as text =>
		    let
		        lower = Text.Lower(text, "en-US")
		    in
		        Text.Combine(List.Select(Text.ToList(lower), (char) =>
		            let code = Character.ToNumber(char) in (code >= 48 and code <= 57) or Text.Upper(char, "en-US") <> char))
	queryGroup: Reading

/// A criticality level 1 to 4 from a number or a label; null when not set or not known (src/core/sources/ci/ci-report.ts, level). "business critical" may have spaces, tabs or dashes between the two words, as /business[\s-]*critical/.
expression fnLevel =
		(value as text) as nullable number =>
		    let
		        text = Text.Lower(Text.Trim(value), "en-US"),
		        isNone = text = "" or List.Contains({"none", "na", "n/a", "unknown"}, text) or Text.StartsWith(text, "not ")
		            or List.AllTrue(List.Transform(Text.ToList(text), (char) => char = "-")),
		        gaps = {" ", "-", "#(tab)", "#(lf)", "#(cr)", "#(00A0)"},
		        businessCritical = List.AnyTrue(List.Transform(Text.PositionOf(text, "business", Occurrence.All),
		            (at) => Text.StartsWith(Text.TrimStart(Text.Middle(text, at + 8), gaps), "critical")))
		    in
		        if List.Contains({"1", "2", "3", "4"}, text) then Number.From(text)
		        else if isNone then null
		        else if Text.Contains(text, "mission") or businessCritical then 4
		        else if Text.StartsWith(text, "less") or Text.StartsWith(text, "low") or Text.StartsWith(text, "minor") then 1
		        else if Text.Contains(text, "critical") or Text.Contains(text, "vital") then 3
		        else if Text.Contains(text, "significant") or Text.Contains(text, "necessary") then 2
		        else null
	queryGroup: Reading

/// A criticality value of a CI by its check-file name ("target.availability"); null when not set or not such a name.
expression fnLevelAt =
		(ci as record, field as text) as nullable number =>
		    let column = Record.FieldOrDefault(LevelColumns, field, null) in
		    if column = null then null else Record.FieldOrDefault(ci, column, null)
	queryGroup: Reading

/// A criticality level in the words of ServiceNow, never as a bare number (src/core/model/model.ts, levelWords).
expression fnLevelWords = (value as number) as text => Record.FieldOrDefault(ReadingRules[levelWords], Text.From(value), Text.From(value))
	queryGroup: Reading

/// A date as the message texts write it: 12 November 2026 (src/core/shared/dates.ts, longDate).
expression fnLongDate = (value as date) as text => Date.ToText(value, [Format = "d MMMM yyyy", Culture = "en-US"])
	queryGroup: Reading

/// The part MappingBacklog of the table Run (D284), which the DAX table MappingBacklog shows (src/app/view/backlog.ts, D200 to D204): one line per CI to map, from the findings of the mapping backlog: its owner (Owned by, else who is asked), why it is on the list, its stage and the steps of its class (reference/mapping-backlog), the criticality lines of the same CI, and whether it can be marked "The process does not exist". The stage is the one a manager set in the journal (from build B6 the Power App sets it; StageId of the cases), else the first stage of the class. Order: to solve first, then by stage, then by name. `run` is CheckRun (null when no CI report is loaded); `cases` is fnCases(run).
expression fnMappingBacklogPart =
		(run as nullable record, cases as list) as table =>
		    let
		        config = fnReference("reference/mapping-backlog"),
		        facts = if run = null or config = null then {} else run[Facts],
		        columns = if run = null then {} else run[Columns],
		        ciByKey = if run = null then [] else Record.FromList(run[Cis], List.Transform(run[Cis], (ci) => ci[Key])),
		        packs = List.Buffer(List.Transform(Json.Document(CheckFiles), (file) => file[pack])),
		        labelOf = (id as text) as text => let pack = List.First(List.Select(packs, (candidate) => candidate[id] = id), null) in
		            if pack = null then id else Record.FieldOrDefault(pack, "cardLabel", id),
		        mappingChecks = List.Buffer(List.Transform(List.Select(packs, (pack) => Record.FieldOrDefault(pack[detector], "module", "") = "mapping/backlog"), (pack) => pack[id])),
		        critical = Record.FieldOrDefault(config, "criticality", {}),
		        // The criticality lines by CI, grouped once (not looked for again for each line).
		        criticalByCi = fnGroupBy(List.Select(facts, (fact) => List.Contains(critical, fact[CheckId])), (fact) => fact[CiKey]),
		        stagesFor = (cls as text) as list => fnStages(config, cls),
		        stageIds = Record.FromList(List.Transform(cases, (item) => item[StageId]), List.Transform(cases, (item) => item[Key])),
		        // The place of the stage of a line in the steps of its class, from 0.
		        stageAt = (fact as record) as number =>
		            let ids = List.Transform(stagesFor(fact[Class]), (stage) => stage[Id]), at = List.PositionOf(ids, Record.FieldOrDefault(stageIds, fact[Key], ""))
		            in if at < 0 then 0 else at,
		        rule = Record.FieldOrDefault(config, "processMissing", null),
		        order = {"open", "review", "waiting", "known"},
		        stateWords = [open = "To solve", review = "To check", waiting = "Waiting", known = "Planned"],
		        lines = List.Select(facts, (fact) => List.Contains(mappingChecks, fact[CheckId])),
		        // Buffered: each row reads it by position, and a lazy sorted list would be sorted again for each row.
		        staged = List.Transform(lines, (fact) => [Fact = fact, At = stageAt(fact)]),
		        sorted = List.Buffer(List.Transform(List.Sort(staged, (a, b) =>
		            let byState = List.PositionOf(order, a[Fact][State]) - List.PositionOf(order, b[Fact][State]), byStage = a[At] - b[At] in
		            if byState <> 0 then byState else if byStage <> 0 then byStage else Comparer.FromCulture("en-US")(a[Fact][CiName], b[Fact][CiName])), (line) => line[Fact] & [StageAt = line[At]])),
		        row = (position as number) as list =>
		            let
		                fact = sorted{position},
		                ci = Record.Field(ciByKey, fact[CiKey]),
		                owner = fnPerson(ci, "owned_by", columns),
		                ownerName = if owner = null then "" else if owner[Name] <> "" then owner[Name] else owner[Email],
		                stages = stagesFor(fact[Class]),
		                sameCi = List.Distinct(List.Transform(Record.FieldOrDefault(criticalByCi, fact[CiKey], {}), (other) => labelOf(other[CheckId]))),
		                canMark = rule <> null and List.Contains(rule[classes], fact[Class]) and List.AnyTrue(List.Transform(fact[Mapping], (reason) => List.Contains(rule[rules], reason)))
		            in
		                {
		                    fact[Key], fact[CiKey], fact[CiName], fact[ClassLabel], if ownerName <> "" then ownerName else fact[ContactName], Text.Replace(fact[Detail], "; ", "#(lf)"),
		                    Text.Combine(fact[Mapping], ", "), if List.IsEmpty(stages) then "" else stages{fact[StageAt]}[Label], fact[StageAt] + 1,
		                    Text.Combine(List.Transform(stages, (stage) => stage[Label]), " → "),
		                    fact[State], Record.Field(stateWords, fact[State]), List.PositionOf(order, fact[State]) + 1, fact[StateWhy], Text.Combine(sameCi, ", "), canMark,
		                    if fact[State] <> "open" then Record.Field(stateWords, fact[State]) & ": " & fact[StateWhy] else "Invite the owner to a mapping session",
		                    position + 1
		                }
		    in
		        #table(
		            type table [Key = text, CiKey = text, CiName = text, ClassLabel = text, Owner = text, Reasons = text, ReasonIds = text, Stage = text, StageNumber = Int64.Type,
		                Steps = text, State = text, StateLabel = text, StateOrder = Int64.Type, StateWhy = text, Criticality = text, CanMarkProcessMissing = logical, NextStep = text, Order = Int64.Type],
		            List.Transform(List.Positions(sorted), row))
	queryGroup: Reading

/// A text of a check's message with its placeholders filled (src/core/messages/messages.ts, fill; build B7, D300), in two forms: Html for the mailbox, Text for Outlook and Teams. `fields`: the fields of the findings of the part (their roles fill {role}, {who}, {epoRole} and the requests of {request}); `texts`: the message texts of the check; `settings`: MessageSettings, with Channel "email" or "chat" ({reply} reads "reply to this email" or "answer in this chat", D163). The placeholders: {role}, {who}, {epoRole}, {request} (the request of the texts, or of each role when it is "role"), {request:<id>}, {form:<id>} (the request without the action inside its form), {reply} and {Reply}. Any other text in braces stays as it is.
expression fnMessageFill =
		(template as text, fields as list, texts as record, settings as record) as record =>
		    let
		        words = MessageWords,
		        roles = List.Select(fields, (field) => Record.HasFields(words[roleLabel], field)),
		        plain = (value as text) as record => [Html = fnHtml(value), Text = value],
		        join = (parts as list, separator as text) as record => [
		            Html = Text.Combine(List.Select(List.Transform(parts, (part) => part[Html]), (value) => value <> ""), separator),
		            Text = Text.Combine(List.Select(List.Transform(parts, (part) => part[Text]), (value) => value <> ""), separator)
		        ],
		        orList = (items as list) as text =>
		            if List.Count(items) <= 1 then List.First(items, "") else Text.Combine(List.RemoveLastN(items, 1), ", ") & " or " & List.Last(items),
		        https = (value as text) as text => let trimmed = Text.Trim(value) in if Text.StartsWith(Text.Lower(trimmed, "en-US"), "https://") then trimmed else "",
		        // A request with its link (requestRef). Head: the same words without " in the Service Portal" at the end (requestRefs).
		        requestRef = (id as text, withAction as logical) as record =>
		            let
		                known = List.First(List.Select(words[requests], (request) => request[id] = id), null),
		                set = Record.FieldOrDefault(settings[Requests], id, [Name = "", Link = ""]),
		                saved = Text.Trim(set[Name]),
		                name = if known = null then (if saved <> "" then saved else id)
		                    else if saved = "" or saved = Record.FieldOrDefault(known, "was", null) then known[name] else saved,
		                action = if known <> null and Record.FieldOrDefault(known, "action", "") <> "" and withAction then ", action """ & known[action] & """" else "",
		                link = https(set[Link]),
		                portal = https(settings[PortalLink]),
		                where = if action <> "" then ", in the" else " in the",
		                comma = if action <> "" then "," else "",
		                headText = """" & name & """" & action & comma
		            in
		                if link <> "" then [Html = """<a href=""" & fnHtml(link) & """>" & fnHtml(name) & "</a>""" & fnHtml(action), Text = """" & name & """" & action & " (" & link & ")", Tail = false, Head = null]
		                else if portal <> "" then [
		                    Html = """" & fnHtml(name) & """" & fnHtml(action) & where & " <a href=""" & fnHtml(portal) & """>Service Portal</a>",
		                    Text = """" & name & """" & action & where & " Service Portal (" & portal & ")", Tail = true,
		                    Head = [Html = """" & fnHtml(name) & """" & fnHtml(action) & comma, Text = headText]]
		                else [Html = fnHtml("""" & name & """" & action & where & " Service Portal"), Text = """" & name & """" & action & where & " Service Portal", Tail = true,
		                    Head = [Html = fnHtml(headText), Text = headText]],
		        // Several requests: "A" or "B" in the Service Portal, with "in the Service Portal" once, at the end.
		        requestRefs = (ids as list) as record =>
		            let
		                refs = List.Buffer(List.Transform(ids, (id) => requestRef(id, true))),
		                last = List.Count(refs) - 1,
		                trimmed = List.Transform(List.Positions(refs), (at) => let ref = refs{at} in if at < last and ref[Tail] and refs{last}[Tail] then ref[Head] else ref)
		            in
		                [Html = Text.Combine(List.Transform(trimmed, (ref) => ref[Html]), " or "), Text = Text.Combine(List.Transform(trimmed, (ref) => ref[Text]), " or ")],
		        isName = (value as text) as logical => value <> "" and Text.Remove(value, {"a".."z", "A".."Z"}) = "",
		        isArgument = (value as text) as logical => value <> "" and Text.Remove(value, {"a".."z", "-"}) = "",
		        // One placeholder: "{name}" or "{name:arg}" (the braces included), else null.
		        token = (piece as text) as nullable record =>
		            let
		                inner = Text.Middle(piece, 1, Text.Length(piece) - 2),
		                colon = Text.PositionOf(inner, ":"),
		                name = if colon < 0 then inner else Text.Start(inner, colon),
		                arg = if colon < 0 then null else Text.Middle(inner, colon + 1)
		            in
		                if isName(name) and (arg = null or isArgument(arg)) then [Name = name, Arg = arg] else null,
		        filled = (found as record, piece as text) as record =>
		            let name = found[Name], arg = found[Arg] in
		            if name = "role" then plain(orList(List.Transform(roles, (field) => Record.Field(words[roleLabel], field))))
		            else if name = "who" then plain(let who = orList(List.Transform(roles, (field) => Record.Field(words[roleWord], field))) in if who = "" then "person" else who)
		            else if name = "epoRole" then plain(orList(List.Transform(roles, (field) => Record.FieldOrDefault(words[epoRole], field, Record.Field(words[roleLabel], field)))))
		            else if name = "request" then
		                let
		                    request = Record.FieldOrDefault(texts, "request", ""),
		                    ids = if arg <> null then {arg}
		                        else if request = "role" then List.Select(List.Transform(roles, (field) => Record.FieldOrDefault(words[roleRequest], field, "")), (id) => id <> "")
		                        else if request <> "" then {request} else {}
		                in
		                    requestRefs(ids)
		            else if name = "form" and arg <> null then requestRef(arg, false)
		            else if name = "reply" or name = "Reply" then
		                let reply = if settings[Channel] = "chat" then "answer in this chat" else "reply to this email" in
		                plain(if name = "Reply" then Text.Upper(Text.Start(reply, 1), "en-US") & Text.Middle(reply, 1) else reply)
		            else plain(piece),
		        // The pieces of the template: the text between the placeholders and each placeholder, in order.
		        chunks = Text.Split(template, "{"),
		        pieces = List.Combine(List.Transform(List.Positions(chunks), (at) =>
		            let chunk = chunks{at}, close = Text.PositionOf(chunk, "}") in
		            if at = 0 then {[Literal = chunk]}
		            else if close < 0 then {[Literal = "{" & chunk]}
		            else
		                let piece = "{" & Text.Start(chunk, close + 1), found = token(piece), rest = Text.Middle(chunk, close + 1) in
		                (if found = null then {[Literal = piece]} else {[Token = found, Piece = piece]}) & {[Literal = rest]})),
		        out = List.Transform(List.Select(pieces, (piece) => not Record.HasFields(piece, "Literal") or piece[Literal] <> ""),
		            (piece) => if Record.HasFields(piece, "Literal") then plain(piece[Literal]) else filled(piece[Token], piece[Piece]))
		    in
		        join(out, "")
	queryGroup: Reading

/// The texts of one part of a message (src/core/messages/messages.ts, sectionTexts; build B7, D300): its Heading, the Intro, the Ask, the Why it matters (each [Html, Text]) and WhyYou (fnWhyYou). A part is the cases of one check and one route (and one kind of problem, for a check with byProblem). `texts`: the message texts of the part (fnDrafts gives those of its kind of problem); `route`: "epo" when the fix is made in EPO; `items`: the cases, each with its Fact; `settings`: MessageSettings. For a CI from EPO the ask names EPO's words for the roles; a team responsible for the record has its own ask (askByTeam, D195); a class may have its own ask (askByClass); a role with no request in the portal (Supported by) asks for a reply only (askNoRequest).
expression fnMessageSection =
		(texts as record, route as text, items as list, settings as record) as record =>
		    let
		        words = MessageWords,
		        facts = List.Buffer(List.Transform(items, (item) => item[Fact])),
		        fields = List.Distinct(List.Transform(facts, (fact) => fact[Field])),
		        roles = List.Select(fields, (field) => Record.HasFields(words[roleLabel], field)),
		        fill = (template as text) as record => fnMessageFill(template, fields, texts, settings),
		        plain = (value as text) as record => [Html = fnHtml(value), Text = value],
		        join = (parts as list) as record => [
		            Html = Text.Combine(List.Select(List.Transform(parts, (part) => part[Html]), (value) => value <> ""), " "),
		            Text = Text.Combine(List.Select(List.Transform(parts, (part) => part[Text]), (value) => value <> ""), " ")
		        ],
		        andList = (values as list) as text =>
		            if List.Count(values) <= 1 then List.First(values, "") else Text.Combine(List.RemoveLastN(values, 1), ", ") & " and " & List.Last(values),
		        textOf = (name as text) as text => let value = Record.FieldOrDefault(texts, name, null) in if value = null then "" else value,
		        // 'sacm' is in runs saved before version 0.17 only: the fix is made in EPO all the same (D123).
		        epo = route = "epo" or route = "sacm",
		        contactId = facts{0}[ContactId],
		        teamId = if Text.StartsWith(contactId, "team:") then Text.Middle(contactId, 5) else "",
		        teamAsk = if teamId <> "" and List.AllTrue(List.Transform(facts, (fact) => fact[ContactId] = contactId))
		            then Record.FieldOrDefault(Record.FieldOrDefault(texts, "askByTeam", []), teamId, null) else null,
		        byClass = Record.FieldOrDefault(texts, "askByClass", []),
		        ask =
		            if epo then
		                let
		                    named = List.Select(roles, (field) => Record.HasFields(words[epoRole], field)),
		                    first = if Record.FieldOrDefault(texts, "epoAsk", null) <> null then texts[epoAsk]
		                        else if textOf("epoWhat") <> "" then "Please correct the " & texts[epoWhat] & " in EPO."
		                        else if not List.IsEmpty(named) then
		                            "In EPO, " & andList(List.Transform(named, (field) => Record.Field(words[roleLabel], field) & " is called " & Record.Field(words[epoRole], field))) & ". Please correct it in EPO."
		                        else "Please correct it in EPO."
		                in
		                    // The service mapped flag is never named and never a reason to ask for a reply: copying EPO into ServiceNow is SACM's own job.
		                    plain("These CIs come from EPO. " & first & " ServiceNow receives the change from EPO.")
		            else if teamAsk <> null and teamAsk <> "" then fill(teamAsk)
		            else
		                let
		                    noRequest = textOf("request") = "role" and textOf("askNoRequest") <> "" and not List.AnyTrue(List.Transform(roles, (field) => Record.HasFields(words[roleRequest], field))),
		                    general = if noRequest then texts[askNoRequest] else texts[ask],
		                    classes = List.Distinct(List.Transform(facts, (fact) => fact[Class])),
		                    own = List.Select(classes, (cls) => Record.FieldOrDefault(byClass, cls, "") <> ""),
		                    // "Service Offerings": the label of the class, a final y as ie, and an s.
		                    labelOf = (cls as text) as text =>
		                        let label = List.First(List.Select(facts, (fact) => fact[Class] = cls))[ClassLabel] in
		                        (if Text.EndsWith(label, "y") then Text.Start(label, Text.Length(label) - 1) & "ie" else label) & "s"
		                in
		                    if List.Count(classes) = 1 and not List.IsEmpty(own) then fill(Record.Field(byClass, own{0}))
		                    else if not List.IsEmpty(own) then
		                        join(List.Transform(own, (cls) => join({plain("For " & labelOf(cls) & ":"), fill(Record.Field(byClass, cls))}))
		                            & (if List.Count(classes) > List.Count(own) then {join({plain("For the other CIs:"), fill(general)})} else {}))
		                    else fill(general),
		        withSeveral = if textOf("several") <> "" and List.Count(List.Distinct(List.Transform(facts, (fact) => fact[CiKey]))) >= 3 then join({ask, fill(texts[several])}) else ask
		    in
		        [
		            Heading = fill(texts[subject]), Intro = fill(texts[intro]), Ask = withSeveral, Why = fill(texts[why]),
		            WhyYou = fnWhyYou(facts{0}[ContactVia], fnBelowWords(items))
		        ]
	queryGroup: Reading

/// "the report has no column "Supported by (active)" (supported_by.active)": the label first, the technical name for whoever builds the report (src/core/shared/text.ts, missingColumns).
expression fnMissingColumns =
		(columns as list) as text =>
		    "the report has no column " & Text.Combine(List.Transform(columns, (column) =>
		        let word = fnColumnWord(column) in
		        if fnMatches(ReadingRules[technicalColumn], "", column) and word <> column then """" & word & """ (" & column & ")" else """" & word & """"), ", ")
	queryGroup: Reading

/// A name as it is compared: hidden characters (zero-width space, zero-width non-joiner, zero-width joiner, byte order mark) replaced by `hiddenAs`, a non-breaking space as a space, trimmed, lower case, runs of spaces squashed (src/core/shared/names.ts: nameKey with "", identityKey with "?").
expression fnNameKey =
		(name as text, hiddenAs as text) as text =>
		    let
		        hidden = List.Transform({8203, 8204, 8205, 65279}, Character.FromNumber),
		        visible = List.Accumulate(hidden, name, (text, char) => Text.Replace(text, char, hiddenAs)),
		        spaced = Text.Replace(visible, Character.FromNumber(160), " "),
		        lower = Text.Lower(Text.Trim(spaced), "en-US")
		    in
		        Text.Combine(List.Select(Text.SplitAny(lower, " #(tab)#(cr)#(lf)"), each _ <> ""), " ")
	queryGroup: Reading

/// Names, each once, sorted, joined with ", " (as the details of the criticality checks list parents).
expression fnNames = (names as list) as text => Text.Combine(List.Sort(List.Distinct(names), Comparer.FromCulture("en-US")), ", ")
	queryGroup: Reading

/// The newest report file of a type (the latest report date, then the last file name), as a one-row table of ReadFiles; empty when there is none.
expression fnNewest =
		(kind as text) as table =>
		    Table.LastN(Table.Sort(Table.SelectRows(ReadFiles, each [Kind] = kind), {{"ReportDate", Order.Ascending}, {"FileName", Order.Ascending}}), 1)
	queryGroup: Reading

/// A report header as the checks compare it: trimmed, lower case, spaces as "_", the "ci." prefix of a CMDB Health result removed (src/core/reading/headers.ts).
expression fnNormaliseHeader =
		(header as text) as text =>
		    let
		        lower = Text.Lower(Text.Trim(header), "en-US"),
		        joined = Text.Combine(List.Select(Text.SplitAny(lower, " #(tab)#(cr)#(lf)#(00A0)"), each _ <> ""), "_")
		    in
		        if Text.StartsWith(joined, "ci.") then Text.Middle(joined, 3) else joined
	queryGroup: Reading

/// The part Notes of the table Run (D284), which the DAX table Notes shows: why a check could not be evaluated, or only in part, on the newest report (D15): a detector not built in Power Query yet, a column or reference file missing, a report not loaded. A card with a note and nothing tested is grey, never green. Notes about the run as a whole (RELATIONSHIPS, PARKED, SOURCE-FIRST, Routing, Listing) have no card. `run` is CheckRun (null when no CI report is loaded).
expression fnNotesPart =
		(run as nullable record) as table =>
		    let
		        date = if run = null then null else run[Date],
		        notBuilt = Table.SelectRows(ChecksRows, each not [Built]),
		        reasons = Table.AddColumn(notBuilt, "Reason", each
		            if [DetectorType] = "manual" then "Not tested: its lines come from the lifecycle review, which the Power BI version reads from stage 2."
		            else "Not tested: this check is not built in the Power BI version yet.", type text),
		        built = Table.SelectColumns(reasons, {"CheckId", "Reason"}),
		        found = #table(type table [CheckId = text, Reason = text], List.Transform(if run = null then {} else run[Notes], (note) => {note[CheckId], note[Note]})),
		        all = Table.Combine({built, found}),
		        withDate = Table.AddColumn(all, "ReportDate", each date, type nullable date),
		        numbered = Table.AddIndexColumn(withDate, "Order", 1, 1, Int64.Type)
		    in
		        Table.SelectColumns(numbered, {"CheckId", "ReportDate", "Reason", "Order"})
	queryGroup: Reading

/// Who made a Service Offering (src/core/cases/fix-place.ts, offeringOrigin, D137, D187): "epo" when the EPO integration created it (Created by is not a person's user ID), "person" when a person did (or the report does not say), "" for a CI that is no offering of reference/epo-synced-classes.
expression fnOfferingOrigin =
		(ci as record) as text =>
		    let
		        synced = Record.FieldOrDefault(ReferenceFiles, "epo-synced-classes", null),
		        offerings = if synced = null then null else Record.FieldOrDefault(synced, "offerings", null),
		        createdBy = Text.Trim(if Record.FieldOrDefault(ci, "CreatedBy", null) = null then "" else ci[CreatedBy])
		    in
		        if offerings = null or not List.Contains(Record.FieldOrDefault(offerings, "classes", {}), ci[Class]) then ""
		        else if createdBy = "" then "person"
		        else if fnMatches(Record.FieldOrDefault(offerings, "personUserId", "^$"), "", createdBy) then "person"
		        else "epo"
	queryGroup: Reading

/// The report of a type that goes with a CI report (plan §4.2, as the engine pairs them): among `files` (rows of ReadFiles, or of fnReadFiles for the history), the newest report of that type dated on or before the CI report (the last file name when two share a date). Returns [FileName, ReportDate, Rows, PreviousDate]: Rows as a list of records, PreviousDate the date of the newest report of the type before it (null when it is the first; the chip "changed in EPO" needs it). Null when there is none, so a check that needs it is not tested and says so.
expression fnPairedFile =
		(files as table, kind as text, date as nullable date) as nullable record =>
		    let
		        candidates = Table.SelectRows(files, each [Kind] = kind and date <> null and [ReportDate] <> null and [ReportDate] <= date),
		        sorted = Table.Sort(candidates, {{"ReportDate", Order.Ascending}, {"FileName", Order.Ascending}}),
		        newest = Table.LastN(sorted, 1),
		        earlier = if Table.IsEmpty(newest) then {} else List.Select(sorted[ReportDate], (day) => day < newest{0}[ReportDate])
		    in
		        if Table.IsEmpty(newest) then null
		        else [
		            FileName = newest{0}[FileName], ReportDate = newest{0}[ReportDate], Rows = Table.ToRecords(fnReadKind(kind, newest{0}[Read])),
		            PreviousDate = List.Max(earlier, null)
		        ]
	queryGroup: Reading

/// The part Parked of the table Run (D284), which the DAX table Parked shows: the grey lines of the Cards page for the classes that are not checked yet (reference/parked-classes, D179), so nothing is hidden silently: "1 Business Capability in Ready is not checked yet". `run` is CheckRun (null when no CI report is loaded).
expression fnParkedPart =
		(run as nullable record) as table =>
		    let
		        lines = if run = null or run[Parked] = null then {} else run[Parked][Lines]
		    in
		        #table(type table [Line = text, Order = Int64.Type], List.Transform(List.Positions(lines), (position) => {lines{position}, position + 1}))
	queryGroup: Reading

/// A date of a report: "2026-06-10 10:35:59", "10-06-2026", "10/06/2026 10:35" (day first), or the serial number Excel keeps. null when empty or not a date, so a check can say what it could not read (src/core/shared/dates.ts, reportDate).
expression fnParseDate =
		(value as text) as nullable date =>
		    let
		        text = Text.Trim(value),
		        isIso = Text.Length(text) >= 10 and Text.Middle(text, 4, 1) = "-" and Text.Middle(text, 7, 1) = "-"
		            and fnDigits(Text.Start(text, 4)) and fnDigits(Text.Middle(text, 5, 2)) and fnDigits(Text.Middle(text, 8, 2)),
		        iso = try #date(Number.From(Text.Start(text, 4)), Number.From(Text.Middle(text, 5, 2)), Number.From(Text.Middle(text, 8, 2))) otherwise null,
		        firstWord = Text.BeforeDelimiter(text, " "),
		        parts = Text.SplitAny(firstWord, "-/."),
		        isDayFirst = List.Count(parts) >= 3 and fnDigits(parts{0}) and Text.Length(parts{0}) <= 2
		            and fnDigits(parts{1}) and Text.Length(parts{1}) <= 2 and Text.Length(parts{2}) >= 4 and fnDigits(Text.Start(parts{2}, 4))
		            and (Text.Length(parts{2}) = 4 or List.Count(parts) = 3),
		        dayFirst = try #date(Number.From(Text.Start(parts{2}, 4)), Number.From(parts{1}), Number.From(parts{0})) otherwise null,
		        serialParts = Text.Split(text, "."),
		        isSerial = Text.Length(serialParts{0}) = 5 and fnDigits(serialParts{0})
		            and (List.Count(serialParts) = 1 or (List.Count(serialParts) = 2 and fnDigits(serialParts{1}))),
		        serial = Date.AddDays(#date(1899, 12, 30), Number.From(serialParts{0}))
		    in
		        if isIso then iso else if isDayFirst then dayFirst else if isSerial then serial else null
	queryGroup: Reading

/// The live CIs on the other end of a node's relationships, in one direction ("parent": above it, "child": below it), of some classes, each once, in the order of the Relationship report (relationship-detectors.ts, partners).
expression fnPartners =
		(graph as record, node as record, direction as text, classes as list) as list =>
		    let
		        edges = Record.FieldOrDefault(if direction = "parent" then graph[Up] else graph[Down], node[Key], {}),
		        others = List.Select(List.Transform(edges, (edge) => if direction = "parent" then edge[Parent] else edge[Child]), (other) => List.Contains(classes, other[Cls])),
		        grouped = fnGroupBy(others, (other) => other[Key])
		    in
		        List.Transform(Record.FieldValues(grouped), (group) => List.Last(group))
	queryGroup: Reading

/// A field name as a column name of the model: owned_by -> OwnedBy, manager.email -> ManagerEmail (tools/powerbi/generate.ts, pascal).
expression fnPascal =
		(name as text) as text =>
		    Text.Combine(List.Transform(List.Select(Text.SplitAny(name, "._"), (part) => part <> ""), (part) => Text.Upper(Text.Start(part, 1), "en-US") & Text.Middle(part, 1)))
	queryGroup: Reading

/// A person of a CI by role (owned_by, managed_by, supported_by, assigned_to), as src/core/sources/ci/ci-report.ts reads it: null when the report has no column for the role. Active and ManagerActive are null when the report does not say.
expression fnPerson =
		(ci as record, role as text, columns as list) as nullable record =>
		    let
		        prefix = Record.FieldOrDefault(RolePrefixes, role, ""),
		        get = (part as text) as any => Record.FieldOrDefault(ci, prefix & part, null),
		        text = (part as text) as text => let value = get(part) in if value = null then "" else value
		    in
		        if not Record.HasFields(RolePrefixes, role) or not List.Contains(columns, role) then null
		        else [
		            Name = text(""), Email = text("Email"), UserId = text("UserId"), Active = get("Active"),
		            Manager = text("Manager"), ManagerEmail = text("ManagerEmail"), ManagerUserId = text("ManagerUserId"), ManagerActive = get("ManagerActive"),
		            DepartmentHead = text("DepartmentHead"), DepartmentHeadEmail = text("DepartmentHeadEmail"), DepartmentHeadUserId = text("DepartmentHeadUserId")
		        ]
	queryGroup: Reading

/// A person of a CI as the relationship checks write it: the name, else the email, else "(empty)" (relationship-detectors.ts, personText). `person` is a record of fnPerson, or null.
expression fnPersonText =
		(person as nullable record) as text =>
		    if person = null then "(empty)" else if person[Name] <> "" then person[Name] else if person[Email] <> "" then person[Email] else "(empty)"
	queryGroup: Reading

/// A person of EPO in words: "Jane Doe (jdo)", the user ID alone when ServiceNow does not know it, or "nobody" (src/core/sources/epo/epo-report.ts, personWords).
expression fnPersonWords =
		(userId as text, names as record) as text =>
		    let
		        id = Text.Lower(Text.Trim(userId), "en-US"),
		        name = Record.FieldOrDefault(names, id, null)
		    in
		        if userId = "" then "nobody" else if name <> null then name & " (" & id & ")" else id
	queryGroup: Reading

/// The columns a reader needs, by header form, as a table of trimmed text with one column per spec (named spec[column]). A column the report does not have is "" on every row; Found lists the specs that were found, Missing the others. Columns: the same columns as buffered lists, in the order of the specs. Column by column (one Text.Trim per cell, no list per row).
expression fnPickColumns =
		(sheet as record, specs as list) as record =>
		    let
		        positions = List.Buffer(List.Transform(specs, (spec) => fnColumnIndex(sheet[Headers], spec[any], Record.FieldOrDefault(spec, "suffix", false)))),
		        names = List.Transform(specs, (spec) => spec[column]),
		        rows = sheet[Rows],
		        sourceColumns = Table.ColumnNames(rows),
		        count = Table.RowCount(rows),
		        // Each column buffered: a table made of lazy lists and taken apart again with Table.ToColumns took 39 s for
		        // 760 CIs (measured in the speed build).
		        columns = List.Buffer(List.Transform(positions, (position) =>
		            if position < 0 or position >= List.Count(sourceColumns) then List.Repeat({""}, count)
		            else List.Buffer(List.Transform(Table.Column(rows, sourceColumns{position}), Text.Trim)))),
		        table = Table.FromColumns(columns, names)
		    in
		        [
		            Columns = columns,
		            Table = table,
		            Found = List.Select(names, (name) => positions{List.PositionOf(names, name)} >= 0),
		            Missing = List.Select(names, (name) => positions{List.PositionOf(names, name)} < 0)
		        ]
	queryGroup: Reading

/// The HTML of an EPO description as plain text (src/core/sources/epo/epo-report.ts, plainText): "{Q}" (how the export writes a quote in an attribute) is a quote again, a line break or the end of a paragraph, a block or a heading is a space, every other tag is left out, the entities are decoded (&amp; &lt; &gt; &quot; &apos; &nbsp; and numbers), and runs of spaces are one space. The same steps, in the same order, as the regular expressions there. A number that is no character of its own (a half of a surrogate pair) is kept as it is written.
expression fnPlainText =
		(html as text) as text =>
		    let
		        isWord = (char as text) as logical =>
		            let code = Character.ToNumber(char) in (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or code = 95 or (code >= 97 and code <= 122),
		        // After "<": br, /p, /div, /li or /h and a digit, then no letter, digit or "_" (the \b of the pattern).
		        isBlock = (after as text) as logical =>
		            let
		                lower = Text.Lower(after, "en-US"),
		                ends = (length as number) as logical => Text.Length(after) = length or not isWord(Text.At(after, length)),
		                heading = Text.StartsWith(lower, "/h") and Text.Length(lower) > 2 and Text.Contains("0123456789", Text.At(lower, 2)) and ends(3)
		            in
		                heading or List.AnyTrue(List.Transform({"br", "/p", "/div", "/li"}, (word) => Text.StartsWith(lower, word) and ends(Text.Length(word)))),
		        // One pass over the text: at each "<" that `takes` (and that has a ">" after it), the tag up to the first ">" becomes `with`.
		        tags = (text as text, takes as function, with as text) as text =>
		            let
		                steps = List.Generate(
		                    () => [Out = "", Rest = text, Done = false],
		                    (state) => state <> null,
		                    (state) =>
		                        if state[Done] then null
		                        else
		                            let
		                                rest = state[Rest],
		                                starts = List.Select(Text.PositionOfAny(rest, {"<"}, Occurrence.All), (at) => takes(Text.Middle(rest, at + 1)) and Text.PositionOf(Text.Middle(rest, at + 1), ">") >= 0),
		                                at = List.First(starts, -1),
		                                close = if at < 0 then -1 else at + 1 + Text.PositionOf(Text.Middle(rest, at + 1), ">")
		                            in
		                                if at < 0 then [Out = state[Out] & rest, Rest = "", Done = true]
		                                else [Out = state[Out] & Text.Start(rest, at) & with, Rest = Text.Middle(rest, close + 1), Done = false],
		                    (state) => state)
		            in
		                List.Last(steps)[Out],
		        hex = "0123456789abcdef",
		        allIn = (text as text, chars as text) as logical => List.AllTrue(List.Transform(Text.ToList(text), (char) => Text.Contains(chars, char))),
		        letters = "abcdefghijklmnopqrstuvwxyz",
		        named = [amp = "&", lt = "<", gt = ">", quot = """", apos = "'", nbsp = " "],
		        // The text of an entity ("amp", "#38", "#x26"), or null when it is none.
		        decode = (code as text) as nullable text =>
		            let
		                lower = Text.Lower(code, "en-US"),
		                body = Text.Middle(lower, 1),
		                isNumber = Text.StartsWith(lower, "#") and ((Text.StartsWith(body, "x") and Text.Length(body) > 1 and allIn(Text.Middle(body, 1), hex)) or (body <> "" and allIn(body, hex))),
		                isName = lower <> "" and allIn(lower, letters),
		                digits = Text.Combine(List.FirstN(Text.ToList(body), each Text.Contains("0123456789", _))),
		                value =
		                    if Text.StartsWith(body, "x") then List.Accumulate(Text.ToList(Text.Middle(body, 1)), 0, (sum, char) => sum * 16 + Text.PositionOf(hex, char))
		                    else if digits = "" then 0 else Number.FromText(digits, "en-US")
		            in
		                if isNumber then (if value > 0 and value <= 1114111 and (value < 55296 or value > 57343) then Character.FromNumber(value) else null)
		                else if isName then Record.FieldOrDefault(named, lower, null)
		                else null,
		        entities = (text as text) as text =>
		            let
		                steps = List.Generate(
		                    () => [Out = "", Rest = text, Done = false],
		                    (state) => state <> null,
		                    (state) =>
		                        if state[Done] then null
		                        else
		                            let
		                                rest = state[Rest],
		                                at = Text.PositionOf(rest, "&"),
		                                after = if at < 0 then "" else Text.Middle(rest, at + 1),
		                                semi = Text.PositionOf(after, ";"),
		                                code = if semi < 0 then "" else Text.Start(after, semi),
		                                // Only letters, digits, "#" and "x" can be in an entity: the first ";" ends it, or it is none.
		                                found = if semi < 0 then null else decode(code)
		                            in
		                                if at < 0 then [Out = state[Out] & rest, Rest = "", Done = true]
		                                else if found = null then [Out = state[Out] & Text.Start(rest, at + 1), Rest = after, Done = false]
		                                else [Out = state[Out] & Text.Start(rest, at) & found, Rest = Text.Middle(after, semi + 1), Done = false],
		                    (state) => state)
		            in
		                List.Last(steps)[Out],
		        // JavaScript's \s and the no-break space.
		        spaces = List.Transform({9, 10, 11, 12, 13, 32, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288, 65279}, Character.FromNumber),
		        quoted = Text.Replace(html, "{Q}", """"),
		        blocks = tags(quoted, isBlock, " "),
		        bare = tags(blocks, (after) => true, ""),
		        decoded = entities(bare),
		        words = List.Select(Text.SplitAny(decoded, Text.Combine(spaces)), (part) => part <> "")
		    in
		        Text.Combine(words, " ")
	queryGroup: Reading

/// "1 Service Offering", "2 Service Offerings", "1,200 rows" (src/core/shared/text.ts, plural).
expression fnPlural =
		(count as number, word as text, optional many as nullable text) as text =>
		    Number.ToText(count, "#,0", "en-GB") & " " & (if count = 1 then word else if many = null then word & "s" else many)
	queryGroup: Reading

/// The CI report as one row per CI with the canonical columns of ReadingRules[ciColumns] (src/core/sources/ci/ci-report.ts, readCiReport). A row without a name is left out. Key is the SACM identity: the name; the asset tag is added only when two CIs share a name, and the order in the report when that does not separate them either. NameSpaces: the name in the file starts or ends with a space, a tab or a no-break space (the rule "outer-space" of reference/name-rules). Speed (ARCHITECTURE §12, the speed rules): column by column, every column a buffered list read by position; a flag, level or status column and the class have few distinct values, so each distinct value is converted once; only the rows whose Key1 is shared are numbered. The table is made once, at the end.
expression fnReadCiReport =
		(read as record) as table =>
		    let
		        specs = List.Buffer(ReadingRules[ciColumns]),
		        names = List.Buffer(List.Transform(specs, (spec) => spec[column])),
		        nameSpec = List.First(List.Select(specs, (spec) => spec[column] = "Name")),
		        nameAt = fnColumnIndex(read[Headers], nameSpec[any], Record.FieldOrDefault(nameSpec, "suffix", false)),
		        sourceColumns = Table.ColumnNames(read[Rows]),
		        count = Table.RowCount(read[Rows]),
		        rawNames = List.Buffer(if nameAt < 0 or nameAt >= List.Count(sourceColumns) then List.Repeat({""}, count) else Table.Column(read[Rows], sourceColumns{nameAt})),
		        picked = fnPickColumns(read, specs)[Columns],
		        columnOf = (name as text) as list => picked{List.PositionOf(names, name)},
		        // The rows with a name, by their place in the report.
		        nameColumn = columnOf("Name"),
		        kept = List.Buffer(List.Select(List.Positions(nameColumn), (at) => nameColumn{at} <> "")),
		        keep = (column as list) as list => List.Buffer(List.Transform(kept, (at) => column{at})),
		        convert = (kind as text) as function =>
		            if kind = "flag" then (value) => fnFlag(value)
		            else if kind = "level" then (value) => fnLevel(value)
		            else if kind = "date" then (value) => fnParseDate(value)
		            else if kind = "status" then (value) => Record.FieldOrDefault(ReadingRules[operationalStatus], value, value)
		            else if kind = "tags" then (value) => Text.Combine(List.Select(List.Transform(Text.Split(value, ","), Text.Trim), each _ <> ""), ", ")
		            else (value) => value,
		        typeOf = (kind as text) as type =>
		            if kind = "flag" then type nullable logical
		            else if kind = "level" then Int64.Type
		            else if kind = "date" then type nullable date
		            else type text,
		        // A column of few distinct values: each value converted once, then looked up.
		        byValue = (column as list, change as function) as list =>
		            let
		                distinct = List.Buffer(List.Distinct(column)),
		                converted = Record.FromList(List.Transform(distinct, change), distinct)
		            in
		                List.Buffer(List.Transform(column, (value) => Record.Field(converted, value))),
		        few = {"flag", "level", "status"},
		        values = List.Buffer(List.Transform(List.Positions(specs), (position) =>
		            let
		                spec = specs{position},
		                column = keep(picked{position})
		            in
		                if List.Contains(few, spec[kind]) then byValue(column, convert(spec[kind]))
		                else if spec[kind] = "text" then column
		                else List.Buffer(List.Transform(column, convert(spec[kind]))))),
		        valueOf = (name as text) as list => values{List.PositionOf(names, name)},
		        classes = byValue(valueOf("SourceClass"), fnCanonicalClass),
		        outer = {" ", "#(tab)", "#(00A0)"},
		        spaces = List.Buffer(List.Transform(keep(rawNames), (name) =>
		            let raw = if Text.StartsWith(name, "#(FEFF)") then Text.Middle(name, 1) else name in
		            raw <> "" and (List.Contains(outer, Text.Start(raw, 1)) or List.Contains(outer, Text.End(raw, 1))))),
		        baseKeys = List.Buffer(List.Transform(valueOf("Name"), (name) => fnNameKey(name, "?"))),
		        tags = valueOf("AssetTag"),
		        rows = List.Buffer(List.Positions(baseKeys)),
		        // How many CIs have each base key, and then each Key1, as records (fnCountBy).
		        sameName = fnCountBy(baseKeys),
		        key1s = List.Buffer(List.Transform(rows, (row) =>
		            let base = baseKeys{row}, tag = tags{row} in
		            if Record.Field(sameName, base) > 1 and tag <> "" then base & "|" & Text.Lower(tag, "en-US") else base)),
		        sameKey1 = fnCountBy(key1s),
		        // Only a Key1 that several CIs share gets a number: the place of the CI among them, in report order.
		        sharing = List.Buffer(List.Select(rows, (row) => Record.Field(sameKey1, key1s{row}) > 1)),
		        groups = Table.Group(Table.FromColumns({List.Transform(sharing, (row) => key1s{row}), sharing}, {"Key1", "Row"}), {"Key1"}, {{"Rows", each _[Row]}}),
		        nthOf = Record.Combine({[]} & List.Transform(groups[Rows],
		            (group) => Record.FromList(List.Numbers(1, List.Count(group)), List.Transform(List.Sort(group), Text.From)))),
		        keys = List.Transform(rows, (row) =>
		            let nth = Record.FieldOrDefault(nthOf, Text.From(row), 1) in if nth = 1 then key1s{row} else key1s{row} & "#" & Text.From(nth)),
		        built = Table.FromColumns({keys, classes} & values & {spaces}, {"Key", "Class"} & names & {"NameSpaces"}),
		        typed = Table.TransformColumnTypes(built, {{"Key", type text}, {"Class", type text}, {"NameSpaces", type logical}}
		            & List.Transform(specs, (spec) => {spec[column], typeOf(spec[kind])}))
		    in
		        typed
	queryGroup: Reading

/// The ServiceNow contract report, one row per contract (src/core/sources/contracts/contract-reports.ts, readContractReport). A row without a number is left out. Criticality is true when any of the criticality columns is filled.
expression fnReadContractReport =
		(read as record) as table =>
		    let
		        columns = ReferenceFiles[#"contract-reports"][servicenow][columns],
		        names = List.Select(Record.FieldNames(columns), (name) => name <> "criticality"),
		        specs = List.Transform(names, (name) => [column = name, any = Record.Field(columns, name)]),
		        critical = List.Select(List.Transform(columns[criticality], (name) => List.PositionOf(read[Headers], name)), (position) => position >= 0),
		        picked = fnPickColumns(read, specs)[Table],
		        criticalRows = List.Transform(Table.ToRows(read[Rows]), (row) =>
		            List.AnyTrue(List.Transform(critical, (position) => position < List.Count(row) and Text.Trim(row{position}) <> ""))),
		        withCritical = Table.FromColumns(Table.ToColumns(picked) & {criticalRows}, Table.ColumnNames(picked) & {"criticality"}),
		        numbered = Table.SelectRows(withCritical, each [number] <> ""),
		        typed = Table.TransformColumns(numbered, {
		            {"start", fnParseDate, type nullable date}, {"end", fnParseDate, type nullable date},
		            {"ownerActive", each fnFlag(_, true), type nullable logical}, {"procurementPartnerActive", each fnFlag(_, true), type nullable logical},
		            {"ownerUserId", each Text.Lower(_, "en-US"), type text}, {"procurementPartnerUserId", each Text.Lower(_, "en-US"), type text},
		            {"tags", each Text.Combine(List.Select(List.Transform(Text.Split(_, ","), Text.Trim), (tag) => tag <> ""), ", "), type text},
		            {"criticality", each _, type logical}}),
		        renamed = Table.TransformColumnNames(typed, (name) => Text.Upper(Text.Start(name, 1)) & Text.Middle(name, 1))
		    in
		        renamed
	queryGroup: Reading

/// The EPO systems report, one row per system (src/core/sources/epo/epo-report.ts). The header forms and the meaning of the status words are the reference file epo-systems-report.json. A row without an EPO ID is left out. Status is the ServiceNow status of the status word ("" when the word is not known); StatusWord is the word as EPO writes it. The description is plain text: EPO writes HTML (fnPlainText).
expression fnReadEpoReport =
		(read as record) as table =>
		    let
		        config = ReferenceFiles[#"epo-systems-report"],
		        columns = config[columns],
		        specs = List.Transform(Record.FieldNames(columns), (name) => [column = name, any = Record.Field(columns, name)]),
		        picked = fnPickColumns(read, specs)[Table],
		        withId = Table.SelectRows(picked, each [epoId] <> ""),
		        words = List.Transform(Record.FieldNames(config[statuses]), (word) => {fnNameKey(word, ""), Record.Field(config[statuses], word)}),
		        statusOf = (word as text) as text => let found = List.Select(words, (pair) => pair{0} = fnNameKey(word, "")) in if List.IsEmpty(found) then "" else found{0}{1},
		        withStatus = Table.AddColumn(withId, "Status", each statusOf([status]), type text),
		        changed = Table.TransformColumns(withStatus, {{"changed", fnParseDate, type nullable date}, {"description", fnPlainText, type text}}),
		        renamed = Table.RenameColumns(changed, {
		            {"epoId", "EpoId"}, {"name", "Name"}, {"description", "Description"}, {"status", "StatusWord"}, {"department", "Department"},
		            {"owner", "Owner"}, {"responsible1", "Responsible1"}, {"responsible2", "Responsible2"}, {"changed", "Changed"}})
		    in
		        Table.SelectColumns(renamed, {"EpoId", "Name", "Status", "StatusWord", "Department", "Owner", "Responsible1", "Responsible2", "Changed", "Description"})
	queryGroup: Reading

/// The report files dated from `from` (that day or later) up to `to` (before that day), each read once: its sheets (Read), its type by its columns (Kind, TypeLabel) and why it was not read (Message). null leaves that end open; a file with no date is always kept. A file outside the dates is never opened, so an old folder stays fast (D290). A file that cannot be opened is not read, with the reason, and the refresh goes on.
expression fnReadFiles =
		(from as nullable date, to as nullable date) as table =>
		    let
		        kept = Table.SelectRows(ReportSourceFiles, each [ReportDate] = null or ((from = null or [ReportDate] >= from) and (to = null or [ReportDate] < to))),
		        read = Table.AddColumn(kept, "Read", each
		            let attempt = try fnReadTable([Content]) in
		            if attempt[HasError] then [Format = "", Sheets = {}, Headers = {}, RawHeaders = {}, Rows = #table({}, {}), Error = attempt[Error][Message]]
		            else attempt[Value]),
		        typed = Table.AddColumn(read, "Type", each
		            if Record.HasFields([Read], "Error") then [Kind = "", Label = "Not read", Message = "The file could not be opened: " & [Read][Error]]
		            else fnReportType([Read][Headers])),
		        expanded = Table.ExpandRecordColumn(typed, "Type", {"Kind", "Label", "Message"}, {"Kind", "TypeLabel", "Message"})
		    in
		        Table.Buffer(expanded)
	queryGroup: Reading

/// The rows of one report file by its type, with the reader of that type; null for a file of no known type.
expression fnReadKind =
		(kind as text, read as record) as nullable table =>
		    if kind = "ci" then fnReadCiReport(read)
		    else if kind = "relationship" then fnReadRelationshipReport(read)
		    else if kind = "epo" then fnReadEpoReport(read)
		    else if kind = "solusi" then fnReadSolusiFile(read)
		    else if kind = "contract" then fnReadContractReport(read)
		    else null
	queryGroup: Reading

/// The Relationship report, one row per relationship (src/core/sources/relationships/relationship-report.ts). The first Class and Asset tag columns are the parent's, the second the child's; the field-name forms win when they are there. Excluded is null when the report has no "Excluded for calculation" column. A row without a parent or a child is left out.
expression fnReadRelationshipReport =
		(read as record) as table =>
		    let
		        rules = ReadingRules[relationshipColumns],
		        headers = read[Headers],
		        first = (names as list) as number => fnColumnIndex(headers, names),
		        all = (name as text) as list => List.Select(List.Positions(headers), (position) => headers{position} = name),
		        classes = all("class") & all("sys_class_name"),
		        tags = all("asset_tag"),
		        byPosition = (explicit as number, list as list, at as number) as number =>
		            if explicit >= 0 then explicit else if List.Count(list) = 2 then list{at} else -1,
		        isExcluded = (header as text) as logical =>
		            List.AnyTrue(List.Transform({"excluded_for_calculation", "excluded_from_calculation"}, (end) =>
		                Text.EndsWith(header, end) and (
		                    let prefix = Text.Start(header, Text.Length(header) - Text.Length(end)) in
		                    prefix = "" or (Text.EndsWith(prefix, "_") and Text.Length(prefix) > 1
		                        and List.AllTrue(List.Transform(Text.ToList(Text.Start(prefix, Text.Length(prefix) - 1)), (char) => Text.Contains("abcdefghijklmnopqrstuvwxyz0123456789", char))))))),
		        positions = [
		            Parent = first(rules[parent]),
		            Type = first(rules[type]),
		            Child = first(rules[child]),
		            ParentClass = byPosition(first(rules[parentClass]), classes, 0),
		            ChildClass = byPosition(first(rules[childClass]), classes, 1),
		            ParentTag = byPosition(first(rules[parentTag]), tags, 0),
		            ChildTag = byPosition(first(rules[childTag]), tags, 1),
		            Excluded = List.PositionOf(List.Transform(headers, isExcluded), true)
		        ],
		        cell = (row as list, position as number) as text => if position < 0 or position >= List.Count(row) then "" else Text.Trim(row{position}),
		        rows = List.Transform(Table.ToRows(read[Rows]), (row) => {
		            cell(row, positions[Parent]), cell(row, positions[Type]), cell(row, positions[Child]),
		            fnCanonicalClass(cell(row, positions[ParentClass])), fnCanonicalClass(cell(row, positions[ChildClass])),
		            cell(row, positions[ParentTag]), cell(row, positions[ChildTag]),
		            if positions[Excluded] < 0 then null else List.Contains({"true", "yes", "1", "y"}, Text.Lower(cell(row, positions[Excluded]), "en-US"))
		        }),
		        table = #table(
		            type table [Parent = text, Type = text, Child = text, ParentClass = text, ChildClass = text, ParentTag = text, ChildTag = text, Excluded = nullable logical],
		            rows)
		    in
		        Table.SelectRows(table, each [Parent] <> "" and [Child] <> "")
	queryGroup: Reading

/// The Solusi contract file, one row per contract (src/core/sources/contracts/contract-reports.ts, readSolusiFile). Every sheet with the contract number column is read; row 2 holds labels and is left out. A sheet with a termination date column holds the contracts terminated in the last 7 days; a contract on both tabs counts once, as terminated.
expression fnReadSolusiFile =
		(read as record) as table =>
		    let
		        config = ReferenceFiles[#"contract-reports"][solusi],
		        columns = config[columns],
		        names = Record.FieldNames(columns),
		        specs = List.Transform(names, (name) => [column = name, any = Record.Field(columns, name)]),
		        labels = List.Transform(config[labelRow], (label) => fnNameKey(label, "")),
		        sheetRows = (sheet as record) as table =>
		            let
		                picked = fnPickColumns(sheet, specs),
		                kind = if List.Contains(picked[Found], "terminated") then "terminated" else "active",
		                rows = Table.SelectRows(picked[Table], each [number] <> "" and not List.Contains(labels, fnNameKey([number], "")))
		            in
		                if List.Contains(picked[Found], "number") then Table.AddColumn(rows, "sheet", each kind, type text) else null,
		        tables = List.RemoveNulls(List.Transform(read[Sheets], sheetRows)),
		        all = if List.IsEmpty(tables) then #table(names & {"sheet"}, {}) else Table.Combine(tables),
		        indexed = Table.AddIndexColumn(all, "Row", 0, 1, Int64.Type),
		        withKey = Table.AddColumn(indexed, "NumberKey", each Text.Lower([number], "en-US"), type text),
		        // The last terminated row of a number wins, else the first row of the number. It keeps the place of the first row
		        // of its number, as a JavaScript Map does in src/core.
		        ranked = Table.AddColumn(withKey, "Rank", each if [sheet] = "terminated" then 1000000000 + [Row] else -[Row], type number),
		        best = Table.Combine(Table.Group(ranked, {"NumberKey"}, {{"Rows", (group) => let place = List.Min(group[Row]) in
		            Table.AddColumn(Table.FirstN(Table.Sort(group, {{"Rank", Order.Descending}}), 1), "Place", each place, Int64.Type)}})[Rows]),
		        sorted = Table.Sort(best, {{"Place", Order.Ascending}}),
		        dates = Table.TransformColumns(sorted, {{"start", fnParseDate, type nullable date}, {"end", fnParseDate, type nullable date}, {"terminated", fnParseDate, type nullable date}}),
		        renamed = Table.RenameColumns(dates, {
		            {"number", "Number"}, {"status", "Status"}, {"name", "Name"}, {"vendor", "Vendor"}, {"vendorNumber", "VendorNumber"},
		            {"category", "Category"}, {"start", "Start"}, {"end", "End"}, {"duration", "Duration"}, {"owner", "Owner"},
		            {"dailyResponsible", "DailyResponsible"}, {"procurementPartner", "ProcurementPartner"}, {"epoId", "EpoId"},
		            {"sheet", "Sheet"}, {"terminated", "Terminated"}})
		    in
		        Table.SelectColumns(renamed, {"Number", "Status", "Name", "Vendor", "VendorNumber", "Category", "Start", "End", "Duration",
		            "Owner", "DailyResponsible", "ProcurementPartner", "EpoId", "Sheet", "Terminated"})
	queryGroup: Reading

/// A report file as sheets. The format comes from the content (an .xlsx is a zip), never from the file name. A CSV file has one sheet; an .xlsx file has every sheet in workbook order. Headers and Rows are those of the first sheet. Lossless: the file keeps hidden characters (an .xlsx, or a CSV with a byte order mark or a hidden character in it), as src/core/reading/table.ts says it.
expression fnReadTable =
		(content as binary) as record =>
		    let
		        isZip = Binary.Length(content) >= 2 and Binary.ToList(Binary.Range(content, 0, 2)) = {80, 75},
		        hasBom = Binary.Length(content) >= 3 and Binary.ToList(Binary.Range(content, 0, 3)) = {239, 187, 191},
		        text = if isZip then "" else fnDecodeText(content),
		        hidden = List.Transform(ReadingRules[hiddenCharacters], (entry) => Character.FromNumber(entry[code])),
		        workbook = Excel.Workbook(content, false, true),
		        sheets =
		            if isZip then
		                List.Transform(Table.ToRecords(Table.SelectRows(workbook, each [Kind] = "Sheet")), (sheet) => fnSheet(sheet[Name], sheet[Data]))
		            else
		                {fnSheetFromCsv(text)},
		        first = if List.IsEmpty(sheets) then [Name = "", RawHeaders = {}, Headers = {}, Rows = #table({}, {})] else sheets{0}
		    in
		        [Format = if isZip then "xlsx" else "csv", Sheets = sheets, Headers = first[Headers], RawHeaders = first[RawHeaders], Rows = first[Rows],
		            Lossless = isZip or hasBom or List.AnyTrue(List.Transform(hidden, (char) => Text.Contains(text, char)))]
	queryGroup: Reading

/// Who a finding goes to (src/core/messages/messages.ts, recipientOf; build B7): [Name, Email]. The EPO inventory owner, the Procurement mailbox and the people of a team come from the team settings (MessageSettings); everybody else is the contact of the finding (fnFacts). The address of a team is its people's addresses, "a@…; b@…" (teamAddresses: no space, an @ with text before and after it); "" when the settings name nobody.
expression fnRecipient =
		(fact as record, settings as record) as record =>
		    let
		        contactId = fact[ContactId],
		        isAddress = (value as text) as logical =>
		            value <> "" and Text.Remove(value, {" ", "#(tab)", "#(cr)", "#(lf)"}) = value
		            and List.AnyTrue(List.Transform(Text.PositionOf(value, "@", Occurrence.All), (at) => at >= 1 and at <= Text.Length(value) - 2)),
		        textOf = (value as any) as text => if value = null then "" else value
		    in
		        if contactId = ReadingRules[epoOwner][id] then [Name = if settings[EpoOwnerName] <> "" then settings[EpoOwnerName] else ReadingRules[epoOwner][name], Email = settings[EpoOwnerEmail]]
		        else if contactId = ReadingRules[procurement][id] then [Name = if settings[ProcurementName] <> "" then settings[ProcurementName] else "Procurement", Email = settings[ProcurementEmail]]
		        else if Text.StartsWith(contactId, "team:") then
		            let team = Record.FieldOrDefault(settings[Teams], Text.Middle(contactId, 5), null) in
		            [
		                Name = if team <> null and Text.Trim(team[Name]) <> "" then Text.Trim(team[Name]) else textOf(fact[ContactName]),
		                Email = if team = null then "" else Text.Combine(List.Select(List.Transform(team[People], (person) => Text.Trim(person[Email])), isAddress), "; ")
		            ]
		        else [Name = textOf(fact[ContactName]), Email = textOf(fact[ContactEmail])]
	queryGroup: Reading

/// A reference file by the name a check file gives it ("reference/criticality"); null when it is not there.
expression fnReference =
		(name as nullable text) as any =>
		    if name = null or not Text.StartsWith(name, "reference/") then null
		    else Record.FieldOrDefault(ReferenceFiles, Text.Middle(name, 10), null)
	queryGroup: Reading

/// The relationship graph of a run (src/core/checks/detectors/relationship-detectors.ts, buildGraph): each end of a relationship is matched to a CI of the CI report by its name (identity first), then its class, its asset tag, and the live one; an end that matches no CI keeps its name and class. A node: [Key, Name, Cls, Ci, Retired, Environment], one per CI (every end that matches the CI is the same node); Cls is the class the rules use (a Service Instance with Platform ticked is a Platform), Environment is worked out only when a check reads it. Up and Down: for each node key, the live relationships above and below it (neither end Retired). NodeOf: the node of any CI of the report. Unmatched and Ambiguous: the ends that match no CI, or two CIs that nothing tells apart. `cis` are the CIs of fnCheckRun, with their normal forms (StatusKey, NameKey).
expression fnRelationshipGraph =
		(cis as list, relationships as list, model as record) as record =>
		    let
		        same = (a as text, b as text) as logical => fnNameKey(a, "") = fnNameKey(b, ""),
		        retiredWords = List.Buffer(List.Transform(model[retiredStatuses], (word) => fnNameKey(word, ""))),
		        isRetired = (ci as record) as logical => List.Contains(retiredWords, ci[StatusKey]),
		        ruleClass = (ci as record) as text => if ci[Class] = "service_instance" and ci[Platform] = true then "platform" else ci[Class],
		        nodeOf = (ci as record) as record =>
		            [Key = ci[Key], Name = ci[Name], Cls = ruleClass(ci), Ci = ci, Retired = isRetired(ci),
		                Environment = fnEnvironment(ci[Name], if ci[Environment] = null then "" else ci[Environment], model)],
		        // One node per CI, made once: every end of a relationship that matches the CI is this node, so its Environment
		        // is worked out once per CI, the first time a check reads it.
		        nodes = Record.FromList(List.Transform(cis, nodeOf), List.Transform(cis, (ci) => ci[Key])),
		        byIdentity = fnGroupBy(cis, (ci) => ci[IdentityKey]),
		        byName = fnGroupBy(cis, (ci) => ci[NameKey]),
		        // The node of an end, and whether two CIs that nothing tells apart could be it.
		        endOf = (name as text, className as text, tag as text) as record =>
		            let
		                first = Record.FieldOrDefault(byIdentity, fnNameKey(name, "?"), Record.FieldOrDefault(byName, fnNameKey(name, ""), {})),
		                sameClass = List.Select(first, (ci) => ci[Class] = className),
		                byClass = if List.Count(first) > 1 and className <> "" and not List.IsEmpty(sameClass) then sameClass else first,
		                sameTag = List.Select(byClass, (ci) => same(ci[AssetTag], tag)),
		                byTag = if List.Count(byClass) > 1 and tag <> "" and not List.IsEmpty(sameTag) then sameTag else byClass,
		                live = List.Select(byTag, (ci) => not isRetired(ci)),
		                found = if List.Count(byTag) > 1 and not List.IsEmpty(live) then live else byTag,
		                ci = if List.IsEmpty(found) then null else found{0}
		            in
		                if ci = null then [Node = [Key = "?" & fnNameKey(name, "?") & "|" & className, Name = name, Cls = className, Ci = null, Retired = false,
		                    Environment = fnEnvironment(name, "", model)], Ambiguous = false]
		                else [Node = Record.Field(nodes, ci[Key]), Ambiguous = List.Count(found) > 1],
		        edges = List.Buffer(List.Transform(relationships, (row) =>
		            let parent = endOf(row[Parent], row[ParentClass], row[ParentTag]), child = endOf(row[Child], row[ChildClass], row[ChildTag]) in
		            [Parent = parent[Node], Child = child[Node], Type = row[Type], Excluded = row[Excluded],
		                Ambiguous = (if parent[Ambiguous] then 1 else 0) + (if child[Ambiguous] then 1 else 0)])),
		        live = List.Buffer(List.Select(edges, (edge) => not edge[Parent][Retired] and not edge[Child][Retired]))
		    in
		        [
		            Edges = edges,
		            Up = fnGroupBy(live, (edge) => edge[Child][Key]),
		            Down = fnGroupBy(live, (edge) => edge[Parent][Key]),
		            NodeOf = (ci as record) as record => let node = Record.FieldOrDefault(nodes, ci[Key], null) in if node = null then nodeOf(ci) else node,
		            Unmatched = List.Sum({0} & List.Transform(edges, (edge) => (if edge[Parent][Ci] = null then 1 else 0) + (if edge[Child][Ci] = null then 1 else 0))),
		            Ambiguous = List.Sum({0} & List.Transform(edges, (edge) => edge[Ambiguous]))
		        ]
	queryGroup: Reading

/// The part RelationshipLinks of the table Run (D284), which the DAX table RelationshipLinks shows: the relationships of each CI of the newest CI report, from both ends, for the Case page: the CI above it (Parent) or below it (Child), the relationship type, the other CI's class and status, and whether the relationship counts (a Retired end does not; one excluded from calculation passes no criticality). From the relationship graph of the checks (fnRelationshipGraph), so a name is matched as the checks match it. `run` is CheckRun (null when no CI report is loaded).
expression fnRelationshipLinksPart =
		(run as nullable record) as table =>
		    let
		        graph = if run = null then null else run[Graph],
		        edges = if graph = null then {} else graph[Edges],
		        rowOf = (edge as record, position as number, mine as record, other as record, relation as text) as list =>
		            {
		                mine[Key], relation, other[Name], fnClassWord(other[Cls]), if other[Ci] = null then "Not in the CI report" else other[Ci][Status], edge[Type],
		                if edge[Parent][Retired] or edge[Child][Retired] then "No: a Retired end" else "Yes",
		                if edge[Excluded] = true then "Yes" else "", position + 1
		            },
		        rows = List.Combine(List.Transform(List.Positions(edges), (position) =>
		            let edge = edges{position} in
		            (if edge[Parent][Ci] = null then {} else {rowOf(edge, position, edge[Parent], edge[Child], "Child")})
		            & (if edge[Child][Ci] = null then {} else {rowOf(edge, position, edge[Child], edge[Parent], "Parent")})))
		    in
		        #table(
		            type table [CiKey = text, Relation = text, Other = text, OtherClass = text, OtherStatus = text, Type = text, Counts = text, Excluded = text, Order = Int64.Type],
		            rows)
	queryGroup: Reading

/// The text with the first `old` replaced by `new` (String.replace of JavaScript with a text, not a pattern).
expression fnReplaceFirst =
		(text as text, old as text, new as text) as text =>
		    let at = Text.PositionOf(text, old) in
		    if old = "" or at < 0 then text else Text.Start(text, at) & new & Text.Middle(text, at + Text.Length(old))
	queryGroup: Reading

/// The text with the first match of a pattern replaced (String.replace of JavaScript with a regular expression, without "g"), for the patterns that end with "$" (see fnSearch).
expression fnReplacePattern =
		(pattern as text, flags as text, value as text, new as text) as text =>
		    let found = fnSearch(pattern, flags, value) in
		    if found[Index] < 0 then value else Text.Start(value, found[Index]) & new & Text.Middle(value, found[End])
	queryGroup: Reading

/// The part RepliesToRead of the table Run (D292), which the DAX table RepliesToRead shows (My day, My work): one line per reply that waits to be read, newest first (src/app/view/cases.ts, repliesToRead). A reply is read once a manager acted on one of its cases after it arrived (a status, a decision to stop following, a message); a case that is closed (Verified, Not followed up) lists none. FirstLine: the first line of the reply that is not a greeting ("Hi Ana,"). AssignedTo: who has its cases, for "mine first". Daily: one of its cases is on a daily card (My day counts only those, D182). `cases` is fnCases(CheckRun).
expression fnRepliesToReadPart =
		(cases as list) as table =>
		    let
		        later = fnKeySet(Table.SelectRows(ChecksRows, each [Priority] = "later")[CheckId]),
		        open = List.Select(cases, (item) => not item[Closed] and not List.IsEmpty(item[Replies])),
		        pairs = List.Combine(List.Transform(open, (item) => List.Transform(item[Replies], (reply) =>
		            [File = reply[Ref] & "|" & reply[Received], Reply = reply, Case = item, Read = Text.Start(reply[Received], 19) <= item[Acted]]))),
		        handled = fnKeySet(List.Transform(List.Select(pairs, (pair) => pair[Read]), (pair) => pair[File])),
		        waiting = List.Select(pairs, (pair) => not pair[Read] and not Record.HasFields(handled, pair[File])),
		        byFile = fnGroupBy(waiting, (pair) => pair[File]),
		        greeting = (line as text) as logical =>
		            let
		                lower = Text.Lower(line, "en-US"),
		                word = List.First(List.Select({"hello", "dear", "hi"}, (item) => Text.StartsWith(lower, item)
		                    and (Text.Length(lower) = Text.Length(item) or not List.Contains({"a".."z", "0".."9", "_"}, Text.At(lower, Text.Length(item))))), null),
		                rest = if word = null then "" else Text.Middle(lower, Text.Length(word)),
		                core = if Text.EndsWith(rest, "!") or Text.EndsWith(rest, ",") then Text.Start(rest, Text.Length(rest) - 1) else rest
		            in
		                word <> null and Text.Length(core) <= 40 and Text.Remove(core, {".", "?", "!"}) = core,
		        firstLine = (body as text) as text =>
		            let
		                lines = List.Select(List.Transform(Text.SplitAny(body, "#(cr)#(lf)"), Text.Trim), (line) => line <> ""),
		                kept = List.Select(lines, (line) => not greeting(line))
		            in
		                List.First(kept, List.First(lines, "")),
		        lines = List.Transform(Record.FieldNames(byFile), (file) =>
		            let
		                group = Record.Field(byFile, file),
		                reply = group{0}[Reply],
		                own = List.Transform(group, (pair) => pair[Case])
		            in
		                {
		                    file, reply[Ref], reply[From], DateTime.FromText(Text.Start(reply[Received], 19), [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"]), firstLine(reply[Body]),
		                    List.Count(own), List.Count(List.Distinct(List.Transform(own, (item) => item[CiKey]))),
		                    Text.Combine(List.Distinct(List.Select(List.Transform(own, (item) => item[AssignedTo]), (name) => name <> "")), ", "),
		                    Text.Combine(List.Distinct(List.Transform(own, (item) => item[CheckId])), ", "),
		                    List.AnyTrue(List.Transform(own, (item) => not Record.HasFields(later, item[CheckId])))
		                })
		    in
		        Table.Sort(
		            #table(type table [File = text, Ref = text, From = text, Received = datetime, FirstLine = text, Cases = Int64.Type, CIs = Int64.Type, AssignedTo = text, Checks = text, Daily = logical], lines),
		            {{"Received", Order.Descending}, {"File", Order.Ascending}})
	queryGroup: Reading

/// The date of a report: the yyyy-MM-dd_ at the start of its file name (flow F1 writes it), else the day the file was last changed (D12, src/core/memory/finder.ts). One difference: a date that does not exist (2026-02-30_) is kept as text by the app, but Power BI cannot hold it, so the day the file changed is used.
expression fnReportDate =
		(name as text, modified as nullable datetime) as nullable date =>
		    let
		        digits = (from as number, count as number) as logical =>
		            List.AllTrue(List.Transform(Text.ToList(Text.Middle(name, from, count)), (char) => char >= "0" and char <= "9")),
		        shaped = Text.Length(name) >= 11 and digits(0, 4) and Text.Middle(name, 4, 1) = "-" and digits(5, 2)
		            and Text.Middle(name, 7, 1) = "-" and digits(8, 2) and Text.Middle(name, 10, 1) = "_",
		        month = if shaped then Number.From(Text.Middle(name, 5, 2)) else 0,
		        day = if shaped then Number.From(Text.Middle(name, 8, 2)) else 0,
		        fromName = if month >= 1 and month <= 12 and day >= 1 and day <= 31
		            then try #date(Number.From(Text.Start(name, 4)), month, day) otherwise null else null
		    in
		        if fromName <> null then fromName else if modified = null then null else DateTime.Date(modified)
	queryGroup: Reading

/// The type of a report from its header row: the type whose needed columns are all there; the one with the most needed columns wins when two fit (src/core/reading/table.ts, recogniseAmong). No type: Kind is "" and Message says what each type is missing.
expression fnReportType =
		(headers as list) as record =>
		    let
		        types = ReadingRules[reportTypes],
		        missingOf = (candidate as record) as list =>
		            List.Transform(List.Select(candidate[needs], (need) => not List.ContainsAny(headers, need[any])), (need) => need[label]),
		        withMissing = List.Transform(types, (candidate) => candidate & [missing = missingOf(candidate)]),
		        fitting = List.Select(withMissing, (candidate) => List.IsEmpty(candidate[missing])),
		        most = List.Max(List.Transform(fitting, (candidate) => List.Count(candidate[needs])), 0),
		        best = List.First(List.Select(fitting, (candidate) => List.Count(candidate[needs]) = most), null),
		        parts = List.Transform(withMissing, (candidate) =>
		            "a " & candidate[label] & " needs " & Text.Combine(List.Transform(candidate[needs], (need) => need[label]), ", ")
		            & " (missing: " & Text.Combine(candidate[missing], ", ") & ")")
		    in
		        if best <> null then [Kind = best[kind], Label = best[label], Message = ""]
		        else [Kind = "", Label = "Not read", Message = "This file is not a report the Workbench knows: " & Text.Combine(parts, "; ") & "."]
	queryGroup: Reading

/// The sample a new lifecycle review would draw from the newest CI report (D306; the part "review" of reference/lifecycle): `underRetirement` CIs in the status Under retirement and `sample` CIs of the other CIs, only of the classes EPO holds, never a Retired CI. The chance is a hash (fnReviewHash) of the report date, the file and the CI key: the same report always proposes the same CIs. Each part is in the order of class, name and key; the sample by chance first. The Power App SACM audit saves this proposal in the journal when a manager presses New review, so the review keeps its CIs when later reports change. null with no CI report or no part "review". The answer key is drawSample in tools/powerbi/review.ts.
expression fnReviewDraw =
		(run as nullable record) as nullable record =>
		    let
		        reference = fnReference("reference/lifecycle"),
		        config = if reference = null then null else Record.FieldOrDefault(reference, "review", null)
		    in
		        if run = null or config = null or not Value.Is(Record.FieldOrDefault(config, "classes", null), type list) then null
		        else
		            let
		                retired = List.Buffer(List.Transform(config[retiredStatuses], (word) => fnNameKey(word, ""))),
		                leaving = fnNameKey(config[underRetirementStatus], ""),
		                classes = List.Buffer(config[classes]),
		                start = fnReviewHash(2166136261, Date.ToText(run[Date], [Format = "yyyy-MM-dd", Culture = "en-US"]) & "|" & run[FileName] & "|"),
		                pool = List.Buffer(List.Transform(
		                    List.Select(run[Cis], (ci) => List.Contains(classes, ci[Class]) and not List.Contains(retired, ci[StatusKey])),
		                    (ci) => [Ci = ci, Rank = fnReviewHash(start, ci[Key])])),
		                byRank = (a as record, b as record) as number => let first = Value.Compare(a[Rank], b[Rank]) in if first <> 0 then first else Comparer.Ordinal(a[Ci][Key], b[Ci][Key]),
		                item = (group as text) as function => (entry as record) as record =>
		                    let ci = entry[Ci] in
		                    [CiKey = ci[Key], Name = ci[Name], ClassLabel = if ci[SourceClass] <> "" then ci[SourceClass] else ci[Class], ClassName = ci[Class],
		                        Status = ci[Status], EpoId = ci[AssetTag], Group = group],
		                byName = (a as record, b as record) as number =>
		                    let
		                        label = Comparer.Ordinal(a[ClassLabel], b[ClassLabel]),
		                        name = Comparer.Ordinal(a[Name], b[Name])
		                    in
		                        if label <> 0 then label else if name <> 0 then name else Comparer.Ordinal(a[CiKey], b[CiKey]),
		                pick = (entries as list, count as number, group as text) as list =>
		                    List.Sort(List.Transform(List.FirstN(List.Sort(entries, byRank), count), item(group)), byName),
		                under = pick(List.Select(pool, (entry) => entry[Ci][StatusKey] = leaving), config[underRetirement], "under-retirement"),
		                sample = pick(List.Select(pool, (entry) => entry[Ci][StatusKey] <> leaving), config[sample], "sample")
		            in
		                [Report = run[FileName], ReportDate = run[Date], Items = List.Buffer(sample & under)]
	queryGroup: Reading

/// The hash of the lifecycle review's draw (D306): FNV-1a of 32 bits over the characters of `text`, from the hash `start` (2166136261 for a new text), so the hash of a fixed beginning is worked out once and each CI key goes on from it. The same as fnvHash in tools/powerbi/review.ts. Every step stays below 2^53, so it is exact in Power Query's numbers: h × 16777619 mod 2^32 = ((h mod 256) × 2^24 + h × 403) mod 2^32.
expression fnReviewHash =
		(start as number, text as text) as number =>
		    List.Accumulate(Text.ToList(text), start, (hash, character) =>
		        let mixed = Number.BitwiseXor(hash, Character.ToNumber(character)) in
		        Number.Mod(Number.Mod(mixed, 256) * 16777216 + mixed * 403, 4294967296))
	queryGroup: Reading

/// The part ReviewLines of the table Run (D306), which the DAX table ReviewLines shows: one line per CI of each lifecycle review of the journal (LifecycleReviews), with its mark and the follow-up of the case it opened, as the evidence file of the HTML app holds it (evidenceRows of src/core/audit/lifecycle-review.ts); then the CIs a new review would draw from the newest report (Review "next", fnReviewDraw), which the Power App SACM audit saves on New review. Status in EPO: the EPO systems report of the newest CI report. Agrees: not marked yet, and EPO shows the same status (the app's "Mark N same"). Case status: the status of the case a "Not the same" opened; Verified once the newest report shows the CI in another status. EpoDate: the date of that EPO report. `run` is the run with the review lines (fnWithReviews), `cases` its cases (fnCases).
expression fnReviewLinesPart =
		(run as nullable record, cases as list) as table =>
		    let
		        reference = fnReference("reference/lifecycle"),
		        config = if reference = null then null else Record.FieldOrDefault(reference, "review", null),
		        results = if config = null then {} else config[results],
		        opens = if config = null then {} else config[opensCase],
		        labelOf = (id as text) as text => let found = List.First(List.Select(results, (result) => result[id] = id), null) in if found = null then id else found[label],
		        groupWord = [sample = "Sample by chance", #"under-retirement" = "Under retirement"],
		        systems = if run = null or run[Epo] = null then [] else
		            let grouped = fnGroupBy(List.Select(run[Epo][Systems], (system) => system[EpoId] <> ""), (system) => Text.Lower(Text.Trim(system[EpoId]), "en-US")) in
		            Record.FromList(List.Transform(Record.FieldValues(grouped), List.Last), Record.FieldNames(grouped)),
		        // The date of the EPO systems report the statuses come from: the note of "Mark N same" names it.
		        epoDate = if run = null or run[Epo] = null then null else run[Epo][Date],
		        epoOf = (epoId as text) as record =>
		            let system = if epoId = "" then null else Record.FieldOrDefault(systems, Text.Lower(Text.Trim(epoId), "en-US"), null) in
		            if system = null then [Status = "", Words = ""] else [Status = system[Status], Words = if system[Status] <> "" then system[StatusWord] & " (" & system[Status] & ")" else system[StatusWord]],
		        casesByKey = Record.FromList(cases, List.Transform(cases, (item) => item[Key])),
		        cis = if run = null then [] else Record.FromList(run[Cis], List.Transform(run[Cis], (ci) => ci[Key])),
		        longDate = (iso as text) as text => if Text.Length(iso) < 10 then iso else fnLongDate(Date.FromText(Text.Start(iso, 10), [Format = "yyyy-MM-dd", Culture = "en-US"])),
		        dateOf = (iso as text) as nullable date => if Text.Length(iso) < 10 then null else Date.FromText(Text.Start(iso, 10), [Format = "yyyy-MM-dd", Culture = "en-US"]),
		        reviews = LifecycleReviews,
		        newest = List.Last(reviews, null),
		        line = (review as record, item as record, next as logical) as list =>
		            let
		                mark = if next then null else Record.FieldOrDefault(review[Marks], item[CiKey], null),
		                epo = epoOf(item[EpoId]),
		                opened = mark <> null and List.Contains(opens, mark[Result]),
		                found = if opened then Record.FieldOrDefault(casesByKey, "LIFECYCLE-REVIEW:" & item[CiKey] & ":status", null) else null,
		                ci = Record.FieldOrDefault(cis, item[CiKey], null),
		                status = if found <> null then found[Status]
		                    else if opened and ci <> null and ci[StatusKey] <> fnNameKey(item[Status], "") then "Verified" else "",
		                sent = if found = null then {} else List.Select(found[MessageEvents], (event) => event[At] >= mark[At]),
		                dates = (kind as text) as list => List.Transform(List.Select(sent, (event) => (if event[Kind] = "" then "first" else event[Kind]) = kind), (event) => Text.Start(event[At], 10))
		            in
		                {
		                    if next then "next" else review[Id], next, not next and newest <> null and review[Id] = newest[Id], dateOf(review[Date]),
		                    if next then "The next review (not started)" else "Lifecycle review of " & longDate(review[Date]),
		                    review[Report], dateOf(review[ReportDate]), item[Group], Record.FieldOrDefault(groupWord, item[Group], item[Group]),
		                    item[CiKey], item[Name], item[ClassLabel], item[ClassName], item[EpoId], item[Status], epo[Status], epo[Words],
		                    mark = null and epo[Status] <> "" and fnNameKey(epo[Status], "") = fnNameKey(item[Status], ""),
		                    if mark = null then "" else mark[Result], if mark = null then "Not checked yet" else labelOf(mark[Result]),
		                    if mark = null then "" else mark[Note], if mark = null then "" else mark[ByName], if mark = null then null else dateOf(mark[At]),
		                    status, List.First(dates("first"), ""), Text.Combine(dates("reminder"), " "), Text.Combine(dates("escalation"), " "), epoDate
		                },
		        draw = fnReviewDraw(run),
		        nextReview = if draw = null then null else [Id = "next", Date = "", Report = draw[Report], ReportDate = Date.ToText(draw[ReportDate], [Format = "yyyy-MM-dd", Culture = "en-US"]), Marks = []],
		        lines = List.Buffer(List.Combine(List.Transform(List.Reverse(reviews), (review) => List.Transform(review[Items], (item) => line(review, item, false))))
		            & (if draw = null then {} else List.Transform(draw[Items], (item) => line(nextReview, item, true)))),
		        numbered = List.Transform(List.Positions(lines), (at) => lines{at} & {at + 1})
		    in
		        #table(
		            type table [Review = text, IsNext = logical, IsCurrent = logical, ReviewDate = nullable date, ReviewLabel = text, Report = text, ReportDate = nullable date,
		                Group = text, GroupLabel = text, CiKey = text, CiName = text, ClassLabel = text, ClassName = text, EpoId = text, Status = text,
		                EpoStatus = text, EpoStatusWords = text, Agrees = logical, Result = text, ResultLabel = text, Note = text, CheckedBy = text, CheckedOn = nullable date,
		                CaseStatus = text, FirstMessage = text, Reminders = text, EscalatedOn = text, EpoDate = nullable date, Order = Int64.Type],
		            numbered)
	queryGroup: Reading

/// The part Runs of the table HistoryRun (D290), which the DAX table Runs shows: one row per CI report date, with the file, its CIs and the other reports its checks used (for each type the newest report dated on or before it, as the HTML app pairs them). `run` is a run of fnCheckRun.
expression fnRunsPart =
		(run as record) as table =>
		    #table(
		        type table [ReportDate = date, FileName = text, CIs = Int64.Type, RelationshipFile = text, EpoFile = text, SolusiFile = text, ContractFile = text],
		        {{run[Date], run[FileName], List.Count(run[Cis]), run[Paired][Relationship], run[Paired][Epo], run[Paired][Solusi], run[Paired][Contract]}})
	queryGroup: Reading

/// The same person (relationship-detectors.ts, samePerson): user ID first, then email, then (only when neither is known) the display name. Two empty roles are the same. `a` and `b` are records of fnPerson, or null.
expression fnSamePerson =
		(a as nullable record, b as nullable record) as logical =>
		    let
		        filled = (person as nullable record) as logical => person <> null and (person[Name] <> "" or person[Email] <> "" or person[UserId] <> ""),
		        lower = (text as text) as text => Text.Lower(text, "en-US")
		    in
		        if not filled(a) or not filled(b) then filled(a) = filled(b)
		        else if a[UserId] <> "" and b[UserId] <> "" then lower(a[UserId]) = lower(b[UserId])
		        else if a[Email] <> "" and b[Email] <> "" then lower(a[Email]) = lower(b[Email])
		        else fnNameKey(a[Name], "") = fnNameKey(b[Name], "")
	queryGroup: Reading

/// The CIs of a check's scope as a record with one field per CI key, to look a key up fast (fnShownOn).
expression fnScopeKeys = (inScope as list) as record => Record.FromList(List.Repeat({true}, List.Count(inScope)), List.Transform(inScope, (ci) => ci[Key]))
	queryGroup: Reading

/// The part SelfCheck of the table Run (D284), which the DAX table SelfCheck shows: per check, what the HTML app's logic finds on the samples (tests/recorded/cards.json, packed by the generator as ExpectedResult) and what this model finds on the newest report (§9.4 of the plan). A check matches when it is built and gives the same state, the same tested flag, the same CIs and the same finding keys in each state. The page shows it only for the sample data. `findings` and `testedPart` are the parts Findings and Tested already made, so the checks are not run again.
expression fnSelfCheckPart =
		(findings as table, testedPart as table) as table =>
		    let
		        expected = Json.Document(ExpectedResult)[cards],
		        words = ReadingRules[stateWords],
		        built = Table.SelectRows(ChecksRows, each [Built])[CheckId],
		        tested = List.Buffer(testedPart[CheckId]),
		        sorted = (keys as list) as list => List.Sort(keys, Comparer.Ordinal),
		        // The findings by check and state, grouped once (not selected again for each card and state).
		        byCard = fnGroupBy(Table.ToRecords(findings), (finding) => finding[CheckId] & "|" & finding[State]),
		        of = (id as text, state as text) as list => Record.FieldOrDefault(byCard, id & "|" & state, {}),
		        keysOf = (id as text, state as text) as list => sorted(List.Transform(of(id, state), (finding) => finding[Key])),
		        strip = (cases as list) as list => sorted(List.Transform(cases, (entry) => if Text.StartsWith(entry, "case ") then Text.Middle(entry, 5) else entry)),
		        states = {"open", "review", "waiting", "known"},
		        row = (card as record) as list =>
		            let
		                id = card[id],
		                isBuilt = List.Contains(built, id),
		                found = List.Buffer(List.Transform(states, (state) => List.Buffer(keysOf(id, state)))),
		                want = List.Buffer(List.Transform(states, (state) => List.Buffer(strip(Record.Field(card, state))))),
		                isTested = List.Contains(tested, id),
		                shown = if not List.IsEmpty(found{0}) then "open" else "review",
		                cis = List.Count(List.Distinct(List.Transform(of(id, shown), (finding) => finding[CiKey]))),
		                light = if not isTested then "grey" else if not List.IsEmpty(found{0}) then "red" else if not List.IsEmpty(found{1}) then "review" else "green",
		                differ = List.Select(List.Positions(states), (position) => found{position} <> want{position}),
		                keyWhy = List.Transform(differ, (position) =>
		                    let
		                        missing = List.Difference(want{position}, found{position}),
		                        extra = List.Difference(found{position}, want{position}),
		                        show = (keys as list) as text => Text.Combine(List.FirstN(keys, 3), ", ") & (if List.Count(keys) > 3 then " and " & Text.From(List.Count(keys) - 3) & " more" else "")
		                    in
		                        {"To solve", "To check", "Waiting", "Known"}{position} & ": "
		                            & Text.Combine(List.Select({if List.IsEmpty(missing) then "" else "missing " & show(missing), if List.IsEmpty(extra) then "" else "not expected " & show(extra)}, (text) => text <> ""), "; ")),
		                why = List.Select({
		                    if light <> card[light] then "Expected " & Record.FieldOrDefault(words, card[light], card[light]) & ", found " & Record.FieldOrDefault(words, light, light) & "." else "",
		                    if isTested <> card[tested] then (if card[tested] then "Expected tested, found not tested." else "Expected not tested, found tested.") else "",
		                    if cis <> card[cis] then "Expected " & Text.From(card[cis]) & " CIs, found " & Text.From(cis) & "." else ""
		                } & List.Transform(keyWhy, (text) => text & "."), (text) => text <> ""),
		                match = isBuilt and List.IsEmpty(why)
		            in
		                {
		                    id, Record.FieldOrDefault(words, card[light], card[light]), card[tested],
		                    List.Count(want{0}), List.Count(want{1}), List.Count(want{2}), List.Count(want{3}), card[cis],
		                    if isBuilt then "Built" else "Not built",
		                    if isBuilt then Record.FieldOrDefault(words, light, light) else "", isBuilt and isTested,
		                    if isBuilt then List.Count(found{0}) else 0, if isBuilt then List.Count(found{1}) else 0,
		                    if isBuilt then List.Count(found{2}) else 0, if isBuilt then List.Count(found{3}) else 0, if isBuilt then cis else 0,
		                    match,
		                    if not isBuilt then "The check is not built in the Power BI version yet." else if match then "Same result." else Text.Combine(why, " ")
		                }
		    in
		        #table(
		            type table [CheckId = text, ExpectedState = text, ExpectedTested = logical, ExpectedToSolve = Int64.Type, ExpectedToCheck = Int64.Type,
		                ExpectedWaiting = Int64.Type, ExpectedKnown = Int64.Type, ExpectedCis = Int64.Type, Found = text, FoundState = text, FoundTested = logical,
		                FoundToSolve = Int64.Type, FoundToCheck = Int64.Type, FoundWaiting = Int64.Type, FoundKnown = Int64.Type, FoundCis = Int64.Type,
		                Match = logical, Why = text],
		            List.Transform(expected, row))
	queryGroup: Reading

/// The ServiceNow address as typed, made safe (src/core/cases/record-search.ts, serviceNowAddress): "https://" and the host only, in lower case; "" when it is not such a link, so no link is built.
expression fnServiceNowAddress =
		(typed as text) as text =>
		    let
		        text = Text.Trim(typed),
		        lower = Text.Lower(text, "en-US"),
		        rest = if Text.StartsWith(lower, "https://") then Text.Middle(text, 8) else "",
		        host = Text.Lower(List.First(Text.SplitAny(rest, "/?#"), ""), "en-US"),
		        name = Text.BeforeDelimiter(host, ":"),
		        port = if Text.Contains(host, ":") then Text.AfterDelimiter(host, ":") else null,
		        allowed = (value as text, chars as text) as logical => List.AllTrue(List.Transform(Text.ToList(value), (char) => Text.Contains(chars, char)))
		    in
		        if name = "" or not allowed(name, "abcdefghijklmnopqrstuvwxyz0123456789.-") or (port <> null and (port = "" or not allowed(port, "0123456789"))) then ""
		        else "https://" & host
	queryGroup: Reading

/// The link that opens the record of a finding in ServiceNow (src/core/cases/record-search.ts, recordSearch, D244): a list of the table that holds it, filtered on its name. A fix on relationships: the relationships between the two CIs, both ways. A contract: the contract table, by its number. "" without an address. The report only builds the link; it never writes to ServiceNow.
expression fnServiceNowLink =
		(address as text, ciName as text, className as text, relatedTo as text) as text =>
		    let
		        // As JavaScript's encodeURIComponent: Uri.EscapeDataString also escapes ! ' ( ) *, which it leaves.
		        encode = (query as text) as text => List.Accumulate({{"%21", "!"}, {"%27", "'"}, {"%28", "("}, {"%29", ")"}, {"%2A", "*"}}, Uri.EscapeDataString(query),
		            (text, pair) => Text.Replace(text, pair{0}, pair{1})),
		        list = (table as text, query as text) as text => address & "/" & table & "_list.do?sysparm_query=" & encode(query),
		        number = Text.Trim(Text.BeforeDelimiter(ciName, ":"))
		    in
		        if address = "" then ""
		        else if className = "contract" then list("ast_contract", "vendor_contract=" & number & "^ORnumber=" & number)
		        else if relatedTo <> "" then list("cmdb_rel_ci", "parent.name=" & ciName & "^child.name=" & relatedTo & "^NQparent.name=" & relatedTo & "^child.name=" & ciName)
		        else list("cmdb_ci", "name=" & ciName)
	queryGroup: Reading

/// Share out (D24, build B7; src/core/team/team.ts, shareOut): the manager each free group of a card goes to, as a record case key → name. A group is the cases of one check that go to one person by one route, to solve (groupCases); it is free when none of its open cases is assigned. On a SACM fix list a group is a record (a CI), sized by its lines. The groups of each card go out together: the biggest first (by its open CIs, then by its key), each to the active member of the list SACM Team with the fewest CIs so far (the first of the list when equal). Fewer than two active members: nobody (the Power App says to add colleagues first). `lines`: the cases of fnCases, before this column.
expression fnShareOut =
		(lines as list) as record =>
		    let
		        rows = Table.ToRecords(fnStateList("team")),
		        members = List.Buffer(List.Transform(List.Select(rows, (row) => not List.Contains({"no", "false", "0"}, Text.Lower(Text.Trim(row[Active]), "en-US"))), (row) => row[Title])),
		        compare = Comparer.FromCulture("en-US"),
		        open = List.Select(lines, (item) => item[InLatest] and item[State] = "open"),
		        contactOf = (fact as record) as text =>
		            if fact[ContactId] <> "" then fact[ContactId] else if Text.Lower(fact[ContactEmail], "en-US") <> "" then Text.Lower(fact[ContactEmail], "en-US") else "nobody",
		        byCard = fnGroupBy(open, (item) => item[CheckId]),
		        card = (items as list) as list =>
		            let
		                book = Record.FieldOrDefault(CheckPlaybooks, items{0}[CheckId], [Kind = "", AskWhenUnsure = ""]),
		                // A SACM fix list (FixListCard, ShareRecords): its records (one CI each) that SACM fixes itself, by their
		                // lines still to mark; free when no line not closed has anybody. Without such lines: the lines
		                // handed to the owner, by group, as on an owners card.
		                fixOnes = if book[Kind] = "fix" then List.Select(items, (item) => not (book[AskWhenUnsure] <> "" and item[Askable])) else {},
		                records = List.Transform(Record.FieldValues(fnGroupBy(fixOnes, (item) => item[CiKey])), (rows) =>
		                    let
		                        live = List.Select(rows, (item) => not item[Closed]),
		                        toMark = List.Select(live, (item) => item[Status] <> "Fixed")
		                    in
		                        [Key = rows{0}[CiKey], Open = toMark, Size = List.Count(toMark), Taken = List.AnyTrue(List.Transform(live, (item) => item[AssignedTo] <> ""))]),
		                owned = if book[Kind] = "fix" then List.Select(items, (item) => item[Askable]) else items,
		                groups = Record.FieldValues(fnGroupBy(owned, (item) => item[CheckId] & "|" & item[Fact][Route] & "|" & contactOf(item[Fact]))),
		                keyed = List.Transform(groups, (rows) =>
		                    let fact = rows{0}[Fact], openOnes = List.Select(rows, (item) => not item[Closed]) in
		                    [Key = fact[CheckId] & "|" & fact[Route] & "|" & contactOf(fact), Open = openOnes, Size = List.Count(List.Distinct(List.Transform(openOnes, (item) => item[CiKey]))),
		                        Taken = List.AnyTrue(List.Transform(openOnes, (item) => item[AssignedTo] <> ""))]),
		                free = List.Select(if List.IsEmpty(fixOnes) then keyed else records, (group) => not List.IsEmpty(group[Open]) and not group[Taken]),
		                ordered = List.Buffer(List.Sort(free, (a, b) => let bySize = Value.Compare(b[Size], a[Size]) in if bySize <> 0 then bySize else compare(a[Key], b[Key]))),
		                count = List.Count(ordered),
		                // Each group to the member with the least so far: one step per group, carrying the CIs of each member
		                // (Load) and giving the name (no list grows step by step, which is slow in M).
		                names = if count = 0 then {} else List.Buffer(List.Skip(List.Generate(
		                    () => [At = -1, Load = List.Repeat({0}, List.Count(members)), Name = ""],
		                    (step) => step[At] < count,
		                    (step) =>
		                        let
		                            at = step[At] + 1,
		                            load = step[Load],
		                            best = List.PositionOf(load, List.Min(load))
		                        in
		                            if at >= count then [At = at, Load = load, Name = ""]
		                            else [At = at, Load = List.Buffer(List.ReplaceRange(load, best, 1, {load{best} + ordered{at}[Size]})), Name = members{best}],
		                    (step) => step[Name])))
		            in
		                List.Combine(List.Transform(List.Positions(ordered), (at) => List.Transform(ordered{at}[Open], (item) => {item[Key], names{at}}))),
		        pairs = if List.Count(members) < 2 then {} else List.Combine(List.Transform(Record.FieldValues(byCard), card))
		    in
		        Record.FromList(List.Transform(pairs, (pair) => pair{1}), List.Transform(pairs, (pair) => pair{0}))
	queryGroup: Reading

/// The files of the reports folder in SharePoint: FileName, Modified, Content. Only read when SourceMode is "SharePoint". SharePoint.Contents opens one folder, which is much faster than SharePoint.Files on a big team site.
expression fnSharePointFiles =
		() as table =>
		    let
		        site = SharePoint.Contents(SharePointSite, [ApiVersion = 15]),
		        parts = List.Select(Text.Split(ReportsFolder, "/"), each _ <> ""),
		        folder = List.Accumulate(parts, site, (node, part) => node{[Name = part]}[Content]),
		        // Only the files of the folder: a sub-folder (its Content is a table) is never read, so old reports moved
		        // into a sub-folder Archive leave the history (D336, README §4A).
		        files = Table.SelectRows(folder, each Value.Is([Content], type binary)),
		        selected = Table.SelectColumns(files, {"Name", "Date modified", "Content"}),
		        renamed = Table.RenameColumns(selected, {{"Name", "FileName"}, {"Date modified", "Modified"}})
		    in
		        Table.TransformColumnTypes(renamed, {{"FileName", type text}, {"Modified", type nullable datetime}, {"Content", type binary}})
	queryGroup: Reading

/// One sheet as the readers use it: the normalised headers, the headers as written, and the rows after the header row as text (Column1 ... ColumnN). Rows where every cell is empty are left out, as the HTML app does. `isText`: every cell is text already, or null for a missing cell (a CSV), so null becomes "" and no cell goes through fnCellText (an .xlsx does). A row is empty when its cells joined trim to "": the same as every cell trimming to "", in one call per row.
expression fnSheet =
		(name as text, data as table, optional isText as nullable logical) as record =>
		    let
		        columns = Table.ColumnNames(data),
		        asText =
		            if isText = true then Table.ReplaceValue(data, null, "", Replacer.ReplaceValue, columns)
		            else Table.TransformColumns(data, List.Transform(columns, (column) => {column, fnCellText, type text})),
		        rows = Table.SelectRows(asText, each Text.Trim(Text.Combine(Record.FieldValues(_))) <> ""),
		        header = if Table.IsEmpty(rows) then {} else Record.FieldValues(rows{0}),
		        body = Table.Buffer(Table.Skip(rows, 1))
		    in
		        [Name = name, RawHeaders = header, Headers = List.Transform(header, fnNormaliseHeader), Rows = body]
	queryGroup: Reading

/// A CSV text as one sheet. The separator is found on the header line (comma, semicolon or tab; text in quotes does not count), as src/core/reading/csv.ts does.
expression fnSheetFromCsv =
		(text as text) as record =>
		    let
		        firstLine = Text.BeforeDelimiter(Text.Replace(text, "#(cr)", "#(lf)"), "#(lf)"),
		        unquoted = Text.Combine(List.Alternate(Text.Split(firstLine, """"), 1, 1, 1)),
		        candidates = {",", ";", "#(tab)"},
		        counts = List.Transform(candidates, (candidate) => List.Count(Text.Split(unquoted, candidate)) - 1),
		        best = List.Max(counts),
		        delimiter = if best = 0 then "," else candidates{List.PositionOf(counts, best)},
		        width = Table.ColumnCount(Csv.Document(firstLine, [Delimiter = delimiter, QuoteStyle = QuoteStyle.Csv])),
		        table = Csv.Document(text, [Delimiter = delimiter, Columns = width, QuoteStyle = QuoteStyle.Csv, ExtraValues = ExtraValues.Ignore])
		    in
		        fnSheet("", table, true)
	queryGroup: Reading

/// The CI a finding about a relationship is shown on (relationship-detectors.ts, shownOn): the parent when it is in the scope of the check, else the child; null when neither is. `scope`: a record with a field per CI key in scope. Returns [Ci, Other] (Other: the node at the other end).
expression fnShownOn =
		(edge as record, scope as record) as nullable record =>
		    if edge[Parent][Ci] <> null and Record.HasFields(scope, edge[Parent][Ci][Key]) then [Ci = edge[Parent][Ci], Other = edge[Child]]
		    else if edge[Child][Ci] <> null and Record.HasFields(scope, edge[Child][Ci][Key]) then [Ci = edge[Child][Ci], Other = edge[Parent]]
		    else null
	queryGroup: Reading

/// The text with every run of two or more spaces as one space (the fix of a name with two spaces in a row).
expression fnSingleSpaces =
		(value as text) as text =>
		    let
		        parts = Text.Split(value, " "),
		        // A run of n spaces gives n - 1 empty parts between two words; keep one space for each run.
		        kept = List.Accumulate(List.Positions(parts), {}, (out, at) => if at > 0 and parts{at} = "" and at < List.Count(parts) - 1 then out else out & {parts{at}})
		    in
		        Text.Combine(kept, " ")
	queryGroup: Reading

/// The names of nodes, sorted, joined with ", " (src/core/checks/detectors/relationship-detectors.ts, names): a name two nodes share is listed twice, as there.
expression fnSortedNames = (nodes as list) as text => Text.Combine(List.Sort(List.Transform(nodes, (node) => node[Name]), Comparer.FromCulture("en-US")), ", ")
	queryGroup: Reading

/// The stages of a case of the mapping backlog for a class (src/core/mapping/backlog.ts, stagesFor; D201): the steps of classStages in order (every stage when the class has none), each [Id, Label] with the word of stageWords for the class. `config` is the reference file mapping-backlog (null: no stages).
expression fnStages =
		(config as nullable record, cls as text) as list =>
		    if config = null then {}
		    else
		        let
		            ids = Record.FieldOrDefault(config[classStages], cls, null),
		            words = Record.FieldOrDefault(Record.FieldOrDefault(config, "stageWords", []), cls, []),
		            list = if ids = null then config[stages] else List.RemoveNulls(List.Transform(ids, (id) => List.First(List.Select(config[stages], (stage) => stage[id] = id), null)))
		        in
		            List.Transform(list, (stage) => [Id = stage[id], Label = Record.FieldOrDefault(words, stage[id], stage[label])])
	queryGroup: Reading

/// One list of the team's state (D291), by its id in StateLists (journal, replies, settings, team): its columns in the order of StateLists, every value as text, whatever the mode. A date and time is yyyy-MM-ddTHH:mm:ss, a date yyyy-MM-dd, a yes/no Yes or No, an empty cell "". Sample: the invented CSV file packed in StateFiles. SharePoint: the list of that name on the team site (SharePoint.Tables, plan §5). A list that is not there gives no rows, so a site without the lists still refreshes and every case is New. The rows come in the order they were added (the list's ID; the samples: the order of the file), so where the last row of a key counts (a setting, D308), it is the newest.
expression fnStateList =
		(id as text) as table =>
		    let
		        spec = Record.Field(StateLists, id),
		        columns = List.Buffer(spec[columns]),
		        sample = Table.SelectRows(StateFiles, each [FileName] = spec[file]),
		        sampleRows =
		            if Table.IsEmpty(sample) then {}
		            else
		                let
		                    csv = Csv.Document(Binary.FromText(sample{0}[Base64], BinaryEncoding.Base64), [Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		                    promoted = Table.PromoteHeaders(csv, [PromoteAllScalars = true])
		                in
		                    Table.ToRecords(promoted),
		        sharePointRows =
		            let
		                lists = SharePoint.Tables(SharePointSite, [Implementation = "2.0", ViewMode = "All"]),
		                found = Table.SelectRows(lists, each [Title] = spec[list]),
		                items = if Table.IsEmpty(found) then null else found{0}[Items]
		            in
		                if items = null then {} else Table.ToRecords(if Table.HasColumns(items, "ID") then Table.Sort(items, {{"ID", Order.Ascending}}) else items),
		        rows = if StateMode = "SharePoint" then sharePointRows else if StateMode = "None" then {} else sampleRows,
		        asText = (value as any) as text =>
		            if value = null then ""
		            else if value is datetimezone then DateTime.ToText(DateTimeZone.RemoveZone(DateTimeZone.ToLocal(value)), [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"])
		            else if value is datetime then DateTime.ToText(value, [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"])
		            else if value is date then Date.ToText(value, [Format = "yyyy-MM-dd", Culture = "en-US"])
		            else if value is logical then (if value then "Yes" else "No")
		            else if value is number then Number.ToText(value, "G", "en-US")
		            else if value is text then value
		            else "",
		        cells = List.Transform(rows, (row) => List.Transform(columns, (column) => asText(Record.FieldOrDefault(row, column, null))))
		    in
		        Table.TransformColumnTypes(#table(columns, cells), List.Transform(columns, (column) => {column, type text}))
	queryGroup: Reading

/// The part Tested of the table Run (D284), which the DAX table Tested shows: each part of a check the newest CI report could test, with the CIs it evaluated (D15). A card with no row here is grey, never green. Part: the field or rule ("owned_by", "outer-space"), as the HTML app's run says it; "" for a check tested as a whole (Process stage). `run` is CheckRun (null when no CI report is loaded).
expression fnTestedPart =
		(run as nullable record) as table =>
		    let
		        evaluated = if run = null then {} else run[Evaluated],
		        tested = if run = null then {} else run[Tested],
		        countOf = (part as text) as nullable number => List.First(List.Transform(List.Select(evaluated, (entry) => entry[Part] = part), (entry) => entry[Count]), null)
		    in
		        #table(
		            type table [CheckId = text, Part = text, ReportDate = date, Evaluated = Int64.Type],
		            List.Transform(tested, (part) =>
		                let at = Text.PositionOf(part, ":") in
		                {if at < 0 then part else Text.Start(part, at), if at < 0 then "" else Text.Middle(part, at + 1), run[Date], countOf(part)}))
	queryGroup: Reading

/// A relationship type as it is compared: without any space, lower case ("Provided By::Provides" = "Provided by::Provides"; relationship-detectors.ts, sameType).
expression fnTypeKey =
		(name as text) as text =>
		    Text.Lower(Text.Remove(name, List.Transform({9, 10, 11, 12, 13, 32, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288, 65279}, Character.FromNumber)), "en-US")
	queryGroup: Reading

/// The name of each person of the CI report by their user ID (lower case), the first name found (src/core/sources/epo/ epo-report.ts, userNames).
expression fnUserNames =
		(cis as list, columns as list) as record =>
		    let
		        pairs = List.Combine(List.Transform(cis, (ci) => List.RemoveNulls(List.Transform(ReadingRules[roles], (role) =>
		            let person = fnPerson(ci, role, columns) in
		            if person = null or person[UserId] = "" or person[Name] = "" then null else [Id = Text.Lower(Text.Trim(person[UserId]), "en-US"), Name = person[Name]])))),
		        grouped = fnGroupBy(pairs, (pair) => pair[Id])
		    in
		        Record.FromList(List.Transform(Record.FieldValues(grouped), (list) => list{0}[Name]), Record.FieldNames(grouped))
	queryGroup: Reading

/// The name with "?" where a hidden character is, as the CSV export shows it, so a person can see where it sits (src/core/shared/names.ts, visibleName).
expression fnVisibleName = (name as text) as text => List.Accumulate(ReadingRules[hiddenCharacters], name, (text, entry) => Text.Replace(text, Character.FromNumber(entry[code]), "?"))
	queryGroup: Reading

/// Why a person gets a message, from how the contact was found (src/core/messages/messages.ts, whyYou; build B7): "ServiceNow names you as Managed by of the CI below." `via`: the ContactVia of the finding; `below`: fnBelowWords.
expression fnWhyYou =
		(via as text, below as text) as text =>
		    let
		        words = MessageWords,
		        firstSpace = (value as text) as text => let at = Text.PositionOf(value, " ") in if at < 0 then value else Text.Start(value, at) & "_" & Text.Middle(value, at + 1),
		        label = (value as text) as text => Record.FieldOrDefault(words[roleLabel], firstSpace(Text.Trim(value)), value),
		        above = if Text.StartsWith(via, "manager of ") and Text.Length(via) > 11 then [Who = "manager", Of = Text.Middle(via, 11)]
		            else if Text.StartsWith(via, "department head of ") and Text.Length(via) > 19 then [Who = "department head", Of = Text.Middle(via, 19)]
		            else null
		    in
		        if above <> null then "You are the " & above[Who] & " of the " & label(above[Of]) & " of " & below & "."
		        else if via = ReadingRules[epoOwner][via] then "You are the inventory owner of EPO, and nobody else could be asked about " & below & "."
		        // A team responsible for the record of a class (D195): "Process Management team".
		        else if Text.EndsWith(via, " team") then Text.Start(via, Text.Length(via) - 5) & " is responsible for the record of " & below & ". SACM updates ServiceNow with what you tell us."
		        else if via = ReadingRules[procurement][via] then "Procurement owns the contract data in Solusi. The contracts below need a correction in Solusi: ServiceNow receives it with the next upload."
		        else if Record.HasFields(words[roleLabel], firstSpace(via)) then "ServiceNow names you as " & label(via) & " of " & below & "."
		        else "You are named on " & below & "."
	queryGroup: Reading

/// The name without its hidden characters: the name to type in ServiceNow (src/core/shared/names.ts, withoutHidden).
expression fnWithoutHidden = (name as text) as text => List.Accumulate(ReadingRules[hiddenCharacters], name, (text, entry) => Text.Replace(text, Character.FromNumber(entry[code]), ""))
	queryGroup: Reading

/// The lines of the lifecycle review on the newest CI report (D192, D306), as withReviewFacts of src/core/audit/lifecycle-review.ts adds them: the newest mark of each CI over all reviews (LifecycleReviews) decides. A mark "Not the same" opens a line of the card Lifecycle review while the newest report still shows the CI in the status it had in the review, from the report of the review on. The line is a SACM fix line (reviewFix): service mapped, SACM copies the status of EPO; not service mapped, an incident for the sync; the owner is asked only after "EPO itself looks wrong: ask the owner". The check counts as tested (status) with every CI checked in a review; with no mark at all it is not tested and says how to start one. Only the newest report gets the lines: the history (HistoryRun) does not count them, as it does not read the journal. `run` is CheckRun (null when no CI report).
expression fnWithReviews =
		(run as nullable record) as nullable record =>
		    let
		        reference = fnReference("reference/lifecycle"),
		        config = if reference = null then null else Record.FieldOrDefault(reference, "review", null),
		        packs = List.Select(List.Transform(Json.Document(CheckFiles), (entry) => entry[pack]), (pack) => pack[id] = "LIFECYCLE-REVIEW" and pack[status] <> "off"),
		        pack = List.First(packs, null),
		        reviews = LifecycleReviews,
		        notYet = [CheckId = "LIFECYCLE-REVIEW", Note = "No lifecycle review yet. A manager starts one on the Audit page, under Lifecycle."]
		    in
		        if run = null then null
		        else if pack = null or config = null or List.IsEmpty(reviews) then run & [Notes = run[Notes] & (if pack = null then {} else {notYet})]
		        else
		            let
		                // The newest mark of each CI over all reviews; a later review wins a tie.
		                entries = List.Combine(List.Transform(reviews, (review) =>
		                    List.RemoveNulls(List.Transform(review[Items], (item) =>
		                        let mark = Record.FieldOrDefault(review[Marks], item[CiKey], null) in
		                        if mark = null then null else [Item = item, Mark = mark, Review = review])))),
		                checked = List.Count(entries),
		                latest = List.Transform(Record.FieldValues(fnGroupBy(entries, (entry) => entry[Item][CiKey])),
		                    (list) => List.Accumulate(list, null, (best, entry) => if best = null or best[Mark][At] <= entry[Mark][At] then entry else best)),
		                from = List.Min(List.Transform(reviews, (review) => review[ReportDate])),
		                date = Date.ToText(run[Date], [Format = "yyyy-MM-dd", Culture = "en-US"]),
		                cis = Record.FromList(run[Cis], List.Transform(run[Cis], (ci) => ci[Key])),
		                retired = List.Buffer(List.Transform(config[retiredStatuses], (word) => fnNameKey(word, ""))),
		                columns = run[Columns],
		                months = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
		                screenDate = (iso as text) as text => if Text.Length(iso) < 10 then iso
		                    else Text.From(Number.FromText(Text.Middle(iso, 8, 2))) & " " & months{Number.FromText(Text.Middle(iso, 5, 2)) - 1} & " " & Text.Start(iso, 4),
		                // A person of the CI as the app keeps it (src/app/view/people.ts): only with a name or an email; the name, else the email.
		                known = (person as nullable record) as nullable record => if person = null or (person[Name] = "" and person[Email] = "") then null
		                    else person & [Name = if person[Name] <> "" then person[Name] else person[Email]],
		                reachable = (person as nullable record) as logical => person <> null and person[Email] <> "" and person[Active] <> false,
		                shown = (person as nullable record) as text => if person = null then "" else person[Name] & (if person[Active] = false then " (inactive)" else ""),
		                idOf = (person as record) as text => let id = Text.Lower(Text.Trim(if person[UserId] <> "" then person[UserId] else person[Email]), "en-US") in
		                    if id <> "" then id else Text.Lower(person[Name], "en-US"),
		                fixOf = (status as text, mapped as nullable logical) as record =>
		                    if mapped = true then [Change = "Operational status: copy the status of EPO into ServiceNow (service mapped)", Current = status, Set = "The status EPO shows"]
		                    else if mapped = false then [Change = "Operational status: the sync did not bring the status of EPO. Raise an incident with the ServiceNow development team", Current = status, Set = "The status EPO shows, brought by the sync"]
		                    else [Change = "Operational status: not the same as in EPO. Service mapped: copy the status of EPO. Not service mapped: raise an incident with the ServiceNow development team", Current = status, Set = "The status EPO shows"],
		                factOf = (entry as record) as nullable record =>
		                    let
		                        item = entry[Item],
		                        mark = entry[Mark],
		                        review = entry[Review],
		                        ci = Record.FieldOrDefault(cis, item[CiKey], null)
		                    in
		                        if not List.Contains(config[opensCase], mark[Result]) or date < review[ReportDate] or ci = null or List.Contains(retired, ci[StatusKey])
		                            or ci[StatusKey] <> fnNameKey(item[Status], "") then null
		                        else
		                            let
		                                owner = known(fnPerson(ci, "owned_by", columns)),
		                                manager = known(fnPerson(ci, "managed_by", columns)),
		                                supporter = known(fnPerson(ci, "supported_by", columns)),
		                                contact = if reachable(owner) then [Person = owner, Via = "owned by"] else if reachable(manager) then [Person = manager, Via = "managed by"] else null,
		                                cc = if contact <> null and contact[Via] = "owned by" and reachable(manager) and Text.Lower(manager[Email], "en-US") <> Text.Lower(contact[Person][Email], "en-US") then {manager[Email]} else {},
		                                finding = fnFinding(pack, ci, "status",
		                                    "Status in ServiceNow is " & ci[Status] & "; EPO does not show the same (lifecycle review of " & screenDate(review[Date]) & ", " & mark[ByName] & ")"
		                                        & (if mark[Note] <> "" then ": " & mark[Note] else ""),
		                                    if pack[playbook][path] = "sacm-fix" then [Fix = fixOf(ci[Status], ci[ServiceMapped])] else null)
		                            in
		                                finding & [
		                                    ClassLabel = if ci[SourceClass] <> "" then ci[SourceClass] else ci[Class], Module = pack[dimension], Route = "", State = "open", StateWhy = "",
		                                    EpoId = ci[AssetTag], Status = ci[Status], SupportGroup = ci[SupportGroup], OwnedBy = shown(owner), ManagedBy = shown(manager), SupportedBy = shown(supporter),
		                                    Tags = {}, Contract = null,
		                                    ContactName = if contact = null then "" else contact[Person][Name], ContactEmail = if contact = null then "" else contact[Person][Email],
		                                    ContactId = if contact = null then "" else idOf(contact[Person]), ContactVia = if contact = null then "" else contact[Via], Cc = cc,
		                                    EscalateName = "", EscalateEmail = "", EscalateVia = ""
		                                ],
		                facts = if date < from then {} else List.RemoveNulls(List.Transform(latest, factOf)),
		                part = "LIFECYCLE-REVIEW:status"
		            in
		                if date < from then run & [Notes = run[Notes] & {notYet}]
		                else run & [
		                    Facts = List.Buffer(List.Select(run[Facts], (fact) => fact[CheckId] <> pack[id]) & facts),
		                    Tested = if List.Contains(run[Tested], part) then run[Tested] else run[Tested] & {part},
		                    Evaluated = List.Select(run[Evaluated], (entry) => entry[Part] <> part) & {[Part = part, Count = checked]}
		                ]
	queryGroup: Reading

/// The events of the list SACM Journal (D291), as the app reads its journal (DATA-MODEL §3): one record per row, oldest first (by At, then by id), every field as text ("" when empty). By is lower case; Keys is the list of the finding keys of the event, one per line of the column Keys. Read by the tables Journal, JournalKeys and Activity, and by the parts CaseLines and Exceptions of the table Run.
expression JournalEvents =
		let
		    rows = Table.ToRecords(fnStateList("journal")),
		    events = List.Transform(rows, (row) => [
		        Id = row[Title], At = row[At], By = Text.Lower(row[By], "en-US"), ByName = row[ByName], Type = row[Type],
		        Keys = List.Select(List.Transform(Text.SplitAny(row[Keys], "#(cr)#(lf)"), Text.Trim), (key) => key <> ""),
		        Text = row[Text], Ref = row[Ref], To = row[To], Cc = row[Cc], Subject = row[Subject], Kind = row[Kind], Channel = row[Channel],
		        Person = row[Person], Reason = row[Reason], ReviewOn = row[ReviewOn], RetireOn = row[RetireOn], CheckId = row[CheckId], CiKey = row[CiKey], CiName = row[CiName],
		        // The sample of a lifecycle review, on the row that starts it (build B8, D306; LifecycleReviews).
		        Items = row[Items]
		    ]),
		    order = (a as record, b as record) as number => let first = Value.Compare(a[At], b[At]) in if first <> 0 then first else Value.Compare(a[Id], b[Id])
		in
		    List.Buffer(List.Sort(events, order))
	queryGroup: Reading

/// The column of the model for each criticality name of the check files ("target.availability" -> TargetAvailability), made once, so fnLevelAt only looks a name up.
expression LevelColumns =
		let
		    names = List.Combine(List.Transform({"target", "inherited"}, (kind) => List.Transform(ReadingRules[dimensions], (dimension) => kind & "." & dimension)))
		in
		    Record.FromList(List.Transform(names, fnPascal), names)
	queryGroup: Reading

/// The lifecycle reviews of the journal (D306), as the HTML app reads its reviews and their marks (src/core/audit/lifecycle-review.ts, marksOf). New review adds one row of type review with no CI: Ref is the id of the review ("2026-11-12_lifecycle", the day it was started) and Items the sample, as the Power App SACM audit saved it (JSON: report, reportDate and the items with ciKey, name, classLabel, className, status, epoId and group). A start row without Items cannot be read and is left out. Two starts with one id (two managers on one day): the first counts. A mark is a row of type review with CiKey and Reason (same, different, not-in-epo) whose Ref is the review: the last mark of a CI counts (the journal is oldest first). Gives the reviews oldest first: [Id, Date, Report, ReportDate, Items, StartedBy, Marks], Marks a record by CI key of [Result, Note, By, ByName, At]. Read by the table Run.
expression LifecycleReviews =
		let
		    textOf = (source as record, field as text) as text => let value = Record.FieldOrDefault(source, field, null) in if value = null then "" else Text.From(value),
		    starts = List.Select(JournalEvents, (event) => event[Type] = "review" and event[CiKey] = "" and event[Ref] <> "" and event[Items] <> ""),
		    parsed = List.Transform(starts, (event) =>
		        let
		            body = try Json.Document(event[Items]) otherwise null,
		            items = if body is record then Record.FieldOrDefault(body, "items", null) else null
		        in
		            if not (items is list) then null
		            else [
		                Id = event[Ref], Date = Text.Start(event[Ref], 10), Report = textOf(body, "report"), ReportDate = Text.Start(textOf(body, "reportDate"), 10),
		                Items = List.Buffer(List.Transform(List.Select(items, (entry) => entry is record and textOf(entry, "ciKey") <> ""), (entry) => [
		                    CiKey = textOf(entry, "ciKey"), Name = textOf(entry, "name"), ClassLabel = textOf(entry, "classLabel"), ClassName = textOf(entry, "className"),
		                    Status = textOf(entry, "status"), EpoId = textOf(entry, "epoId"), Group = if textOf(entry, "group") = "under-retirement" then "under-retirement" else "sample"])),
		                StartedBy = if event[ByName] <> "" then event[ByName] else event[By]
		            ]),
		    byId = fnGroupBy(List.RemoveNulls(parsed), (review) => review[Id]),
		    reviews = List.Sort(List.Transform(Record.FieldValues(byId), List.First), (a, b) => Comparer.Ordinal(a[Id], b[Id])),
		    marks = List.Select(JournalEvents, (event) => event[Type] = "review" and event[CiKey] <> "" and event[Reason] <> ""),
		    marksOf = fnGroupBy(marks, (event) => event[Ref]),
		    withMarks = List.Transform(reviews, (review) =>
		        let
		            own = fnGroupBy(Record.FieldOrDefault(marksOf, review[Id], {}), (event) => event[CiKey]),
		            last = List.Transform(Record.FieldValues(own), (events) => let event = List.Last(events) in
		                [Result = event[Reason], Note = event[Text], By = event[By], ByName = if event[ByName] <> "" then event[ByName] else event[By], At = event[At]])
		        in
		            review & [Marks = Record.FromList(last, Record.FieldNames(own))])
		in
		    List.Buffer(withMarks)
	queryGroup: Reading

/// The reference files that decide how a finding is listed (fnListing), with their words in compared form, made once: reference/not-live-statuses (NotLive: null when missing) and the rules of reference/known-tags.
expression ListingRules =
		let
		    notLive = Record.FieldOrDefault(ReferenceFiles, "not-live-statuses", null),
		    known = Record.FieldOrDefault(Record.FieldOrDefault(ReferenceFiles, "known-tags", []), "rules", {})
		in
		    [
		        NotLive = notLive,
		        NotLiveKeys = if notLive = null then {} else List.Buffer(List.Transform(notLive[statuses], (status) => fnNameKey(status, ""))),
		        ExceptChecks = if notLive = null then {} else Record.FieldOrDefault(notLive, "exceptChecks", {}),
		        Known = List.Buffer(List.Transform(known, (rule) => rule & [TagKeys = List.Buffer(List.Transform(rule[tags], (word) => fnNameKey(word, "")))]))
		    ]
	queryGroup: Reading

/// The team settings the messages use (build B7, D300), from the list SACM Settings, with the defaults of the HTML app (src/app/state/store.ts, DEFAULT_SETTINGS): the Service Portal, the signature, the EPO inventory owner, the Procurement mailbox and its lead, the name and link of each request of the portal, and the people of each team of reference/record-teams. One row per setting: Title is the key, Value the value. The keys: portalLink, signature, epoOwnerName, epoOwnerEmail, procurementName, procurementEmail, procurementLeadName, procurementLeadEmail, request.<id>.name and request.<id>.link (the ids of MessageWords[requests]), team.<id>.name and team.<id>.people ("Name <address>; Name <address>", one person per part), and rowsInEmail: the lines a table of an email shows before "and N more in the attached file" (D314; a whole number in its range of SettingRanges, else the default 10). A key that is not there, or empty, keeps its default. The manager who sends is not a setting: the Power App puts their name in the draft (%%SENDER%%, fnDrafts).
expression MessageSettings =
		let
		    // A Title typed twice: the last row counts (as the HTML app reads its settings); an empty Title is left out.
		    rows = List.Select(Table.ToRecords(fnStateList("settings")), (row) => row[Title] <> null and Text.Trim(row[Title]) <> ""),
		    titles = List.Distinct(List.Transform(rows, (row) => Text.Trim(row[Title]))),
		    lastOf = (title as text) as text =>
		        let row = List.Last(List.Select(rows, (candidate) => Text.Trim(candidate[Title]) = title)) in if row[Value] = null then "" else Text.Trim(row[Value]),
		    values = Record.FromList(List.Transform(titles, lastOf), titles),
		    value = (key as text, default as text) as text => let found = Record.FieldOrDefault(values, key, "") in if found = "" then default else found,
		    requests = Record.FromList(
		        List.Transform(MessageWords[requests], (request) => [Name = value("request." & request[id] & ".name", ""), Link = value("request." & request[id] & ".link", "")]),
		        List.Transform(MessageWords[requests], (request) => request[id])),
		    // "Pat Process <pat.process@example.com>; quinn@example.com": a name and its address in angle brackets, or an address alone.
		    person = (part as text) as record =>
		        let
		            open = Text.PositionOf(part, "<"),
		            close = Text.PositionOf(part, ">", Occurrence.Last)
		        in
		            if open >= 0 and close > open then [Name = Text.Trim(Text.Start(part, open)), Email = Text.Trim(Text.Middle(part, open + 1, close - open - 1))]
		            else [Name = "", Email = Text.Trim(part)],
		    teamIds = List.Transform(Record.FieldOrDefault(Record.FieldOrDefault(ReferenceFiles, "record-teams", []), "teams", {}), (team) => team[id]),
		    teams = Record.FromList(
		        List.Transform(teamIds, (id) => [
		            Name = value("team." & id & ".name", ""),
		            People = List.Transform(List.Select(Text.SplitAny(value("team." & id & ".people", ""), ";#(cr)#(lf)"), (part) => Text.Trim(part) <> ""), person)
		        ]),
		        teamIds)
		in
		    [
		        RowsInEmail =
		            let
		                range = SettingRanges[rowsInEmail],
		                raw = value("rowsInEmail", ""),
		                whole = if raw <> "" and Text.Remove(raw, {"0".."9"}) = "" then Number.FromText(raw, "en-US") else null
		            in
		                if whole <> null and whole >= range[min] and whole <= range[max] then whole else range[default],
		        PortalLink = value("portalLink", ""), Signature = value("signature", "SACM team"),
		        EpoOwnerName = value("epoOwnerName", ""), EpoOwnerEmail = value("epoOwnerEmail", ""),
		        ProcurementName = value("procurementName", "Procurement"), ProcurementEmail = value("procurementEmail", ""),
		        ProcurementLeadName = value("procurementLeadName", ""), ProcurementLeadEmail = value("procurementLeadEmail", ""),
		        Requests = requests, Teams = teams, Channel = "email"
		    ]
	queryGroup: Reading

/// How many days before a report date the files are read (D290): enough for the weekly reports and the report before each of them (the chip "changed in EPO", Contract changes compares the two newest Solusi files). The pages of the newest report read the files of the last ReadDays days before the newest file (ReadFiles); each day of the history reads the ReadDays days before it (HistoryRun). An older file is never opened, so a folder that keeps two years of reports stays fast; the Reports page does not list it.
expression ReadDays = 21
	queryGroup: Reading

/// The report files the pages of the newest report use, each read once (fnReadFiles): every file dated at most ReadDays days before the newest file of the folder. Older files belong to the history, which reads its own days (HistoryRun, D290), so a folder that keeps two years of reports does not slow the refresh.
expression ReadFiles =
		let
		    newest = List.Max(List.RemoveNulls(ReportSourceFiles[ReportDate]), null)
		in
		    fnReadFiles(if newest = null then null else Date.AddDays(newest, -ReadDays), null)
	queryGroup: Reading

/// The replies of the list SACM Replies (D291): one record per reply, with the reference of the message it answers (Ref, the column Title), who sent it, when it arrived (yyyy-MM-ddTHH:mm:ss), its subject and its text.
expression ReplyItems = List.Buffer(List.Transform(Table.ToRecords(fnStateList("replies")), (row) => [Ref = row[Title], From = row[From], Received = row[Received], Subject = row[Subject], Body = row[Body]]))
	queryGroup: Reading

/// Every report file, whatever the mode: FileName, ReportDate, Modified, Content (D271). Sample: the invented samples packed in this file by the generator (SampleFiles). SharePoint: the reports folder of the team site.
expression ReportSourceFiles =
		let
		    sample = Table.TransformColumns(
		        Table.RenameColumns(Table.AddColumn(SampleFiles, "Modified", each null, type nullable datetime), {{"Base64", "Content"}}),
		        {{"Content", (text) => Binary.FromText(text, BinaryEncoding.Base64), type binary}}),
		    files = if SourceMode = "SharePoint" then fnSharePointFiles() else Table.SelectColumns(sample, {"FileName", "Modified", "Content"}),
		    reports = Table.SelectRows(files, each fnIsReportFile([FileName])),
		    dated = Table.AddColumn(reports, "ReportDate", each fnReportDate([FileName], [Modified]), type nullable date)
		in
		    Table.Sort(dated, {{"ReportDate", Order.Ascending}, {"FileName", Order.Ascending}})
	queryGroup: Reading

/// The column prefix of the model for each role of the CI report (owned_by -> OwnedBy), made once, so fnPerson only looks a role up.
expression RolePrefixes = Record.FromList(List.Transform(ReadingRules[roles], fnPascal), ReadingRules[roles])
	queryGroup: Reading

/// The detectors of checks/packs that are built in Power Query. A check whose detector is not in this list is grey with the note "not built" (D15), so each build can port a part. Build B2: the rule checks and the CI code detectors. Build B3: the relationship checks, the EPO checks, the stages of a Business Process and the mapping backlog. Build B4: the contract checks. Build B8: the lifecycle review, whose lines come from the journal (fnWithReviews, on the newest report only).
expression BuiltDetectors =
		{
		    "rule", "ci/name-standard", "ci/epo-id", "ci/status-age", "criticality/above-parents", "criticality/none-reaches",
		    "relationships/missing", "relationships/too-many", "relationships/wrong-type", "relationships/twice",
		    "relationships/application-instance", "relationships/offering-owner", "relationships/offering-parent",
		    "epo/differs", "epo/not-arrived", "process/stage", "mapping/backlog",
		    "contracts/not-in-solusi", "contracts/to-clear", "contracts/status", "contracts/upload-check", "contracts/problems",
		    "review/lifecycle"
		}
	queryGroup: Checks

/// The checks on the newest CI report (fnCheckRun), worked out once per refresh; null when no CI report is loaded. Only the table Run reads it (D284). The history runs the checks on every report date in its own table HistoryRun (D290).
expression CheckRun =
		let
		    newest = fnNewest("ci")
		in
		    if Table.IsEmpty(newest) then null else fnCheckRun(newest{0}, ReadFiles)
	queryGroup: Checks

/// The small words of the contract checks (src/core/sources/contracts/contract-reports.ts and contract-detectors.ts), SameWord (two texts the same without case and extra spaces), InList (a text is one of a list, the same way), Blank (no value), Shown (a value as a message writes it: a date as "12 November 2026"), StatusTag (the first status tag of a ServiceNow contract, "S - Concluded", or "") and TargetTag (the first tag that sets the criticality by hand, or "").
expression ContractWords =
		[
		    SameWord = (a as nullable text, b as nullable text) as logical => fnNameKey(if a = null then "" else a, "") = fnNameKey(if b = null then "" else b, ""),
		    InList = (list as list, value as nullable text) as logical => let key = fnNameKey(if value = null then "" else value, "") in
		        List.AnyTrue(List.Transform(list, (entry) => fnNameKey(entry, "") = key)),
		    Blank = (value as any) as logical => value = null or value = "",
		    Shown = (value as any) as text => if value = null then "" else if value is date then fnLongDate(value) else value,
		    TagList = (contract as record) as list => if contract[Tags] = "" then {} else Text.Split(contract[Tags], ", "),
		    FirstTag = (contract as record, pattern as text) as text =>
		        List.First(List.Select(TagList(contract), (tag) => fnMatches(pattern, "i", tag)), ""),
		    StatusTag = (contract as record, config as record) as text => FirstTag(contract, config[statusTag]),
		    TargetTag = (contract as record, config as record) as text => FirstTag(contract, config[targetTag])
		]
	queryGroup: Checks

/// The checks on one CI report (src/core/checks/engine.ts, runChecks, then src/core/cases/cases.ts, buildRun): the reports of the other types that go with it (fnPairedFile), the scope of each check, the built detectors, the source first (D190), the parked CIs (D179), then who is asked and how each finding is listed. `file` is a row of ReadFiles, `files` the files it is paired from (ReadFiles for the newest report, fnReadFiles of the window for the history, D290). Returns [Date, FileName, Cis, Columns, Facts, Tested, Evaluated, Notes, Parked, Graph, Epo, Subjects, Paired]; Notes are [CheckId, Note]; Subjects are the contracts findings are about (fnContractSubject); Paired the file names of the other reports used (Relationship, Epo, Solusi, Contract; null when none). Outputs (one lazy field per built check), RunContext and Stages are read only by the probes of the refresh time. Each CI gets its normal forms once (StatusKey, NameKey, IdentityKey, TagKeys, Squashed: the compared text of the six fields a rule counts), so no check normalises a CI field again (ARCHITECTURE §12, the speed rules).
expression fnCheckRun =
		(file as record, files as table) as record =>
		    let
		        date = file[ReportDate],
		        read = file[Read],
		        rows = Table.ToRecords(fnReadCiReport(read)),
		        found = fnCiColumns(read),
		        relationshipFile = fnPairedFile(files, "relationship", date),
		        relationships = if relationshipFile = null then null else relationshipFile[Rows],
		        epoFile = fnPairedFile(files, "epo", date),
		        epo = if epoFile = null then null else epoFile[Rows],
		        solusiFile = fnPairedFile(files, "solusi", date),
		        contractFile = fnPairedFile(files, "contract", date),

		        // Hidden characters: the name itself, else the name as the Relationship report holds it (a CSV writes "?").
		        known = if read[Lossless] or relationships = null then [] else
		            let
		                ends = List.Combine(List.Transform(relationships, (item) => {item[Parent], item[Child]})),
		                // Most names hold no hidden character: fnHiddenCharacters says so with one native test.
		                hidden = List.Select(List.Transform(ends, (name) => [Name = name, Chars = fnHiddenCharacters(name)]), (entry) => not List.IsEmpty(entry[Chars])),
		                keyed = List.Transform(hidden, (entry) => entry & [Key = fnNameKey(entry[Name], "?")]),
		                grouped = fnGroupBy(keyed, (entry) => entry[Key])
		            in
		                Record.FromList(List.Transform(Record.FieldValues(grouped), (entries) => List.Last(entries)[Chars]), Record.FieldNames(grouped)),
		        createdBy = List.Contains(found, "createdBy"),
		        squash = (row as record, field as text) as text => fnNameKey(fnCiText(row, field), ""),
		        cis = List.Buffer(List.Transform(rows, (row) =>
		            let own = fnHiddenCharacters(row[Name]), tags = if row[Tags] = "" then {} else Text.Split(row[Tags], ", "), status = fnNameKey(row[Status], ""), name = fnNameKey(row[Name], "") in
		            row & [
		                TagList = tags,
		                TagKeys = List.Buffer(List.Transform(tags, (tag) => fnNameKey(tag, ""))),
		                OwnHidden = own,
		                HiddenCharacters = if not List.IsEmpty(own) then own else Record.FieldOrDefault(known, row[Key], {}),
		                CreatedBy = if createdBy then row[CreatedBy] else null,
		                StatusKey = status, NameKey = name, IdentityKey = fnNameKey(row[Name], "?"),
		                Squashed = [
		                    description = squash(row, "description"), name = name, exception_justification = squash(row, "exception_justification"),
		                    exception_status = squash(row, "exception_status"), support_group = squash(row, "support_group"), operational_status = status
		                ]
		            ])),
		        inFile = List.AnyTrue(List.Transform(cis, (ci) => not List.IsEmpty(ci[OwnHidden]))),
		        hiddenFrom = if read[Lossless] or inFile then "file" else if Record.FieldCount(known) > 0 then "relationships" else "",
		        columns = List.Buffer(found & (if hiddenFrom <> "" then {"name.hidden"} else {})),
		        questionMarks = List.Count(List.Select(cis, (ci) => Text.Contains(ci[Name], "?"))),
		        hiddenNotes =
		            if hiddenFrom = "relationships" then {[CheckId = "NAME-HIDDEN-CHAR", Note = "Partly tested. A CSV report cannot show hidden characters, so only the names that are also in the Relationship report were checked."]}
		            else if hiddenFrom = "" and questionMarks > 0 then {[CheckId = "NAME-HIDDEN-CHAR", Note = Text.From(questionMarks) & " names show ""?"". It can be a hidden character the CSV could not write."]}
		            else {},

		        model = fnReference("reference/relationship-model"),
		        graph = if relationships = null or model = null then null else fnRelationshipGraph(cis, relationships, model),
		        epoConfig = let config = fnReference("reference/epo-systems-report") in
		            if config <> null and Record.HasFields(config, {"columns", "statuses", "roles"}) then config else null,
		        contractConfig = let config = fnReference("reference/contract-reports") in
		            if config <> null and Record.HasFields(config, {"solusi", "servicenow", "fields"}) and Value.Is(config[fields], type list) then config else null,
		        // How many CIs of the whole report share each value (compared form), per field of a rule; the same for the live
		        // CIs per class (the operators duplicatedMoreThan and duplicatedInClass of fnDetectRule).
		        textFields = {"description", "name", "exception_justification", "exception_status", "support_group", "operational_status"},
		        countOf = (keys as list) as record =>
		            let
		                kept = List.Select(keys, (key) => key <> ""),
		                grouped = Table.Group(Table.FromColumns({kept}, {"Value"}), {"Value"}, {{"Count", Table.RowCount, Int64.Type}})
		            in
		                Record.FromList(grouped[Count], grouped[Value]),
		        live = List.Buffer(List.Select(cis, (ci) => ci[StatusKey] <> "retired")),
		        // Worked out once, when a check reads it (a field of a record is worked out only when it is read).
		        run = [
		            Cis = cis, Columns = columns, Date = date, Graph = graph, EpoSystems = epo, CheckableKeys = checkableKeys,
		            Counts = Record.FromList(List.Transform(textFields, (field) => countOf(List.Transform(cis, (ci) => Record.Field(ci[Squashed], field)))), textFields),
		            ClassCounts = Record.FromList(List.Transform(textFields, (field) => countOf(List.Transform(live, (ci) =>
		                let key = Record.Field(ci[Squashed], field) in if key = "" then "" else ci[Class] & "|" & key))), textFields),
		            Epo = if epoFile = null then null else [Systems = epo, Date = epoFile[ReportDate], Report = epoFile[FileName], PreviousDate = epoFile[PreviousDate]],
		            EpoComparison = if epo = null or epoConfig = null then null else fnEpoCompare(cis, epo, columns, epoConfig),
		            // The two contract files matched, once, when a contract check reads it.
		            Contracts = if contractConfig = null or solusiFile = null or contractFile = null then null else fnContractCompare(solusiFile, contractFile, contractConfig)
		        ],

		        parked = fnParked(cis),
		        parkedSet = if parked = null then [] else parked[KeySet],
		        checkable = List.Buffer(List.Select(cis, (ci) => not Record.HasFields(parkedSet, ci[Key]))),
		        checkableKeys = fnKeySet(List.Transform(checkable, (ci) => ci[Key])),
		        packs = List.Buffer(List.Select(List.Transform(Json.Document(CheckFiles), (entry) => entry[pack]), (pack) => pack[status] <> "off")),
		        moduleOf = (pack as record) as text => if pack[detector][type] = "rule" then "rule" else Record.FieldOrDefault(pack[detector], "module", pack[detector][type]),
		        built = List.Buffer(List.Select(packs, (pack) => List.Contains(BuiltDetectors, moduleOf(pack)))),
		        // The scope of a check (fnInScope), with its words in compared form once: the class, and the status of the CI.
		        scopeOf = (pack as record) as list =>
		            let
		                scope = pack[scope],
		                all = List.Contains(scope[classes], "*"),
		                classes = List.Buffer(scope[classes]),
		                excluded = List.Buffer(List.Transform(Record.FieldOrDefault(Record.FieldOrDefault(scope, "exclude", []), "operational_status", {}), (word) => fnNameKey(word, "")))
		            in
		                List.Buffer(List.Select(checkable, (ci) => (all or List.Contains(classes, ci[Class])) and not List.Contains(excluded, ci[StatusKey]))),
		        skipped = (ref as text) as record => [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Skipped: reference data missing (" & ref & ")."}],
		        noRelationships = [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: no Relationship report. Load the Relationship report with the CI report."}],
		        relationshipDetectors = [
		            #"relationships/missing" = fnDetectRelationshipsMissing, #"relationships/too-many" = fnDetectRelationshipsTooMany,
		            #"relationships/wrong-type" = fnDetectRelationshipsWrongType, #"relationships/twice" = fnDetectRelationshipsTwice,
		            #"relationships/application-instance" = fnDetectRelationshipsApplicationInstance,
		            #"relationships/offering-owner" = fnDetectRelationshipsOfferingOwner, #"relationships/offering-parent" = fnDetectRelationshipsOfferingParent
		        ],
		        contractDetectors = [
		            #"contracts/not-in-solusi" = fnDetectContractsNotInSolusi, #"contracts/to-clear" = fnDetectContractsToClear,
		            #"contracts/status" = fnDetectContractsStatus, #"contracts/upload-check" = fnDetectContractsUploadCheck,
		            #"contracts/problems" = fnDetectContractsProblems
		        ],
		        noContracts = [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: "
		            & Text.Combine(List.Select({if solusiFile = null then "no Solusi contract file" else "", if contractFile = null then "no ServiceNow contract report" else ""}, (part) => part <> ""), " and ")
		            & ". Load the Solusi contract file and the ServiceNow contract report with the CI report."}],
		        detect = (pack as record) as record =>
		            let
		                module = moduleOf(pack),
		                inScope = scopeOf(pack),
		                ref = Record.FieldOrDefault(pack[detector], "ref",
		                    if Text.StartsWith(module, "criticality/") then "reference/criticality"
		                    else if Text.StartsWith(module, "relationships/") then "reference/relationship-model"
		                    else if module = "process/stage" then "reference/lifecycle"
		                    else if module = "mapping/backlog" then "reference/mapping-backlog"
		                    else ""),
		                reference = fnReference(ref),
		                criticality = reference <> null and Value.Is(Record.FieldOrDefault(reference, "waitDays", null), type number),
		                isModel = (value as any) as logical => value <> null and Value.Is(Record.FieldOrDefault(value, "dictionary", null), type list)
		                    and Value.Is(Record.FieldOrDefault(value, "expectations", null), type list),
		                stages = if reference = null then null else Record.FieldOrDefault(reference, "processStages", null)
		            in
		                if module = "rule" then fnDetectRule(pack, run, inScope)
		                else if Record.HasFields(relationshipDetectors, module) then
		                    (if not isModel(reference) then skipped(ref) else if graph = null then noRelationships
		                    else Record.Field(relationshipDetectors, module)(pack, run, inScope, reference))
		                else if module = "epo/differs" or module = "epo/not-arrived" then
		                    (if epoConfig = null then skipped("reference/epo-systems-report")
		                    else if epo = null then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: no EPO systems report. Load the EPO systems report with the CI report."}]
		                    else if not List.Contains(columns, "assetTag") then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: the CI report has no column for the EPO ID (asset_tag)."}]
		                    else if module = "epo/differs" then fnDetectEpoDiffers(pack, run, epoConfig) else fnDetectEpoNotArrived(pack, run, epoConfig))
		                // The contract checks: the Solusi contract file and the ServiceNow contract report dated on or before the CI report.
		                else if Record.HasFields(contractDetectors, module) then
		                    (if contractConfig = null then skipped("reference/contract-reports")
		                    else if solusiFile = null or contractFile = null then noContracts
		                    else Record.Field(contractDetectors, module)(pack, run, contractConfig))
		                else if module = "process/stage" then
		                    (if stages = null then skipped(ref & ", processStages") else fnDetectProcessStage(pack, run, inScope, stages))
		                else if module = "mapping/backlog" then
		                    (if reference = null or not Value.Is(Record.FieldOrDefault(reference, "rules", null), type list) then skipped(ref)
		                    else if not (model <> null and Value.Is(Record.FieldOrDefault(model, "expectations", null), type list)) then skipped("reference/relationship-model")
		                    else fnDetectMappingBacklog(pack, run, inScope, reference, model))
		                else if module = "review/lifecycle" then fnDetectReviewLifecycle(pack, run, inScope, reference)
		                else if module = "ci/name-standard" then (if reference = null then skipped(ref) else fnDetectCiNameStandard(pack, run, inScope, reference))
		                else if module = "ci/epo-id" then (if reference = null then skipped(ref) else fnDetectCiEpoId(pack, run, inScope, reference))
		                else if module = "ci/status-age" then (if reference = null then skipped(ref) else fnDetectCiStatusAge(pack, run, inScope, reference))
		                else if module = "criticality/above-parents" then (if not criticality then skipped(ref) else fnDetectCriticalityAboveParents(pack, run, inScope, reference))
		                else if module = "criticality/none-reaches" then (if not criticality then skipped(ref) else fnDetectCriticalityNoneReaches(pack, run, inScope, reference))
		                // A module listed in BuiltDetectors that has no branch here: never a silent pass (D15).
		                else [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: the detector " & module & " is listed as built, but fnCheckRun does not run it."}],
		        // One field per built check, worked out only when it is read (so a check can be timed alone: tools/powerbi/probes.ts).
		        noted = (pack as record) as record => let out = detect(pack) in out & [Notes = List.Transform(out[Notes], (note) => [CheckId = pack[id], Note = note])],
		        Outputs = List.Accumulate(built, [], (record, pack) => Record.AddField(record, pack[id], () => noted(pack), true)),
		        outputs = List.Buffer(List.Transform(built, (pack) => Record.Field(Outputs, pack[id]))),
		        combined = fnCombineOutputs(outputs),

		        // The relationship graph says once what it could not match (as the first check that builds it).
		        usesGraph = List.AnyTrue(List.Transform(built, (pack) => let module = moduleOf(pack) in
		            Text.StartsWith(module, "criticality/") or Text.StartsWith(module, "relationships/") or module = "process/stage" or module = "mapping/backlog")),
		        graphNotes = if graph = null or not usesGraph then {} else
		            (if graph[Unmatched] > 0 then {[CheckId = "RELATIONSHIPS", Note = Text.From(graph[Unmatched]) & " relationship " & (if graph[Unmatched] = 1 then "end is" else "ends are")
		                & " not in the CI report. They count by the class of the Relationship report, and their status is not known."]} else {})
		            & (if graph[Ambiguous] > 0 then {[CheckId = "RELATIONSHIPS", Note = Text.From(graph[Ambiguous]) & " relationship ends name a CI that two CIs share, and neither class nor asset tag told them apart. The first was used."]} else {}),

		        source = fnSourceFirst(combined[Findings], run, packs),
		        // The records findings are about that are not CIs of the report (contracts): the first of each key, for fnFacts.
		        subjects = List.Buffer(List.RemoveNulls(List.Transform(combined[Findings], (finding) => finding[Subject]))),
		        parkedFields = if parked = null then [] else parked[FieldSet],
		        kept = List.Buffer(List.Select(source[Findings], (finding) => not Record.HasFields(parkedFields, finding[CheckId] & ":" & finding[Field]) and not Record.HasFields(parkedSet, finding[CiKey]))),
		        parkedNotes = if parked = null then {[CheckId = "PARKED", Note = "Parked classes: reference data missing (reference/parked-classes), so every class is checked."]} else {},

		        // Where the fix is made and how findings are listed: never silent when the reference data is missing.
		        synced = fnReference("reference/epo-synced-classes"),
		        offeringClasses = if synced = null then {} else Record.FieldOrDefault(Record.FieldOrDefault(synced, "offerings", []), "classes", {}),
		        blind = if createdBy then 0 else List.Count(List.Select(cis, (ci) => List.Contains(offeringClasses, ci[Class]))),
		        routingNotes =
		            if synced = null then {[CheckId = "Routing", Note = "reference data missing (reference/epo-synced-classes), so no finding is routed to EPO."]}
		            else if blind > 0 then {[CheckId = "Routing", Note = "the report has no Created by column (sys_created_by), so " & Text.From(blind)
		                & " Service Offerings count as made by a person: they are fixed in ServiceNow, not in EPO."]}
		            else {},
		        listingNotes =
		            (if fnReference("reference/not-live-statuses") = null then {[CheckId = "Listing", Note = "reference data missing (reference/not-live-statuses), so findings on CIs that are not live yet are shown as to solve."]} else {})
		            & (if fnReference("reference/known-tags") = null then {[CheckId = "Listing", Note = "reference data missing (reference/known-tags), so findings a tag explains are shown as to solve."]} else {})
		    in
		        [
		            Date = date, FileName = file[FileName], Cis = cis, Columns = columns,
		            Facts = List.Buffer(fnFacts(kept, run & [Subjects = subjects], packs)), Subjects = subjects,
		            Tested = combined[Tested], Evaluated = combined[Evaluated],
		            Notes = graphNotes & combined[Notes] & source[Notes] & parkedNotes & routingNotes & listingNotes & hiddenNotes,
		            Parked = parked, Graph = graph, Epo = run[Epo], CheckableKeys = checkableKeys,
		            Paired = [
		                Relationship = if relationshipFile = null then null else relationshipFile[FileName], Epo = if epoFile = null then null else epoFile[FileName],
		                Solusi = if solusiFile = null then null else solusiFile[FileName], Contract = if contractFile = null then null else contractFile[FileName]
		            ],
		            // Never loaded into a table: for the probes of the refresh time (tools/powerbi/probes.ts).
		            Outputs = Outputs, RunContext = run, Stages = [Combined = combined, SourceFirst = source, Kept = kept]
		        ]
	queryGroup: Checks

/// Who to write to about a finding (src/core/cases/contact.ts, resolveContact; DOMAIN-RULES §5). `audience` is an ordered list; the first entry that gives a reachable person wins: a role ("owned_by"), "otherRoles" (the first other filled role), "managerOf(<role>)", "departmentHeadOf(<role>)", where "<role>" may be "field" (the role the finding is about). The role the finding is about is never the contact, and nobody marked inactive is. The other reachable roles are copied (Cc, their emails). Returns [To, Cc]; To is [Name, Email, Id, Via, Above] or null, Above the escalation ([Name, Email, Id, Via]) or null.
expression fnContact =
		(ci as record, field as text, audience as list, columns as list) as record =>
		    let
		        roles = ReadingRules[roles],
		        personOf = (role as text) as nullable record => fnPerson(ci, role, columns),
		        reachable = (person as nullable record) as logical => person <> null and person[Email] <> "" and person[Active] <> false,
		        idOf = (userId as text, email as text) as text => Text.Lower(Text.Trim(if userId <> "" then userId else email), "en-US"),
		        words = (role as text) as text => if Text.Contains(role, "_") then Text.BeforeDelimiter(role, "_") & " " & Text.AfterDelimiter(role, "_") else role,
		        others = List.Select(roles, (role) => role <> field and reachable(personOf(role))),
		        // The manager of a person (when `manager` is true and the manager is active), else the head of their department.
		        aboveOf = (person as record, manager as logical) as nullable record =>
		            if manager and person[ManagerEmail] <> "" and person[ManagerActive] <> false
		                then [Name = person[Manager], Email = person[ManagerEmail], Id = idOf(person[ManagerUserId], person[ManagerEmail]), Via = "manager"]
		            else if person[DepartmentHeadEmail] <> ""
		                then [Name = person[DepartmentHead], Email = person[DepartmentHeadEmail], Id = idOf(person[DepartmentHeadUserId], person[DepartmentHeadEmail]), Via = "department head"]
		            else null,
		        // For a person asked as Managed by (D160): the Owned by person of the CI, else the owner's manager or department head.
		        managedByAbove = (person as record) as nullable record =>
		            let
		                owner = personOf("owned_by"),
		                self = idOf(person[UserId], person[Email]),
		                ownerAbove = if owner <> null and (owner[Email] <> "" or owner[Name] <> "") then aboveOf(owner, true) else null
		            in
		                if reachable(owner) and idOf(owner[UserId], owner[Email]) <> self then [Name = owner[Name], Email = owner[Email], Id = idOf(owner[UserId], owner[Email]), Via = "owner"]
		                else if ownerAbove <> null and ownerAbove[Id] <> self then ownerAbove & [Via = if ownerAbove[Via] = "manager" then "manager of owner" else "department head of owner"]
		                else aboveOf(person, true),
		        asContact = (role as text) as record =>
		            let person = personOf(role) in
		            [Name = person[Name], Email = person[Email], Id = idOf(person[UserId], person[Email]), Via = words(role),
		                Above = if role = "managed_by" then managedByAbove(person) else aboveOf(person, true)],
		        fromEntry = (entry as text) as nullable record =>
		            let
		                isManager = Text.StartsWith(entry, "managerOf(") and Text.EndsWith(entry, ")") and Text.Length(entry) > 11,
		                isHead = Text.StartsWith(entry, "departmentHeadOf(") and Text.EndsWith(entry, ")") and Text.Length(entry) > 18,
		                inner = if isManager then Text.Middle(entry, 10, Text.Length(entry) - 11) else if isHead then Text.Middle(entry, 17, Text.Length(entry) - 18) else "",
		                role = if inner = "field" then field else inner,
		                person = personOf(role),
		                label = words(role)
		            in
		                if isManager then
		                    (if person <> null and person[ManagerEmail] <> "" and person[ManagerActive] <> false
		                    then [Name = person[Manager], Email = person[ManagerEmail], Id = idOf(person[ManagerUserId], person[ManagerEmail]), Via = "manager of " & label, Above = aboveOf(person, false)]
		                    else null)
		                else if isHead then
		                    (if person <> null and person[DepartmentHeadEmail] <> ""
		                    then [Name = person[DepartmentHead], Email = person[DepartmentHeadEmail], Id = idOf(person[DepartmentHeadUserId], person[DepartmentHeadEmail]),
		                        Via = "department head of " & label, Above = null]
		                    else null)
		                else if entry = "otherRoles" then (if List.IsEmpty(others) then null else asContact(others{0}))
		                else if List.Contains(others, entry) then asContact(entry)
		                else null,
		        to = List.Accumulate(audience, null, (found, entry) => if found <> null then found else fromEntry(entry)),
		        toEmail = if to = null then "" else Text.Lower(to[Email], "en-US"),
		        cc = List.Select(List.Transform(others, (role) => personOf(role)[Email]), (email) => Text.Lower(email, "en-US") <> toEmail)
		    in
		        [To = to, Cc = cc]
	queryGroup: Checks

/// The two contract files matched (src/core/sources/contracts/contract-reports.ts, compareContracts): the Solusi contract number is the Vendor contract of ServiceNow. Worked out once per run, when a contract check reads it. `solusi` and `servicenow` are the files of fnPairedFile. Returns [Solusi, ServiceNow] (each [Contracts, Date, Report]), Pairs (each [Solusi, ServiceNow, Subject, Differences]), NotInSolusi (a Solusi number the Solusi file does not hold), NoNumber (no Solusi number: typed in by hand), NotInServiceNow (not imported yet) and ServiceNowOf (Solusi number in lower case -> the ServiceNow contract of its pair). Differences: the fields Solusi holds and ServiceNow shows differently (contract-detectors.ts, fieldDifferences); a field empty in Solusi is not one (that is the card "To clear by hand").
expression fnContractCompare =
		(solusi as record, servicenow as record, config as record) as record =>
		    let
		        lower = (value as text) as text => Text.Lower(value, "en-US"),
		        solusiRows = List.Buffer(solusi[Rows]),
		        servicenowRows = List.Buffer(servicenow[Rows]),
		        // As a Map that is set contract after contract: the last contract of a number wins.
		        grouped = fnGroupBy(solusiRows, (contract) => lower(contract[Number])),
		        byNumber = Record.FromList(List.Transform(Record.FieldValues(grouped), List.Last), Record.FieldNames(grouped)),
		        matched = List.Buffer(List.Transform(servicenowRows, (contract) =>
		            let number = lower(contract[VendorContract]) in
		            [ServiceNow = contract, Number = number, Solusi = if number = "" then null else Record.FieldOrDefault(byNumber, number, null)])),
		        fields = List.Buffer(List.Transform(config[fields], (entry) => entry & [Column = fnPascal(entry[field])])),
		        blank = (value as any) as logical => value = null or value = "",
		        differences = (pair as record) as list =>
		            List.Transform(List.Select(fields, (entry) =>
		                let
		                    one = Record.Field(pair[Solusi], entry[Column]),
		                    other = Record.Field(pair[ServiceNow], entry[Column])
		                in
		                    not blank(one) and not (if entry[kind] = "date" then one = other else fnNameKey(one, "") = fnNameKey(if other = null then "" else other, ""))),
		                (entry) => [Field = entry[field], Label = entry[label], Kind = entry[kind],
		                    Solusi = Record.Field(pair[Solusi], entry[Column]), ServiceNow = Record.Field(pair[ServiceNow], entry[Column])]),
		        pairs = List.Buffer(List.Transform(List.Select(matched, (item) => item[Solusi] <> null), (item) =>
		            let pair = [Solusi = item[Solusi], ServiceNow = item[ServiceNow]] in
		            pair & [Subject = fnContractSubject(item[ServiceNow], item[Solusi]), Differences = List.Buffer(differences(pair))])),
		        seen = fnKeySet(List.Transform(List.Select(matched, (item) => item[Solusi] <> null), (item) => item[Number])),
		        // The ServiceNow contract of each paired Solusi number (the last pair of a number wins, as a Map).
		        pairsByNumber = fnGroupBy(pairs, (pair) => lower(pair[Solusi][Number]))
		    in
		        [
		            Solusi = [Contracts = solusiRows, Date = solusi[ReportDate], Report = solusi[FileName]],
		            ServiceNow = [Contracts = servicenowRows, Date = servicenow[ReportDate], Report = servicenow[FileName]],
		            Pairs = pairs,
		            NotInSolusi = List.Buffer(List.Transform(List.Select(matched, (item) => item[Number] <> "" and item[Solusi] = null), (item) => item[ServiceNow])),
		            NoNumber = List.Buffer(List.Transform(List.Select(matched, (item) => item[Number] = ""), (item) => item[ServiceNow])),
		            NotInServiceNow = List.Buffer(List.Select(solusiRows, (contract) => not Record.HasFields(seen, lower(contract[Number])))),
		            ServiceNowOf = Record.FromList(List.Transform(Record.FieldValues(pairsByNumber), (list) => List.Last(list)[ServiceNow]), Record.FieldNames(pairsByNumber))
		        ]
	queryGroup: Checks

/// A contract as a CI-shaped record (src/core/sources/contracts/contract-reports.ts, contractSubject), so a finding about it is listed, asked and shown like a finding about a CI. Its key is contract:<Solusi number> (the ServiceNow number when there is none); the name shown is "<number>: <name>"; Owned by is the contract owner. SubjectColumns says which roles it has (fnFacts reads them instead of the columns of the CI report). It is never mixed with the CIs of the CI report. `servicenow` and `solusi` are rows of the two contract readers; either may be null.
expression fnContractSubject =
		(servicenow as nullable record, solusi as nullable record) as record =>
		    let
		        text = (row as nullable record, field as text) as text => if row = null then "" else let value = Record.Field(row, field) in if value = null then "" else value,
		        number = List.First(List.Select({text(solusi, "Number"), text(servicenow, "VendorContract"), text(servicenow, "Number")}, (value) => value <> ""), ""),
		        name = if text(servicenow, "Name") <> "" then text(servicenow, "Name") else text(solusi, "Name"),
		        status = if text(servicenow, "State") <> "" then text(servicenow, "State") else text(solusi, "Status"),
		        tags = if text(servicenow, "Tags") = "" then {} else Text.Split(text(servicenow, "Tags"), ", "),
		        owner =
		            if text(servicenow, "Owner") <> "" then
		                [OwnedBy = servicenow[Owner], OwnedByEmail = servicenow[OwnerEmail], OwnedByUserId = servicenow[OwnerUserId], OwnedByActive = servicenow[OwnerActive]]
		            else if text(solusi, "Owner") <> "" then [OwnedBy = solusi[Owner], OwnedByEmail = "", OwnedByUserId = "", OwnedByActive = null]
		            else []
		    in
		        [
		            Key = "contract:" & Text.Lower(Text.Trim(number), "en-US"), Name = if name <> "" then number & ": " & name else number,
		            Class = "contract", SourceClass = "Contract", AssetTag = "", Status = status, StatusKey = fnNameKey(status, ""), NameKey = fnNameKey(name, ""),
		            SupportGroup = "", TagList = tags, TagKeys = List.Buffer(List.Transform(tags, (tag) => fnNameKey(tag, ""))),
		            Contract = [Number = number, Name = name, Vendor = if text(servicenow, "Vendor") <> "" then text(servicenow, "Vendor") else text(solusi, "Vendor")],
		            SubjectColumns = if Record.FieldCount(owner) > 0 then {"owned_by"} else {}
		        ] & owner
	queryGroup: Checks

/// The EPO ID (code detector ci/epo-id, src/core/checks/detectors/ci-detectors.ts). The EPO ID is the asset tag (reference/epo-id): missing on a class that must have one (or listed for a review), and two live CIs that share one.
expression fnDetectCiEpoId =
		(pack as record, run as record, inScope as list, reference as record) as record =>
		    let
		        columns = run[Columns],
		        required = Record.FieldOrDefault(reference, "required", {}),
		        reviewWhen = Record.FieldOrDefault(reference, "reviewWhenMissing", {}),
		        reviewWhy = Record.FieldOrDefault(reference, "reviewWhy", ""),
		        applies = (classes as nullable list, ci as record) as logical => classes = null or List.Contains(classes, "*") or List.Contains(classes, ci[Class]),
		        exempt = (ci as record) as logical => List.AnyTrue(List.Transform(Record.FieldOrDefault(reference, "notNeeded", {}), (rule) => applies(rule[classes], ci) and fnMatches(rule[name], "", ci[Name]))),
		        checked = List.Select(inScope, (ci) => (List.Contains(required, ci[Class]) or List.Contains(reviewWhen, ci[Class])) and not exempt(ci)),
		        missing = [
		            Findings = List.Transform(List.Select(checked, (ci) => ci[AssetTag] = ""), (ci) =>
		                fnFinding(pack, ci, "missing", "No EPO ID", if List.Contains(required, ci[Class]) then [] else [Review = if reviewWhy <> "" then reviewWhy else "Review only"])),
		            Tested = {pack[id] & ":missing"}, Evaluated = {[Part = pack[id] & ":missing", Count = List.Count(checked)]}, Notes = {}
		        ],
		        // The number of a Service Offering against its Business Service needs a part of the pattern back: not built in Power BI yet.
		        number = if Record.HasFields(reference, "offeringNumber")
		            then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested for the number of the Business Service: this part is not built in the Power BI version yet."}]
		            else [Findings = {}, Tested = {}, Evaluated = {}, Notes = {}],
		        tagged = List.Select(inScope, (ci) => ci[AssetTag] <> ""),
		        byTag = fnGroupBy(tagged, (ci) => Text.Lower(ci[AssetTag], "en-US")),
		        repeated = List.Select(Record.FieldValues(byTag), (list) => List.Count(list) > 1),
		        duplicate = if Record.FieldOrDefault(reference, "unique", false) <> true then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {}] else [
		            // The names of a group sorted once; each finding leaves out its own name (the first place it is in).
		            Findings = List.Combine(List.Transform(repeated, (list) =>
		                let sortedNames = List.Buffer(List.Sort(List.Transform(list, (other) => other[Name]), Comparer.FromCulture("en-US"))) in
		                List.Transform(List.Positions(list), (at) =>
		                let
		                    ci = list{at},
		                    others = List.RemoveRange(sortedNames, List.PositionOf(sortedNames, ci[Name]), 1)
		                in
		                    fnFinding(pack, ci, "duplicate", "EPO ID " & ci[AssetTag] & " is also on " & Text.Combine(others, ", "))))),
		            Tested = {pack[id] & ":duplicate"}, Evaluated = {[Part = pack[id] & ":duplicate", Count = List.Count(tagged)]}, Notes = {}
		        ]
		    in
		        if not List.Contains(columns, "assetTag") then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: the report has no column for the EPO ID (asset_tag)."}]
		        else fnCombineOutputs({missing, number, duplicate})
	queryGroup: Checks

/// Name not standard (code detector ci/name-standard, src/core/checks/detectors/ci-detectors.ts): a name rule of the CI's class (reference/name-rules) is broken. The pack names the rules it applies (detector.rules).
expression fnDetectCiNameStandard =
		(pack as record, run as record, inScope as list, reference as record) as record =>
		    let
		        wanted = Record.FieldOrDefault(pack[detector], "rules", null),
		        rules = List.Select(Record.FieldOrDefault(reference, "rules", {}), (rule) => wanted = null or List.Contains(wanted, rule[id])),
		        applies = (classes as nullable list, ci as record) as logical => classes = null or List.Contains(classes, "*") or List.Contains(classes, ci[Class]),
		        perRule = List.Transform(rules, (rule) =>
		            let
		                when = Record.FieldOrDefault(rule, "when", null),
		                pattern = Record.FieldOrDefault(rule, "pattern", null),
		                evaluated = List.Select(inScope, (ci) => applies(Record.FieldOrDefault(rule, "classes", null), ci) and (when = null or when = "" or fnMatches(when, "", ci[Name]))),
		                broken = List.Select(evaluated, (ci) =>
		                    (pattern <> null and pattern <> "" and not fnMatches(pattern, "", ci[Name])) or (Record.FieldOrDefault(rule, "noOuterSpaces", false) = true and ci[NameSpaces] = true)),
		                set = Record.FieldOrDefault(rule, "set", null)
		            in
		                [
		                    Findings = List.Transform(broken, (ci) => fnFinding(pack, ci, rule[id], rule[say],
		                        [Fix = if set = null then null else [Change = "Name of " & ci[Name], Current = rule[say], Set = set, Value = ""]])),
		                    Tested = {pack[id] & ":" & rule[id]},
		                    Evaluated = {[Part = pack[id] & ":" & rule[id], Count = List.Count(evaluated)]},
		                    Notes = {}
		                ])
		    in
		        fnCombineOutputs(perRule)
	queryGroup: Checks

/// How long a CI sits in a status (code detector ci/status-age, src/core/checks/detectors/ci-detectors.ts): more than `days` days in the status of the rule (reference/lifecycle), counted from the day the record was created or last changed to the date of the report. Every CI of the scope is tested; only a CI in the status without a date is not. A rule with a setting (underRetirementDays, readyDays) takes its days from the team's settings (CaseRules, D158; build B8, D308), as withTeamDays of the HTML app does. The history keeps the days of the refresh that computed each day.
expression fnDetectCiStatusAge =
		(pack as record, run as record, inScope as list, reference as record) as record =>
		    let
		        columns = run[Columns],
		        date = run[Date],
		        wanted = Record.FieldOrDefault(pack[detector], "rules", null),
		        rules = List.Select(Record.FieldOrDefault(reference, "rules", {}), (rule) => wanted = null or List.Contains(wanted, rule[id])),
		        fixLine = Record.FieldOrDefault(pack, "playbook", [])[path] = "sacm-fix",
		        teamDays = [underRetirementDays = CaseRules[UnderRetirementDays], readyDays = CaseRules[ReadyDays]],
		        perRule = List.Transform(rules, (given) =>
		            let
		                setting = Record.FieldOrDefault(given, "setting", ""),
		                rule = if setting <> "" and Record.HasFields(teamDays, setting) then given & [days = Record.Field(teamDays, setting)] else given,
		                column = if rule[from] = "created" then "createdOn" else "updatedOn",
		                word = if rule[from] = "created" then "Created (sys_created_on)" else "Updated (sys_updated_on)",
		                sinceOf = (ci as record) as nullable date => if rule[from] = "created" then ci[CreatedOn] else ci[UpdatedOn],
		                status = fnNameKey(rule[status], ""),
		                inStatus = List.Buffer(List.Select(inScope, (ci) => ci[StatusKey] = status)),
		                unread = List.Count(List.Select(inStatus, (ci) => sinceOf(ci) = null)),
		                over = List.Select(inStatus, (ci) => sinceOf(ci) <> null and Duration.Days(date - sinceOf(ci)) > rule[days]),
		                fill = (ci as record) as text =>
		                    let since = sinceOf(ci) in
		                    Text.Replace(Text.Replace(Text.Replace(Text.Replace(rule[say], "{status}", ci[Status]), "{days}", Text.From(rule[days])),
		                        "{date}", fnLongDate(since)), "{age}", Text.From(Duration.Days(date - since))),
		                fix = Record.FieldOrDefault(rule, "fix", null)
		            in
		                if not List.Contains(columns, "operationalStatus") or not List.Contains(columns, column) then
		                    [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: the report has no column for " & (if not List.Contains(columns, "operationalStatus") then "Operational status" else word) & "."}]
		                else if date = null then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: the date of the report is not known."}]
		                else [
		                    Findings = List.Transform(over, (ci) => fnFinding(pack, ci, rule[id], fill(ci),
		                        [Fix = if fixLine and fix <> null then [Change = fix[change], Current = ci[Status] & " since " & fnLongDate(sinceOf(ci)), Set = fix[set], Value = ""] else null])),
		                    Tested = {pack[id] & ":" & rule[id]},
		                    Evaluated = {[Part = pack[id] & ":" & rule[id], Count = List.Count(inScope) - unread]},
		                    Notes = if unread > 0 then {"Partly tested: " & Text.From(unread) & " CIs in status " & rule[status] & " have no date the tool can read."} else {}
		                ])
		    in
		        fnCombineOutputs(perRule)
	queryGroup: Checks

/// Not in Solusi (code detector contracts/not-in-solusi, src/core/checks/detectors/contract-detectors.ts): a contract in ServiceNow that the Solusi contract file does not hold, or that has no Solusi number at all (typed in by hand), is to delete (D144). "Still linked" only says what links it to the CMDB: a criticality from a CI, the tag that sets the criticality by hand, or a running status that has not ended at the date of the CI report. SACM deletes it; the report deletes nothing. Every finding carries its contract as Subject (fnContractSubject).
expression fnDetectContractsNotInSolusi =
		(pack as record, run as record, config as record) as record =>
		    let
		        words = ContractWords,
		        contracts = run[Contracts],
		        date = run[Date],
		        solusiDate = if contracts[Solusi][Date] = null then "" else fnLongDate(contracts[Solusi][Date]),
		        stillLinked = (contract as record) as text =>
		            let
		                tag = words[TargetTag](contract, config),
		                running = words[InList](config[runningStatuses], contract[State]) and (contract[End] = null or date = null or contract[End] >= date),
		                reasons = (if contract[Criticality] = true then {"it carries a criticality from a CI"} else {})
		                    & (if tag <> "" then {"it is tagged " & tag} else {})
		                    & (if running then {if contract[End] <> null then "it is " & contract[State] & " and ends " & fnLongDate(contract[End]) else "it is " & contract[State] & " with no end date"} else {})
		            in
		                if List.IsEmpty(reasons) then "" else "Still linked: " & Text.Combine(reasons, "; "),
		        findingOf = (contract as record) as record =>
		            let
		                note = stillLinked(contract),
		                state = if contract[State] = "" then "empty" else contract[State],
		                detail = if contract[VendorContract] = ""
		                    then "In ServiceNow with no Solusi contract number (status " & state & "): it does not come from Solusi"
		                    else "In ServiceNow (status " & state & "), not in the Solusi contract file of " & solusiDate,
		                subject = fnContractSubject(contract, null)
		            in
		                fnFinding(pack, subject, "record", if note <> "" then detail & ". " & note else detail, [
		                    Fix = [Change = "Delete the contract in ServiceNow", Current = contract[Number] & ", " & (if contract[State] = "" then "no status" else contract[State]), Set = "Deleted", Note = note],
		                    Subject = subject])
		    in
		        [
		            Findings = List.Buffer(List.Transform(contracts[NotInSolusi] & contracts[NoNumber], findingOf)),
		            Tested = {pack[id] & ":record"},
		            Evaluated = {[Part = pack[id] & ":record", Count = List.Count(contracts[ServiceNow][Contracts])]},
		            Notes = {}
		        ]
	queryGroup: Checks

/// The problems of the contract data (code detector contracts/problems, src/core/checks/detectors/contract-detectors.ts, contractProblems): the list `problems` of reference/contract-reports; a check raises the ones of its detector.rules (all when it has none). One finding per contract and problem; the field is the id of the problem and Problem its label, so the message shows one table per problem. "For Procurement" raises the problems of Solusi itself; "Contracts to fix in ServiceNow" the ones SACM corrects in ServiceNow, each with its line of the fix list (D145). An inactive contract owner or Procurement partner is SACM's when the loaded reports know an active account with the same name (the upload picked the wrong account), and Procurement's when they know none (the person left, D193). Every problem is marked as tested, also the ones a check does not raise, so a problem that moved to the other card closes on this one.
expression fnDetectContractsProblems =
		(pack as record, run as record, config as record) as record =>
		    let
		        words = ContractWords,
		        contracts = run[Contracts],
		        pairs = contracts[Pairs],
		        solusiDate = contracts[Solusi][Date],
		        servicenowContracts = contracts[ServiceNow][Contracts],
		        rules = Record.FieldOrDefault(pack[detector], "rules", null),
		        wanted = (id as text) as logical => rules = null or List.Contains(rules, id),
		        fixList = Record.FieldOrDefault(Record.FieldOrDefault(pack, "playbook", []), "path", "") = "sacm-fix",
		        problemOf = (id as text) as nullable record => List.First(List.Select(config[problems], (entry) => entry[id] = id), null),
		        label = (id as text) as text => let found = problemOf(id) in if found = null then id else found[label],
		        fixOf = (id as text, current as text) as nullable record =>
		            let found = problemOf(id) in
		            if not fixList then null
		            else [Change = if found = null then id else Record.FieldOrDefault(found, "change", found[label]), Current = current, Set = if found = null then "" else Record.FieldOrDefault(found, "set", "")],
		        line = (subject as record, field as text, detail as text, fix as nullable record, group as text) as record =>
		            fnFinding(pack, subject, field, detail, [Fix = fix, Problem = group, Subject = subject]),
		        // A finding of problem `id` when the check raises it.
		        raise = (subject as record, id as text, detail as text, current as text) as list =>
		            if wanted(id) then {line(subject, id, detail, fixOf(id, current), label(id))} else {},
		        tested = (id as text, count as number) as record =>
		            [Findings = {}, Tested = {pack[id] & ":" & id}, Notes = {},
		                Evaluated = if wanted(let at = Text.PositionOf(id, ".") in if at < 0 then id else Text.Start(id, at)) then {[Part = pack[id] & ":" & id, Count = count]} else {}],
		        none = [Findings = {}, Tested = {}, Evaluated = {}, Notes = {}],
		        noted = (id as text, text as text) as list => if wanted(id) then {text} else {},
		        running = (contract as record) as logical => words[InList](config[runningStatuses], contract[Status]),
		        concluded = (contract as record) as logical => words[InList](config[concludedStatuses], contract[Status]),
		        active = List.Buffer(List.Select(contracts[Solusi][Contracts], (contract) => contract[Sheet] = "active")),
		        servicenowOf = (contract as record) as nullable record => Record.FieldOrDefault(contracts[ServiceNowOf], Text.Lower(contract[Number], "en-US"), null),
		        subjectOf = (contract as record) as record => fnContractSubject(servicenowOf(contract), contract),

		        // The active accounts the loaded reports know, by the name of the person (D193, activeAccounts): the people of
		        // the CIs and their managers, and the people of the ServiceNow contracts. Only an account with a user ID counts.
		        accounts =
		            let
		                columns = run[Columns],
		                account = (name as text, userId as text, isActive as any) as list =>
		                    if Text.Trim(name) = "" or Text.Trim(userId) = "" or isActive <> true then {} else {[Name = fnNameKey(name, ""), Id = Text.Lower(Text.Trim(userId), "en-US")]},
		                ofCis = List.Combine(List.Transform(run[Cis], (ci) => List.Combine(List.Transform(ReadingRules[roles], (role) =>
		                    let person = fnPerson(ci, role, columns) in
		                    if person = null then {} else account(person[Name], person[UserId], person[Active]) & account(person[Manager], person[ManagerUserId], person[ManagerActive]))))),
		                ofContracts = List.Combine(List.Transform(servicenowContracts, (contract) =>
		                    account(contract[Owner], contract[OwnerUserId], contract[OwnerActive]) & account(contract[ProcurementPartner], contract[ProcurementPartnerUserId], contract[ProcurementPartnerActive]))),
		                grouped = fnGroupBy(ofCis & ofContracts, (entry) => entry[Name])
		            in
		                Record.FromList(List.Transform(Record.FieldValues(grouped), (entries) => List.Distinct(List.Transform(entries, (entry) => entry[Id]))), Record.FieldNames(grouped)),
		        runningPairs = List.Buffer(List.Select(pairs, (pair) => running(pair[Solusi]))),
		        people = {
		            [Id = "ownerInactive", Left = "ownerLeft", Field = "Owner", Flag = "OwnerActive", UserId = "OwnerUserId", Word = "Contract owner"],
		            [Id = "partnerInactive", Left = "partnerLeft", Field = "ProcurementPartner", Flag = "ProcurementPartnerActive", UserId = "ProcurementPartnerUserId", Word = "Procurement partner"]
		        },
		        inactive = List.Transform(people, (entry) =>
		            let
		                lowerWord = Text.Lower(entry[Word], "en-US"),
		                known = List.AnyTrue(List.Transform(servicenowContracts, (contract) => Record.Field(contract, entry[Flag]) <> null)),
		                findingsOf = (pair as record) as list =>
		                    let
		                        contract = pair[ServiceNow],
		                        name = Record.Field(contract, entry[Field]),
		                        own = Text.Lower(Text.Trim(Record.Field(contract, entry[UserId])), "en-US"),
		                        others = List.Sort(List.Select(Record.FieldOrDefault(accounts, fnNameKey(name, ""), {}), (id) => id <> own)),
		                        fix = fixOf(entry[Id], name & " (" & (if own <> "" then own & ", " else "") & "inactive)")
		                    in
		                        if name = "" or Record.Field(contract, entry[Flag]) <> false then {}
		                        else if List.IsEmpty(others) then
		                            raise(pair[Subject], entry[Left], entry[Word] & " " & name & " is no longer active in ServiceNow, and no active account with that name is known", name & " (inactive)")
		                        else if not wanted(entry[Id]) then {}
		                        else {line(pair[Subject], entry[Id],
		                            entry[Word] & " " & name & " is inactive in ServiceNow" & (if own <> "" then " (account " & own & ")" else "") & ". An active account with the same name exists: " & Text.Combine(others, " or "),
		                            if fix = null then null else fix & [Set = name & " (" & Text.Combine(others, " or ") & ")", Value = if List.Count(others) = 1 then others{0} else ""],
		                            label(entry[Id]))}
		            in
		                if not known then none & [Notes =
		                    noted(entry[Id], "Not tested for an inactive " & lowerWord & ": the ServiceNow contract report has no column that says if the person is active.")
		                    & noted(entry[Left], "Not tested for a " & lowerWord & " who left: the ServiceNow contract report has no column that says if the person is active.")]
		                else fnCombineOutputs({tested(entry[Id], List.Count(runningPairs)), tested(entry[Left], List.Count(runningPairs))})
		                    & [Findings = List.Buffer(List.Combine(List.Transform(runningPairs, findingsOf))), Notes = {}]),

		        // The dates, the vendor number and the contract owner of the active tab of Solusi.
		        concludedCount = List.Count(List.Select(active, concluded)),
		        ofActive = List.Combine(List.Transform(active, (contract) =>
		            let subject = subjectOf(contract) in
		            (if concluded(contract) and contract[End] <> null and solusiDate <> null and contract[End] < solusiDate
		                then raise(subject, "endPassed", contract[Status] & ", but the end date " & fnLongDate(contract[End]) & " has passed", contract[Status] & ", ends " & fnLongDate(contract[End])) else {})
		            & (if concluded(contract) and contract[End] = null and words[InList](config[fixedTermWords], contract[Duration])
		                then raise(subject, "noEnd", contract[Duration] & ", but no end date", contract[Duration] & ", no end date") else {})
		            & (if contract[VendorNumber] = ""
		                then raise(subject, "noVendorNumber", "No vendor number for " & (if contract[Vendor] <> "" then contract[Vendor] else "the vendor") & ", so the vendor stays empty in ServiceNow", "") else {})
		            & (if running(contract) and contract[Owner] = "" then raise(subject, "noOwner", "No contract owner", "") else {}))),
		        dates = fnCombineOutputs({tested("endPassed", concludedCount), tested("noEnd", concludedCount), tested("noVendorNumber", List.Count(active)),
		            tested("noOwner", List.Count(List.Select(active, running)))}) & [Findings = List.Buffer(ofActive)],

		        // A name of a person that ServiceNow shows differently: most often free text that ServiceNow did not recognise.
		        personFields = List.Select(config[fields], (entry) => entry[kind] = "person"),
		        names = fnCombineOutputs(List.Transform(personFields, (entry) => tested("personName." & entry[field], List.Count(pairs)))) & [Findings =
		            if not wanted("personName") then {}
		            else List.Buffer(List.Combine(List.Transform(pairs, (pair) => List.Transform(List.Select(pair[Differences], (difference) => difference[Kind] = "person"), (difference) =>
		                let fix = fixOf("personName", if difference[ServiceNow] = "" then "nobody" else difference[ServiceNow]) in
		                line(pair[Subject], "personName." & difference[Field],
		                    difference[Label] & ": Solusi has """ & difference[Solusi] & """, ServiceNow has " & (if difference[ServiceNow] = "" then "nobody" else """" & difference[ServiceNow] & """"),
		                    if fix = null then null else fix & [Change = difference[Label] & ": " & fix[Change], Set = difference[Solusi], Value = difference[Solusi]],
		                    label("personName"))))))],

		        // The EPO ID column: a system that is Retired, or a number that is not an EPO ID.
		        epo = config[epo],
		        epoIds =
		            if not List.Contains(run[Columns], "assetTag") then none & [Notes = noted("epoUnknown", "Not tested for the EPO ID of a contract: the CI report has no column for the EPO ID (asset_tag).")]
		            else
		                let
		                    systemCis = List.Select(run[Cis], (ci) => List.Contains(epo[classes], ci[Class]) and Text.Trim(ci[AssetTag]) <> ""),
		                    systems = fnGroupBy(systemCis, (ci) => Text.Lower(Text.Trim(ci[AssetTag]), "en-US")),
		                    retired = (ci as record) as logical => words[InList](epo[retiredStatuses], ci[Status]),
		                    // An id counts as known as it is written ("AST-0006") or by its digits.
		                    idsOf = (contract as record) as list => List.Distinct(List.Transform(fnEpoIds(contract[EpoId], epo[minDigits]), (id) =>
		                        if Record.HasFields(systems, Text.Lower(id[Written], "en-US")) then Text.Lower(id[Written], "en-US") else id[Digits])),
		                    withIds = List.Buffer(List.Select(List.Transform(List.Select(active, running), (contract) => [Contract = contract, Ids = idsOf(contract)]), (item) => not List.IsEmpty(item[Ids]))),
		                    findingsOf = (item as record) as list =>
		                        let
		                            contract = item[Contract],
		                            subject = subjectOf(contract),
		                            gone = List.Select(item[Ids], (id) => Record.HasFields(systems, id) and List.AllTrue(List.Transform(Record.Field(systems, id), retired))),
		                            unknown = List.Select(item[Ids], (id) => not Record.HasFields(systems, id)),
		                            named = (id as text) as text => let ci = Record.Field(systems, id){0} in Text.Trim(ci[AssetTag]) & " (" & ci[Name] & ")"
		                        in
		                            (if List.IsEmpty(gone) then {} else raise(subject, "epoRetired", "EPO ID " & Text.Combine(List.Transform(gone, named), ", ") & ": the system is Retired", ""))
		                            & (if List.IsEmpty(unknown) then {} else raise(subject, "epoUnknown", "EPO ID " & Text.Combine(unknown, ", ") & ": not the EPO ID of a system in ServiceNow", ""))
		                in
		                    fnCombineOutputs({tested("epoRetired", List.Count(withIds)), tested("epoUnknown", List.Count(withIds))}) & [Findings = List.Buffer(List.Combine(List.Transform(withIds, findingsOf)))]
		    in
		        fnCombineOutputs(inactive & {dates, names, epoIds})
	queryGroup: Checks

/// Contract status (code detector contracts/status, src/core/checks/detectors/contract-detectors.ts): ServiceNow sets "Expired" by itself from the end date (known challenge 4), so the real Solusi status is kept as a tag. A contract that ServiceNow shows as Expired needs the tag of the Solusi status; a contract whose status was imported carries no other status tag. Contracts of the tab "terminated in the last 7 days" are checked the same way (known challenge 3). A status that differs while ServiceNow did not set it is on the card "Upload check".
expression fnDetectContractsStatus =
		(pack as record, run as record, config as record) as record =>
		    let
		        words = ContractWords,
		        pairs = run[Contracts][Pairs],
		        findingOf = (pair as record) as nullable record =>
		            let
		                wanted = pair[Solusi][Status],
		                contract = pair[ServiceNow],
		                state = contract[State],
		                tag = words[StatusTag](contract, config),
		                from = if pair[Solusi][Sheet] = "terminated" then " (terminated in the last 7 days)" else "",
		                line = (detail as text, fix as record) as record => fnFinding(pack, pair[Subject], "status", detail, [Fix = fix, Subject = pair[Subject]])
		            in
		                if wanted = "" then null
		                else if words[InList](config[autoStates], state) then
		                    (if tag = "" then line("ServiceNow shows " & state & " and has no status tag. Solusi says " & wanted & from,
		                        [Change = "Add the tag " & wanted, Current = state & ", no status tag", Set = "tag " & wanted])
		                    else if not words[SameWord](tag, wanted) then line("ServiceNow shows " & state & " with the tag " & tag & ". Solusi says " & wanted & from,
		                        [Change = "Change the tag " & tag & " to " & wanted, Current = "tag " & tag, Set = "tag " & wanted])
		                    else null)
		                else if words[SameWord](state, wanted) and tag <> "" and not words[SameWord](tag, wanted) then
		                    line("ServiceNow shows " & state & ", like Solusi, but carries the tag " & tag,
		                        [Change = "Remove the tag " & tag, Current = state & ", tag " & tag, Set = "no other status tag"])
		                else null
		    in
		        [
		            Findings = List.Buffer(List.RemoveNulls(List.Transform(pairs, findingOf))),
		            Tested = {pack[id] & ":status"},
		            Evaluated = {[Part = pack[id] & ":status", Count = List.Count(pairs)]},
		            Notes = {}
		        ]
	queryGroup: Checks

/// To clear by hand (code detector contracts/to-clear, src/core/checks/detectors/contract-detectors.ts): the import from Solusi never clears a field (known challenge 2), so a value Procurement removed in Solusi stays in ServiceNow until SACM clears it. An old end date matters most: ServiceNow shows the contract as Expired because of it.
expression fnDetectContractsToClear =
		(pack as record, run as record, config as record) as record =>
		    let
		        words = ContractWords,
		        contracts = run[Contracts],
		        pairs = contracts[Pairs],
		        solusiDate = if contracts[Solusi][Date] = null then "" else fnLongDate(contracts[Solusi][Date]),
		        fields = List.Buffer(List.Transform(config[fields], (entry) => entry & [Column = fnPascal(entry[field])])),
		        findings = List.Combine(List.Transform(pairs, (pair) => List.Transform(
		            List.Select(fields, (entry) => words[Blank](Record.Field(pair[Solusi], entry[Column])) and not words[Blank](Record.Field(pair[ServiceNow], entry[Column]))),
		            (entry) =>
		                let
		                    shown = words[Shown](Record.Field(pair[ServiceNow], entry[Column])),
		                    state = pair[ServiceNow][State],
		                    expired = if entry[field] = "end" and words[InList](config[autoStates], state) then "; ServiceNow shows the contract as " & state & " only because of it" else ""
		                in
		                    fnFinding(pack, pair[Subject], entry[field],
		                        entry[label] & " is empty in the Solusi contract file of " & solusiDate & ", ServiceNow still has " & shown & expired,
		                        [Fix = [Change = entry[label] & ": clear it", Current = shown, Set = "empty (empty in Solusi)"], Subject = pair[Subject]]))))
		    in
		        [
		            Findings = List.Buffer(findings),
		            Tested = List.Transform(fields, (entry) => pack[id] & ":" & entry[field]),
		            Evaluated = List.Transform(fields, (entry) => [Part = pack[id] & ":" & entry[field], Count = List.Count(pairs)]),
		            Notes = {}
		        ]
	queryGroup: Checks

/// Upload check (code detector contracts/upload-check, src/core/checks/detectors/contract-detectors.ts): a field differs between Solusi and ServiceNow after the import, the status was not imported, or a contract is not in ServiceNow yet. A SACM fix list grouped by field (D146): SACM first asks "was this Solusi file uploaded?", then sets the Solusi value. A person's name is not here (card "Contracts to fix in ServiceNow"), nor a vendor that is empty because Solusi has no vendor number (card "For Procurement").
expression fnDetectContractsUploadCheck =
		(pack as record, run as record, config as record) as record =>
		    let
		        words = ContractWords,
		        contracts = run[Contracts],
		        pairs = contracts[Pairs],
		        parts = List.Transform(config[fields], (entry) => entry[field]) & {"status", "record"},
		        lines = (pair as record) as list =>
		            let
		                solusi = pair[Solusi],
		                state = pair[ServiceNow][State],
		                kept = List.Select(pair[Differences], (difference) => difference[Kind] <> "person"
		                    and not (difference[Field] = "vendor" and words[Blank](difference[ServiceNow]) and solusi[VendorNumber] = "")),
		                fields = List.Transform(kept, (difference) =>
		                    let
		                        now = if words[Blank](difference[ServiceNow]) then "nothing" else words[Shown](difference[ServiceNow]),
		                        value = words[Shown](difference[Solusi])
		                    in
		                        fnFinding(pack, pair[Subject], difference[Field], difference[Label] & ": Solusi has " & value & ", ServiceNow has " & now, [
		                            Fix = [Change = difference[Label] & ": set the value of Solusi", Current = now, Set = value, Value = if difference[Kind] = "text" then difference[Solusi] else ""],
		                            Problem = difference[Label], Subject = pair[Subject]])),
		                status = if solusi[Status] <> "" and state <> "" and not words[InList](config[autoStates], state) and not words[SameWord](state, solusi[Status]) then
		                    {fnFinding(pack, pair[Subject], "status", "Status: Solusi has " & solusi[Status] & ", ServiceNow has " & state, [
		                        Fix = [Change = "Status: set the status of Solusi", Current = state, Set = solusi[Status]], Problem = "Status", Subject = pair[Subject]])}
		                    else {}
		            in
		                fields & status,
		        missing = List.Transform(contracts[NotInServiceNow], (contract) =>
		            let subject = fnContractSubject(null, contract) in
		            fnFinding(pack, subject, "record",
		                "In the Solusi contract file (" & (if contract[Status] = "" then "no status" else contract[Status]) & (if contract[Start] <> null then ", starts " & fnLongDate(contract[Start]) else "") & "), not in ServiceNow yet",
		                [Fix = [Change = "Bring the contract into ServiceNow (upload the Solusi contract file again, or create it)", Current = "not in ServiceNow", Set = "in ServiceNow"],
		                    Problem = "Not in ServiceNow yet", Subject = subject]))
		    in
		        [
		            Findings = List.Buffer(List.Combine(List.Transform(pairs, lines)) & missing),
		            Tested = List.Transform(parts, (part) => pack[id] & ":" & part),
		            Evaluated = List.Transform(parts, (part) => [Part = pack[id] & ":" & part, Count = if part = "record" then List.Count(contracts[Solusi][Contracts]) else List.Count(pairs)]),
		            Notes = {}
		        ]
	queryGroup: Checks

/// Above the parents (code detector criticality/above-parents, src/core/checks/detectors/criticality-detectors.ts): a Target value higher than every value the parents pass on (their Target, else their Inherited value). Parents over a relationship excluded from calculation do not count (D131). Each finding is first for SACM to review. Without the Relationship report, the Target is compared with the Inherited field.
expression fnDetectCriticalityAboveParents =
		(pack as record, run as record, inScope as list, rules as record) as record =>
		    let
		        columns = run[Columns],
		        graph = run[Graph],
		        review = "SACM checks the mapping first: a parent relationship may be missing",
		        passes = (node as record, dimension as text) as nullable number =>
		            if node[Ci] = null then null
		            else let target = fnLevelAt(node[Ci], "target." & dimension) in if target <> null then target else fnLevelAt(node[Ci], "inherited." & dimension),
		        perDimension = List.Transform(ReadingRules[dimensions], (dimension) =>
		            let
		                word = fnCapital(dimension),
		                findings = List.Buffer(List.RemoveNulls(List.Transform(inScope, (ci) =>
		                    let
		                        target = fnLevelAt(ci, "target." & dimension),
		                        inherited = fnLevelAt(ci, "inherited." & dimension),
		                        edges = if graph = null then {} else Record.FieldOrDefault(graph[Up], ci[Key], {}),
		                        counted = List.Select(edges, (edge) => edge[Excluded] <> true),
		                        excluded = List.Select(edges, (edge) => edge[Excluded] = true),
		                        values = List.Select(List.Transform(counted, (edge) => [Name = edge[Parent][Name], Value = passes(edge[Parent], dimension)]), (entry) => entry[Value] <> null),
		                        top = List.Max(List.Transform(values, (entry) => entry[Value])),
		                        highest = fnNames(List.Transform(List.Select(values, (entry) => entry[Value] = top), (entry) => entry[Name])),
		                        left = List.Transform(List.Select(excluded, (edge) => passes(edge[Parent], dimension) <> null), (edge) => edge[Parent][Name]),
		                        aside = if List.IsEmpty(left) then "" else ". Not counted (excluded from calculation): " & fnNames(left)
		                    in
		                        if target = null then null
		                        else if graph = null then
		                            (if inherited <> null and target > inherited
		                            then fnFinding(pack, ci, dimension, word & ": Target is " & fnLevelWords(target) & ", Inherited is " & fnLevelWords(inherited), [Review = review]) else null)
		                        else if List.IsEmpty(values) or target <= top then null
		                        else fnFinding(pack, ci, dimension, word & ": Target is " & fnLevelWords(target) & ", higher than every parent (highest " & fnLevelWords(top)
		                            & ", from " & highest & ")" & aside, [Review = review]))))
		            in
		                if not List.Contains(columns, "target." & dimension) then
		                    [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested for " & dimension & ": " & fnMissingColumns({"target." & dimension}) & "."}]
		                else if graph = null and not List.Contains(columns, "inherited." & dimension) then
		                    [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested for " & dimension & ": no Relationship report, and " & fnMissingColumns({"inherited." & dimension}) & "."}]
		                else [Findings = findings, Tested = {pack[id] & ":" & dimension}, Evaluated = {[Part = pack[id] & ":" & dimension, Count = List.Count(inScope)]}, Notes = {}]),
		        out = fnCombineOutputs(perDimension)
		    in
		        if graph = null and not List.IsEmpty(out[Tested])
		        then out & [Notes = out[Notes] & {"Parents not known: no Relationship report, so the Target is compared with the Inherited field. Load the Relationship report with the CI report to leave out relationships excluded from calculation."}]
		        else out
	queryGroup: Checks

/// No criticality reaches the CI (code detector criticality/none-reaches, src/core/checks/detectors/criticality-detectors.ts): Target is not complete. Inherited set too: ServiceNow copies it to Target after two weeks, so the finding waits `waitDays` days after the last change of the record. Nothing inherited: the parents say why (the mapping).
expression fnDetectCriticalityNoneReaches =
		(pack as record, run as record, inScope as list, rules as record) as record =>
		    let
		        columns = run[Columns],
		        graph = run[Graph],
		        date = run[Date],
		        dimensions = ReadingRules[dimensions],
		        absent = List.Select(List.Combine(List.Transform({"target", "inherited"}, (kind) => List.Transform(dimensions, (dimension) => kind & "." & dimension))),
		            (column) => not List.Contains(columns, column)),
		        passes = (node as record, dimension as text) as nullable number =>
		            if node[Ci] = null then null
		            else let target = fnLevelAt(node[Ci], "target." & dimension) in if target <> null then target else fnLevelAt(node[Ci], "inherited." & dimension),
		        hasAny = (node as record) as logical => List.AnyTrue(List.Transform(dimensions, (dimension) => passes(node, dimension) <> null)),
		        mappingWords = (ci as record) as text =>
		            let
		                edges = if graph = null then {} else Record.FieldOrDefault(graph[Up], ci[Key], {}),
		                counted = List.Transform(List.Select(edges, (edge) => edge[Excluded] <> true), (edge) => edge[Parent]),
		                excluded = List.Transform(List.Select(edges, (edge) => edge[Excluded] = true), (edge) => edge[Parent]),
		                giving = List.Select(counted, hasAny),
		                cut = List.Select(excluded, hasAny),
		                namesOf = (nodes as list) as text => fnNames(List.Transform(nodes, (node) => node[Name]))
		            in
		                if graph = null then ""
		                else if List.IsEmpty(counted) and List.IsEmpty(excluded) then "no parent relationship"
		                else if not List.IsEmpty(giving) then "the parent " & namesOf(giving) & " has a criticality, but nothing is inherited yet"
		                else if not List.IsEmpty(cut) then "only parents over a relationship excluded from calculation have a criticality: " & namesOf(cut)
		                else "no parent has a criticality: " & namesOf(counted & excluded),
		        findings = List.Buffer(List.RemoveNulls(List.Transform(inScope, (ci) =>
		            let
		                complete = List.AllTrue(List.Transform(dimensions, (dimension) => fnLevelAt(ci, "target." & dimension) <> null)),
		                inherited = List.AnyTrue(List.Transform(dimensions, (dimension) => fnLevelAt(ci, "inherited." & dimension) <> null)),
		                age = if ci[UpdatedOn] <> null and date <> null then Duration.Days(date - ci[UpdatedOn]) else -1,
		                why = mappingWords(ci)
		            in
		                if complete then null
		                else if inherited then
		                    (if age < rules[waitDays] then fnFinding(pack, ci, "target", "Inherited is set, Target is empty", [Wait = "Inherited is set: ServiceNow copies it to Target after 2 weeks"])
		                    else fnFinding(pack, ci, "target", "Inherited is set, but Target is still empty " & Text.From(age) & " days after the last change: ServiceNow did not copy it"))
		                else fnFinding(pack, ci, "target", "No criticality reaches this CI" & (if why <> "" then ": " & why else "")))))
		    in
		        if not List.IsEmpty(absent) then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: " & fnMissingColumns(absent) & "."}]
		        else [
		            Findings = findings, Tested = {pack[id] & ":target"}, Evaluated = {[Part = pack[id] & ":target", Count = List.Count(inScope)]},
		            Notes = if graph = null then {"Load the Relationship report with the CI report to see the parents of each CI."} else {}
		        ]
	queryGroup: Checks

/// EPO ≠ ServiceNow (code detector epo/differs, src/core/checks/detectors/epo-detectors.ts): a service mapped CI differs from its EPO system. SACM copies the EPO value into ServiceNow (a SACM fix list). A leftover is on neither EPO card (D190). The chip "changed in EPO": the system changed after the EPO systems report before this one. Not tested without the "service mapped" column: it decides which of the two cards a difference belongs to.
expression fnDetectEpoDiffers =
		(pack as record, run as record, config as record) as record =>
		    let
		        epo = run[Epo],
		        pairs = List.Select(run[EpoComparison][Pairs], (pair) => pair[Mapped] = true),
		        tested = fnEpoTested(pack, run, config, pairs),
		        changedSince = (system as record) as logical => epo[PreviousDate] <> null and system[Changed] <> null and system[Changed] > epo[PreviousDate],
		        changedWords = (system as record) as text => if system[Changed] = null then "" else " (last change in EPO: " & fnLongDate(system[Changed]) & ")",
		        findings = List.Combine(List.Transform(pairs, (pair) => List.Transform(List.Select(pair[Differences], (difference) => not difference[Leftover]), (difference) =>
		            fnFinding(pack, pair[Ci], difference[Field],
		                difference[Label] & " is " & difference[Current] & " in ServiceNow, EPO has " & difference[Epo] & changedWords(pair[System]),
		                [
		                    Fix = [Change = difference[Label], Current = difference[Current], Set = difference[Epo] & ", from EPO"] & (if difference[Value] <> "" then [Value = difference[Value]] else []),
		                    Chips = if changedSince(pair[System]) then {ReadingRules[epoChangedChip]} else {}
		                ]))))
		    in
		        if not List.Contains(run[Columns], "serviceMapped") then fnEpoNoFlag()
		        else [
		            Findings = List.Buffer(findings), Tested = tested[Tested], Evaluated = tested[Evaluated],
		            Notes = tested[Notes] & (if epo[PreviousDate] = null then {"The chip """ & ReadingRules[epoChangedChip] & """ needs an earlier EPO systems report: this is the first one loaded."} else {})
		        ]
	queryGroup: Checks

/// EPO update not arrived (code detector epo/not-arrived, src/core/checks/detectors/epo-detectors.ts): a CI that is not service mapped differs from its EPO system, so the sync did not bring the change. A review list. A change in EPO younger than `waitDays` days before the report waits: the sync may still bring it. A leftover is on neither EPO card (D190). The note names the EPO systems that are not Retired and match no Service Instance.
expression fnDetectEpoNotArrived =
		(pack as record, run as record, config as record) as record =>
		    let
		        epo = run[Epo],
		        date = run[Date],
		        comparison = run[EpoComparison],
		        pairs = List.Select(comparison[Pairs], (pair) => pair[Mapped] = false),
		        tested = fnEpoTested(pack, run, config, pairs),
		        changedSince = (system as record) as logical => epo[PreviousDate] <> null and system[Changed] <> null and system[Changed] > epo[PreviousDate],
		        changedWords = (system as record) as text => if system[Changed] = null then "" else " (last change in EPO: " & fnLongDate(system[Changed]) & ")",
		        waitOf = (system as record) as text =>
		            let age = if system[Changed] <> null and date <> null then Duration.Days(date - system[Changed]) else null in
		            if age = null or age >= config[waitDays] then ""
		            else "Changed in EPO " & (if age <= 0 then "on the day of the report" else Text.From(age) & " day" & (if age = 1 then "" else "s") & " before the report") & ": the sync may still bring it",
		        findings = List.Combine(List.Transform(pairs, (pair) => List.Transform(List.Select(pair[Differences], (difference) => not difference[Leftover]), (difference) =>
		            fnFinding(pack, pair[Ci], difference[Field],
		                difference[Label] & " is " & difference[Current] & " in ServiceNow, EPO has " & difference[Epo] & changedWords(pair[System]),
		                [Chips = if changedSince(pair[System]) then {ReadingRules[epoChangedChip]} else {}, Wait = waitOf(pair[System])])))),
		        without = comparison[WithoutCi],
		        count = List.Count(without),
		        shown = Text.Combine(List.Transform(List.FirstN(without, 10), (system) => system[Name] & " (" & system[EpoId] & ")"), ", ")
		    in
		        if not List.Contains(run[Columns], "serviceMapped") then fnEpoNoFlag()
		        else [
		            Findings = List.Buffer(findings), Tested = tested[Tested], Evaluated = tested[Evaluated],
		            Notes = tested[Notes] & (if count = 0 then {} else {fnPlural(count, "EPO system") & " that "
		                & (if count = 1 then "is not Retired has no Service Instance with its" else "are not Retired have no Service Instance with their")
		                & " EPO ID: " & shown & (if count > 10 then ", …" else "") & "."})
		        ]
	queryGroup: Checks

/// The mapping backlog (code detector mapping/backlog, src/core/checks/detectors/mapping-detectors.ts, D200): one line per CI that must be mapped, with every reason: a rule of the relationship model that reference/mapping-backlog names and that is not met, or a tag that says its future is decided in the mapping session. A Business Process in Ready without CIA values waits for the BIA (no line, D197); another CI in Ready waits (not live yet). Field "mapping"; Mapping holds the ids of the reasons, the detail their words.
expression fnDetectMappingBacklog =
		(pack as record, run as record, inScope as list, config as record, model as record) as record =>
		    let
		        graph = run[Graph],
		        columns = run[Columns],
		        readyStatus = fnNameKey(config[readyStatus], ""),
		        taggedStatus = if tagged = null then "" else fnNameKey(tagged[status], ""),
		        rules = List.Select(model[expectations], (rule) => List.Contains(config[rules], rule[id]) and Record.HasFields(rule, "min")),
		        tagged = Record.FieldOrDefault(config, "tagged", null),
		        hasCia = (ci as record) as logical => List.AnyTrue(List.Transform(ReadingRules[dimensions], (dimension) => fnLevelAt(ci, "target." & dimension) <> null)),
		        lineOf = (ci as record) as nullable record =>
		            let
		                node = graph[NodeOf](ci),
		                ready = ci[StatusKey] = readyStatus,
		                missed = List.Select(rules, (rule) => List.Contains(rule[classes], node[Cls])
		                    and List.Count(fnPartners(graph, node, rule[direction], rule[related])) < rule[min]
		                    and not (Record.FieldOrDefault(rule, "parentField", false) = true and List.Contains(columns, "parentService")
		                        and Text.Trim(if ci[ParentService] = null then "" else ci[ParentService]) <> "")),
		                isTagged = tagged <> null and List.Contains(tagged[classes], ci[Class]) and ci[StatusKey] = taggedStatus
		                    and List.AnyTrue(List.Transform(ci[TagList], (tag) => List.AnyTrue(List.Transform(tagged[tags], (pattern) => fnMatches(pattern, "i", tag))))),
		                ids = List.Transform(missed, (rule) => rule[id]) & (if isTagged then {tagged[id]} else {}),
		                words = List.Transform(missed, (rule) => fnReplaceFirst(rule[title], "Service Instance", if node[Cls] = "platform" then "Platform" else "Service Instance"))
		                    & (if isTagged then {tagged[say]} else {}),
		                // A CI in Ready is not live yet, so its mapping waits; a process in Ready with CIA values is the one to map now (D197).
		                waits = ready and ci[Class] <> "business_process"
		            in
		                if ready and ci[Class] = "business_process" and not hasCia(ci) then null
		                else if List.IsEmpty(ids) then null
		                else fnFinding(pack, ci, "mapping", Text.Combine(words, "; "), [Mapping = ids, InServiceNow = true]
		                    & (if waits then [Wait = "Status " & ci[Status] & ": not live yet"] else [])),
		        findings = List.RemoveNulls(List.Transform(inScope, lineOf))
		    in
		        if not List.Contains(columns, "operationalStatus") then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: " & fnMissingColumns({"operationalStatus"}) & "."}]
		        else if graph = null then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: no Relationship report. Load the Relationship report with the CI report."}]
		        else [Findings = List.Buffer(findings), Tested = {pack[id] & ":mapping"}, Evaluated = {[Part = pack[id] & ":mapping", Count = List.Count(inScope)]}, Notes = {}]
	queryGroup: Checks

/// The stages of a Business Process in Ready (code detector process/stage, src/core/checks/detectors/process-detectors.ts, D197): it waits for the BIA (no CIA value yet: no line, a note says how many), is to map (CIA values, nothing live linked below: a case of the mapping backlog, D200, and a note here), or is mapped (CIA values and something linked below: SACM makes it Operational, a line here). The words and classes are processStages of reference/lifecycle.
expression fnDetectProcessStage =
		(pack as record, run as record, inScope as list, stages as record) as record =>
		    let
		        graph = run[Graph],
		        columns = run[Columns],
		        target = List.Transform(ReadingRules[dimensions], (dimension) => "target." & dimension),
		        status = fnNameKey(stages[status], ""),
		        inStatus = List.Buffer(List.Select(inScope, (ci) => ci[StatusKey] = status)),
		        hasCia = (ci as record) as logical => List.AnyTrue(List.Transform(ReadingRules[dimensions], (dimension) => fnLevelAt(ci, "target." & dimension) <> null)),
		        below = (ci as record) as list =>
		            let edges = Record.FieldOrDefault(graph[Down], ci[Key], {}) in
		            List.Sort(List.Distinct(List.Transform(List.Select(edges, (edge) => List.Contains(stages[below], edge[Child][Cls])), (edge) => edge[Child][Name])), Comparer.FromCulture("en-US")),
		        lines = List.Buffer(List.Transform(inStatus, (ci) => [Ci = ci, Cia = hasCia(ci), Below = if hasCia(ci) then below(ci) else {}])),
		        waiting = List.Count(List.Select(lines, (line) => not line[Cia])),
		        toMap = List.Count(List.Select(lines, (line) => line[Cia] and List.IsEmpty(line[Below]))),
		        mapped = stages[mapped],
		        say = (text as text, names as list) as text => Text.Replace(text, "{below}", Text.Combine(names, ", ")),
		        count = (words as record, n as number) as text => if n = 1 then words[one] else Text.Replace(words[many], "{n}", Text.From(n)),
		        findings = List.Transform(List.Select(lines, (line) => line[Cia] and not List.IsEmpty(line[Below])), (line) =>
		            fnFinding(pack, line[Ci], "mapped", say(mapped[say], line[Below]), [Fix = [Change = mapped[change], Current = say(mapped[current], line[Below]), Set = mapped[set]]]))
		    in
		        if not List.AnyTrue(List.Transform(target, (column) => List.Contains(columns, column))) then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: " & fnMissingColumns(target) & "."}]
		        else if not List.Contains(columns, "operationalStatus") then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: " & fnMissingColumns({"operationalStatus"}) & "."}]
		        else if graph = null then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: no Relationship report. Load the Relationship report with the CI report."}]
		        else [
		            Findings = List.Buffer(findings), Tested = {pack[id]}, Evaluated = {[Part = pack[id], Count = List.Count(inStatus)]},
		            Notes = (if waiting = 0 then {} else {count(stages[waits], waiting)}) & (if toMap = 0 then {} else {count(stages[toMap], toMap)})
		        ]
	queryGroup: Checks

/// Application ≠ Instance (code detector relationships/application-instance, relationship-detectors.ts; procedure 2.9, D180): a Business Application is a copy of its Service Instance: the same Owned by, Managed by, Operational status and description, and the name of the instance with "_BA" (applicationCopy of the relationship model). SACM copies the values itself (a SACM fix list). With several instances, the one that carries the application's name (production first).
expression fnDetectRelationshipsApplicationInstance =
		(pack as record, run as record, inScope as list, model as record) as record =>
		    let
		        graph = run[Graph],
		        columns = run[Columns],
		        copy = Record.FieldOrDefault(model, "applicationCopy", null),
		        words = [owned_by = "Owned by", managed_by = "Managed by", operational_status = "Operational status", description = "Description", name = "Name"],
		        checks = List.Transform({"owned_by", "managed_by", "operational_status", "description", "name"}, (field) =>
		            let column = if field = "operational_status" then "operationalStatus" else field in
		            if (field = "description" or field = "name") and copy = null then
		                [Field = field, Note = "Not tested for " & Text.Lower(Record.Field(words, field), "en-US") & ": reference data missing (applicationCopy in reference/relationship-model)."]
		            else if field = "name" or List.Contains(columns, column) then [Field = field, Note = ""]
		            else [Field = field, Note = "Not tested for " & fnColumnWord(field) & ": " & fnMissingColumns({field}) & "."]),
		        fields = List.Transform(List.Select(checks, (entry) => entry[Note] = ""), (entry) => entry[Field]),
		        fieldNotes = List.Transform(List.Select(checks, (entry) => entry[Note] <> ""), (entry) => entry[Note]),
		        person = (ci as record, role as text) as nullable record => fnPerson(ci, role, columns),
		        valueOf = (ci as record, field as text) as text =>
		            if field = "operational_status" then (if ci[Status] = "" then "(empty)" else ci[Status])
		            else if field = "description" then (let text = Text.Trim(if ci[Description] = null then "" else ci[Description]) in if text = "" then "(empty)" else text)
		            else if field = "name" then ci[Name]
		            else fnPersonText(person(ci, field)),
		        // The description of the application is copied from its instance (D180); never when the instance has no usable one.
		        descriptionDiffers = (application as record, instance as record) as logical =>
		            let
		                mine = if application[Description] = null then "" else application[Description],
		                theirs = if instance[Description] = null then "" else instance[Description],
		                source = fnLetters(theirs),
		                now = fnLetters(mine),
		                start = List.Max({1, copy[descriptionStart]})
		            in
		                if Text.Length(Text.Trim(theirs)) < copy[descriptionMin] or now = source then false
		                else if now = "" or Text.Length(Text.Trim(mine)) < copy[descriptionMin] or now = fnLetters(application[Name]) or Text.StartsWith(source, now) then true
		                else copy[descriptions] = "different" and Text.Start(now, start) <> Text.Start(source, start),
		        applicationName = (instance as text) as text => Text.Trim(fnReplacePattern(copy[instanceSuffix], "", Text.Trim(instance), "")) & copy[applicationSuffix],
		        // The Service Instance whose name the application carries ("Fines_BA" -> "Fines - PROD"), production first.
		        instanceOf = (node as record, instances as list) as nullable record =>
		            let
		                base = fnNameKey(fnReplacePattern(ReadingRules[applicationSuffix], "i", node[Name], ""), ""),
		                named = List.Select(instances, (other) => Text.StartsWith(fnNameKey(other[Name], ""), base)),
		                production = List.First(List.Select(named, (other) => other[Environment] = "PROD"), null)
		            in
		                if List.Count(instances) = 1 then instances{0}
		                else if production <> null then production
		                else if List.Count(named) = 1 then named{0}
		                else null,
		        perCi = List.Buffer(List.Transform(inScope, (ci) =>
		            let
		                node = graph[NodeOf](ci),
		                instances = if node[Cls] = "business_application" then fnPartners(graph, node, "child", {"service_instance", "platform"}) else {},
		                instance = if List.IsEmpty(instances) then null else instanceOf(node, instances),
		                theirs = if instance = null then null else instance[Ci],
		                findings = if theirs = null then {} else List.RemoveNulls(List.Transform(fields, (field) =>
		                    let
		                        set = if field = "name" then applicationName(theirs[Name]) else valueOf(theirs, field),
		                        differs =
		                            if field = "operational_status" then fnNameKey(ci[Status], "") <> fnNameKey(theirs[Status], "")
		                            else if field = "description" then descriptionDiffers(ci, theirs)
		                            else if field = "name" then fnNameKey(ci[Name], "") <> fnNameKey(set, "")
		                            else not fnSamePerson(person(ci, field), person(theirs, field)),
		                        current = valueOf(ci, field),
		                        word = Record.Field(words, field),
		                        detail =
		                            if field = "description" then "Description is not the one of its Service Instance " & instance[Name]
		                            else if field = "name" then "Name is not the name of its Service Instance " & instance[Name] & " with " & copy[applicationSuffix]
		                            else word & " is " & current & "; its Service Instance " & instance[Name] & " has " & set
		                    in
		                        if not differs then null
		                        else fnFinding(pack, ci, field, detail, [Fix = [Change = "Set " & word & " (as on " & instance[Name] & ")", Current = current, Set = set]
		                            & (if set <> "" and set <> "(empty)" then [Value = set] else [])])))
		            in
		                [Kind = if List.IsEmpty(instances) then "none" else if theirs = null then "unclear" else "compared", Findings = findings])),
		        evaluated = List.Count(List.Select(perCi, (entry) => entry[Kind] = "compared")),
		        unclear = List.Count(List.Select(perCi, (entry) => entry[Kind] = "unclear"))
		    in
		        [
		            Findings = List.Buffer(List.Combine(List.Transform(perCi, (entry) => entry[Findings]))),
		            Tested = List.Transform(fields, (field) => pack[id] & ":" & field),
		            Evaluated = List.Transform(fields, (field) => [Part = pack[id] & ":" & field, Count = evaluated]),
		            Notes = fieldNotes & (if unclear = 0 then {} else {"Partly tested: " & fnPlural(unclear, "Business Application") & " "
		                & (if unclear = 1 then "has several Service Instances and none carries its" else "have several Service Instances and none carries their")
		                & " name, so the instance to compare with is not known."})
		        ]
	queryGroup: Checks

/// Relationship missing (code detector relationships/missing, src/core/checks/detectors/relationship-detectors.ts): fewer related CIs than a rule of the relationship model asks (`min`), in the direction of the rule. A Service Offering whose Parent field already names its service is not raised for a rule with `parentField`: Offering parent lists it for SACM. A rule that is not agreed (`review`) is listed for a review.
expression fnDetectRelationshipsMissing =
		(pack as record, run as record, inScope as list, model as record) as record =>
		    let
		        graph = run[Graph],
		        columns = run[Columns],
		        rules = List.Select(fnChosenRules(pack, model[expectations]), (rule) => Record.HasFields(rule, "min")),
		        perRule = List.Transform(rules, (rule) =>
		            let
		                candidates = List.Select(inScope, (ci) => List.Contains(rule[classes], graph[NodeOf](ci)[Cls])),
		                parentField = Record.FieldOrDefault(rule, "parentField", false) = true and List.Contains(columns, "parentService"),
		                findings = List.RemoveNulls(List.Transform(candidates, (ci) =>
		                    let
		                        node = graph[NodeOf](ci),
		                        found = List.Count(fnPartners(graph, node, rule[direction], rule[related])),
		                        review = if Record.FieldOrDefault(rule, "review", false) = true then [Review = let why = Record.FieldOrDefault(rule, "reviewWhy", "") in if why <> "" then why else "Review only"] else [],
		                        here = if Record.FieldOrDefault(rule, "inServiceNow", false) = true then [InServiceNow = true] else []
		                    in
		                        if found >= rule[min] then null
		                        else if parentField and Text.Trim(if ci[ParentService] = null then "" else ci[ParentService]) <> "" then null
		                        else fnFinding(pack, ci, rule[id], fnReplaceFirst(rule[title], "Service Instance", if node[Cls] = "platform" then "Platform" else "Service Instance"), review & here)))
		            in
		                [Findings = findings, Tested = {pack[id] & ":" & rule[id]}, Evaluated = {[Part = pack[id] & ":" & rule[id], Count = List.Count(candidates)]}, Notes = {}])
		    in
		        fnCombineOutputs(perRule)
	queryGroup: Checks

/// Offering owner ≠ Service owner (code detector relationships/offering-owner, relationship-detectors.ts; procedure 2.6): a Service Offering made by a person has the owner of its one Business Service. An offering the EPO integration created takes it from EPO by itself and is not checked here (D137). SACM copies the owner (a SACM fix list).
expression fnDetectRelationshipsOfferingOwner =
		(pack as record, run as record, inScope as list, model as record) as record =>
		    let
		        graph = run[Graph],
		        columns = run[Columns],
		        owner = (ci as record) as nullable record => fnPerson(ci, "owned_by", columns),
		        offerings = List.Select(inScope, (ci) => graph[NodeOf](ci)[Cls] = "service_offering"),
		        fromEpo = List.Count(List.Select(offerings, (ci) => fnOfferingOrigin(ci) = "epo")),
		        checked = List.Buffer(List.RemoveNulls(List.Transform(List.Select(offerings, (ci) => fnOfferingOrigin(ci) <> "epo"), (ci) =>
		            let services = fnPartners(graph, graph[NodeOf](ci), "parent", {"business_service"}) in
		            if List.Count(services) <> 1 or services{0}[Ci] = null then null else [Ci = ci, Service = services{0}[Ci]]))),
		        findings = List.RemoveNulls(List.Transform(checked, (entry) =>
		            let
		                ci = entry[Ci],
		                service = entry[Service],
		                current = fnPersonText(owner(ci)),
		                set = fnPersonText(owner(service))
		            in
		                if fnSamePerson(owner(ci), owner(service)) then null
		                else fnFinding(pack, ci, "service-owner", "Owned by is " & current & "; its Business Service " & service[Name] & " is owned by " & set,
		                    [Fix = [Change = "Owned by (as on " & service[Name] & ")", Current = current, Set = set] & (if set <> "" and set <> "(empty)" then [Value = set] else [])])))
		    in
		        if not List.Contains(columns, "owned_by") then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: " & fnMissingColumns({"owned_by"}) & "."}]
		        else [
		            Findings = List.Buffer(findings), Tested = {pack[id] & ":service-owner"}, Evaluated = {[Part = pack[id] & ":service-owner", Count = List.Count(checked)]},
		            Notes = if fromEpo = 0 then {} else {fnPlural(fromEpo, "Service Offering") & " " & (if fromEpo = 1 then "comes" else "come") & " from EPO: "
		                & (if fromEpo = 1 then "it takes its" else "they take their") & " owner from EPO and " & (if fromEpo = 1 then "is" else "are") & " not checked here."}
		        ]
	queryGroup: Checks

/// Offering parent (code detector relationships/offering-parent, relationship-detectors.ts): the Parent field of a Service Offering and its Business Service relationship name the same, single Business Service. A SACM fix list: the field is set, the relationship added, or the extra relationships removed. Neither field nor relationship: Relationship missing asks the owner.
expression fnDetectRelationshipsOfferingParent =
		(pack as record, run as record, inScope as list, model as record) as record =>
		    let
		        graph = run[Graph],
		        same = (a as text, b as text) as logical => fnNameKey(a, "") = fnNameKey(b, ""),
		        offerings = List.Select(inScope, (ci) => graph[NodeOf](ci)[Cls] = "service_offering"),
		        findings = List.RemoveNulls(List.Transform(offerings, (ci) =>
		            let
		                parent = Text.Trim(if ci[ParentService] = null then "" else ci[ParentService]),
		                services = fnPartners(graph, graph[NodeOf](ci), "parent", {"business_service"}),
		                listed = fnSortedNames(services),
		                offering = ci[Name],
		                named = List.AnyTrue(List.Transform(services, (service) => same(service[Name], parent))),
		                others = fnSortedNames(List.Select(services, (service) => not same(service[Name], parent))),
		                line =
		                    if parent = "" then
		                        (if List.IsEmpty(services) then null
		                        else [Detail = "The Parent field is empty; the relationship names " & listed,
		                            Fix = if List.Count(services) = 1 then [Change = "Set the Parent field of " & offering, Current = "(empty)", Set = services{0}[Name], Value = services{0}[Name]] else null])
		                    else if List.IsEmpty(services) then
		                        [Detail = "The Parent field names " & parent & ", but no Business Service is related",
		                            Fix = [Change = "Add the relationship " & parent & " Provides::Provided by " & offering, Current = "No Business Service related", Set = parent, Value = parent]]
		                    else if not named then
		                        [Detail = "The Parent field names " & parent & "; the relationship names " & listed,
		                            Fix = [Change = "Business Service of " & offering & ": check which is right", Current = "Relationship: " & listed, Set = "Parent field: " & parent]]
		                    else if List.Count(services) > 1 then
		                        [Detail = "The Parent field names " & parent & "; there are also relationships to " & others,
		                            Fix = [Change = "Remove the extra Business Service relationships of " & offering, Current = others, Set = "Keep only " & parent]]
		                    else null
		            in
		                if line = null then null else fnFinding(pack, ci, "parent", line[Detail], if line[Fix] = null then null else [Fix = line[Fix]])))
		    in
		        if not List.Contains(run[Columns], "parentService") then
		            [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: the report has no Parent column (ref_cmdb_ci_service.parent). Add it to the CI report."}]
		        else [Findings = List.Buffer(findings), Tested = {pack[id] & ":parent"}, Evaluated = {[Part = pack[id] & ":parent", Count = List.Count(offerings)]}, Notes = {}]
	queryGroup: Checks

/// Too many partners (code detector relationships/too-many, relationship-detectors.ts): more related CIs than a rule of the relationship model allows (`max`), per environment of the related CI where the rule says so. SACM fixes the mapping in ServiceNow (D138): keep the right one, remove the other relationships.
expression fnDetectRelationshipsTooMany =
		(pack as record, run as record, inScope as list, model as record) as record =>
		    let
		        graph = run[Graph],
		        rules = List.Select(fnChosenRules(pack, model[expectations]), (rule) => Record.HasFields(rule, "max")),
		        perRule = List.Transform(rules, (rule) =>
		            let
		                perEnvironment = Record.FieldOrDefault(rule, "maxPerEnvironment", false) = true,
		                title = Record.FieldOrDefault(rule, "tooManyTitle", rule[title]),
		                candidates = List.Select(inScope, (ci) => List.Contains(rule[classes], graph[NodeOf](ci)[Cls])),
		                findings = List.RemoveNulls(List.Transform(candidates, (ci) =>
		                    let
		                        found = fnPartners(graph, graph[NodeOf](ci), rule[direction], rule[related]),
		                        groups = fnGroupBy(found, (other) => "env:" & (if perEnvironment then other[Environment] else "")),
		                        over = List.Select(List.Zip({Record.FieldNames(groups), Record.FieldValues(groups)}), (group) => List.Count(group{1}) > rule[max]),
		                        what = Text.Combine(List.Transform(over, (group) => (if perEnvironment then Text.Middle(group{0}, 4) & ": " else "") & fnSortedNames(group{1})), "; ")
		                    in
		                        if List.IsEmpty(over) then null
		                        else fnFinding(pack, ci, rule[id], title & ": " & what, [Fix = [
		                            Change = title & ": keep the right one, remove the other relationships", Current = what, Set = "Keep only the right one"]])))
		            in
		                [Findings = findings, Tested = {pack[id] & ":" & rule[id]}, Evaluated = {[Part = pack[id] & ":" & rule[id], Count = List.Count(candidates)]}, Notes = {}])
		    in
		        fnCombineOutputs(perRule)
	queryGroup: Checks

/// Relationship entered twice (code detector relationships/twice, relationship-detectors.ts): between two CIs only one relationship is allowed. Rows with the same parent, type and child, and also rows of another type or the other direction between the same two CIs. Only live relationships count (a Retired end is another card). Shown on the parent when it is in scope, else the child.
expression fnDetectRelationshipsTwice =
		(pack as record, run as record, inScope as list, model as record) as record =>
		    let
		        graph = run[Graph],
		        scope = fnScopeKeys(inScope),
		        ends = List.Select(graph[Edges], (edge) => edge[Parent][Key] <> edge[Child][Key]),
		        pairs = fnGroupBy(ends, (edge) => Text.Combine(List.Sort({edge[Parent][Key], edge[Child][Key]}, Comparer.Ordinal), "<>")),
		        findingOf = (pair as text, list as list) as nullable record =>
		            let
		                first = list{0},
		                at = fnShownOn(first, scope),
		                count = List.Count(list),
		                // One kind per parent, type and child, in the order of the report.
		                bySuffix = fnGroupBy(list, fnEdgeSuffix),
		                kinds = List.Transform(Record.FieldValues(bySuffix), (group) => group{0}[Parent][Name] & " " & group{0}[Type] & " " & group{0}[Child][Name]),
		                a = first[Parent][Name],
		                b = first[Child][Name]
		            in
		                if count < 2 or first[Parent][Retired] or first[Child][Retired] or at = null then null
		                else if List.Count(kinds) = 1 then
		                    fnFinding(pack, at[Ci], "twice", "Entered " & Text.From(count) & " times: " & kinds{0}, [Suffix = fnEdgeSuffix(first), Fix = [
		                        Change = "Relationship entered " & Text.From(count) & " times: " & kinds{0}, Current = Text.From(count) & " rows", Set = "Keep one", RelatedTo = at[Other][Name]]])
		                else
		                    fnFinding(pack, at[Ci], "twice", Text.From(count) & " relationships between " & a & " and " & b & ": " & Text.Combine(kinds, "; "), [Suffix = pair, Fix = [
		                        Change = Text.From(count) & " relationships between " & a & " and " & b & ": only one is allowed", Current = Text.Combine(kinds, "; "),
		                        Set = "Keep only the right one", RelatedTo = at[Other][Name]]]),
		        findings = List.RemoveNulls(List.Transform(Record.FieldNames(pairs), (pair) => findingOf(pair, Record.Field(pairs, pair))))
		    in
		        [Findings = List.Buffer(findings), Tested = {pack[id] & ":twice"}, Evaluated = {[Part = pack[id] & ":twice", Count = List.Count(inScope)]}, Notes = {}]
	queryGroup: Checks

/// Wrong relationship type (code detector relationships/wrong-type, relationship-detectors.ts): a live relationship whose type the model does not approve for its pair of classes, a pair the model does not allow, or the wrong direction. Shown on the parent when it is in scope, else the child; each relationship (parent, type, child) once. A pair the model has not confirmed is not checked.
expression fnDetectRelationshipsWrongType =
		(pack as record, run as record, inScope as list, model as record) as record =>
		    let
		        graph = run[Graph],
		        scope = fnScopeKeys(inScope),
		        live = List.Select(graph[Edges], (edge) => not edge[Parent][Retired] and not edge[Child][Retired]),
		        shown = List.Buffer(List.RemoveNulls(List.Transform(live, (edge) => let at = fnShownOn(edge, scope) in if at = null then null else [Edge = edge, At = at]))),
		        ruleFor = (parent as text, child as text) as nullable record =>
		            List.First(List.Select(model[dictionary], (rule) => List.Contains(rule[parents], parent) and List.Contains(rule[children], child)), null),
		        findingOf = (item as record) as nullable record =>
		            let
		                edge = item[Edge],
		                at = item[At],
		                rule = ruleFor(edge[Parent][Cls], edge[Child][Cls]),
		                status = if rule = null then "" else rule[status],
		                types = if rule = null then {} else Record.FieldOrDefault(rule, "types", {}),
		                pair = fnClassWord(edge[Parent][Cls]) & " → " & fnClassWord(edge[Child][Cls]),
		                sentence = edge[Parent][Name] & " " & edge[Type] & " " & edge[Child][Name],
		                suffix = fnEdgeSuffix(edge),
		                advice = if rule = null then null else Record.FieldOrDefault(rule, "advice", null)
		            in
		                if status = "allowed" and not List.AnyTrue(List.Transform(types, (allowed) => fnTypeKey(allowed) = fnTypeKey(edge[Type]))) then
		                    fnFinding(pack, at[Ci], "type", pair & " as """ & edge[Type] & """: the model uses " & Text.Combine(types, " or "), [Suffix = suffix, Fix = [
		                        Change = "Type of " & edge[Parent][Name] & " → " & edge[Child][Name], Current = edge[Type], Set = types{0}, Value = types{0}, RelatedTo = at[Other][Name]]])
		                else if status = "blocked" then
		                    fnFinding(pack, at[Ci], "pair", pair & " is not allowed: " & rule[note], [Suffix = suffix, Fix = [
		                        Change = "Remove the relationship " & sentence, Current = edge[Type], Set = if advice = null then "Remove it" else advice, RelatedTo = at[Other][Name]]])
		                else if status = "direction" then
		                    fnFinding(pack, at[Ci], "direction", pair & ": the wrong direction. " & rule[note], [Suffix = suffix, Fix = [
		                        Change = "Direction: " & sentence, Current = edge[Parent][Name] & " is the parent", Set = if advice = null then "Swap the direction" else advice, RelatedTo = at[Other][Name]]]
		                        & (if Record.FieldOrDefault(rule, "review", false) = true then [Review = "Review: confirm with the criticality owner first"] else []))
		                else null,
		        // A relationship entered more than once gives one finding: the first.
		        found = List.RemoveNulls(List.Transform(shown, findingOf)),
		        grouped = fnGroupBy(found, (finding) => finding[Key]),
		        findings = List.Transform(Record.FieldValues(grouped), (group) => group{0}),
		        count = List.Count(shown),
		        parts = {"type", "pair", "direction"}
		    in
		        [
		            Findings = List.Buffer(findings), Tested = List.Transform(parts, (part) => pack[id] & ":" & part),
		            Evaluated = List.Transform(parts, (part) => [Part = pack[id] & ":" & part, Count = count]), Notes = {}
		        ]
	queryGroup: Checks

/// The lifecycle review (manual detector review/lifecycle, D192): it reads no report, so on a CI report alone it finds nothing and tests nothing. Its lines come from the managers' marks in the journal, added to the newest run only (fnWithReviews, build B8, D306); the history (HistoryRun) keeps the checks of the reports alone.
expression fnDetectReviewLifecycle =
		(pack as record, run as record, inScope as list, reference as nullable record) as record =>
		    [Findings = {}, Tested = {}, Evaluated = {}, Notes = {}]
	queryGroup: Checks

/// The detector of the checks of type "rule" (src/core/checks/engine.ts, runChecks and test): the condition of the check file (detector.when) is tested on each CI of the scope, once per entry of detector.forEach ("{each}" in the condition). A part the report has no column for is not tested and says so (D15). Returns [Findings, Tested, Evaluated, Notes].
expression fnDetectRule =
		(pack as record, run as record, inScope as list) as record =>
		    let
		        detector = pack[detector],
		        when = detector[when],
		        playbook = Record.FieldOrDefault(pack, "playbook", []),
		        rules = ReadingRules,
		        columns = run[Columns],
		        squash = (value as text) as text => fnNameKey(value, ""),
		        // The compared form of a CI field a rule reads (made once per CI by fnCheckRun; "" for any other field, as fnCiText).
		        squashed = (ci as record, field as text) as text => Record.FieldOrDefault(ci[Squashed], field, ""),
		        fill = (value as any, part as text) as any => if value is text then Text.Replace(value, "{each}", part) else value,
		        isRole = (field as text) as logical => List.Contains(rules[roles], field),
		        labelOf = (field as text) as text => Text.Replace(Text.Replace(field, "_", " "), ".", " "),
		        isRetired = (ci as record) as logical => ci[StatusKey] = "retired",
		        listOf = (value as any) as list => if value is list then value else {Text.From(value)},
		        entriesOf = (value as text) as list => List.Transform(Text.SplitAny(value, ",;#(lf)"), Text.Trim),
		        leaves = (condition as record) as list =>
		            if Record.HasFields(condition, "all") then List.Combine(List.Transform(condition[all], @leaves))
		            else if Record.HasFields(condition, "any") then List.Combine(List.Transform(condition[any], @leaves))
		            else {condition},

		        // How many CIs of the whole report share each value (compared form), per field; the same for live CIs per class.
		        // Worked out once per run (fnCheckRun), not once per check.
		        counts = run[Counts],
		        classCounts = run[ClassCounts],
		        // A tag as its words (a hyphen counts as a space): a mandatory-tag rule is met by one of its tags, or by a tag that ends
		        // with one of its endings after a first word (src/core/checks/engine.ts, meetsTagRule).
		        tagWords = (tag as text) as text => squash(Text.Replace(tag, "-", " ")),
		        // The tags of a reference file in compared form, made once per check (not once per CI): by the name of the file.
		        refs = List.Distinct(List.Transform(List.Select(leaves(when), (item) => Record.HasFields(item, "ref") and List.Contains({"missingTags", "tagsNotIn"}, item[op])), (item) => item[ref])),
		        tagRefs = List.Accumulate(refs, [], (record, name) => Record.AddField(record, name, () =>
		            let value = fnReference(name) in
		            if value = null then null
		            else if value is list then fnKeySet(List.Transform(value, (tag) => squash(Text.From(tag))))
		            else Record.FromList(List.Transform(Record.FieldValues(value), (rules) => if rules is list
		                then List.Buffer(List.Transform(rules, (rule) => rule & [Keys = List.Buffer(List.Transform(rule[oneOf], tagWords)),
		                    Endings = List.Buffer(List.Transform(Record.FieldOrDefault(rule, "endsWith", {}), (ending) => " " & tagWords(ending)))])) else rules), Record.FieldNames(value)), true)),

		        samePerson = (a as nullable record, b as nullable record) as logical =>
		            if a = null or b = null then false
		            else if a[UserId] <> "" and b[UserId] <> "" then Text.Lower(a[UserId], "en-US") = Text.Lower(b[UserId], "en-US")
		            else if a[Email] <> "" and b[Email] <> "" then Text.Lower(a[Email], "en-US") = Text.Lower(b[Email], "en-US")
		            else a[Email] = "" and b[Email] = "" and a[Name] <> "" and squash(a[Name]) = squash(b[Name]),

		        /** Why one leaf of the condition holds for this CI, or "" when it does not. */
		        leaf = (condition as record, ci as record, part as text) as text =>
		            let
		                op = condition[op],
		                field = fill(Record.FieldOrDefault(condition, "field", part), part),
		                value = fill(Record.FieldOrDefault(condition, "value", null), part),
		                label = labelOf(field),
		                current = fnCiText(ci, field),
		                trimmed = Text.Trim(current),
		                person = if isRole(field) then fnPerson(ci, field, columns) else null,
		                tags = ci[TagList]
		            in
		                if op = "isEmpty" then
		                    (if isRole(field) then (if person <> null and person[Name] = "" and person[Email] = "" then label & " is empty" else "")
		                    else if trimmed = "" then label & " is empty" else "")
		                else if op = "refInactive" then
		                    (if person <> null and (person[Name] <> "" or person[Email] <> "") and person[Active] = false
		                    then label & " is an inactive user: " & (if person[Name] <> "" then person[Name] else person[Email]) else "")
		                else if op = "shorterThan" then
		                    (if trimmed <> "" and Text.Length(trimmed) < Number.From(value) then label & " has only " & Text.From(Text.Length(trimmed)) & " characters" else "")
		                else if op = "equalsField" then
		                    (let own = squashed(ci, field) in if own <> "" and own = squashed(ci, Text.From(value)) then label & " repeats the " & Text.From(value) else "")
		                else if op = "matchesAny" then
		                    (if trimmed <> "" and List.AnyTrue(List.Transform(listOf(value), (pattern) => fnMatches(pattern, "i", trimmed)))
		                    then label & " is a placeholder: """ & trimmed & """" else "")
		                else if op = "duplicatedMoreThan" then
		                    (let count = Record.FieldOrDefault(Record.FieldOrDefault(counts, field, []), squashed(ci, field), 0) in
		                    if trimmed <> "" and count > Number.From(value) then "the same " & label & " is used on " & Text.From(count) & " CIs" else "")
		                else if op = "duplicatedInClass" then
		                    (if isRetired(ci) or trimmed = "" then ""
		                    else let count = Record.FieldOrDefault(Record.FieldOrDefault(classCounts, field, []), ci[Class] & "|" & squashed(ci, field), 0) in
		                    if count > Number.From(value) then "the same " & label & " is used on " & Text.From(count) & " live CIs of this class" else "")
		                else if op = "hasDoubleSpaces" then
		                    (if Text.Contains(current, "  ") then label & " has two or more spaces in a row" else "")
		                else if op = "equals" then
		                    (if squashed(ci, field) = squash(Text.From(value)) then label & " is " & current else "")
		                else if op = "samePersonAs" then
		                    (let other = Text.From(value) in
		                    if isRole(other) and samePerson(person, fnPerson(ci, other, columns))
		                    then label & " and " & Text.Replace(other, "_", " ") & " are the same person: " & (if person[Name] <> "" then person[Name] else person[Email]) else "")
		                else if op = "tagMatchesAny" then
		                    (let matching = List.Select(tags, (tag) => List.AnyTrue(List.Transform(listOf(value), (pattern) => fnMatches(pattern, "i", tag)))) in
		                    if List.IsEmpty(matching) then "" else "tagged " & Text.Combine(matching, ", "))
		                else if op = "levelsMissing" then
		                    (let missing = List.Select(rules[dimensions], (dimension) => fnLevelAt(ci, field & "." & dimension) = null) in
		                    if List.IsEmpty(missing) then ""
		                    else if List.Count(missing) = List.Count(rules[dimensions]) then "no " & label & " criticality"
		                    else "no " & label & " criticality for " & Text.Combine(missing, ", "))
		                else if op = "greaterThanField" or op = "lessThanField" then
		                    (let
		                        left = fnLevelAt(ci, field),
		                        right = fnLevelAt(ci, Text.From(value)),
		                        other = Text.From(value),
		                        otherWords = if Text.Contains(other, ".") then Text.BeforeDelimiter(other, ".") & " " & Text.AfterDelimiter(other, ".") else other
		                    in
		                        if left = null or right = null then ""
		                        else if (if op = "greaterThanField" then left > right else left < right)
		                        then label & " is " & fnLevelWords(left) & ", " & otherWords & " is " & fnLevelWords(right) else "")
		                else if op = "lacksValidEntryFor" then
		                    (let
		                        dimension = Text.From(value),
		                        ignore = Record.FieldOrDefault(condition, "ignore", null),
		                        entries = List.Select(entriesOf(current), (entry) => Text.StartsWith(Text.Lower(entry, "en-US"), Text.Lower(dimension, "en-US")))
		                    in
		                        if List.AnyTrue(List.Transform(entries, (entry) => ignore = null or not fnMatches(ignore, "i", entry))) then ""
		                        else if List.IsEmpty(entries) then "no justification for " & dimension
		                        else "only an auto-generated justification for " & dimension)
		                else if op = "onlyMatches" or op = "notOnlyMatches" then
		                    (let
		                        entries = List.Select(entriesOf(current), (entry) => entry <> ""),
		                        only = not List.IsEmpty(entries) and List.AllTrue(List.Transform(entries, (entry) => fnMatches(Text.From(value), "i", entry)))
		                    in
		                        if op = "onlyMatches" then (if only then label & " holds only the automatic text" else "")
		                        else if only then "" else if List.IsEmpty(entries) then label & " is empty" else label & " holds a text of its own")
		                else if op = "groupInactive" then
		                    (if ci[SupportGroup] <> "" and ci[SupportGroupActive] = false then "Support group " & ci[SupportGroup] & " is not active" else "")
		                else if op = "hasHiddenCharacters" then
		                    (if List.IsEmpty(ci[HiddenCharacters]) then "" else "the name holds a hidden character: " & Text.Combine(ci[HiddenCharacters], ", "))
		                else if op = "missingTags" then
		                    (let
		                        ref = Record.FieldOrDefault(condition, "ref", null),
		                        byClass = if ref = null then null else Record.FieldOrDefault(tagRefs, ref, null),
		                        own = List.Transform(tags, tagWords),
		                        wanted = if byClass = null then {} else Record.FieldOrDefault(byClass, ci[Class], {}),
		                        meets = (rule as record, tag as text) as logical =>
		                            List.Contains(rule[Keys], tag) or List.AnyTrue(List.Transform(rule[Endings], (ending) => Text.EndsWith(tag, ending))),
		                        missing = List.Select(wanted, (rule) => not List.AnyTrue(List.Transform(own, (tag) => meets(rule, tag))))
		                    in
		                        if List.IsEmpty(missing) then "" else "missing tag: " & Text.Combine(List.Transform(missing, (rule) => rule[label]), ", "))
		                else if op = "tagsNotIn" then
		                    (let
		                        ref = Record.FieldOrDefault(condition, "ref", null),
		                        allowed = if ref = null then null else Record.FieldOrDefault(tagRefs, ref, null),
		                        keys = ci[TagKeys],
		                        unknown = List.Transform(List.Select(List.Positions(tags), (at) => allowed = null or not Record.HasFields(allowed, keys{at})), (at) => tags{at})
		                    in
		                        if List.IsEmpty(unknown) then "" else "tag not in the allowed list: " & Text.Combine(unknown, ", "))
		                else error Error.Record("SACM.Rule", "Unknown operator """ & op & """ in " & pack[id]),

		        /** Why the condition holds for this CI, or "" when it does not. */
		        test = (condition as record, ci as record, part as text) as text =>
		            if Record.HasFields(condition, "all") then
		                let reasons = List.Transform(condition[all], (item) => @test(item, ci, part)) in
		                if List.AllTrue(List.Transform(reasons, (reason) => reason <> "")) then Text.Combine(reasons, "; ") else ""
		            else if Record.HasFields(condition, "any") then
		                let found = List.Select(List.Transform(condition[any], (item) => @test(item, ci, part)), (reason) => reason <> "") in
		                if List.IsEmpty(found) then "" else found{0}
		            else leaf(condition, ci, part),

		        /** The leaves that hold for this CI, in the order of the condition: the parts that made the finding. */
		        holding = (condition as record, ci as record, part as text) as list =>
		            List.Select(leaves(condition), (item) => leaf(item, ci, part) <> ""),

		        /** The line of the SACM fix list, from the first part that holds and says what to change (engine.ts, fixLineOf). */
		        fixLineOf = (condition as record, ci as record, part as text) as nullable record =>
		            let
		                lines = List.Transform(holding(condition, ci, part), (item) =>
		                    if item[op] = "hasHiddenCharacters" then
		                        [Change = "Remove the hidden character from the name", Current = fnVisibleName(ci[Name]), Set = "The same name without the hidden character", Value = fnWithoutHidden(ci[Name])]
		                    else if item[op] = "duplicatedInClass" then
		                        [Change = "Two records for one thing: retire one", Current = ci[Name], Set = "Retire the record that is not used (two real CIs: ask the owner)", Value = ""]
		                    else if item[op] = "hasDoubleSpaces" then
		                        (let set = fnSingleSpaces(ci[Name]) in [Change = "Two spaces in a row in the name", Current = ci[Name], Set = set, Value = set])
		                    else if item[op] = "lacksValidEntryFor" then
		                        (let dimension = fnCapital(Text.From(fill(Record.FieldOrDefault(item, "value", part), part))) in
		                        [Change = "Add the justification for " & dimension & ", from the request",
		                            Current = if Text.Trim(ci[ExceptionJustification]) = "" then "(empty)" else Text.Trim(ci[ExceptionJustification]), Set = "A justification for " & dimension, Value = ""])
		                    else if item[op] = "levelsMissing" then
		                        [Change = "Status " & ci[Status] & " without CIA values: check the status, or add the tag BIA N/A or BIA is pending",
		                            Current = if ci[Status] = "" then "(empty)" else ci[Status], Set = "The right status, or the tag", Value = ""]
		                    else null),
		                found = List.RemoveNulls(lines)
		            in
		                if List.IsEmpty(found) then null else found{0},

		        /** The report columns a condition needs (engine.ts, requiredColumns and columnsFor). */
		        required = (condition as record, part as text) as list =>
		            List.Combine(List.Transform(leaves(condition), (item) =>
		                let
		                    op = item[op],
		                    field = fill(Record.FieldOrDefault(item, "field", part), part),
		                    value = fill(Record.FieldOrDefault(item, "value", null), part),
		                    own =
		                        if op = "hasHiddenCharacters" then {"name.hidden"}
		                        else if op = "groupInactive" then {"supportGroup", "supportGroupActive"}
		                        else if op = "levelsMissing" then List.Transform(rules[dimensions], (dimension) => field & "." & dimension)
		                        else if isRole(field) then {if op = "refInactive" then field & ".active" else field}
		                        else {Record.FieldOrDefault(rules[columnOf], field, field)},
		                    other = if (Text.EndsWith(op, "Field") or op = "samePersonAs") and value is text then {value} else {}
		                in
		                    own & other)),

		        missingReferences = List.Select(List.Transform(List.Select(leaves(when), (item) => Record.HasFields(item, "ref")), (item) => item[ref]), (name) => fnReference(name) = null),
		        parts = Record.FieldOrDefault(detector, "forEach", {""}),
		        hints = rules[columnHints],

		        perPart = List.Transform(parts, (part) =>
		            let
		                absent = List.Select(List.Distinct(required(when, part)), (column) => not List.Contains(columns, column)),
		                said = List.Transform(List.Select(absent, (column) => Record.HasFields(hints, column)), (column) => Record.Field(hints, column)),
		                plain = List.Select(absent, (column) => not Record.HasFields(hints, column)),
		                note = "Not tested" & (if part <> "" then " for " & fnColumnWord(part) else "") & ": "
		                    & Text.Combine(said & (if List.IsEmpty(plain) then {} else {fnMissingColumns(plain)}), "; ") & ".",
		                classes = Record.FieldOrDefault(Record.FieldOrDefault(detector, "forEachClasses", []), part, null),
		                field = if part <> "" then part else if Record.HasFields(when, "field") and when[field] <> "" then when[field] else pack[family],
		                evaluated = List.Select(inScope, (ci) => classes = null or List.Contains(classes, ci[Class])),
		                found = List.Buffer(List.RemoveNulls(List.Transform(evaluated, (ci) =>
		                    let detail = test(when, ci, part) in
		                    if detail = "" then null
		                    else fnFinding(pack, ci, field, detail, [Fix = if playbook[path] = "sacm-fix" then fixLineOf(when, ci, part) else null]))))
		            in
		                if not List.IsEmpty(absent) then [Findings = {}, Tested = {}, Evaluated = {}, Notes = {note}]
		                else [Findings = found, Tested = {pack[id] & ":" & field}, Evaluated = {[Part = pack[id] & ":" & field, Count = List.Count(evaluated)]}, Notes = {}])
		    in
		        if not List.IsEmpty(missingReferences) then
		            [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Skipped: reference data missing (" & Text.Combine(missingReferences, ", ") & ")."}]
		        else
		            [
		                Findings = List.Combine(List.Transform(perPart, (out) => out[Findings])),
		                Tested = List.Combine(List.Transform(perPart, (out) => out[Tested])),
		                Evaluated = List.Combine(List.Transform(perPart, (out) => out[Evaluated])),
		                Notes = List.Combine(List.Transform(perPart, (out) => out[Notes]))
		            ]
	queryGroup: Checks

/// The EPO systems report compared with the CI report (src/core/sources/epo/epo-report.ts, compareEpo): a system matches the CI of the classes of reference/epo-systems-report whose asset tag is its EPO ID (two CIs with the tag: the live one). A pair Retired on both sides is not compared. Compared: status, name (the EPO name and " - PROD"), the three people by user ID and, when the CI report has the column, the description (by letters and digits: empty, cut short or another start). A role empty in EPO while ServiceNow still shows a person is a leftover (D190): the owner is asked, it is on neither EPO card. Returns [Pairs, WithoutCi, RetiredBoth, Notes]; a pair is [Ci, System, Mapped, Differences, Leftovers], a difference [Field, Label, Current, Epo, Value, Leftover].
expression fnEpoCompare =
		(cis as list, systems as list, columns as list, config as record) as record =>
		    let
		        retiredWords = List.Buffer(List.Transform(config[retiredStatuses], (word) => fnNameKey(word, ""))),
		        isRetired = (status as text) as logical => List.Contains(retiredWords, fnNameKey(status, "")),
		        isRetiredCi = (ci as record) as logical => List.Contains(retiredWords, ci[StatusKey]),
		        same = (a as text, b as text) as logical => fnNameKey(a, "") = fnNameKey(b, ""),
		        byTag = fnGroupBy(List.Select(cis, (ci) => List.Contains(config[classes], ci[Class]) and ci[AssetTag] <> ""), (ci) => Text.Lower(Text.Trim(ci[AssetTag]), "en-US")),
		        names = fnUserNames(cis, columns),
		        roles = List.Select(config[roles], (entry) => List.Contains(columns, entry[role] & ".userId") or List.Contains(columns, entry[role])),
		        unread = List.Select(config[roles], (entry) => not List.Contains(roles, entry)),
		        noUserId = List.Select(roles, (entry) => not List.Contains(columns, entry[role] & ".userId")),
		        compared = List.Select(roles, (entry) => List.Contains(columns, entry[role] & ".userId")),
		        descriptions = List.Contains(columns, "description"),
		        labels = (entries as list) as text => Text.Combine(List.Transform(entries, (entry) => entry[label]), ", "),
		        notes =
		            (if List.IsEmpty(unread) then {} else {"The CI report has no column for " & labels(unread) & ", so " & (if List.Count(unread) = 1 then "it is" else "they are") & " not compared."})
		            & (if List.IsEmpty(noUserId) then {} else {"The CI report has no user ID column for " & labels(noUserId) & " ("
		                & Text.Combine(List.Transform(noUserId, (entry) => entry[role] & ".user_name"), ", ") & "): EPO names people by user ID, so "
		                & (if List.Count(noUserId) = 1 then "it is" else "they are") & " not compared."})
		            & (if descriptions then {} else {"The CI report has no description column (short_description), so the description is not compared."}),
		        leftovers = Record.HasFields(config, "sourceFirst"),
		        startOf = (text as text) as text => if Text.Length(text) > 120 then Text.Start(text, 117) & "…" else text,
		        words = [empty = "empty in ServiceNow, EPO has one", cut = "stops before the end of the EPO text", start = "starts differently from the EPO text"],
		        // How the description differs (descriptionDifference): "" when the same, or when only later words differ.
		        descriptionKind = (ci as record, system as record) as text =>
		            let
		                epo = fnLetters(system[Description]),
		                now = fnLetters(if ci[Description] = null then "" else ci[Description]),
		                start = List.Max({1, config[descriptionStart]})
		            in
		                if epo = "" or now = epo then ""
		                else if now = "" then "empty"
		                else if Text.StartsWith(epo, now) then "cut"
		                else if Text.Start(now, start) <> Text.Start(epo, start) then "start"
		                else "",
		        pairOf = (system as record) as nullable record =>
		            let
		                first = Record.FieldOrDefault(byTag, Text.Lower(Text.Trim(system[EpoId]), "en-US"), {}),
		                live = List.Select(first, (ci) => not isRetiredCi(ci)),
		                found = if List.Count(first) > 1 and not List.IsEmpty(live) then live else first,
		                ci = if List.IsEmpty(found) then null else found{0},
		                epoRetired = system[Status] <> "" and isRetired(system[Status]),
		                status = if system[Status] <> "" and not same(system[Status], ci[Status])
		                    then {[Field = "status", Label = "Operational status", Current = if ci[Status] = "" then "empty" else ci[Status],
		                        Epo = system[Status] & " (" & system[StatusWord] & ")", Value = system[Status], Leftover = false]} else {},
		                epoName = system[Name] & config[nameSuffix],
		                name = if system[Name] <> "" and not same(ci[Name], epoName)
		                    then {[Field = "name", Label = "Name", Current = ci[Name], Epo = epoName, Value = epoName, Leftover = false]} else {},
		                people = List.RemoveNulls(List.Transform(compared, (entry) =>
		                    let
		                        person = fnPerson(ci, entry[role], columns),
		                        now = if person = null then "" else Text.Lower(Text.Trim(person[UserId]), "en-US"),
		                        epo = Text.Lower(Text.Trim(Record.Field(system, fnPascal(entry[column]))), "en-US"),
		                        shown = if now <> "" then fnPersonWords(now, names)
		                            else if person <> null and (person[Name] <> "" or person[Email] <> "") then (if person[Name] <> "" then person[Name] else person[Email]) & " (no user ID)"
		                            else "nobody"
		                    in
		                        if now = epo then null
		                        else [Field = entry[role], Label = entry[label], Current = shown, Epo = fnPersonWords(epo, names),
		                            Value = if epo = "" then "" else Record.FieldOrDefault(names, epo, epo), Leftover = epo = "" and leftovers])),
		                kind = if descriptions then descriptionKind(ci, system) else "",
		                description = if kind = "" then {}
		                    else {[Field = "description", Label = "Description (" & Record.Field(words, kind) & ")",
		                        Current = if ci[Description] = "" then "empty" else """" & startOf(ci[Description]) & """",
		                        Epo = """" & startOf(system[Description]) & """", Value = system[Description], Leftover = false]},
		                differences = status & name & people & description
		            in
		                if ci = null then [Kind = if epoRetired then "none" else "without", System = system]
		                else if epoRetired and isRetiredCi(ci) then [Kind = "retired"]
		                else [Kind = "pair", Pair = [Ci = ci, System = system, Mapped = ci[ServiceMapped], Differences = differences,
		                    Leftovers = List.Select(differences, (difference) => difference[Leftover])]],
		        results = List.Buffer(List.Transform(systems, pairOf))
		    in
		        [
		            Pairs = List.Buffer(List.Transform(List.Select(results, (result) => result[Kind] = "pair"), (result) => result[Pair])),
		            WithoutCi = List.Transform(List.Select(results, (result) => result[Kind] = "without"), (result) => result[System]),
		            RetiredBoth = List.Count(List.Select(results, (result) => result[Kind] = "retired")),
		            Notes = notes
		        ]
	queryGroup: Checks

/// "Corrected in EPO" (src/app/view/cases.ts, epoCorrection, and src/core/sources/epo/epo-report.ts, correctedInEpo): for each fact, in the same order, what the case says when the fix is made in EPO and the EPO systems report of the run shows another person in the role than ServiceNow; "" when there is nothing to say. Until the team's journal is read (build B5) no message is known, so it is always the words for a case nobody was asked about yet: "EPO already has …". Only shown: nothing is sent and nothing is changed.
expression fnEpoCorrections =
		(facts as list, run as record) as list =>
		    let
		        epo = run[Epo],
		        config = let found = fnReference("reference/epo-systems-report") in if found <> null and Value.Is(Record.FieldOrDefault(found, "roles", null), type list) then found else null,
		        columns = run[Columns],
		        ciByKey = Record.FromList(run[Cis], List.Transform(run[Cis], (ci) => ci[Key])),
		        roles = {"owned_by", "managed_by", "supported_by"},
		        // The people of a CI as the case shows them (src/app/view/people.ts): a role with a name or an email; its id is
		        // the user ID, else the email, else the name, in lower case.
		        personOf = (ci as record, role as text) as nullable record =>
		            let
		                person = fnPerson(ci, role, columns),
		                lower = (text as text) as text => Text.Lower(Text.Trim(text), "en-US"),
		                id = if person = null then "" else if person[UserId] <> "" then lower(person[UserId]) else lower(person[Email])
		            in
		                if person = null or (person[Name] = "" and person[Email] = "") then null
		                else [Id = if id <> "" then id else Text.Lower(person[Name], "en-US"), Name = if person[Name] <> "" then person[Name] else person[Email]],
		        // The people the app keeps with the run: of every CI with a finding and of every CI of the inventory (not parked).
		        // Both as key sets (fnKeySet), made once: the CIs that are not parked (fnCheckRun) and the CIs with a finding.
		        kept = run[CheckableKeys],
		        withFinding = fnKeySet(List.Transform(facts, (fact) => fact[CiKey])),
		        withPeople = List.Distinct(List.Select(List.Transform(run[Cis], (ci) => ci[Key]), (key) => Record.HasFields(withFinding, key) or Record.HasFields(kept, key))),
		        named = List.Combine(List.Transform(withPeople, (key) => List.RemoveNulls(List.Transform(roles, (role) => personOf(Record.Field(ciByKey, key), role))))),
		        grouped = fnGroupBy(named, (person) => person[Id]),
		        names = Record.FromList(List.Transform(Record.FieldValues(grouped), (list) => list{0}[Name]), Record.FieldNames(grouped)),
		        systems = if epo = null then [] else
		            let byId = fnGroupBy(epo[Systems], (system) => Text.Lower(Text.Trim(system[EpoId]), "en-US")) in
		            Record.FromList(List.Transform(Record.FieldValues(byId), List.Last), Record.FieldNames(byId)),
		        textOf = (fact as record) as text =>
		            let
		                system = if fact[EpoId] = "" then null else Record.FieldOrDefault(systems, Text.Lower(Text.Trim(fact[EpoId]), "en-US"), null),
		                role = List.First(List.Select(config[roles], (entry) => entry[role] = fact[Field]), null),
		                epoId = if role = null or system = null then "" else Text.Lower(Text.Trim(Record.Field(system, fnPascal(role[column]))), "en-US"),
		                person = if role = null or not List.Contains(roles, fact[Field]) then null else personOf(Record.Field(ciByKey, fact[CiKey]), fact[Field]),
		                now = if person = null then "" else person[Id]
		            in
		                if fact[Route] = "" or system = null or system[Changed] = null or role = null or epoId = "" or epoId = now then ""
		                else "EPO already has " & role[epoLabel] & " " & fnPersonWords(epoId, names) & " (last change in EPO: " & fnLongDate(system[Changed])
		                    & "), so nobody needs to be asked. ServiceNow receives it from EPO (for a service mapped CI, SACM copies it: fix list of ""EPO ≠ ServiceNow"")."
		    in
		        if epo = null or config = null then List.Transform(facts, (fact) => "") else List.Transform(facts, textOf)
	queryGroup: Checks

/// The EPO IDs written in the EPO ID column of Solusi (free text; src/core/checks/detectors/contract-detectors.ts, epoIdsOf): every match of /[A-Za-z]*-?\d+/ from left to right whose digits are at least `minDigits` long, each number once. Returns a list of [Written, Digits]: Written keeps the letters in front ("AST-0006"), because an EPO ID can be more than digits. Read character by character: the letters (ASCII), then "-" and digits, or digits.
expression fnEpoIds =
		(text as text, minDigits as number) as list =>
		    let
		        chars = List.Buffer(Text.ToList(text)),
		        count = List.Count(chars),
		        isLetter = (at as number) as logical => at < count and ((chars{at} >= "A" and chars{at} <= "Z") or (chars{at} >= "a" and chars{at} <= "z")),
		        isDigit = (at as number) as logical => at < count and chars{at} >= "0" and chars{at} <= "9",
		        runOf = (at as number, test as function) as number => List.Last(List.Generate(() => at, (position) => test(position), (position) => position + 1, (position) => position + 1), at),
		        // The match that starts at `at`, as [Start, Digits, End], or null.
		        matchAt = (at as number) as nullable record =>
		            let
		                lettersEnd = runOf(at, isLetter),
		                dash = lettersEnd < count and chars{lettersEnd} = "-" and isDigit(lettersEnd + 1),
		                digitsStart = if dash then lettersEnd + 1 else lettersEnd,
		                digitsEnd = runOf(digitsStart, isDigit)
		            in
		                if dash or isDigit(lettersEnd) then [Start = at, DigitsStart = digitsStart, End = digitsEnd] else null,
		        matches = List.Generate(
		            () => [At = 0, Found = null],
		            (state) => state[At] <= count,
		            (state) => let found = matchAt(state[At]) in if found = null then [At = state[At] + 1, Found = null] else [At = found[End], Found = found],
		            (state) => state[Found]),
		        found = List.Transform(List.RemoveNulls(matches), (match) =>
		            [Written = Text.Combine(List.Range(chars, match[Start], match[End] - match[Start])), Digits = Text.Combine(List.Range(chars, match[DigitsStart], match[End] - match[DigitsStart]))]),
		        long = List.Select(found, (id) => Text.Length(id[Digits]) >= List.Max({1, minDigits}))
		    in
		        List.Accumulate(long, {}, (kept, id) => if List.Contains(List.Transform(kept, (item) => item[Digits]), id[Digits]) then kept else kept & {id})
	queryGroup: Checks

/// The output of an EPO card when the CI report has no "service mapped" column: not tested, with the note that says why.
expression fnEpoNoFlag =
		() as record =>
		    [Findings = {}, Tested = {}, Evaluated = {}, Notes = {"Not tested: the CI report has no ""service mapped"" column (ref_cmdb_ci_service.u_service_mapped). It decides whether SACM or the sync brings the EPO value."}]
	queryGroup: Checks

/// What an EPO card tests (src/core/checks/detectors/epo-detectors.ts, testedFields): status and name always, each role of reference/epo-systems-report whose user ID column the CI report has, and the description when it has that column, each on the pairs of the card. The notes of the comparison (what it could not compare) are the card's notes too.
expression fnEpoTested =
		(pack as record, run as record, config as record, pairs as list) as record =>
		    let
		        columns = run[Columns],
		        fields = {"status", "name"} & List.Transform(config[roles], (entry) => entry[role]) & {"description"},
		        kept = List.Select(fields, (field) =>
		            if field = "description" then List.Contains(columns, "description")
		            else field = "status" or field = "name" or List.Contains(columns, field & ".userId"))
		    in
		        [
		            Tested = List.Transform(kept, (field) => pack[id] & ":" & field),
		            Evaluated = List.Transform(kept, (field) => [Part = pack[id] & ":" & field, Count = List.Count(pairs)]),
		            Notes = run[EpoComparison][Notes]
		        ]
	queryGroup: Checks

/// The findings of a run as facts: each finding with who to ask about it, where it is fixed and how it is listed (src/core/cases/cases.ts, buildRun). Procurement problems go to the Procurement mailbox; a record a team is responsible for goes to the team (reference/record-teams, D195); a detector may name another CI whose people are asked (ContactCi); a CI from EPO where nobody can be asked goes to the EPO inventory owner (D47). Nothing is sent here.
expression fnFacts =
		(findings as list, run as record, packs as list) as list =>
		    let
		        cis = run[Cis],
		        columns = run[Columns],
		        // The contracts (and other records that are not CIs) findings are about: the first of each key; never a CI of the report.
		        subjectGroups = fnGroupBy(Record.FieldOrDefault(run, "Subjects", {}), (subject) => subject[Key]),
		        subjects = Record.FromList(List.Transform(Record.FieldValues(subjectGroups), List.First), Record.FieldNames(subjectGroups)),
		        ciByKey = subjects & Record.FromList(cis, List.Transform(cis, (ci) => ci[Key])),
		        // A contract says which roles it has; a CI has the columns of its report.
		        columnsOf = (ci as record) as list => Record.FieldOrDefault(ci, "SubjectColumns", columns),
		        packById = Record.FromList(packs, List.Transform(packs, (pack) => pack[id])),
		        chipRules = List.Buffer(List.Transform(Record.FieldOrDefault(Record.FieldOrDefault(ReferenceFiles, "tag-chips", []), "chips", {}), (rule) => rule & [TagKey = fnNameKey(rule[tag], "")])),
		        teams = Record.FieldOrDefault(Record.FieldOrDefault(ReferenceFiles, "record-teams", []), "teams", {}),
		        chipsOf = (ci as record) as list =>
		            List.Distinct(List.Transform(List.Select(chipRules, (rule) => List.Contains(ci[TagKeys], rule[TagKey])), (rule) => rule[chip])),
		        nameOf = (ci as record, role as text) as text =>
		            let person = fnPerson(ci, role, columnsOf(ci)), shown = if person = null then "" else if person[Name] <> "" then person[Name] else person[Email] in
		            if shown = "" then "" else shown & (if person[Active] = false then " (inactive)" else ""),
		        nobody = [EscalateName = "", EscalateEmail = "", EscalateVia = ""],
		        factOf = (finding as record) as record =>
		            let
		                ci = Record.Field(ciByKey, finding[CiKey]),
		                pack = Record.FieldOrDefault(packById, finding[CheckId], null),
		                playbook = if pack = null then [] else Record.FieldOrDefault(pack, "playbook", []),
		                audience = Record.FieldOrDefault(playbook, "audience", {}),
		                route = if Record.FieldOrDefault(playbook, "routeBy", "") = "epo" and finding[InServiceNow] <> true and fnFixedInEpo(ci, finding[CheckId], finding[Field]) then "epo" else "",
		                listed = fnListing(ci, pack, finding[Review], finding[Wait]),
		                own = chipsOf(ci),
		                module = if pack <> null and List.Contains(ReadingRules[modules], pack[dimension]) then pack[dimension] else "correctness",
		                base = finding & [
		                    Detail = fnCapital(finding[Detail]),
		                    ClassLabel = if ci[SourceClass] <> "" then ci[SourceClass] else finding[Class],
		                    Module = module, Route = route, State = listed[State], StateWhy = listed[Why],
		                    EpoId = ci[AssetTag], Status = ci[Status], SupportGroup = ci[SupportGroup],
		                    OwnedBy = nameOf(ci, "owned_by"), ManagedBy = nameOf(ci, "managed_by"), SupportedBy = nameOf(ci, "supported_by"),
		                    Chips = own & List.Select(List.Distinct(finding[Chips]), (chip) => not List.Contains(own, chip)),
		                    Tags = ci[TagList],
		                    // A contract (fnContractSubject): its number, name and vendor, for the table of a message (build B7); null for a CI.
		                    Contract = Record.FieldOrDefault(ci, "Contract", null)
		                ],
		                team = if pack = null or List.Contains(audience, "sacm") then null
		                    else List.First(List.Select(teams, (candidate) => List.Contains(candidate[classes], ci[Class]) and List.Contains(candidate[checks], pack[id])), null),
		                other = if finding[ContactCi] <> "" then Record.FieldOrDefault(ciByKey, finding[ContactCi], null) else null,
		                theirs = if other = null then null else fnContact(other, "", audience, columnsOf(other)),
		                contact =
		                    if theirs <> null and theirs[To] <> null then
		                        [To = theirs[To] & [Via = theirs[To][Via] & " of " & (if other[SourceClass] <> "" then other[SourceClass] else "Business Service") & " " & other[Name]], Cc = theirs[Cc]]
		                    else fnContact(ci, finding[Field], audience, columnsOf(ci)),
		                to = contact[To],
		                above = if to = null then null else to[Above]
		            in
		                if List.Contains(audience, "procurement") then
		                    base & [ContactName = "Procurement", ContactEmail = "", ContactId = ReadingRules[procurement][id], ContactVia = ReadingRules[procurement][via], Cc = {}] & nobody
		                else if team <> null then
		                    base & [Route = "", ContactName = team[name], ContactEmail = "", ContactId = "team:" & team[id], ContactVia = team[name] & " team", Cc = {}] & nobody
		                else if route <> "" and to = null then
		                    base & [ContactName = ReadingRules[epoOwner][name], ContactEmail = "", ContactId = ReadingRules[epoOwner][id], ContactVia = ReadingRules[epoOwner][via], Cc = {}] & nobody
		                else
		                    base & [
		                        ContactName = if to = null then "" else to[Name], ContactEmail = if to = null then "" else to[Email],
		                        ContactId = if to = null then "" else to[Id], ContactVia = if to = null then "" else to[Via], Cc = contact[Cc],
		                        EscalateName = if above = null then "" else above[Name], EscalateEmail = if above = null then "" else above[Email],
		                        EscalateVia = if above = null then "" else above[Via]
		                    ]
		    in
		        List.Transform(findings, factOf)
	queryGroup: Checks

/// One finding of a check on a CI (src/core/model/model.ts, Finding). The key never changes: <check>:<CI key>:<field>, and ":<suffix>" for a finding about one relationship. `extra` may give Suffix, Review (listed for a review, why), Wait (waits, why), Source (what the source says), Fix (the line of a SACM fix list: Change, Current, Set, Value, RelatedTo, Note), Chips, ContactCi, InServiceNow, Mapping (the reasons of a case of the mapping backlog, by id), Problem (the kind of problem a line is listed under: a problem of the contract data, a field of the upload check; D146) and Subject (the record a finding is about when it is not a CI of the report: a contract, fnContractSubject).
expression fnFinding =
		(pack as record, ci as record, field as text, detail as text, optional extra as nullable record) as record =>
		    let
		        more = if extra = null then [] else extra,
		        suffix = Record.FieldOrDefault(more, "Suffix", "")
		    in
		        [
		            Key = pack[id] & ":" & ci[Key] & ":" & field & (if suffix = "" then "" else ":" & suffix), CheckId = pack[id], CiKey = ci[Key], CiName = ci[Name],
		            Class = ci[Class], Field = field, Severity = Record.FieldOrDefault(pack, "severity", ""), Detail = detail,
		            Review = Record.FieldOrDefault(more, "Review", ""), Wait = Record.FieldOrDefault(more, "Wait", ""), Source = Record.FieldOrDefault(more, "Source", ""),
		            Fix = Record.FieldOrDefault(more, "Fix", null), Chips = Record.FieldOrDefault(more, "Chips", {}), ContactCi = Record.FieldOrDefault(more, "ContactCi", ""),
		            InServiceNow = Record.FieldOrDefault(more, "InServiceNow", false), Mapping = Record.FieldOrDefault(more, "Mapping", {}),
		            Problem = Record.FieldOrDefault(more, "Problem", ""), Subject = Record.FieldOrDefault(more, "Subject", null)
		        ]
	queryGroup: Checks

/// How a finding is listed (src/core/checks/finding-states.ts, listing): waiting (a detector says it waits, or the CI is not live yet: reference/not-live-statuses), known (a tag of the team explains it: reference/known-tags), review (the check is listed for a review only, or the detector says so), else open (to solve). Returns [State, Why].
expression fnListing =
		(ci as record, pack as nullable record, review as text, wait as text) as record =>
		    let
		        rules = ListingRules,
		        id = if pack = null then "" else pack[id],
		        waits = pack = null or not List.Contains(rules[ExceptChecks], id),
		        liveStatus = waits and List.Contains(rules[NotLiveKeys], ci[StatusKey]),
		        // The first rule of the file that has a tag of the CI, and its first such tag (as finding-states.ts loops).
		        tags = ci[TagList],
		        keys = ci[TagKeys],
		        first = (entry as record) as nullable number => List.First(List.Select(List.Positions(keys), (at) => List.Contains(entry[TagKeys], keys{at})), null),
		        rule = if pack = null then null else List.First(List.Select(rules[Known], (candidate) => List.Contains(candidate[checks], id) and first(candidate) <> null), null),
		        tag = if rule = null then null else tags{first(rule)},
		        reviewWhy = if pack = null then "" else Record.FieldOrDefault(pack, "reviewWhy", "")
		    in
		        if wait <> "" then [State = "waiting", Why = wait]
		        else if liveStatus then [State = "waiting", Why = "Status " & ci[Status] & ": not live yet"]
		        else if tag <> null then [State = "known", Why = "Tagged " & tag]
		        else if pack <> null and Record.FieldOrDefault(pack, "reviewOnly", false) = true then [State = "review", Why = if reviewWhy <> "" then reviewWhy else "Allowed: listed for a review"]
		        else if review <> "" then [State = "review", Why = review]
		        else [State = "open", Why = ""]
	queryGroup: Checks

/// Does the text match the pattern (a regular expression of a check file or a reference file)? `flags` is "i" to ignore case, else "". The pattern must be one the generator compiled (the query Patterns): an unknown one stops the refresh with its name, so a check never passes silently on a pattern Power Query does not know. Its fast form (PatternForms, fnFastMatch) decides most texts without the walk.
expression fnMatches =
		(pattern as text, flags as text, value as text) as logical =>
		    let
		        key = flags & "/" & pattern,
		        tree = Record.FieldOrDefault(Patterns, key, null),
		        form = Record.FieldOrDefault(PatternForms, key, null)
		    in
		        if tree = null then error Error.Record("SACM.Pattern", "The pattern /" & pattern & "/" & flags & " is not compiled. Run npm run powerbi:generate.")
		        else if form = null then fnRegexTest(tree, value)
		        else fnFastMatch(form, tree, value)
	queryGroup: Checks

/// The parked CIs of a report (src/core/checks/parked.ts, D179): the CIs of a class that is not checked yet. They give no line on any card and are not counted as tested; each rule of reference/parked-classes gives one grey line. Returns [Keys, Fields, Lines, KeySet, FieldSet] (the two sets: fnKeySet, made once), or null when the reference file is missing (then nothing is parked, and a note says so). `cis` are the CIs of fnCheckRun, with their StatusKey.
expression fnParked =
		(cis as list) as nullable record =>
		    let
		        reference = Record.FieldOrDefault(ReferenceFiles, "parked-classes", null),
		        retired = fnNameKey("Retired", ""),
		        parkedBy = (classes as list, statuses as list, ci as record) as logical =>
		            List.Contains(classes, ci[Class]) and ci[StatusKey] <> retired and (List.IsEmpty(statuses) or List.Contains(statuses, ci[StatusKey])),
		        rules = if reference = null then {} else Record.FieldOrDefault(reference, "rules", {}),
		        perRule = List.Buffer(List.Transform(rules, (rule) =>
		            let
		                classes = List.Buffer(rule[classes]),
		                statuses = List.Buffer(List.Transform(Record.FieldOrDefault(rule, "statuses", {}), (status) => fnNameKey(status, ""))),
		                found = List.Buffer(List.Select(cis, (ci) => parkedBy(classes, statuses, ci))),
		                count = List.Count(found),
		                line = if count = 0 then Record.FieldOrDefault(rule, "none", "")
		                    else if count = 1 then rule[one]
		                    else Text.Replace(rule[many], "{n}", Number.ToText(count, "#,0", "en-GB"))
		            in
		                [Keys = List.Transform(found, (ci) => ci[Key]), Fields = Record.FieldOrDefault(rule, "fields", {}), Line = if line = null then "" else line])),
		        keys = List.Buffer(List.Distinct(List.Combine(List.Transform(perRule, (rule) => rule[Keys])))),
		        fields = List.Buffer(List.Distinct(List.Combine(List.Transform(perRule, (rule) => rule[Fields]))))
		    in
		        if reference = null then null
		        else [
		            Keys = keys, Fields = fields, KeySet = fnKeySet(keys), FieldSet = fnKeySet(fields),
		            Lines = List.Select(List.Transform(perRule, (rule) => rule[Line]), (line) => line <> "")
		        ]
	queryGroup: Checks

/// Does a compiled pattern (the query Patterns, tools/powerbi/regex.ts) match somewhere in the text? As RegExp.test of JavaScript: the walk of fnRegexWalk from every place in the text.
expression fnRegexTest =
		(tree as list, value as text) as logical =>
		    not List.IsEmpty(fnRegexWalk(tree, value, List.Numbers(0, Text.Length(value) + 1)))
	queryGroup: Checks

/// The places in the text where a compiled pattern (the query Patterns, tools/powerbi/regex.ts) can end, when it starts at one of `starts`. The walk keeps the set of places in the text the pattern can reach, part after part. Read by fnRegexTest (RegExp.test of JavaScript) and fnSearch (String.search).
expression fnRegexWalk =
		(tree as list, value as text, starts as list) as list =>
		    let
		        codes = List.Buffer(List.Transform(Text.ToList(value), Character.ToNumber)),
		        size = List.Count(codes),
		        isWord = (at as number) as logical =>
		            at >= 0 and at < size and (let code = codes{at} in (code >= 48 and code <= 57) or (code >= 65 and code <= 90) or code = 95 or (code >= 97 and code <= 122)),
		        inRanges = (ranges as list, code as number) as logical =>
		            List.AnyTrue(List.Transform(List.Numbers(0, List.Count(ranges) / 2, 2), (at) => code >= ranges{at} and code <= ranges{at + 1})),
		        // Each step is buffered: a list of M is worked out again each time it is read, and the walk reads each one often.
		        step = (node as list, from as list) as list => List.Buffer(walk(node, from)),
		        walk = (node as list, from as list) as list =>
		            let
		                kind = node{0}
		            in
		                if List.IsEmpty(from) then from
		                else if kind = "c" then List.Transform(List.Select(from, (at) => at < size and (inRanges(node{1}, codes{at}) <> (node{2} = 1))), (at) => at + 1)
		                else if kind = "s" then List.Accumulate(node{1}, from, (places, part) => step(part, places))
		                else if kind = "a" then List.Sort(List.Distinct(List.Combine(List.Transform(node{1}, (part) => step(part, from)))))
		                else if kind = "^" then List.Select(from, (at) => at = 0)
		                else if kind = "$" then List.Select(from, (at) => at = size)
		                else if kind = "b" then List.Select(from, (at) => isWord(at - 1) <> isWord(at))
		                else if kind = "B" then List.Select(from, (at) => isWord(at - 1) = isWord(at))
		                else if kind = "r" then
		                    let
		                        low = node{1},
		                        high = node{2},
		                        part = node{3},
		                        first = List.Accumulate(List.Numbers(1, low), from, (places, count) => step(part, places)),
		                        states = List.Generate(
		                            () => [All = first, Frontier = first, Count = low],
		                            (state) => state <> null,
		                            (state) =>
		                                if List.IsEmpty(state[Frontier]) or (high >= 0 and state[Count] >= high) then null
		                                else
		                                    let
		                                        next = List.Buffer(List.Difference(step(part, state[Frontier]), state[All]))
		                                    in
		                                        [All = List.Buffer(List.Sort(List.Union({state[All], next}))), Frontier = next, Count = state[Count] + 1],
		                            (state) => state[All])
		                    in
		                        List.Last(states)
		                else error "Unknown part of a pattern: " & kind
		    in
		        step(tree, starts)
	queryGroup: Checks

/// Where a pattern (a regular expression of a check file or a reference file, compiled into the query Patterns) first matches in the text, as String.search of JavaScript: [Index, End], Index -1 when it does not match. End is the furthest place the match can reach from Index: the end of the match of JavaScript for the patterns that end with "$", the only ones read for their end (fnEnvironment, the name of a Business Application). An unknown pattern stops the refresh with its name, as fnMatches does.
expression fnSearch =
		(pattern as text, flags as text, value as text) as record =>
		    let
		        key = flags & "/" & pattern,
		        tree = Record.FieldOrDefault(Patterns, key, null),
		        ends = (at as number) as list => fnRegexWalk(tree, value, {at}),
		        index = if not fnMatches(pattern, flags, value) then -1
		            else List.First(List.Select(List.Numbers(0, Text.Length(value) + 1), (at) => not List.IsEmpty(ends(at))), -1)
		    in
		        if tree = null then error Error.Record("SACM.Pattern", "The pattern /" & pattern & "/" & flags & " is not compiled. Run npm run powerbi:generate.")
		        else [Index = index, End = if index < 0 then -1 else List.Max(ends(index))]
	queryGroup: Checks

/// The source first (D190, src/core/checks/detectors/source-first.ts): a people line of a CI that pairs with an EPO system is compared with EPO before anybody is asked. EPO already names another person: the line waits. EPO is empty or wrong too: the owner is asked, and the line says what EPO holds (Source). A leftover whose old person is still active gets a line of its own. Without the EPO systems report the lines stay as they are and a note says so. Returns [Findings, Notes].
expression fnSourceFirst =
		(findings as list, run as record, packs as list) as record =>
		    let
		        config = ReferenceFiles[#"epo-systems-report"],
		        rules = Record.FieldOrDefault(config, "sourceFirst", null),
		        columns = run[Columns],
		        cis = run[Cis],
		        systems = run[EpoSystems],
		        checks = if rules = null then {} else rules[checks] & rules[samePerson],
		        why =
		            if systems = null then "no EPO systems report is loaded. Load it with the CI report"
		            else if not List.Contains(columns, "assetTag") then "the CI report has no column for the EPO ID (asset_tag)"
		            else "",
		        lines = List.Count(List.Select(findings, (finding) => List.Contains(checks, finding[CheckId]) and List.Contains(config[classes], finding[Class]))),
		        notCompared = if lines = 0 then {} else {[CheckId = "SOURCE-FIRST", Note = Text.From(lines) & " people "
		            & (if lines = 1 then "line of a CI from EPO was" else "lines of CIs from EPO were") & " not compared with EPO first: " & why & "."]},

		        pairs = if systems = null or run[EpoComparison] = null then {} else run[EpoComparison][Pairs],
		        // As a Map that is set pair after pair: the last pair of a CI wins.
		        pairsByCi = fnGroupBy(pairs, (pair) => pair[Ci][Key]),
		        pairByCi = Record.FromList(List.Transform(Record.FieldValues(pairsByCi), List.Last), Record.FieldNames(pairsByCi)),
		        names = fnUserNames(cis, columns),
		        // The user IDs of people marked inactive, as a key set (fnKeySet), made once.
		        inactive = fnKeySet(List.Combine(List.Transform(cis, (ci) => List.Combine(List.Transform(ReadingRules[roles], (role) =>
		            let person = fnPerson(ci, role, columns) in
		            if person = null then {}
		            else (if person[UserId] <> "" and person[Active] = false then {Text.Lower(Text.Trim(person[UserId]), "en-US")} else {})
		                & (if person[ManagerUserId] <> "" and person[ManagerActive] = false then {Text.Lower(Text.Trim(person[ManagerUserId]), "en-US")} else {})))))),
		        roles = List.Select(config[roles], (entry) => List.Contains(columns, entry[role] & ".userId")),
		        roleOf = (field as text) as nullable record => List.First(List.Select(roles, (entry) => entry[role] = field), null),
		        cardOf = (id as text) as text =>
		            let pack = List.First(List.Select(packs, (candidate) => candidate[id] = id), null) in
		            if pack = null then id else Record.FieldOrDefault(pack, "cardLabel", pack[title]),
		        follows = (pair as record) as text =>
		            if pair[Mapped] = true then "SACM copies it into ServiceNow (card """ & cardOf(rules[cards][mapped]) & """)"
		            else if pair[Mapped] = false then "the sync has not brought it yet (card """ & cardOf(rules[cards][notMapped]) & """)"
		            else "ServiceNow does not show it yet",
		        epoOf = (pair as record, entry as record) as text => Text.Lower(Text.Trim(Record.Field(pair[System], fnPascal(entry[column]))), "en-US"),
		        said = (finding as record, source as text) as record => finding & [Detail = finding[Detail] & ". " & source, Source = source],

		        compared = List.Buffer(List.Transform(findings, (finding) =>
		            let
		                pair = Record.FieldOrDefault(pairByCi, finding[CiKey], null),
		                owner = roleOf("owned_by"),
		                manager = roleOf("managed_by"),
		                entry = if List.Contains(rules[checks], finding[CheckId]) then roleOf(finding[Field]) else null
		            in
		                if pair = null then finding
		                else if List.Contains(rules[samePerson], finding[CheckId]) then
		                    (if owner = null or manager = null then finding
		                    else
		                        let first = epoOf(pair, owner), second = epoOf(pair, manager) in
		                        if first <> "" and second <> "" and first <> second then
		                            finding & [Wait = "EPO already names two people (" & owner[epoLabel] & " " & fnPersonWords(first, names) & ", " & manager[epoLabel] & " "
		                                & fnPersonWords(second, names) & "): " & follows(pair)]
		                        else if first <> "" and first = second then said(finding, "EPO names the same person as " & owner[epoLabel] & " and " & manager[epoLabel])
		                        else said(finding, (if second = "" then manager[epoLabel] else owner[epoLabel]) & " is empty in EPO"))
		                else if entry = null then finding
		                else
		                    let
		                        person = fnPerson(pair[Ci], entry[role], columns),
		                        filled = person <> null and (person[Name] <> "" or person[Email] <> ""),
		                        epo = epoOf(pair, entry),
		                        own = if person = null then "" else Text.Lower(Text.Trim(person[UserId]), "en-US")
		                    in
		                        if epo = "" then said(finding, if filled
		                            then entry[epoLabel] & " is empty in EPO; ServiceNow still shows the old person, because the sync never clears a field"
		                            else entry[epoLabel] & " is empty in EPO too")
		                        else if epo = own then said(finding, "EPO names the same person as " & entry[epoLabel])
		                        else if Record.HasFields(inactive, epo) then said(finding, "EPO names " & fnPersonWords(epo, names) & " as " & entry[epoLabel] & ", who is not active either")
		                        else finding & [Wait = "EPO already names " & fnPersonWords(epo, names) & " as " & entry[epoLabel] & ": " & follows(pair)])),

		        // A leftover whose old person is still active has no line of its own: the role is empty in EPO, so the owner is asked.
		        inScope = (pack as record, ci as record, role as text) as logical =>
		            let
		                detector = pack[detector],
		                classes = Record.FieldOrDefault(Record.FieldOrDefault(detector, "forEachClasses", []), role, null)
		            in
		                fnInScope(pack, ci) and detector[type] = "rule" and List.Contains(Record.FieldOrDefault(detector, "forEach", {}), role)
		                and (classes = null or List.Contains(classes, ci[Class])),
		        candidates = List.Combine(List.Transform(pairs, (pair) => List.Transform(pair[Leftovers], (difference) => [Pair = pair, Difference = difference]))),
		        // Taken: a key of a finding already there, or a people line of the same CI and role of the checks compared first.
		        // Both as key sets (fnKeySet), made once.
		        keys = fnKeySet(List.Transform(compared, (finding) => finding[Key])),
		        lined = fnKeySet(List.Transform(List.Select(compared, (finding) => List.Contains(rules[checks], finding[CheckId])), (finding) => finding[CiKey] & "|" & finding[Field])),
		        packById = Record.FromList(packs, List.Transform(packs, (pack) => pack[id])),
		        leftovers = List.Transform(candidates, (candidate) =>
		            let
		                pair = candidate[Pair],
		                difference = candidate[Difference],
		                entry = roleOf(difference[Field]),
		                checkId = if entry = null then null else Record.FieldOrDefault(rules[leftover], entry[role], null),
		                pack = if checkId = null then null else Record.FieldOrDefault(packById, checkId, null),
		                key = if pack = null then "" else pack[id] & ":" & pair[Ci][Key] & ":" & entry[role],
		                taken = Record.HasFields(keys, key) or Record.HasFields(lined, pair[Ci][Key] & "|" & entry[role]),
		                source = entry[label] & " is empty in EPO (" & entry[epoLabel] & "); ServiceNow still shows " & difference[Current] & ", because the sync never clears a field"
		            in
		                if entry = null or pack = null or not inScope(pack, pair[Ci], entry[role]) or taken then null
		                else [Key = key, Finding = fnFinding(pack, pair[Ci], entry[role], source, [Source = source])]),
		        // A key added once: the first candidate with it, in the order of the candidates (what a loop that remembers the keys
		        // it added does: it reads no other state).
		        added = [Out = List.Transform(Record.FieldValues(fnGroupBy(List.RemoveNulls(leftovers), (line) => line[Key])), (group) => group{0}[Finding])]
		    in
		        if rules = null then [Findings = findings, Notes = {}]
		        else if why <> "" then [Findings = findings, Notes = notCompared]
		        else [Findings = compared & added[Out], Notes = {}]
	queryGroup: Checks

/// Table About: one row. The version of the Workbench, where the data comes from, and the day the samples were recorded: in Sample mode the report counts the age of a report from that day, so the samples look as on the day they were made. The time of the refresh twice: RefreshedAt as the engine's clock gives it (the PC's time in Desktop, UTC in the service), and RefreshedUtc always in UTC (D335): the rail says how long ago it was, and the apps show it in the browser's time (the measure Report at). RefreshRule: the refresh rule in words (powerbi/apps/refresh.json, D333).
expression AboutRows =
		#table(
		    type table [Version = text, SourceMode = text, Data = text, SampleDate = date, RefreshedAt = datetime, RefreshedUtc = datetime, RefreshRule = text],
		    {{WorkbenchVersion, SourceMode,
		        if SourceMode = "SharePoint" then "Reports from the SharePoint folder" else "Invented sample data, packed in this file",
		        SampleDate, DateTime.LocalNow(), DateTimeZone.RemoveZone(DateTimeZone.UtcNow()), RefreshRule[Text]}})
	queryGroup: Tables

/// Table Activity (the tab What happened of History, D293, D321): every event of the journal in words, newest first, as the app's Activity page says it (src/app/view/activity.ts, describeEvent): What it did, By who, Text (the reason, the note, how a message left), the cards it touched (every name up to three, else "4 cards") and the number of CIs. One line per row of the list: a reminder with new points is two rows (the app shows it once). Every email of the shared mailbox counts as sent (the outbox is the app's, D162). Since build D3 also every reply of the list SACM Replies that has a time (Kind Replies: who wrote, the subject, the cards of the messages it answers), and Find: the words the search box of History looks in (what, the cards, the text, who).
expression ActivityRows =
		let
		    labels = Record.FromList(ChecksRows[CardLabel], ChecksRows[CheckId]),
		    labelOf = (id as text) as text => Record.FieldOrDefault(labels, id, id),
		    checkOf = (key as text) as text => let at = Text.PositionOf(key, ":") in if at < 0 then key else Text.Start(key, at),
		    ciOf = (key as text) as text => let first = Text.PositionOf(key, ":"), last = Text.PositionOf(key, ":", Occurrence.Last) in
		        if first < 0 or last <= first then "" else Text.Middle(key, first + 1, last - first - 1),
		    months = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"},
		    screenDate = (iso as text) as text => if Text.Length(iso) < 10 then iso
		        else Text.From(Number.FromText(Text.Middle(iso, 8, 2))) & " " & months{Number.FromText(Text.Middle(iso, 5, 2)) - 1} & " " & Text.Start(iso, 4),
		    longDate = (iso as text) as text => fnLongDate(Date.FromText(Text.Start(iso, 10), [Format = "yyyy-MM-dd", Culture = "en-US"])),
		    reviewWords = [same = "same in EPO", different = "not the same as in EPO", #"not-in-epo" = "not in EPO"],
		    stageWord = (id as text) as text => if id = "" then "" else Text.Upper(Text.Start(id, 1)) & Text.Replace(Text.Middle(id, 1), "-", " "),
		    words = (event as record) as record =>
		        let
		            kind = event[Type]
		        in
		            if kind = "message" then
		                (if event[Channel] = "teams" then [Icon = "teams", What = "Teams chat started with " & event[To], Text = event[Subject]]
		                else [
		                    Icon = if event[Kind] = "reminder" or event[Kind] = "escalation" then "remind" else "mail",
		                    What = (if event[Kind] = "reminder" then "Reminder" else if event[Kind] = "escalation" then "Escalation" else "Email") & " to " & event[To] & (if event[Cc] <> "" then ", Cc " & event[Cc] else ""),
		                    Text = (if event[Channel] = "outlook" then "sent from Outlook" else "sent from the shared mailbox") & " · " & event[Ref]])
		            else if kind = "status" and event[Text] = "Waived" then [Icon = "stop", What = "Not followed up (before version 0.12: no reason or review date)", Text = ""]
		            else if kind = "status" then [Icon = "ok", What = "Status set to " & event[Text], Text = ""]
		            else if kind = "assign" then [Icon = "assign", What = if event[Text] <> "" then "Assigned to " & event[Text] else "Assignment removed", Text = ""]
		            else if kind = "handover" then [Icon = "handover", What = "Handed over to " & event[To], Text = event[Text]]
		            else if kind = "request" then [Icon = "file", What = "Request number " & event[Text], Text = ""]
		            else if kind = "report" then [Icon = "load", What = if event[Text] <> "" then event[Text] else "Report", Text = ""]
		            else if kind = "exception" then
		                let again = event[Text] = "Ended by hand" in
		                [Icon = "stop", What = (if again then "Followed up again" else "Not followed up") & (if event[CiName] <> "" then " for " & event[CiName] else ""),
		                    Text = if again then "" else event[Reason] & (if event[ReviewOn] <> "" then "; review on " & screenDate(event[ReviewOn]) else "") & (if event[Text] <> "" then ". " & event[Text] else "")]
		            else if kind = "review" then [Icon = "review", What = if event[CiKey] <> "" then "Lifecycle review: " & (if event[CiName] <> "" then event[CiName] else event[CiKey]) & " is " & Record.FieldOrDefault(reviewWords, event[Reason], event[Reason]) else "Lifecycle review started", Text = event[Text]]
		            else if kind = "reviewed" then [Icon = "eye", What = if event[Text] = "Ask the owner" then "SACM checked it: the owner is asked" else "Back to SACM", Text = ""]
		            else if kind = "retirement" then [Icon = "calendar", What = if event[RetireOn] <> "" then "Planned retirement date: " & longDate(event[RetireOn]) else "Planned retirement date taken away", Text = event[Text]]
		            else if kind = "stage" then [Icon = "stage", What = "Mapping stage set to " & stageWord(event[Text]), Text = ""]
		            else if kind = "no-process" then [Icon = "note", What = if event[Text] = "yes" then "The owner says the Business Process does not exist" else "The mark ""the process does not exist"" taken away", Text = ""]
		            else if kind = "settings" then [Icon = "settings", What = "Settings changed", Text = event[Text]]
		            else if kind = "person-note" then [Icon = "note", What = "Note about the person", Text = event[Text]]
		            else [Icon = "note", What = "Note", Text = event[Text]],
		    cardWords = (ids as list) as text => let names = List.Distinct(List.Select(List.Transform(ids, labelOf), (name) => name <> "")) in
		        if List.Count(names) > 3 then Text.From(List.Count(names)) & " cards" else Text.Combine(names, ", "),
		    // The kind of an event for the buttons of History (build D3): the icon of its words, in a few groups.
		    kindOf = (icon as text) as text => Record.FieldOrDefault([mail = "Emails", teams = "Emails", remind = "Reminders", ok = "Status", assign = "Assigned",
		        handover = "Assigned", load = "Reports", note = "Notes", stop = "Not followed", review = "Reviews", eye = "Reviews"], icon, "Other"),
		    line = (event as record) as list =>
		        let
		            said = words(event),
		            checks = List.Transform(event[Keys], checkOf) & (if List.IsEmpty(event[Keys]) and event[CheckId] <> "" and event[CheckId] <> "*" then {event[CheckId]} else {})
		        in
		            {
		                event[Id], DateTime.FromText(event[At], [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"]), Date.FromText(Text.Start(event[At], 10), [Format = "yyyy-MM-dd", Culture = "en-US"]), event[Type], said[Icon], said[What],
		                if event[ByName] <> "" then event[ByName] else event[By], said[Text], cardWords(checks),
		                List.Count(List.Distinct(List.Select(List.Transform(event[Keys], ciOf), (key) => key <> ""))), List.Count(event[Keys]), kindOf(said[Icon])
		            },
		    // The keys of the messages of each reference: a reply touches the cases of the message it answers.
		    asked = List.Select(JournalEvents, (event) => event[Type] = "message" and event[Ref] <> ""),
		    keysByRef = let grouped = Table.Group(Table.FromRows(List.Transform(asked, (event) => {event[Ref], event[Keys]}), type table [Ref = text, Keys = list]),
		        {"Ref"}, {{"Keys", (rows) => List.Distinct(List.Combine(rows[Keys])), type list}}) in Record.FromList(grouped[Keys], grouped[Ref]),
		    reply = (item as record) as list =>
		        let
		            keys = Record.FieldOrDefault(keysByRef, item[Ref], {}),
		            at = DateTime.FromText(item[Received], [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"])
		        in
		            {
		                "reply|" & item[Ref] & "|" & item[Received], at, Date.From(at), "reply", "reply", "Reply from " & item[From], item[From], item[Subject],
		                cardWords(List.Transform(keys, checkOf)), List.Count(List.Distinct(List.Select(List.Transform(keys, ciOf), (key) => key <> ""))), List.Count(keys), "Replies"
		            },
		    replies = List.Transform(List.Select(ReplyItems, (item) => item[Received] <> ""), reply),
		    lines = List.Transform(List.Reverse(JournalEvents), line) & replies,
		    withFind = List.Transform(lines, (row) => row & {Text.Combine(List.Select({row{5}, row{8}, row{7}, row{6}}, (part) => part <> ""), " · ")})
		in
		    Table.Sort(
		        #table(type table [Id = text, At = datetime, Day = date, Type = text, Icon = text, What = text, By = text, Text = text, Cards = text, CIs = Int64.Type, Keys = Int64.Type, Kind = text, Find = text], withFind),
		        {{"At", Order.Descending}, {"Id", Order.Descending}})
	queryGroup: Tables

/// Table Checks: one row per check file that is not "off" (D141), from the check files packed by the generator (CheckFiles). The check files stay the one place where a check is described (D16).
expression ChecksRows =
		let
		    files = Json.Document(CheckFiles),
		    topics = ReadingRules[topics],
		    sections = ReadingRules[sections],
		    topicOf = (folder as text) as record => let found = List.Select(topics, (topic) => topic[folder] = folder) in if List.IsEmpty(found) then topics{0} else found{0},
		    sectionOrder = (id as text) as number => List.PositionOf(List.Transform(sections, (item) => item[id]), id) + 1,
		    row = (position as number) as list =>
		        let
		            file = files{position},
		            pack = file[pack],
		            detector = pack[detector],
		            playbook = Record.FieldOrDefault(pack, "playbook", []),
		            topic = topicOf(file[folder]),
		            sectionNo = sectionOrder(pack[dimension]),
		            module = if detector[type] = "rule" then "rule" else Record.FieldOrDefault(detector, "module", detector[type]),
		            // The kind of card page (src/app/view/cards.ts, cardKind; plan §6.1), as the Power App knows it too (CheckPlaybooks).
		            kind = Record.Field(CheckPlaybooks, pack[id])[Kind]
		        in
		            {
		                pack[id], pack[status], Record.FieldOrDefault(pack, "title", ""), Record.FieldOrDefault(pack, "cardLabel", ""), Record.FieldOrDefault(pack, "cardHint", ""), Record.FieldOrDefault(pack, "cardText", Record.FieldOrDefault(pack, "cardHint", "")),
		                Record.FieldOrDefault(pack, "family", ""), pack[dimension], sections{sectionNo - 1}[label], sectionNo, Record.FieldOrDefault(pack, "severity", ""), topic[word],
		                List.PositionOf(topics, topic) + 1, Record.FieldOrDefault(pack, "priority", "daily"), Record.FieldOrDefault(pack, "reviewOnly", false),
		                detector[type], module, Record.FieldOrDefault(playbook, "path", ""),
		                if Record.FieldOrDefault(pack, "subject", "") = "contract" then "contracts" else "CIs",
		                position + 1, sectionNo * 1000 + position + 1, file[path], List.Contains(BuiltDetectors, module), kind
		            },
		    table = #table(
		        type table [CheckId = text, Status = text, Title = text, CardLabel = text, CardHint = text, CardText = text,
		            Family = text, Dimension = text, Section = text, SectionOrder = Int64.Type, Severity = text, Topic = text,
		            TopicOrder = Int64.Type, Priority = text, ReviewOnly = logical, DetectorType = text, Module = text, Path = text,
		            Counts = text, FileOrder = Int64.Type, SortKey = Int64.Type, FileName = text, Built = logical, Kind = text],
		        List.Transform(List.Positions(files), row))
		in
		    Table.SelectRows(table, each [Status] <> "off")
	queryGroup: Tables

/// Table Classes: the nine logical classes, their names in words and their order.
expression ClassesRows =
		let
		    classes = ReadingRules[classes]
		in
		    #table(type table [Id = text, Label = text, Order = Int64.Type],
		        List.Transform(List.Positions(classes), (position) => {classes{position}[id], classes{position}[label], position + 1}))
	queryGroup: Tables

/// Table ContractChanges: the page Contract changes (src/core/sources/contracts/contract-changes.ts, contractChanges and contractInformation). The newest Solusi contract file against the one before it: new contracts, contracts no longer in the file, status changes and every changed field (the lines of its export), then the Concluded contracts of the active tab with an end date on or after the date of the file (DaysLeft: days from that date; the page counts the days from today, so the next 30 and 90 days are right on any day), then the running contracts with no daily responsible. For information only: nobody is asked, no case is opened. Its own small query: it does not read the checks (D284).
expression ContractChangesRows =
		let
		    config = fnReference("reference/contract-reports"),
		    words = ContractWords,
		    files = Table.Buffer(Table.Sort(Table.SelectRows(ReadFiles, each [Kind] = "solusi" and [ReportDate] <> null), {{"ReportDate", Order.Ascending}, {"FileName", Order.Ascending}})),
		    count = Table.RowCount(files),
		    fileAt = (at as number) as record => let row = files{at} in [Date = row[ReportDate], Contracts = List.Buffer(Table.ToRecords(fnReadKind("solusi", row[Read])))],
		    current = if count = 0 then null else fileAt(count - 1),
		    previous = if count < 2 then null else fileAt(count - 2),
		    lower = (value as text) as text => Text.Lower(value, "en-US"),
		    shown = (value as any) as text => if words[Blank](value) then "empty" else words[Shown](value),
		    whole = (contract as record) as text => Text.Combine(List.Select({contract[Status],
		        if contract[Start] = null then "" else "starts " & fnLongDate(contract[Start]), if contract[End] = null then "" else "ends " & fnLongDate(contract[End])}, (part) => part <> ""), ", "),
		    tab = (contract as record) as text => if contract[Sheet] = "terminated" then " (terminated in the last 7 days)" else "",
		    // A line of the table: [Kind, Number, Name, Vendor, Field, Before, After, Status, End, DaysLeft].
		    lineOf = (kind as text, contract as record, field as text, before as text, after as text) as list =>
		        {kind, contract[Number], contract[Name], contract[Vendor], field, before, after, contract[Status], contract[End], null},
		    changes =
		        if current = null or previous = null then {}
		        else
		            let
		                beforeGroups = fnGroupBy(previous[Contracts], (contract) => lower(contract[Number])),
		                before = Record.FromList(List.Transform(Record.FieldValues(beforeGroups), List.Last), Record.FieldNames(beforeGroups)),
		                now = fnKeySet(List.Transform(current[Contracts], (contract) => lower(contract[Number]))),
		                fields = List.Buffer(List.Transform(ReadingRules[contractChangeFields], (entry) => entry & [Column = fnPascal(entry[field])])),
		                compared = List.Buffer(List.Transform(current[Contracts], (contract) => [Now = contract, Old = Record.FieldOrDefault(before, lower(contract[Number]), null)])),
		                added = List.Transform(List.Select(compared, (item) => item[Old] = null), (item) => lineOf("New contract", item[Now], "", "", whole(item[Now]))),
		                left = List.Transform(List.Select(previous[Contracts], (contract) => not Record.HasFields(now, lower(contract[Number]))),
		                    (contract) => lineOf("No longer in the file", contract, "", whole(contract), "")),
		                kept = List.Buffer(List.Select(compared, (item) => item[Old] <> null)),
		                status = List.Transform(List.Select(kept, (item) => not words[SameWord](item[Old][Status], item[Now][Status]) or item[Old][Sheet] <> item[Now][Sheet]),
		                    (item) => lineOf("Status change", item[Now], "Status", shown(item[Old][Status]) & tab(item[Old]), shown(item[Now][Status]) & tab(item[Now]))),
		                changed = List.Combine(List.Transform(kept, (item) => List.Transform(List.Select(fields, (entry) =>
		                    let was = Record.Field(item[Old], entry[Column]), later = Record.Field(item[Now], entry[Column]) in
		                    if entry[date] then was <> later else not words[SameWord](if was = null then "" else was, if later = null then "" else later)),
		                    (entry) => lineOf("Changed field", item[Now], entry[label], shown(Record.Field(item[Old], entry[Column])), shown(Record.Field(item[Now], entry[Column]))))))
		            in
		                added & left & status & changed,
		    information =
		        if current = null or config = null then {}
		        else
		            let
		                active = List.Buffer(List.Select(current[Contracts], (contract) => contract[Sheet] = "active")),
		                concluded = List.Select(List.Positions(active), (at) => words[InList](config[concludedStatuses], active{at}[Status]) and active{at}[End] <> null and active{at}[End] >= current[Date]),
		                ending = List.Transform(List.Sort(concluded, (a, b) => Value.Compare(active{a}[End], active{b}[End]) * 2 + Value.Compare(a, b)), (at) =>
		                    let contract = active{at} in
		                    List.FirstN(lineOf("Concluded with an end date", contract, "", "", ""), 9) & {Duration.Days(contract[End] - current[Date])}),
		                noDaily = List.Transform(List.Select(active, (contract) => words[InList](config[runningStatuses], contract[Status]) and contract[DailyResponsible] = ""),
		                    (contract) => lineOf("No daily responsible", contract, "", "", ""))
		            in
		                ending & noDaily,
		    // Buffered: each row below reads its line by position, and a list that is not buffered is worked out again each time.
		    lines = List.Buffer(changes & information),
		    kinds = {"New contract", "No longer in the file", "Status change", "Changed field", "Concluded with an end date", "No daily responsible"}
		in
		    #table(
		        type table [Line = Int64.Type, Kind = text, KindOrder = Int64.Type, Number = text, Name = text, Vendor = text, Field = text, Before = text, After = text,
		            Status = text, End = nullable date, DaysLeft = nullable Int64.Type, FileDate = nullable date, EarlierDate = nullable date],
		        List.Transform(List.Positions(lines), (at) => let line = lines{at} in
		            {at + 1, line{0}, List.PositionOf(kinds, line{0}) + 1} & List.Range(line, 1) & {if current = null then null else current[Date], if previous = null then null else previous[Date]}))
	queryGroup: Tables

/// Table Date: one row per day, from a year before the first report to a month after today.
expression DateRows =
		let
		    dates = List.RemoveNulls(ReportSourceFiles[ReportDate]),
		    first = Date.AddDays(List.Min(dates & {SampleDate}), -365),
		    last = Date.AddDays(List.Max(dates & {SampleDate, Date.From(DateTime.LocalNow())}), 31),
		    days = List.Dates(first, Duration.Days(last - first) + 1, #duration(1, 0, 0, 0)),
		    table = Table.FromList(days, Splitter.SplitByNothing(), type table [Date = date])
		in
		    Table.AddColumn(Table.AddColumn(Table.AddColumn(table, "Year", each Date.Year([Date]), Int64.Type),
		        "Month", each Date.ToText([Date], [Format = "MMM yyyy", Culture = "en-GB"]), type text),
		        "MonthOrder", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type)
	queryGroup: Tables

/// Table EpoSystems: the systems of the newest EPO systems report.
expression EpoSystemsRows = fnNewestRows("epo")
	queryGroup: Tables

/// The rows of the newest report of a type, read by its reader, with ReportDate and FileName in front. When no report of the type is there: an empty table with the same columns.
expression fnNewestRows =
		(kind as text) as table =>
		    let
		        newest = fnNewest(kind),
		        file = if Table.IsEmpty(newest) then null else newest{0},
		        rows = fnReadKind(kind, if file = null then EmptyRead else file[Read]),
		        withDate = Table.AddColumn(rows, "ReportDate", each file[ReportDate], type nullable date),
		        withFile = Table.AddColumn(withDate, "FileName", each file[FileName], type text)
		    in
		        Table.ReorderColumns(withFile, {"ReportDate", "FileName"} & Table.ColumnNames(rows))
	queryGroup: Tables

/// Table HistoryExpected (the Self-check page, D293): what the HTML app counts on the samples over the two report dates and the team's state (ExpectedHistory, generated). The measure History found gives the same count from the model.
expression HistoryExpectedRows =
		let
		    items = Json.Document(ExpectedHistory)
		in
		    #table(type table [Metric = text, Expected = Int64.Type, Order = Int64.Type],
		        List.Transform(List.Positions(items), (at) => {items{at}[metric], items{at}[expected], at + 1}))
	queryGroup: Tables

/// Table Inventory: the CIs of the newest CI report, one row each, with every column the checks read.
expression InventoryRows = fnNewestRows("ci")
	queryGroup: Tables

/// Table JournalKeys (D291): one row per finding key of each journal event (the column Keys of the list holds them one per line), so an event can be found from its case and a case from its events.
expression JournalKeysRows =
		let
		    rows = List.Combine(List.Transform(JournalEvents, (event) => List.Transform(event[Keys], (key) =>
		        {event[Id], key, let at = Text.PositionOf(key, ":") in if at < 0 then key else Text.Start(key, at), event[Type],
		            DateTime.FromText(event[At], [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"])})))
		in
		    #table(type table [EventId = text, Key = text, CheckId = text, Type = text, At = datetime], rows)
	queryGroup: Tables

/// Table Journal (D291): every event of the list SACM Journal, oldest first (JournalEvents). Keys holds the finding keys of the event, one per line, as the list does; the table JournalKeys has one row per key. Day: the day of At, for the period of the Audit page (the table Date).
expression JournalRows =
		let
		    dateOf = (value as text) as nullable date => if value = "" then null else Date.FromText(Text.Start(value, 10), [Format = "yyyy-MM-dd", Culture = "en-US"]),
		    rows = List.Transform(JournalEvents, (event) => {
		        event[Id], DateTime.FromText(event[At], [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"]), dateOf(event[At]), event[By], event[ByName], if event[ByName] <> "" then event[ByName] else event[By],
		        event[Type], Text.Combine(event[Keys], "#(lf)"), List.Count(event[Keys]), event[Text], event[Ref], event[To], event[Cc], event[Subject], event[Kind],
		        event[Channel], event[Person], event[Reason], dateOf(event[ReviewOn]), dateOf(event[RetireOn]), event[CheckId], event[CiKey], event[CiName]})
		in
		    #table(
		        type table [Id = text, At = datetime, Day = date, By = text, ByName = text, Who = text, Type = text, Keys = text, KeyCount = Int64.Type, Text = text, Ref = text,
		            To = text, Cc = text, Subject = text, Kind = text, Channel = text, Person = text, Reason = text, ReviewOn = date, RetireOn = date,
		            CheckId = text, CiKey = text, CiName = text],
		        rows)
	queryGroup: Tables

/// Table NotRead: the files of no known type, with what each type is missing (the Reports page).
expression NotReadRows = Table.SelectColumns(Table.SelectRows(ReportFilesRows, each not [IsRead]), {"FileName", "ReportDate", "Message"})
	queryGroup: Tables

/// Table Relationships: the relationships of the newest Relationship report.
expression RelationshipsRows = fnNewestRows("relationship")
	queryGroup: Tables

/// Table Replies (D291): every reply the shared mailbox filed in the list SACM Replies, newest first. Matched: a message of the journal has its reference, so the reply shows on that case.
expression RepliesRows =
		let
		    refs = fnKeySet(List.Transform(List.Select(JournalEvents, (event) => event[Type] = "message" and event[Ref] <> ""), (event) => event[Ref])),
		    rows = List.Transform(ReplyItems, (reply) => {
		        reply[Ref], reply[From], if reply[Received] = "" then null else DateTime.FromText(reply[Received], [Format = "yyyy-MM-ddTHH:mm:ss", Culture = "en-US"]),
		        reply[Subject], reply[Body], Record.HasFields(refs, reply[Ref])})
		in
		    Table.Sort(#table(type table [Ref = text, From = text, Received = datetime, Subject = text, Body = text, Matched = logical], rows), {{"Received", Order.Descending}, {"Ref", Order.Ascending}})
	queryGroup: Tables

/// Table ReportFiles: every report file, its type (by its columns), its report date and how many rows its reader read.
expression ReportFilesRows =
		let
		    withRows = Table.AddColumn(ReadFiles, "Rows", each
		        let rows = fnReadKind([Kind], [Read]) in if rows = null then Table.RowCount([Read][Rows]) else Table.RowCount(rows), Int64.Type),
		    withFormat = Table.AddColumn(withRows, "Format", each [Read][Format], type text),
		    withColumns = Table.AddColumn(withFormat, "Columns", each List.Count([Read][Headers]), Int64.Type),
		    withIsRead = Table.AddColumn(withColumns, "IsRead", each [Kind] <> "", type logical),
		    selected = Table.SelectColumns(withIsRead, {"FileName", "ReportDate", "Kind", "TypeLabel", "Format", "Rows", "Columns", "IsRead", "Message"})
		in
		    Table.TransformColumnTypes(selected, {{"FileName", type text}, {"Kind", type text}, {"TypeLabel", type text}, {"Message", type text}})
	queryGroup: Tables

/// Table ReportTypes: one row per report type (src/core/sources/report-types.ts), with its newest file. The Reports page shows one line per type; the age and "old" are DAX, so they are right on any day (D14). The rows read from the newest file are the measure Newest rows (the Rows of that file in ReportFiles): no file is opened here (build B8, D307).
expression ReportTypesRows =
		let
		    types = ReadingRules[reportTypes],
		    row = (position as number) as list =>
		        let
		            reportType = types{position},
		            newest = fnNewest(reportType[kind]),
		            file = if Table.IsEmpty(newest) then null else newest{0}
		        in
		            {
		                reportType[kind], reportType[label], reportType[hint], position + 1, List.Max({CaseRules[StaleDays], Record.FieldOrDefault(reportType, "staleAfter", 0)}),
		                Table.RowCount(Table.SelectRows(ReadFiles, each [Kind] = reportType[kind])),
		                if file = null then null else file[FileName],
		                if file = null then null else file[ReportDate]
		            }
		in
		    #table(
		        type table [Kind = text, Label = text, Hint = text, Order = Int64.Type, StaleAfter = Int64.Type, Files = Int64.Type,
		            NewestFile = nullable text, NewestDate = nullable date],
		        List.Transform(List.Positions(types), row))
	queryGroup: Tables

/// Table Run (hidden, D284): the checks on the newest CI report, computed ONCE per refresh, as the rows of thirteen parts. Power Query computes a shared query again for every table that reads it, so the tables that show a result of the checks do not read CheckRun: they are DAX calculated tables that split Run (Findings, Tested, Notes, Parked, MappingBacklog, RelationshipLinks, CapabilitySheet, SelfCheck, and from build B5 CaseLines, RepliesToRead and Exceptions, which add the journal of the team, D292; from build B7 Drafts, the messages ready to send, D300). Part: the name of the part; every other column of a part is named <Part>.<Column> (Findings.Key), so no two parts share a column. ReportDate: the date of the run, on every row. Run is computed in full at every refresh, so the cases follow the journal; the history of every report date is the table HistoryRun (D290). A new result of the checks is a new part here, never a table that reads CheckRun (ARCHITECTURE §12, the speed rules). From build B8 the run also holds the lines of the lifecycle review (fnWithReviews, the journal's marks, D306), and the part ReviewLines the reviews and the sample of the next one. The Self-check compares the checks of the reports alone (the HTML app's recorded result has no journal), so it leaves the lines of the review out.
expression RunRows =
		let
		    run = fnWithReviews(CheckRun),
		    findings = Table.Buffer(fnFindingsPart(run)),
		    tested = Table.Buffer(fnTestedPart(run)),
		    cases = fnCases(run),
		    review = "LIFECYCLE-REVIEW",
		    parts = {
		        {"Findings", findings}, {"Tested", tested}, {"Notes", fnNotesPart(run)}, {"Parked", fnParkedPart(run)},
		        {"MappingBacklog", fnMappingBacklogPart(run, cases)}, {"RelationshipLinks", fnRelationshipLinksPart(run)},
		        {"CapabilitySheet", fnCapabilitySheetPart(run)},
		        {"SelfCheck", fnSelfCheckPart(Table.SelectRows(findings, each [CheckId] <> review), Table.SelectRows(tested, each [CheckId] <> review))},
		        {"CaseLines", fnCaseLinesPart(cases)}, {"RepliesToRead", fnRepliesToReadPart(cases)}, {"Exceptions", fnExceptionsPart(run)},
		        {"Drafts", fnDraftsPart(cases)}, {"ReviewLines", fnReviewLinesPart(run, cases)}
		    },
		    // Each part with its columns named <Part>.<Column> and a column Part. The type of each column is the data type of the
		    // calculated table that shows it (RunColumnTypes, generated), so Run and the calculated tables never differ. Each part
		    // gets the types of its own columns before the parts are put together (build B8, D307): typing the combined table
		    // would convert every cell of every part, most of them empty (37,000 rows by 300 columns at real size). The empty
		    // frame first gives every column its type, also the columns of a part with no rows.
		    prefixed = List.Transform(parts, (part) =>
		        let
		            name = part{0},
		            rows = part{1},
		            renamed = Table.RenameColumns(rows, List.Transform(Table.ColumnNames(rows), (column) => {column, name & "." & column})),
		            present = Table.ColumnNames(renamed),
		            own = List.Select(RunColumnTypes, (pair) => List.Contains(present, pair{0}))
		        in
		            Table.AddColumn(Table.TransformColumnTypes(renamed, own), "Part", each name, type text)),
		    frame = Table.TransformColumnTypes(#table(List.Transform(RunColumnTypes, (pair) => pair{0}), {}), RunColumnTypes),
		    typed = Table.Combine({frame} & prefixed),
		    withDate = Table.AddColumn(typed, "ReportDate", each if run = null then null else run[Date], type nullable date)
		in
		    Table.ReorderColumns(withDate, {"Part", "ReportDate"} & List.Select(Table.ColumnNames(withDate), (column) => column <> "Part" and column <> "ReportDate"))
	queryGroup: Tables

/// Table ServiceNowContracts: the contracts of the newest ServiceNow contract report.
expression ServiceNowContractsRows = fnNewestRows("contract")
	queryGroup: Tables

/// Table Settings (D291): the settings of the list SACM Settings, one row per setting (Key): the value of its last row, as the Settings screen of the Power App adds a row for each change (build B8, D308), and for the seven numbers (the six of CaseRules and rowsInEmail of the emails, D314) the value that counts (CaseRules): a value that is not a whole number in its range is not used, so the page says which value counts.
expression SettingsRows =
		let
		    rows = List.Select(Table.ToRecords(fnStateList("settings")), (row) => Text.Trim(row[Title]) <> ""),
		    keys = List.Distinct(List.Transform(rows, (row) => Text.Trim(row[Title]))),
		    used = [
		        reminderDays = CaseRules[ReminderDays], maxReminders = CaseRules[MaxReminders], staleDays = CaseRules[StaleDays],
		        exceptionMonths = CaseRules[ExceptionMonths], underRetirementDays = CaseRules[UnderRetirementDays], readyDays = CaseRules[ReadyDays],
		        rowsInEmail = MessageSettings[RowsInEmail]
		    ],
		    lines = List.Transform(keys, (key) =>
		        let
		            row = List.Last(List.Select(rows, (candidate) => Text.Trim(candidate[Title]) = key)),
		            number = Record.HasFields(used, key),
		            counted = if number then Text.From(Record.Field(used, key)) else row[Value],
		            range = if number then Record.Field(SettingRanges, key) else null
		        in
		            {key, row[Value], counted,
		                if number and Text.Trim(row[Value]) <> counted then
		                    "Not used: a whole number from " & Text.From(range[min]) & " to " & Text.From(range[max]) & ". The default counts."
		                else ""})
		in
		    #table(type table [Key = text, Value = text, Used = text, Note = text], lines)
	queryGroup: Tables

/// Table SolusiContracts: the contracts of the newest Solusi contract file.
expression SolusiContractsRows = fnNewestRows("solusi")
	queryGroup: Tables

/// Table Team (D291): the SACM managers of the list SACM Team. Me: the manager who opens the report, by the email of their sign-in (the measure Me); in Sample mode the first active manager, so My work shows something.
expression TeamRows =
		let
		    rows = Table.ToRecords(fnStateList("team")),
		    lines = List.Transform(rows, (row) => {row[Title], Text.Lower(Text.Trim(row[Email]), "en-US"), not List.Contains({"no", "false", "0"}, Text.Lower(Text.Trim(row[Active]), "en-US"))}),
		    firstActive = List.First(List.Select(lines, (item) => item{2}), null),
		    marked = List.Transform(lines, (item) => item & {StateMode = "Sample" and firstActive <> null and item{1} = firstActive{1}})
		in
		    #table(type table [Name = text, Email = text, Active = logical, SampleMe = logical], marked)
	queryGroup: Tables
