/// GENERATED from checks/reference/. Every reference file, by its name.
expression ReferenceFiles = Json.Document("{""contract-reports"":{""note"":""The two contract files (piece 5C, procedure 2.8): the Solusi contract file (Excel, every Monday; row 1 field names, row 2 labels) and the ServiceNow contract report (ast_contract). They are matched by the Solusi contract number, which ServiceNow keeps in Vendor contract. Procurement owns the data: a wrong value is corrected in Solusi, because the next import writes over ServiceNow. The problems of the contract data ('problems') are split over two cards: For Procurement raises the problems of Solusi itself, Contracts to fix in ServiceNow the ones SACM corrects in ServiceNow ('change' and 'set' are the words of its fix list). An inactive contract owner or Procurement partner: when the loaded reports know an active account with the same name, the upload picked the wrong account and SACM sets the active one ('ownerInactive', 'partnerInactive'); when they know none, the person left and Procurement names a new person in Solusi ('ownerLeft', 'partnerLeft')."",""solusi"":{""columns"":{""number"":[""contract_no""],""status"":[""contract_status""],""name"":[""contract_name""],""vendor"":[""partner_name""],""vendorNumber"":[""partner_no""],""category"":[""contract_category""],""start"":[""contract_start""],""end"":[""contract_end""],""duration"":[""map_duration_type""],""owner"":[""clm_contract_owner""],""dailyResponsible"":[""clm_contract_daily_responsible""],""procurementPartner"":[""clm_contract_supporter""],""epoId"":[""clm_contract_epo_id""],""terminated"":[""termination_date""]},""labelRow"":[""contract no."",""contract no"",""contract""],""terminatedSheet"":""The tab with a termination date column holds the contracts terminated in the last 7 days.""},""servicenow"":{""columns"":{""number"":[""number""],""vendorContract"":[""vendor_contract""],""state"":[""state""],""name"":[""short_description""],""vendor"":[""vendor""],""category"":[""u_contract_category""],""start"":[""starts""],""end"":[""ends""],""owner"":[""business_owner""],""ownerActive"":[""business_owner.active""],""ownerUserId"":[""business_owner.user_name""],""ownerEmail"":[""business_owner.email""],""dailyResponsible"":[""u_point_of_contact""],""procurementPartner"":[""contract_administrator""],""procurementPartnerActive"":[""contract_administrator.active""],""procurementPartnerUserId"":[""contract_administrator.user_name""],""procurementPartnerEmail"":[""contract_administrator.email""],""tags"":[""sys_tags""],""criticality"":[""u_inherited_confidentiality"",""u_inherited_integrity"",""u_inherited_availability"",""u_inherited_authenticity""]}},""fields"":[{""field"":""name"",""label"":""Name"",""kind"":""text""},{""field"":""vendor"",""label"":""Vendor"",""kind"":""text""},{""field"":""category"",""label"":""Category"",""kind"":""text""},{""field"":""start"",""label"":""Start date"",""kind"":""date""},{""field"":""end"",""label"":""End date"",""kind"":""date""},{""field"":""owner"",""label"":""Contract owner"",""kind"":""person""},{""field"":""dailyResponsible"",""label"":""Daily responsible"",""kind"":""person""},{""field"":""procurementPartner"",""label"":""Procurement partner"",""kind"":""person""}],""autoStates"":[""Expired""],""draftStates"":[""Draft""],""statusTag"":""\\b[ESTN]\\s*-\\s*(Ended|Terminated|Concluded|In negotiation)\\b"",""runningStatuses"":[""S - Concluded"",""N - In negotiation""],""targetTag"":""target\\s*bc\\s*=\\s*[1-4]"",""concludedStatuses"":[""S - Concluded""],""fixedTermWords"":[""Fixed-term""],""epo"":{""classes"":[""service_instance""],""retiredStatuses"":[""Retired""],""minDigits"":3},""endsWithinDays"":[30,90],""problems"":[{""id"":""ownerInactive"",""label"":""Contract owner: an inactive account was picked"",""change"":""Contract owner: set the active account with the same name"",""set"":""the active account""},{""id"":""partnerInactive"",""label"":""Procurement partner: an inactive account was picked"",""change"":""Procurement partner: set the active account with the same name"",""set"":""the active account""},{""id"":""noOwner"",""label"":""No contract owner""},{""id"":""ownerLeft"",""label"":""Contract owner left""},{""id"":""partnerLeft"",""label"":""Procurement partner left""},{""id"":""personName"",""label"":""A name ServiceNow does not show the same"",""change"":""set the person Solusi names""},{""id"":""endPassed"",""label"":""Concluded, but the end date has passed"",""change"":""End date: correct it, or set the status Ended"",""set"":""the right end date, or Ended""},{""id"":""noEnd"",""label"":""Fixed-term, but no end date"",""change"":""End date: add it, or correct the duration type"",""set"":""the end date""},{""id"":""noVendorNumber"",""label"":""No vendor number""},{""id"":""epoRetired"",""label"":""The EPO ID names a Retired system""},{""id"":""epoUnknown"",""label"":""The EPO ID is not a known EPO ID""}]},""criticality"":{""note"":""Criticality (CIA-A) flows down from the Business Process (BIA). Each parent passes its values to its children's Inherited fields; the highest value per dimension wins. A relationship 'Excluded for calculation' in the Relationship report passes nothing (D131). ServiceNow copies Inherited to Target after two weeks, unless an exception applies: a CI with Inherited set and Target empty waits 'waitDays' days after the last change of its record (D132)."",""waitDays"":14},""epo-id"":{""note"":""The EPO ID is the asset tag. 'required': a missing EPO ID is to solve (the known cases of section 3.1 of the instruction are marked Not followed up once, by a manager). 'unique': two live CIs must not share an EPO ID. Service Offerings are ServiceNow records and are not checked (D128). Business Application, Business Process and Business Capability have no EPO ID: not checked."",""required"":[""business_service"",""service_instance""],""unique"":true},""epo-synced-classes"":{""note"":""Where a fix is made (decisions D122 and D123). On a CI of 'classes' the fix is made in EPO, by the person the check asks, and ServiceNow receives it from EPO. A Service Offering is a ServiceNow record: it comes from EPO only when the EPO integration created it, that is when its Created by is not a person's user ID ('personUserId'); then it is fixed in EPO, on its Business Service. An offering made by a person, and every other class, is fixed in ServiceNow with the request the message names. Without the Created by column, every offering counts as made by a person. The service mapped flag plays no part here: only the card EPO ≠ ServiceNow reads it. On an offering the integration created, only Owned by follows its Business Service in EPO; Managed by, Supported by and the Support group are changed in ServiceNow with the request \""Add or modify a Service (CI)\"", action \""Modify service offering\"" ('inServiceNow': the fields, and the checks whose finding is about one of them; decision D187)."",""classes"":[""business_service"",""service_instance""],""offerings"":{""classes"":[""service_offering""],""personUserId"":""^[A-Za-z0-9]{3}$"",""inServiceNow"":{""fields"":[""managed_by"",""supported_by""],""checks"":[""RESP-SAME-PERSON"",""SUPPORT-GROUP-MISSING"",""SUPPORT-GROUP-INACTIVE""]}}},""epo-systems-report"":{""note"":""The EPO systems report (piece 5A): one line per EPO system. How its columns are called, what its status words mean, and how a system matches a CI. A system matches the Service Instance whose Asset tag is its EPO ID. The fix is always made in EPO; a service mapped CI is then updated in ServiceNow by SACM by hand."",""columns"":{""epoId"":[""epoid"",""epo_id""],""name"":[""systemname"",""system_name""],""description"":[""systemdescription"",""system_description""],""status"":[""systemstatus"",""system_status""],""department"":[""ownerdepartment"",""owner_department""],""owner"":[""owner""],""responsible1"":[""responsible1"",""responsible_1""],""responsible2"":[""responsible2"",""responsible_2""],""changed"":[""ajour_tms"",""last_change"",""changed""]},""statuses"":{""Kørende"":""Operational"",""Nedlagt"":""Retired"",""Konstruktion"":""Ready"",""Udgående"":""Under retirement""},""classes"":[""service_instance""],""nameSuffix"":"" - PROD"",""retiredStatuses"":[""Retired""],""roles"":[{""role"":""owned_by"",""column"":""owner"",""label"":""Owned by"",""epoLabel"":""System Owner""},{""role"":""managed_by"",""column"":""responsible1"",""label"":""Managed by"",""epoLabel"":""Primary Responsible""},{""role"":""supported_by"",""column"":""responsible2"",""label"":""Supported by"",""epoLabel"":""Secondary Responsible""}],""sourceFirst"":{""note"":""The source first: a people line of these checks on a CI that pairs with an EPO system is compared with EPO before anybody is asked. EPO already names another person: the line waits (SACM copies it, or the sync brings it). EPO is wrong or empty too: the owner is asked, and the line says what EPO holds. A leftover (empty in EPO, a person still in ServiceNow) is asked of the owner; when its person is still active, the line is made on the check named in 'leftover'."",""checks"":[""RESP-MISSING"",""RESP-INACTIVE"",""SUPPORTED-BY""],""samePerson"":[""RESP-SAME-PERSON""],""leftover"":{""owned_by"":""RESP-MISSING"",""managed_by"":""RESP-MISSING"",""supported_by"":""SUPPORTED-BY""},""cards"":{""mapped"":""EPO-DIFF"",""notMapped"":""EPO-NOT-ARRIVED""}},""waitDays"":2,""descriptionStart"":40,""notCompared"":""The two EPO criticality numbers (scale 1 to 5, ServiceNow uses another scale) and the GDPR marks are not compared.""},""known-tags"":{""note"":""Tags of the team that explain a finding. A finding of a listed check on a CI with one of the tags is listed under Known: not to solve, no message. Remove the tag in ServiceNow and the finding is to solve at the next report. Tags are compared ignoring case and spaces."",""rules"":[{""checks"":[""CRIT-TARGET-MISSING"",""CRIT-NONE-REACHES""],""tags"":[""BIA is pending"",""BIA N/A""],""why"":""The BIA that gives the values is pending, or does not apply.""},{""checks"":[""RESP-SAME-PERSON""],""tags"":[""Owned by is interim managed by""],""why"":""The manager holds the owner role for a while, on purpose.""},{""checks"":[""REL-MISSING"",""MAPPING""],""tags"":[""To Be Mapped"",""Descoped"",""Process is missing or unknown""],""why"":""Mapping is planned (To Be Mapped, Descoped), or the process is not known yet.""}]},""lifecycle"":{""note"":""Lifecycle rules (Operational Activities Instruction 2.13). 'rules': a CI sits in a status for more than 'days' days, counted from the day the record was created or last changed, to the date of the report. 'days' is the value proposed; the team sets its own number in Settings ('setting'). 'fix': the line of the fix list when SACM changes the status itself (Business Capabilities in Ready). 'review': the sample of the lifecycle review, drawn only from the classes EPO holds (Business Service, Service Offering, Service Instance), so every CI of the sample can be compared with EPO; drawn once on a button press and saved in data/reviews/ of the team folder."",""rules"":[{""id"":""under-retirement"",""status"":""Under retirement"",""from"":""updated"",""days"":90,""setting"":""underRetirementDays"",""say"":""Status {status}, and the record did not change since {date} ({age} days)""},{""id"":""ready"",""status"":""Ready"",""from"":""created"",""days"":90,""setting"":""readyDays"",""say"":""Status {status} since it was created on {date} ({age} days)"",""fix"":{""change"":""Operational status: make it Operational"",""set"":""Operational""}}],""review"":{""sample"":50,""classes"":[""business_service"",""service_offering"",""service_instance""],""underRetirement"":20,""underRetirementStatus"":""Under retirement"",""retiredStatuses"":[""Retired""],""results"":[{""id"":""same"",""label"":""Same in EPO""},{""id"":""different"",""label"":""Not the same""},{""id"":""not-in-epo"",""label"":""Not in EPO""}],""opensCase"":[""different""]},""processStages"":{""note"":""The stages of a Business Process in Ready (D197). Waits for the BIA: no CIA value (Target) yet, no line, only a note. To map: CIA values and nothing live linked below of the classes in below: no line here, the process is a case of the Mapping backlog (D200), and a note says how many. Mapped: CIA values and something linked below: SACM makes it Operational."",""status"":""Ready"",""below"":[""business_application"",""business_service""],""waits"":{""one"":""1 Business Process in Ready waits for the BIA (no CIA values yet): nothing to do."",""many"":""{n} Business Processes in Ready wait for the BIA (no CIA values yet): nothing to do.""},""toMap"":{""one"":""1 Business Process in Ready is to map (CIA values set, nothing linked below): it is on the Mapping backlog."",""many"":""{n} Business Processes in Ready are to map (CIA values set, nothing linked below): they are on the Mapping backlog.""},""mapped"":{""say"":""Mapped: the CIA values are set and {below} linked below. Make it Operational"",""change"":""Operational status: make it Operational"",""current"":""Ready, mapped"",""set"":""Operational""}}},""mandatory-tags"":{""business_process"":[{""label"":""process type (customer facing or internal)"",""oneOf"":[""Internal process"",""Internal BP""],""endsWith"":[""facing"",""facing process""]}]},""mapping-backlog"":{""note"":""The mapping backlog (D200): one case per CI that must be mapped, SACM's work with the owner in a mapping session. 'rules' are the rules of reference/relationship-model that make a CI a mapping case; they are not on Relationship missing. A Business Process in 'readyStatus' is a case only when it has CIA values (a Target value): before that it waits for the BIA. 'tagged': a CI of 'classes' with a tag that matches one of 'tags' (a regular expression, ignoring case) and in 'status' is a case too: its future is decided in the session. 'stages': the steps of a case, in order; 'classStages': the steps each class goes through (D201). 'processMissing': the classes whose case can be marked 'The process does not exist' when one of 'rules' is the reason; 'team' is the team of reference/record-teams that is told (D203). 'criticality': the checks whose lines of the same CI are shown in the case (D204)."",""rules"":[""si-business-application"",""bs-business-process"",""ba-business-process"",""ba-service-instance"",""bp-application-or-service""],""readyStatus"":""Ready"",""tagged"":{""id"":""tagged-to-delete"",""classes"":[""business_application""],""tags"":[""to be deleted""],""status"":""Operational"",""say"":""Tagged To be deleted and still Operational: decide in the session whether it is retired, or was never a Business Application""},""stages"":[{""id"":""to-plan"",""label"":""To plan""},{""id"":""session-held"",""label"":""Session held""},{""id"":""classified"",""label"":""Classified""},{""id"":""application-linked"",""label"":""Application linked""},{""id"":""process-linked"",""label"":""Process linked""}],""classStages"":{""service_instance"":[""to-plan"",""session-held"",""classified"",""application-linked"",""process-linked""],""business_application"":[""to-plan"",""session-held"",""process-linked""],""business_service"":[""to-plan"",""session-held"",""process-linked""],""business_process"":[""to-plan"",""session-held"",""application-linked""]},""stageWords"":{""business_process"":{""application-linked"":""Applications linked""}},""processMissing"":{""classes"":[""business_service"",""business_application""],""rules"":[""bs-business-process"",""ba-business-process""],""team"":""process-management""},""criticality"":[""CRIT-ABOVE-PARENT"",""CRIT-NONE-REACHES""]},""name-rules"":{""note"":""The naming rules of the SACM instruction, as data. Patterns are regular expressions; upper and lower case count. 'when': only names that match it are tested. The check packs name the rules they apply (detector.rules). Decision of 11 Nov 2026, to confirm: the instruction writes \""API-\"", but the API offerings in ServiceNow are written \""API - \"" with spaces, so the rule follows the data."",""rules"":[{""id"":""ba-suffix"",""classes"":[""business_application""],""pattern"":""_BA$"",""say"":""The name does not end with _BA""},{""id"":""bs-suffix"",""classes"":[""business_service""],""pattern"":""_BS$"",""say"":""The name does not end with _BS""},{""id"":""si-suffix"",""classes"":[""service_instance""],""pattern"":"" - (PROD|TEST)$"",""say"":""The name does not end with \"" - PROD\"" or \"" - TEST\""""},{""id"":""api-prefix"",""classes"":[""service_offering""],""when"":""^API\\b"",""pattern"":""^API - "",""say"":""The name of an API offering does not start with \""API - \"""",""set"":""Start the name with \""API - \"" (API, space, hyphen, space)""},{""id"":""outer-space"",""classes"":[""*""],""noOuterSpaces"":true,""say"":""The name has a space at its start or its end"",""set"":""Remove the space""}]},""not-live-statuses"":{""note"":""Operational statuses of a CI that is not live yet. A CI is created in Ready and becomes Operational after sign-off; criticality comes after the BIA (Operational Activities Instruction 2.14). Findings on these CIs are listed under Waiting: not to solve, no message. They move to to solve at the first report that shows the CI live."",""statuses"":[""Ready""],""exceptChecks"":[""NAME-HIDDEN-CHAR"",""REL-WRONG-TYPE"",""REL-RETIRED"",""REL-TWICE"",""APP-INSTANCE-MATCH"",""OFFERING-PARENT"",""OFFERING-OWNER"",""NAME-FORMAT"",""READY-TOO-LONG"",""READY-TOO-LONG-BC"",""LIFECYCLE-REVIEW"",""EPO-DIFF"",""EPO-NOT-ARRIVED"",""TAG-MISSING"",""PROCESS-STAGE"",""MAPPING""],""exceptNote"":""Checks that SACM fixes itself, with no question to anybody, do not wait: they stay to solve on a CI that is not live yet. Ready too long is about the status Ready itself, and the lifecycle review compares the status with EPO: they do not wait either. The EPO checks compare ServiceNow with EPO, which has its own status for a system in construction: they do not wait either. The mapping backlog decides itself (D200): a CI in Ready waits, except a Business Process with CIA values, which is the one to map now.""},""parked-classes"":{""note"":""Parked classes (decision D179): CIs that are not checked yet. A parked CI stays in the report, so relationships to it count, but no check tests it, it has no line on any card and it is not counted as tested. The first screen, the load message and the verification record show one grey line per rule instead, so nothing is hidden silently. 'statuses': only CIs in these statuses are parked (empty: every status); a Retired CI is never counted. 'one', 'many' ({n} is the number) and 'none' are the words of the line; 'none' empty: no line. 'fields': parts of checks (check:field) that are parked with the rule on every CI. A capability that is Operational or Under retirement is checked as before; its own rules wait for the round with Enterprise Architecture (OPEN-QUESTIONS)."",""rules"":[{""id"":""capability-ready"",""classes"":[""business_capability""],""statuses"":[""Ready""],""one"":""1 Business Capability in Ready is not checked yet"",""many"":""{n} Business Capabilities in Ready are not checked yet"",""none"":"""",""fields"":[""REL-MISSING:bp-business-capability""]},{""id"":""api-application"",""classes"":[""api"",""application""],""one"":""1 API or Application CI is not checked yet: the class is not used yet"",""many"":""{n} API or Application CIs are not checked yet: the classes are not used yet"",""none"":""No API or Application CIs in this report""},{""id"":""technology-management-service"",""classes"":[""technology_management_service""],""one"":""1 Technology Management Service is not checked yet: the class is not used yet"",""many"":""{n} Technology Management Services are not checked yet: the class is not used yet"",""none"":""No Technology Management Service in this report""}]},""record-teams"":{""note"":""Teams that are the contact for the record of a class (D195). A line of one of the 'checks' on a CI of one of the 'classes' goes to the team, never to the people of the CI: one message to every person of the team (Settings, Requests and mailboxes), nobody copied. Process Management is responsible for the record of a Business Process; its mapping is SACM's work with the process owner (Relationship missing), and SACM does not chase the BIA (the criticality cards)."",""teams"":[{""id"":""process-management"",""name"":""Process Management"",""classes"":[""business_process""],""checks"":[""RESP-MISSING"",""RESP-INACTIVE"",""RESP-SAME-PERSON"",""DESC-QUALITY"",""NAME-DUPLICATE"",""TAG-MISSING"",""TAG-STATUS-CONFLICT"",""UNDER-RETIREMENT-LONG""]}]},""relationship-model"":{""note"":""The relationship model of the Service Mapping Workspace (dictionary and mandatory relationships), as data. Relationships are written parent -> child: the parent is the upstream CI. Only the classes the reports hold today; more can be added. Rule ids are the ones of the Workspace, so both projects can be compared. A Service Instance with Platform ticked (u_platform) is the class 'platform'. A relationship counts only when neither end is Retired."",""retiredStatuses"":[""Retired""],""environments"":{""note"":""The environment of a Service Instance: its Environment field, else a trailing word of its name ('- TEST'), else production. Synonyms count as one."",""suffix"":""\\b(prod|production|prd|preprod|pre-prod|pre-production|non-prod|nonprod|non-production|acc|acceptance|uat|test|tst|dev|development|dr|disaster recovery)\\)?\\s*$"",""aliases"":[{""pattern"":""^(prod|production|prd)$"",""name"":""PROD""},{""pattern"":""^(preprod|pre-prod|pre-production)$"",""name"":""PREPROD""},{""pattern"":""^(acc|acceptance)$"",""name"":""ACC""},{""pattern"":""^(test|tst)$"",""name"":""TEST""},{""pattern"":""^(dev|development)$"",""name"":""DEV""},{""pattern"":""^(dr|disaster recovery)$"",""name"":""DR""},{""pattern"":""^(non-prod|nonprod|non-production)$"",""name"":""NONPROD""}]},""applicationCopy"":{""descriptions"":""poor"",""descriptionMin"":30,""descriptionStart"":40,""instanceSuffix"":""\\s+-\\s+(PROD|TEST)$"",""applicationSuffix"":""_BA""},""dictionary"":[{""parents"":[""business_capability""],""children"":[""business_capability""],""status"":""allowed"",""types"":[""Provided by::Provides""],""note"":""Capability hierarchy.""},{""parents"":[""business_capability""],""children"":[""business_process""],""status"":""allowed"",""types"":[""Provided by::Provides""],""note"":""The process carries out the capability.""},{""parents"":[""business_capability""],""children"":[""business_application""],""status"":""unconfirmed"",""types"":[""Provided by::Provides""],""note"":""Type not agreed yet: not checked.""},{""parents"":[""business_process""],""children"":[""business_application""],""status"":""allowed"",""types"":[""Provided by::Provides""],""note"":""A process can use several applications, and the other way round.""},{""parents"":[""business_process""],""children"":[""business_service""],""status"":""allowed"",""types"":[""Provided by::Provides""],""note"":""The process is delivered through the Business Service.""},{""parents"":[""business_process""],""children"":[""service_instance"",""platform"",""application"",""api""],""status"":""blocked"",""note"":""Go through the Business Service and the Business Application."",""advice"":""Link the process to a Business Service or a Business Application instead.""},{""parents"":[""business_application""],""children"":[""service_instance"",""platform""],""status"":""allowed"",""types"":[""Consumes::Consumed by""],""note"":""One Service Instance or Platform per environment.""},{""parents"":[""business_application""],""children"":[""business_service"",""service_offering""],""status"":""blocked"",""note"":""A Business Application's only children are Service Instances."",""advice"":""Link it through the Service Instance.""},{""parents"":[""business_service"",""service_offering""],""children"":[""business_application""],""status"":""blocked"",""note"":""Services and offerings reach a Business Application through the Service Instance."",""advice"":""Link it through the Service Instance.""},{""parents"":[""business_service""],""children"":[""service_offering""],""status"":""allowed"",""types"":[""Provided by::Provides"",""Provides::Provided by""],""note"":""A Business Service has at least one offering; each offering has exactly one Business Service.""},{""parents"":[""business_service""],""children"":[""business_service""],""status"":""blocked"",""note"":""A Business Service is never the parent of another Business Service.""},{""parents"":[""service_offering""],""children"":[""service_instance"",""platform""],""status"":""allowed"",""types"":[""Depends on::Used by""],""note"":""The offering depends on the Service Instances that deliver it.""},{""parents"":[""service_instance""],""children"":[""platform""],""status"":""allowed"",""types"":[""Depends on::Used by""],""note"":""The Service Instance uses the Platform's data or technology: the Service Instance is the parent.""},{""parents"":[""platform""],""children"":[""platform""],""status"":""allowed"",""types"":[""Depends on::Used by""],""note"":""A Platform that depends on another Platform.""},{""parents"":[""service_instance""],""children"":[""service_instance""],""status"":""allowed"",""types"":[""Depends on::Used by""],""note"":""A runtime dependency between Service Instances.""},{""parents"":[""platform""],""children"":[""service_instance""],""status"":""direction"",""review"":true,""note"":""A Platform is the child of the Service Instance that uses it. Confirm with the criticality owner before changing production, because criticality flows down."",""advice"":""Swap the direction: the Service Instance is the parent of the Platform.""},{""parents"":[""service_instance"",""platform""],""children"":[""application"",""api""],""status"":""allowed"",""types"":[""Depends on::Used by""],""note"":""The Service Instance depends on its Application CIs and APIs.""}],""expectations"":[{""id"":""bc-below"",""classes"":[""business_capability""],""direction"":""child"",""related"":[""business_process"",""business_capability""],""min"":1,""title"":""Business Capability with nothing below"",""todo"":""Add at least one Business Process or Business Capability as child, with Provided by::Provides.""},{""id"":""bp-business-capability"",""classes"":[""business_process""],""direction"":""parent"",""related"":[""business_capability""],""min"":1,""title"":""Business Process without a Business Capability above"",""todo"":""Add its Business Capability as parent, with Provided by::Provides.""},{""id"":""bp-application-or-service"",""classes"":[""business_process""],""direction"":""child"",""related"":[""business_application"",""business_service""],""min"":1,""title"":""Business Process without a Business Application or Business Service below"",""todo"":""Add one as child, with Provided by::Provides.""},{""id"":""ba-business-process"",""classes"":[""business_application""],""direction"":""parent"",""related"":[""business_process""],""min"":1,""title"":""Business Application without a Business Process above"",""todo"":""Add a Business Process as parent, with Provided by::Provides.""},{""id"":""ba-service-instance"",""classes"":[""business_application""],""direction"":""child"",""related"":[""service_instance"",""platform""],""min"":1,""max"":1,""maxPerEnvironment"":true,""title"":""Business Application without a Service Instance"",""tooManyTitle"":""Business Application with more than one Service Instance in one environment"",""todo"":""Add its Service Instance or Platform as child, with Consumes::Consumed by."",""tooManyTodo"":""Keep one per environment: which one is right?""},{""id"":""bs-offering"",""classes"":[""business_service""],""direction"":""child"",""related"":[""service_offering""],""min"":1,""title"":""Business Service without a Service Offering"",""todo"":""Add its Service Offering as child, with Provided by::Provides.""},{""id"":""bso-business-service"",""parentField"":true,""classes"":[""service_offering""],""direction"":""parent"",""related"":[""business_service""],""min"":1,""max"":1,""title"":""Service Offering without a Business Service"",""tooManyTitle"":""Service Offering with more than one Business Service"",""todo"":""Add its Business Service as parent."",""tooManyTodo"":""An offering has exactly one Business Service: which one is right?""},{""id"":""si-business-application"",""classes"":[""service_instance"",""platform""],""direction"":""parent"",""related"":[""business_application""],""min"":1,""max"":1,""inServiceNow"":true,""title"":""Service Instance without a Business Application"",""tooManyTitle"":""Service Instance with more than one Business Application"",""todo"":""SACM maps it in ServiceNow with the owner: add its Business Application as parent, with Consumes::Consumed by."",""tooManyTodo"":""A Service Instance has exactly one Business Application: which one is right?""},{""id"":""bso-service-instance"",""review"":true,""classes"":[""service_offering""],""direction"":""child"",""related"":[""service_instance"",""platform""],""min"":1,""title"":""Service Offering without a Service Instance"",""todo"":""Review: the Workspace documents disagree on this rule."",""reviewWhy"":""Review only: the rule is not agreed.""},{""id"":""bs-business-process"",""review"":true,""classes"":[""business_service""],""direction"":""parent"",""related"":[""business_process""],""min"":1,""title"":""Business Service without a Business Process above"",""todo"":""Review: the instruction says a Business Service should relate to a Business Process."",""reviewWhy"":""Review only: the instruction says \""should\"".""}],""notRaised"":[""A Service Instance that no offering uses."",""A Service Instance with nothing below it.""]},""tag-chips"":{""note"":""A short word shown next to a CI that carries a tag."",""chips"":[{""tag"":""Descoped"",""chip"":""to map"",""why"":""Descoped from service mapping earlier; now to be mapped. It does not mean deleted.""}]}}")
	queryGroup: Packed

/// GENERATED from powerbi/apps/refresh.json (D333). The refresh rule of the report in My workspace: the length of a window on demand, its hours, the scheduled times, the limit a day, and the rule in words for the pages My day and Reports.
expression RefreshRule = [WindowMinutes = 120, From = "08:00", To = "18:00", Scheduled = {"07:00"}, DailyLimit = 8, Text = "Refresh now: once every 2 hours, 08:00 to 18:00. The report refreshes at 07:00."]
	queryGroup: Packed

/// GENERATED from the calculated tables (D284). The type of every column of Run that a part gives, for RunRows: the data type of the column of the calculated table.
expression RunColumnTypes =
		{
		    {"CapabilitySheet.Name", type nullable text},
		    {"CapabilitySheet.Status", type nullable text},
