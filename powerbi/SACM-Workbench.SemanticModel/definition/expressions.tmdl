/// The day after the last day of the history the table HistoryRun computes (D290), with RangeStart. In the workspace the incremental refresh sets it for each part of the history; in Power BI Desktop keep it in the future.
expression RangeEnd = #datetime(2030, 1, 1, 0, 0, 0) meta [IsParameterQuery = true, Type = "DateTime", IsParameterQueryRequired = true]
	queryGroup: Parameters

/// The first day of the history the table HistoryRun computes (D290). In the workspace the incremental refresh sets it for each part of the history (keep 24 months, look at the last 7 days); in Power BI Desktop only the CI reports from this day to RangeEnd are computed, so keep it a few weeks back. The invented samples are of 4 and 11 November 2026.
expression RangeStart = #datetime(2026, 11, 1, 0, 0, 0) meta [IsParameterQuery = true, Type = "DateTime", IsParameterQueryRequired = true]
	queryGroup: Parameters

/// The folder of the report files inside the site, from the document library down ("Shared Documents/..."). Invented here.
expression ReportsFolder = "Shared Documents/Workbench/Reports" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	queryGroup: Parameters

/// The address of the team's ServiceNow, for the links that open a record (D244). The repository holds an invented address only: the real one is typed in the workspace (semantic model, Settings, Parameters) or in Power BI Desktop, never committed.
expression ServiceNowAddress = "https://contoso.service-now.com" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	queryGroup: Parameters

/// The team's SharePoint site. The repository holds an invented address only: the real one is typed in the workspace (semantic model, Settings, Parameters) or in Power BI Desktop on the company laptop, never committed.
expression SharePointSite = "https://contoso.sharepoint.com/sites/sacm" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
	queryGroup: Parameters

/// Where the report files come from. "Sample": the invented samples packed inside this file (no sign-in, no path). "SharePoint": the report files in the team's SharePoint folder (SharePointSite and ReportsFolder). Nothing after the source step knows the mode (D271).
expression SourceMode = "Sample" meta [IsParameterQuery = true, List = {"Sample", "SharePoint"}, DefaultValue = "Sample", Type = "Text", IsParameterQueryRequired = true]
	queryGroup: Parameters

/// Where the team's state comes from (D291): the journal, the replies, the settings, the team and the lifecycle reviews. "Sample": invented rows packed in this file (powerbi/samples/state/), so the history pages show something. "SharePoint": the five lists of the team site (SharePointSite; powerbi/README.md says how to make them). Empty lists are fine: every case is then New. "None": no state at all (every case New), for the real reports before the lists exist.
expression StateMode = "Sample" meta [IsParameterQuery = true, List = {"Sample", "SharePoint", "None"}, DefaultValue = "Sample", Type = "Text", IsParameterQueryRequired = true]
	queryGroup: Parameters

/// GENERATED from powerbi/apps/actions.json (D294). The actions of the Power App SACM actions: id, label, the journal event, its scope and what the manager types; fnCaseActions gives each case the actions of scope line that apply.
expression AppActions = Json.Document("{""note"":""The actions of the Power App SACM actions (build B6, D294). One entry per action: what it is called, the journal event it adds to the list SACM Journal (type and fixed text; DATA-MODEL §3) and what the manager types or picks (asks). scope 'line': the model gives the action to each case it applies to (the column Actions of CaseLines, fnCaseActions); the app offers it when every selected line has it. scope 'mine': on the open lines assigned to the manager. scope 'person': when every selected line is about one person. scope 'card': share out (D24, build B7): the free groups of a card go to the active members of SACM Team, each line to the member of its column ShareTo, worked out at the refresh. The app only adds rows, never changes or removes one (D272). The words of the buttons are those of the HTML app; a check file can give its own (playbook askAfterReview, askWhenUnsure, markWord)."",""actions"":[{""id"":""note"",""label"":""Note"",""type"":""note"",""scope"":""line"",""asks"":[""text""]},{""id"":""status"",""label"":""Status"",""type"":""status"",""scope"":""line"",""asks"":[""status""]},{""id"":""request"",""label"":""Request number"",""type"":""request"",""scope"":""line"",""asks"":[""request""]},{""id"":""assign"",""label"":""Assign"",""type"":""assign"",""scope"":""line"",""asks"":[""member""]},{""id"":""stop"",""label"":""Stop following"",""type"":""exception"",""scope"":""line"",""asks"":[""reason"",""reviewOn"",""text""]},{""id"":""follow-again"",""label"":""Follow again"",""type"":""exception"",""scope"":""line"",""text"":""Ended by hand"",""asks"":[]},{""id"":""fixed"",""label"":""Fixed"",""type"":""status"",""scope"":""line"",""text"":""Fixed"",""asks"":[]},{""id"":""undo-fixed"",""label"":""Undo the mark"",""type"":""status"",""scope"":""line"",""text"":""New"",""asks"":[]},{""id"":""ask-owner"",""label"":""Ask the owner"",""type"":""reviewed"",""scope"":""line"",""text"":""Ask the owner"",""asks"":[]},{""id"":""back-to-sacm"",""label"":""Back to SACM"",""type"":""reviewed"",""scope"":""line"",""text"":""Back to review"",""asks"":[]},{""id"":""retirement"",""label"":""Retirement date"",""type"":""retirement"",""scope"":""line"",""asks"":[""retireOn""]},{""id"":""stage"",""label"":""Stage"",""type"":""stage"",""scope"":""line"",""asks"":[""stage""]},{""id"":""no-process"",""label"":""The process does not exist"",""type"":""no-process"",""scope"":""line"",""text"":""yes"",""asks"":[]},{""id"":""no-process-undo"",""label"":""Undo: the process does not exist"",""type"":""no-process"",""scope"":""line"",""text"":""no"",""asks"":[]},{""id"":""handover"",""label"":""Hand over my work"",""type"":""handover"",""scope"":""mine"",""asks"":[""member"",""text""]},{""id"":""person-note"",""label"":""Note about the person"",""type"":""person-note"",""scope"":""person"",""asks"":[""text""]},{""id"":""share-out"",""label"":""Share out"",""type"":""assign"",""scope"":""card"",""asks"":[]}]}")
	queryGroup: Packed

/// GENERATED from checks/packs/. Every check file, in the order of the file names, with its folder.
expression CheckFiles = "[{""path"":""checks/packs/relationships/app-instance-match.json"",""folder"":""relationships"",""pack"":{""id"":""APP-INSTANCE-MATCH"",""status"":""live"",""title"":""Business Application differs from its Service Instance"",""cardLabel"":""Application ≠ Instance"",""cardHint"":""A Business Application is a copy of its Service Instance: owners, status, description and name. SACM copies what differs."",""cardText"":""A Business Application has the same Owned by, Managed by, Operational status and description as its Service Instance, and its name is the instance name without \"" - PROD\"" or \"" - TEST\"", plus \""_BA\"" (procedure 2.9). With several instances: the production one whose name it carries. Nobody is asked about the owners, status, description or name of an application: SACM copies the value of the instance in ServiceNow. Use the fix list. When the instance itself is wrong, its own card asks its owner, in EPO."",""family"":""relationships"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""business_application""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/application-instance"",""ref"":""reference/relationship-model""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/contracts/contract-for-procurement.json"",""folder"":""contracts"",""pack"":{""id"":""CONTRACT-PROCUREMENT"",""status"":""live"",""family"":""contracts"",""subject"":""contract"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""contract""]},""title"":""A problem in Solusi itself: only Procurement can correct it"",""cardLabel"":""For Procurement"",""cardHint"":""Problems in Solusi itself, such as no contract owner or a person who left. Only Procurement can correct them: one message to their mailbox."",""cardText"":""Problems in Solusi itself: no contract owner, a contract owner or Procurement partner who left (inactive in ServiceNow, and no active account with that name is known), no vendor number, and an EPO ID that is unknown or names a Retired system. Nobody in SACM can correct them, and a correction in ServiceNow is lost at the next upload. One message goes to the Procurement mailbox (its address is in Settings), with one table per problem. After the reminders, the escalation goes to the Procurement lead of Settings. Export this list gives the same tables as a file. Nothing is sent before you press Send."",""detector"":{""type"":""code"",""module"":""contracts/problems"",""ref"":""reference/contract-reports"",""rules"":[""noOwner"",""ownerLeft"",""partnerLeft"",""noVendorNumber"",""epoRetired"",""epoUnknown""]},""playbook"":{""path"":""source-fix"",""audience"":[""procurement""],""message"":{""subject"":""Contracts to correct in Solusi"",""intro"":""These contracts need a correction in Solusi."",""ask"":""Please correct them in Solusi."",""why"":""ServiceNow receives the contract data from Solusi with each upload, so these values can only be corrected in Solusi. Please {reply} when it is done, or when a contract is right as it is."",""byProblem"":{""noOwner"":{""subject"":""No contract owner"",""intro"":""These running contracts have no contract owner in Solusi."",""ask"":""Please add the contract owner in Solusi.""},""ownerLeft"":{""subject"":""Contract owner left"",""intro"":""The contract owner of these running contracts is no longer an active user in ServiceNow, and we know no active account with that name."",""ask"":""Please name a new contract owner in Solusi, or tell us if the person is still with the company.""},""partnerLeft"":{""subject"":""Procurement partner left"",""intro"":""The Procurement partner of these running contracts is no longer an active user in ServiceNow, and we know no active account with that name."",""ask"":""Please name a new Procurement partner in Solusi, or tell us if the person is still with the company.""},""noVendorNumber"":{""subject"":""No vendor number"",""intro"":""These contracts have no vendor number in Solusi. The upload finds the vendor by this number, so the vendor stays empty in ServiceNow."",""ask"":""Please add the vendor number in Solusi.""},""epoRetired"":{""subject"":""The EPO ID names a Retired system"",""intro"":""These running contracts name a system that is Retired in ServiceNow."",""ask"":""Please check if the contract still covers a system in use, and correct the EPO ID in Solusi.""},""epoUnknown"":{""subject"":""The EPO ID is not a known EPO ID"",""intro"":""The EPO ID of these running contracts holds a number that is not the EPO ID of a system in ServiceNow."",""ask"":""Please check the number, and correct the EPO ID in Solusi.""}}}}}},{""path"":""checks/packs/contracts/contract-not-in-solusi.json"",""folder"":""contracts"",""pack"":{""id"":""CONTRACT-NOT-IN-SOLUSI"",""status"":""live"",""title"":""A contract in ServiceNow is not in Solusi"",""cardLabel"":""Not in Solusi"",""cardHint"":""Contracts in ServiceNow that the Solusi contract file does not hold. SACM deletes them in ServiceNow; the app deletes nothing."",""cardText"":""Contracts that ServiceNow holds and the Solusi contract file does not (procedure 2.8). What is not in Solusi does not exist, or should not exist, in ServiceNow: every line is to delete. SACM deletes them in ServiceNow; the app deletes nothing. A note \""Still linked\"" on a line only says what links the contract to the CMDB. If Procurement asks to keep a contract, open it and choose Not followed up, with the reason."",""family"":""contracts"",""subject"":""contract"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""contract""]},""detector"":{""type"":""code"",""module"":""contracts/not-in-solusi"",""ref"":""reference/contract-reports""},""playbook"":{""path"":""sacm-fix"",""markWord"":""deleted"",""audience"":[""sacm""]}}},{""path"":""checks/packs/contracts/contract-servicenow-fix.json"",""folder"":""contracts"",""pack"":{""id"":""CONTRACT-SN-FIX"",""status"":""live"",""title"":""A contract value SACM corrects in ServiceNow"",""cardLabel"":""Contracts to fix in ServiceNow"",""cardHint"":""Contract fields that are wrong in ServiceNow, such as an inactive account with the name of an active person. SACM corrects them itself."",""cardText"":""SACM corrects these contracts itself in ServiceNow; no email is needed: a contract owner or Procurement partner for whom the upload picked an inactive account while an active account with the same name exists (the line names the account to set), a person ServiceNow shows differently from Solusi, a fixed-term contract without an end date, and a Concluded contract whose end date has passed. A person who really left is on the card \""For Procurement\"". Mark as fixed when it is done. A line is Verified when a later report no longer shows it."",""family"":""contracts"",""subject"":""contract"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""contract""]},""detector"":{""type"":""code"",""module"":""contracts/problems"",""ref"":""reference/contract-reports"",""rules"":[""ownerInactive"",""partnerInactive"",""personName"",""endPassed"",""noEnd""]},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/contracts/contract-status.json"",""folder"":""contracts"",""pack"":{""id"":""CONTRACT-STATUS"",""status"":""proposed"",""title"":""The status tag of a contract does not say what Solusi says"",""cardLabel"":""Contract status"",""cardHint"":""The real status from Solusi is kept as a tag, because ServiceNow sets Expired by itself. The list shows the tag to set."",""cardText"":""ServiceNow sets \""Expired\"" by itself from the end date, so the real status from Solusi is kept as a tag, for example \""S - Concluded\"" (procedure 2.8, known challenge 4). This list shows the tag to add, change or remove. Contracts terminated in the last 7 days are checked the same way."",""family"":""contracts"",""subject"":""contract"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""contract""]},""detector"":{""type"":""code"",""module"":""contracts/status"",""ref"":""reference/contract-reports""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/contracts/contract-to-clear.json"",""folder"":""contracts"",""pack"":{""id"":""CONTRACT-TO-CLEAR"",""status"":""proposed"",""title"":""A value removed in Solusi is still in ServiceNow"",""cardLabel"":""To clear by hand"",""cardHint"":""A value Procurement removed in Solusi stays in ServiceNow, because the import never clears a field. SACM clears it by hand."",""cardText"":""The import from Solusi never clears a field (procedure 2.8, known challenge 2). A value that Procurement removed in Solusi stays in ServiceNow until SACM clears it by hand. An old end date matters most: ServiceNow shows the contract as Expired because of it."",""family"":""contracts"",""subject"":""contract"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""contract""]},""detector"":{""type"":""code"",""module"":""contracts/to-clear"",""ref"":""reference/contract-reports""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/contracts/contract-upload-check.json"",""folder"":""contracts"",""pack"":{""id"":""CONTRACT-UPLOAD"",""status"":""live"",""family"":""contracts"",""subject"":""contract"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""contract""]},""title"":""A field differs between Solusi and ServiceNow after the upload"",""cardLabel"":""Upload check"",""cardHint"":""Solusi and ServiceNow differ. First check that the Solusi file was uploaded; if it was, SACM sets the Solusi value itself."",""cardText"":""First question: was this Solusi contract file uploaded to ServiceNow? If not, upload it, load a new ServiceNow contract report and look again. If it was, SACM sets the value of Solusi in ServiceNow itself and marks the line as fixed; no incident is raised. A person's name that differs is on Contracts to fix in ServiceNow."",""detector"":{""type"":""code"",""module"":""contracts/upload-check"",""ref"":""reference/contract-reports""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/ci/crit-above-parent.json"",""folder"":""ci"",""pack"":{""id"":""CRIT-ABOVE-PARENT"",""status"":""live"",""title"":""Target criticality is higher than every parent passes on"",""cardLabel"":""Above parent"",""cardHint"":""The target criticality is higher than every parent passes on. Often a parent relationship is missing: SACM checks the mapping first."",""cardText"":""A target value higher than every value the parents pass on is unusual: often a parent relationship is missing. SACM checks the mapping first, so these CIs start under Check the mapping first. Parents over a relationship excluded from calculation do not count. When the mapping of a CI is complete, press \""Mapping is complete: ask the owner\"" on its line: the CI moves to Asked of the owner, and the owner is asked to confirm the value or lower it with the criticality request."",""family"":""criticality"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""business_process"",""business_application"",""business_service"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""criticality/above-parents"",""ref"":""reference/criticality""},""playbook"":{""path"":""service-request"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)""],""askAfterReview"":""Mapping done: ask owner"",""message"":{""subject"":""Criticality above the parent CIs"",""intro"":""A target value is higher than every value the parent CIs pass on. We checked the mapping: no parent relationship is missing."",""ask"":""Could you confirm that the value is right? If it is too high, please lower it with the request {request:criticality}."",""why"":""Criticality flows down from the parents. A CI rated higher than all of its parents is unusual.""}}}},{""path"":""checks/packs/ci/crit-auto-justification.json"",""folder"":""ci"",""pack"":{""id"":""CRIT-AUTO-JUSTIFICATION"",""status"":""live"",""title"":""Criticality exception with only the automatic justification"",""cardLabel"":""Automatic justification only"",""cardHint"":""A CI kept a lower value after its parent was raised; its only justification is the automatic text. The owner says why."",""cardText"":""When the inherited value rises, ServiceNow keeps the lower target with the text \""Inherited value increased (Auto generated)\"". That text gives no reason. The owner is asked which justification applies, or if the value should follow the parent. SACM then selects the justification, or raises the target."",""family"":""criticality"",""dimension"":""correctness"",""severity"":""high"",""scope"":{""classes"":[""business_process"",""business_application"",""business_service"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""forEach"":[""confidentiality"",""integrity"",""availability"",""authenticity""],""when"":{""all"":[{""op"":""lessThanField"",""field"":""target.{each}"",""value"":""inherited.{each}""},{""op"":""onlyMatches"",""field"":""exception_justification"",""value"":""\\(Auto generated\\)""}]}},""playbook"":{""path"":""email"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)""],""message"":{""subject"":""Lower criticality without a reason"",""intro"":""The parent of these CIs was raised, and the CIs kept a lower value. The only justification is the automatic text, which gives no reason."",""ask"":""Which justification applies, or should the value follow the parent? {Reply}, and we select the justification in ServiceNow, or raise the target."",""why"":""If it is lower, we should know why: an exception needs a reason.""}}}},{""path"":""checks/packs/ci/crit-no-justification.json"",""folder"":""ci"",""pack"":{""id"":""CRIT-NO-JUSTIFICATION"",""status"":""live"",""title"":""Criticality exception without a valid justification"",""cardLabel"":""No justification"",""cardHint"":""A lowered criticality value has no justification of its own. SACM applied it, so SACM adds the justification from the request."",""family"":""criticality"",""dimension"":""correctness"",""severity"":""high"",""scope"":{""classes"":[""business_process"",""business_application"",""business_service"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""forEach"":[""confidentiality"",""integrity"",""availability"",""authenticity""],""when"":{""all"":[{""op"":""lessThanField"",""field"":""target.{each}"",""value"":""inherited.{each}""},{""op"":""lacksValidEntryFor"",""field"":""exception_justification"",""value"":""{each}"",""ignore"":""\\(Auto generated\\)""},{""op"":""notOnlyMatches"",""field"":""exception_justification"",""value"":""\\(Auto generated\\)""}]}},""playbook"":{""path"":""sacm-fix"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)""],""askWhenUnsure"":""The request gives none: ask the owner"",""message"":{""subject"":""Criticality exception without a justification"",""intro"":""A target value is lower than the inherited value, and the request gives no justification for it."",""ask"":""Could you tell us why the value is lower than the one inherited from the parent? {Reply} with the reason, and we select the justification in ServiceNow. If the value should follow the parent, tell us and we raise the target."",""why"":""Without a justification, the exception cannot be explained to an auditor.""}},""cardText"":""The target criticality is lower than the inherited one, and no justification covers that value. SACM applied the values of the request, so SACM adds the justification the request gives for each lowered value. Only when the request gives none: open the CI and press \""The request gives none: ask the owner\"". A CI whose field holds only the automatic text is on the card Only the automatic justification.""}},{""path"":""checks/packs/ci/crit-none-reaches.json"",""folder"":""ci"",""pack"":{""id"":""CRIT-NONE-REACHES"",""status"":""live"",""reviewOnly"":true,""reviewWhy"":""SACM checks the mapping: no criticality reaches these CIs"",""title"":""No criticality reaches the CI"",""cardLabel"":""No criticality reaches the CI"",""cardHint"":""No target and nothing inherited: no parent passes a criticality to the CI. Often a parent relationship is missing."",""cardText"":""The owner is not asked for a target: criticality flows down from the Business Process. These CIs have no target and nothing inherited, so no parent passes a criticality to them. Often a parent relationship is missing, or the only parent is over a relationship excluded from calculation. SACM checks the mapping. A CI with Inherited set and Target empty waits two weeks: ServiceNow then copies Inherited to Target. A target without Inherited is fine."",""family"":""criticality"",""dimension"":""completeness"",""severity"":""medium"",""scope"":{""classes"":[""business_application"",""business_service"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""criticality/none-reaches"",""ref"":""reference/criticality""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/ci/crit-target-missing.json"",""folder"":""ci"",""pack"":{""id"":""CRIT-TARGET-MISSING"",""status"":""live"",""title"":""Business Process without target criticality (BIA missing)"",""cardLabel"":""BIA missing"",""cardHint"":""An Operational Business Process has no CIA values and no tag BIA N/A or BIA is pending. SACM checks the status or the tag."",""cardText"":""Criticality starts on the Business Process: its CIA values come from the BIA, and the process becomes Operational after its mapping. A process in Ready without CIA values is not listed: it may wait there. An Operational (or Under retirement) process without CIA values is wrong, unless the tag BIA N/A or BIA is pending says why: SACM checks the status, or adds the tag. Nobody is written to: SACM does not chase the BIA."",""family"":""criticality"",""dimension"":""completeness"",""severity"":""high"",""scope"":{""classes"":[""business_process""],""exclude"":{""operational_status"":[""retired"",""ready""]}},""detector"":{""type"":""rule"",""when"":{""op"":""levelsMissing"",""field"":""target""}},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/ci/desc-quality.json"",""folder"":""ci"",""pack"":{""id"":""DESC-QUALITY"",""status"":""proposed"",""title"":""Description is missing or of poor quality"",""cardLabel"":""Description"",""cardHint"":""The description is empty, too short, the same as the name, or a placeholder. The owner writes what the CI is and what it is for."",""cardText"":""The description is empty, too short, the same as the name, or a placeholder. The owner writes what the CI is and what it is for. On a Business Service or a Service Instance the owner corrects it in EPO. A Business Application is not asked: SACM copies the description of its Service Instance (card Application ≠ Instance)."",""family"":""description"",""dimension"":""completeness"",""severity"":""medium"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""any"":[{""field"":""description"",""op"":""isEmpty""},{""field"":""description"",""op"":""shorterThan"",""value"":30},{""field"":""description"",""op"":""equalsField"",""value"":""name""},{""field"":""description"",""op"":""matchesAny"",""value"":[""^tbd$"",""^n/?a$"",""^test(ing)?$"",""^to ?do$"",""^[-.?x]+$"",""^none$"",""^unknown$""]},{""field"":""description"",""op"":""duplicatedMoreThan"",""value"":10}]}},""playbook"":{""path"":""self-fix"",""audience"":[""managed_by"",""owned_by"",""managerOf(owned_by)""],""message"":{""subject"":""No useful description"",""intro"":""The description is empty, or does not say what the CI is."",""ask"":""Could you reply with one or two sentences per CI: what it is, and what it is used for? We will update ServiceNow for you. You can also raise the request {form:modify-service-offering}."",""why"":""The service desk and change approvers read it to understand the CI."",""epoWhat"":""description"",""askByClass"":{""service_offering"":""Could you reply with one or two sentences per offering: what it is, and what it is used for? We will update ServiceNow for you. You can also raise the request {request:modify-service-offering}.""},""askByTeam"":{""process-management"":""Could you reply with one or two sentences per process: what the process is and what it does? We will update ServiceNow.""}},""routeBy"":""epo""}}},{""path"":""checks/packs/epo/epo-differs.json"",""folder"":""epo"",""pack"":{""id"":""EPO-DIFF"",""status"":""live"",""title"":""A service mapped CI differs from EPO"",""cardLabel"":""EPO ≠ ServiceNow"",""cardHint"":""Service mapped CIs whose status, name, people or description differ from EPO. SACM copies the EPO value into ServiceNow."",""cardText"":""Service mapped CIs whose status, name, people or description in ServiceNow are not the same as in EPO (procedure 2.7). The description is compared by letters and digits only: empty in ServiceNow, cut short, or another start. The sync to these CIs is cut, so SACM copies the EPO value into ServiceNow by hand: use the fix list. When the Service Instance changes, change its Business Application too (the card \""Application ≠ Instance\"" shows it at the next report). Never remove the relationships."",""family"":""epo-report"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""service_instance""]},""detector"":{""type"":""code"",""module"":""epo/differs"",""ref"":""reference/epo-systems-report""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/ci/epo-id.json"",""folder"":""ci"",""pack"":{""id"":""EPO-ID"",""status"":""proposed"",""title"":""EPO ID missing or used twice"",""cardLabel"":""EPO ID"",""cardHint"":""A Business Service or Service Instance without an EPO ID, or with one used twice. SACM looks first: known case, or ask the owner."",""cardText"":""The EPO ID is the Asset tag. A Business Service or Service Instance without one was most likely created in ServiceNow and not in EPO. SACM looks at each line first. Created in ServiceNow on purpose (the known cases of the instruction, section 3.1): use Not followed up once, with a reason. It must be in EPO: open the CI and press \""Must be created in EPO: ask the owner\"": the owner is asked to create it in EPO. Service Offerings are ServiceNow records and are not checked."",""family"":""epo"",""dimension"":""completeness"",""severity"":""medium"",""scope"":{""classes"":[""business_service"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""ci/epo-id"",""ref"":""reference/epo-id""},""playbook"":{""path"":""sacm-fix"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""askWhenUnsure"":""Must be created in EPO: ask the owner"",""message"":{""subject"":""EPO ID to check"",""intro"":""These CIs have no EPO ID in ServiceNow, or the same EPO ID as another CI, so they cannot be matched with EPO."",""ask"":""Please check that the system or service exists in EPO, once only. If it is not in EPO, please create it there: ServiceNow receives it from EPO. {Reply} if you have a question."",""why"":""The EPO ID links the ServiceNow record to EPO. Without it the two cannot be compared.""}}}},{""path"":""checks/packs/epo/epo-not-arrived.json"",""folder"":""epo"",""pack"":{""id"":""EPO-NOT-ARRIVED"",""reviewOnly"":true,""reviewWhy"":""ServiceNow should follow EPO by itself: listed for a review of the sync"",""status"":""live"",""title"":""EPO change not in ServiceNow (not service mapped)"",""cardLabel"":""EPO update not arrived"",""cardHint"":""CIs that should follow EPO by themselves but differ from it: the sync did not bring the change. A list to look at."",""cardText"":""CIs that are not service mapped: ServiceNow must follow EPO by itself, so a difference means the sync did not bring the change. Status, name, the three people and the description are compared (the description by letters and digits only). Check a few of them in EPO and in ServiceNow. A change made in EPO less than two days before the report waits: the sync may still bring it. After two days, raise one incident for the pattern with the ServiceNow development team, and keep its number on the cases."",""family"":""epo-report"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""service_instance""]},""detector"":{""type"":""code"",""module"":""epo/not-arrived"",""ref"":""reference/epo-systems-report""},""playbook"":{""path"":""source-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/lifecycle/lifecycle-review.json"",""folder"":""lifecycle"",""pack"":{""id"":""LIFECYCLE-REVIEW"",""status"":""proposed"",""title"":""Status in ServiceNow is not the same as in EPO (lifecycle review)"",""cardLabel"":""Lifecycle review"",""cardHint"":""A manager found that the status of a sampled CI is not the same as in EPO. SACM looks at the source first."",""cardText"":""From the lifecycle review (Audit, Lifecycle): a manager compared the status of a sampled CI with EPO and marked it Not the same. A service mapped CI: SACM copies the status of EPO into ServiceNow. A CI that is not service mapped should follow EPO by itself: raise an incident with the ServiceNow development team. Only when EPO itself looks wrong, press \""EPO itself looks wrong: ask the owner\"" on the line. A line stays to solve until a later report shows another status for the CI."",""family"":""lifecycle"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""manual"",""module"":""review/lifecycle"",""ref"":""reference/lifecycle""},""playbook"":{""path"":""sacm-fix"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""message"":{""subject"":""Status differs from EPO"",""intro"":""In our lifecycle review, their status in ServiceNow was not the same as in EPO, and the status in EPO looks wrong to us."",""ask"":""Which status is right? Please correct it in EPO, or {reply}."",""why"":""The status decides whether a CI is followed up, and whether incidents and changes can use it.""},""askWhenUnsure"":""EPO itself looks wrong: ask the owner""}}},{""path"":""checks/packs/relationships/mapping.json"",""folder"":""relationships"",""pack"":{""id"":""MAPPING"",""status"":""proposed"",""title"":""CI to map with its owner"",""cardLabel"":""Mapping backlog"",""cardHint"":""One case per CI to map: SACM invites the owner to a mapping session and moves the case through its stages."",""cardText"":""Everything that must be mapped, one case per CI: a Service Instance without a Business Application, a Business Service or Business Application without a Business Process, a Business Application without a Service Instance, a Business Process with nothing below (in Ready only once it has CIA values), and a Business Application tagged To be deleted that is still Operational. SACM invites the owner to a mapping session (no list of questions), maps the CI with the owner in the Service Mapping Workspace and makes the changes in ServiceNow. Set the stage on the case as it moves on. When the owner says the Business Process does not exist, mark it: Tell Process Management writes one message to the team. A case is solved when a later report no longer shows the problem. CIs tagged To Be Mapped, Descoped or Process is missing or unknown are planned (known); CIs in Ready wait."",""family"":""relationships"",""dimension"":""compliance"",""severity"":""high"",""scope"":{""classes"":[""business_process"",""business_application"",""business_service"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""mapping/backlog"",""ref"":""reference/mapping-backlog""},""playbook"":{""path"":""mapping"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)""],""message"":{""subject"":""Mapping session"",""intro"":""SACM maps every CI of the CMDB to the CIs above and below it. These CIs of yours are not fully mapped yet."",""ask"":""Could we plan a 30-minute mapping session with you? {Reply} with a time that suits you. There is nothing to prepare: we go through it together."",""why"":""Without these relationships, criticality cannot flow to the CIs that support your service, and incidents cannot be linked to it."",""byProblem"":{""no-process"":{""subject"":""No Business Process"",""intro"":""In a mapping session, the owners of these CIs told us that the Business Process they belong to does not exist yet."",""ask"":""Could you identify the Business Process of each CI, or have it created? {Reply} with the process, and SACM links the CI to it in ServiceNow.""}}}}}},{""path"":""checks/packs/ci/name-duplicate.json"",""folder"":""ci"",""pack"":{""id"":""NAME-DUPLICATE"",""status"":""live"",""title"":""CI name is used twice in one class, or has double spaces"",""cardLabel"":""Duplicate names"",""cardHint"":""Two live CIs of one class have the same name, or a name has two spaces. SACM looks first: one thing twice, retire one."",""cardText"":""Two live CIs of the same class with the same name, or a name with two spaces in a row. A Retired CI, or a CI of another class, with the same name does not count. SACM looks at each line first. Two records for one thing: SACM retires one, and removes the double space itself. Two real CIs: open the CI and press \""Two real CIs: ask the owner\"": the owner gives each one its own name (in EPO for a Business Service or a Service Instance)."",""family"":""name"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""any"":[{""op"":""duplicatedInClass"",""field"":""name"",""value"":1},{""op"":""hasDoubleSpaces"",""field"":""name""}]}},""playbook"":{""path"":""sacm-fix"",""audience"":[""managed_by"",""owned_by"",""managerOf(owned_by)""],""askWhenUnsure"":""Two real CIs: ask the owner"",""routeBy"":""epo"",""message"":{""subject"":""Duplicate name"",""intro"":""Another live CI of the same class has the same name. They are two different CIs."",""ask"":""Could you give each one a name of its own? {Reply} with the right names, and we will update ServiceNow for you."",""why"":""A CI is found by its name, so each name must be unique."",""epoWhat"":""name""}}}},{""path"":""checks/packs/ci/name-format.json"",""folder"":""ci"",""pack"":{""id"":""NAME-FORMAT"",""status"":""proposed"",""title"":""CI name has a wrong dash or a space at its start or end"",""cardLabel"":""Name to tidy"",""cardHint"":""Small faults in a name, such as a space at the start or the end. SACM corrects them itself; nobody is asked."",""cardText"":""Small faults in a name that SACM corrects itself, nobody is asked: an API offering that does not start with \""API - \"" (for example another dash), and a space at the start or the end of a name."",""family"":""name"",""dimension"":""compliance"",""severity"":""low"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""ci/name-standard"",""ref"":""reference/name-rules"",""rules"":[""api-prefix"",""outer-space""]},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/ci/name-hidden-char.json"",""folder"":""ci"",""pack"":{""id"":""NAME-HIDDEN-CHAR"",""status"":""live"",""title"":""CI name holds a hidden character"",""cardLabel"":""Hidden character in name"",""cardHint"":""The name holds a character nobody can see, so searching and matching fail. SACM removes it in ServiceNow."",""cardText"":""The name holds a character nobody can see, most often a zero-width space. ServiceNow does not show it, but it is in the record, so searching for the name or matching it with another report fails. A CSV export shows it as \""?\"". SACM removes it in ServiceNow; nobody needs to be asked."",""family"":""name"",""dimension"":""correctness"",""severity"":""low"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""op"":""hasHiddenCharacters"",""field"":""name""}},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/ci/name-standard.json"",""folder"":""ci"",""pack"":{""id"":""NAME-STANDARD"",""status"":""proposed"",""title"":""CI name does not follow the naming standard"",""cardLabel"":""Name not standard"",""cardHint"":""The name does not end as the instruction asks for its class, for example _BS. The owner corrects it in EPO."",""cardText"":""The instruction gives each class an ending: a Business Service ends with _BS, a Service Instance with \"" - PROD\"" or \"" - TEST\"". The owner is asked to correct the name in EPO. The name of a Business Application is on Application ≠ Instance: SACM copies it from its Service Instance."",""family"":""name"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""business_service"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""ci/name-standard"",""ref"":""reference/name-rules"",""rules"":[""bs-suffix"",""si-suffix""]},""playbook"":{""path"":""service-request"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""routeBy"":""epo"",""message"":{""subject"":""Name not standard"",""intro"":""Their name does not follow the SACM naming standard."",""ask"":""Please correct the name. {Reply} if you need help, or if the name is right as it is."",""why"":""A standard name lets everybody find the CI and see what it is."",""epoWhat"":""name""}}}},{""path"":""checks/packs/relationships/offering-owner.json"",""folder"":""relationships"",""pack"":{""id"":""OFFERING-OWNER"",""status"":""live"",""title"":""Service Offering owner differs from its Business Service owner"",""cardLabel"":""Offering owner ≠ Service owner"",""cardHint"":""A Service Offering made by a person has another owner than its Business Service. SACM copies the service owner."",""cardText"":""A Service Offering made by a person has the owner of its Business Service (procedure 2.6). Offerings from EPO take their owner from EPO and are not raised. SACM copies the owner of the Business Service onto the offering in ServiceNow: use the fix list. Nobody is asked."",""family"":""relationships"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""service_offering""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/offering-owner"",""ref"":""reference/relationship-model""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/relationships/offering-parent.json"",""folder"":""relationships"",""pack"":{""id"":""OFFERING-PARENT"",""status"":""live"",""title"":""Parent field and Business Service relationship of an offering do not match"",""cardLabel"":""Offering parent"",""cardHint"":""The Parent field of a Service Offering and its Business Service relationship do not name the same service. SACM fixes it."",""cardText"":""The Parent field of a Service Offering and its Business Service relationship must name the same, single Business Service. SACM fixes it, nobody is asked: use the fix list. When the Parent field names a service and no relationship exists, add the relationship to that service."",""family"":""relationships"",""dimension"":""correctness"",""severity"":""high"",""scope"":{""classes"":[""service_offering""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/offering-parent"",""ref"":""reference/relationship-model""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/lifecycle/process-stage.json"",""folder"":""lifecycle"",""pack"":{""id"":""PROCESS-STAGE"",""status"":""proposed"",""title"":""Business Process in Ready that is mapped: make it Operational"",""cardLabel"":""Process stage"",""cardHint"":""A Business Process in Ready has its CIA values and something linked below: SACM makes it Operational."",""cardText"":""A Business Process is created in Ready. After the BIA its CIA values are added: that is the sign to map it. To map: nothing is linked below yet, so the process is a case of the Mapping backlog, where SACM plans a mapping session with the process owner. Mapped: a Business Application or Business Service is linked below, so SACM makes the process Operational: that is the line of this card. A process in Ready without CIA values waits for the BIA: it has no line, and nobody is chased. Needs the Relationship report."",""family"":""lifecycle"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""business_process""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""process/stage"",""ref"":""reference/lifecycle""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/lifecycle/ready-too-long-capability.json"",""folder"":""lifecycle"",""pack"":{""id"":""READY-TOO-LONG-BC"",""status"":""off"",""title"":""Business Capability is in status Ready for too long"",""cardLabel"":""Capability Ready too long"",""cardHint"":""A Business Capability has been in status Ready for too long. SACM makes it Operational itself."",""cardText"":""The Business Capability was created more than the number of days in Settings ago (90 at first) and is still in status Ready. SACM makes it Operational itself in ServiceNow; Enterprise Architecture owns the capabilities and only answers questions. Mark as fixed when it is done. A line is Verified when a later report shows it Operational."",""family"":""lifecycle"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""business_capability""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""ci/status-age"",""ref"":""reference/lifecycle"",""rules"":[""ready""]},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/lifecycle/ready-too-long.json"",""folder"":""lifecycle"",""pack"":{""id"":""READY-TOO-LONG"",""status"":""proposed"",""title"":""CI is in status Ready for too long"",""cardLabel"":""Ready too long"",""cardHint"":""The CI has been in status Ready for months. Its other problems wait while it is not live, so the owner is asked."",""cardText"":""The CI was created more than the number of days in Settings ago (90 at first) and is still in status Ready. A CI in Ready is not live, so its other problems wait. That is right for a new CI, not for one that sits in Ready for months: clarify it with the owner when there is time. Business Processes and Business Applications are not on this card."",""family"":""lifecycle"",""dimension"":""compliance"",""severity"":""medium"",""priority"":""later"",""scope"":{""classes"":[""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""ci/status-age"",""ref"":""reference/lifecycle"",""rules"":[""ready""]},""playbook"":{""path"":""email"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""message"":{""subject"":""In status Ready for a long time"",""intro"":""They are still in status Ready, long after they were created."",""ask"":""Is it in use? Then the status must be Operational. Is it not needed any more? Then it must be retired. Please make the change, or {reply}."",""askByClass"":{""service_instance"":""Is this system in use? Then its status must be Operational. Is it not needed any more? Then it must be retired. Please make the change in EPO, or {reply}.""},""why"":""A CI in Ready is treated as not live: its owner, criticality and relationships are not followed up.""}}}},{""path"":""checks/packs/relationships/rel-missing.json"",""folder"":""relationships"",""pack"":{""id"":""REL-MISSING"",""status"":""live"",""title"":""Mandatory relationship is missing (unmapped CI)"",""cardLabel"":""Relationship missing"",""cardHint"":""A CI lacks a relationship the model asks for, such as a Business Service without a Service Offering."",""cardText"":""A CI without a relationship the model asks for. On a Business Service and on an offering from EPO the change goes into EPO. A Business Capability needs at least one Business Process or Business Capability below it. One rule is only listed for a review (offering without a Service Instance): it is not agreed yet. What SACM maps with the owner (a Service Instance without a Business Application, a Business Application without a Service Instance or a Business Process, a Business Service without a Business Process, a Business Process with nothing below) is on the Mapping backlog."",""family"":""relationships"",""dimension"":""compliance"",""severity"":""high"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/missing"",""ref"":""reference/relationship-model"",""rules"":[""bc-below"",""bp-business-capability"",""bs-offering"",""bso-business-service"",""bso-service-instance""]},""playbook"":{""path"":""self-fix"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)""],""routeBy"":""epo"",""message"":{""subject"":""Relationship missing"",""intro"":""A relationship the CMDB model asks for is missing on these CIs."",""ask"":""Could you tell us which CI is missing? {Reply} with its name (or EPO ID), and we add the relationship {request:service-mapping}."",""several"":""As there are several CIs, a 30-minute mapping session may be quicker. Reply with a time that suits you."",""why"":""Without these relationships, criticality cannot flow to the CIs that support your service, and incidents cannot be linked to it."",""epoAsk"":""Please add the missing relationship in EPO. If you are not sure which one, reply with the Business Process your system delivers and the systems it depends on (EPO IDs or names)."",""askByClass"":{""business_capability"":""Which Business Processes or Business Capabilities carry out this capability? {Reply}, and we add the relationships {request:service-mapping}.""}}}}},{""path"":""checks/packs/relationships/rel-one-to-one.json"",""folder"":""relationships"",""pack"":{""id"":""REL-ONE-TO-ONE"",""status"":""live"",""title"":""CI has more than the one allowed partner"",""cardLabel"":""Too many partners"",""cardHint"":""A CI has more partners than the model allows, such as an offering with two Business Services. SACM fixes the mapping."",""cardText"":""An offering has exactly one Business Service; a Service Instance exactly one Business Application; a Business Application one Service Instance per environment. SACM fixes the mapping in ServiceNow: use the fix list. When SACM cannot tell which one is right, open the CI and press \""Cannot tell which one is right: ask the owner\"": the owner is asked."",""family"":""relationships"",""dimension"":""compliance"",""severity"":""high"",""scope"":{""classes"":[""business_application"",""service_offering"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/too-many"",""ref"":""reference/relationship-model"",""rules"":[""bso-business-service"",""ba-service-instance"",""si-business-application""]},""playbook"":{""path"":""sacm-fix"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)""],""askWhenUnsure"":""Cannot tell which one is right: ask the owner"",""message"":{""subject"":""Too many related CIs"",""intro"":""These CIs are related to more CIs than the CMDB model allows. The table shows which."",""ask"":""Which one is right? {Reply}, and SACM removes the other relationships in ServiceNow."",""why"":""With two parents, criticality and ownership are not clear.""}}}},{""path"":""checks/packs/relationships/rel-retired.json"",""folder"":""relationships"",""pack"":{""id"":""REL-RETIRED"",""status"":""off"",""title"":""Relationship to a Retired CI"",""cardLabel"":""Relationship to a Retired CI"",""cardHint"":""One end of the relationship is Retired, the other is not (procedure 2.12). SACM removes it in ServiceNow: use the fix list, grouped by the live CI."",""family"":""relationships"",""dimension"":""correctness"",""severity"":""low"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/retired-end"",""ref"":""reference/relationship-model""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/relationships/rel-twice.json"",""folder"":""relationships"",""pack"":{""id"":""REL-TWICE"",""status"":""live"",""title"":""More than one relationship between two CIs"",""cardLabel"":""Relationship entered twice"",""cardHint"":""Two CIs are linked more than once. Only one relationship is allowed: SACM keeps the right one and removes the others."",""cardText"":""Between two CIs only one relationship is allowed. This lists the same relationship entered more than once, and two CIs linked by relationships of different types or in both directions. SACM keeps the right one and removes the others: use the fix list."",""family"":""relationships"",""dimension"":""correctness"",""severity"":""low"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/twice"",""ref"":""reference/relationship-model""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/relationships/rel-wrong-type.json"",""folder"":""relationships"",""pack"":{""id"":""REL-WRONG-TYPE"",""status"":""live"",""title"":""Relationship type is not allowed between these classes"",""cardLabel"":""Wrong relationship type"",""cardHint"":""The relationship has a type the model does not allow between these classes. SACM corrects it in ServiceNow."",""cardText"":""SACM corrects these in ServiceNow: use the fix list. A Platform above the Service Instance that uses it is only listed for a review: confirm with the criticality owner before changing production, because criticality flows down."",""family"":""relationships"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""relationships/wrong-type"",""ref"":""reference/relationship-model""},""playbook"":{""path"":""sacm-fix"",""audience"":[""sacm""]}}},{""path"":""checks/packs/ci/resp-inactive.json"",""folder"":""ci"",""pack"":{""id"":""RESP-INACTIVE"",""status"":""live"",""title"":""Responsible person is an inactive user"",""cardLabel"":""Inactive person"",""cardHint"":""Owned by or Managed by names a person who is no longer active, so we ask who took over. Supported by has its own card."",""family"":""responsibility"",""dimension"":""correctness"",""severity"":""high"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""forEach"":[""owned_by"",""managed_by"",""supported_by""],""when"":{""op"":""refInactive""},""forEachClasses"":{""supported_by"":[]}},""playbook"":{""path"":""service-request"",""audience"":[""managed_by"",""otherRoles"",""managerOf(field)"",""departmentHeadOf(field)"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""message"":{""subject"":""Inactive {who}"",""intro"":""Their {role} is no longer an active user."",""ask"":""Could you tell us who took over? You can {reply}, or raise the request {request}."",""why"":""Without an active owner, approvals for these CIs are rejected automatically."",""request"":""role"",""askNoRequest"":""Could you tell us who took over? Please {reply}, and we will update ServiceNow for you."",""askByClass"":{""service_offering"":""Could you tell us who took over? You can {reply}, or raise the request {request:modify-service-offering}.""},""askByTeam"":{""process-management"":""Could you tell us who took over? Please {reply} with the name of the person for each process, and we will update ServiceNow.""}},""routeBy"":""epo""}}},{""path"":""checks/packs/ci/resp-missing.json"",""folder"":""ci"",""pack"":{""id"":""RESP-MISSING"",""status"":""live"",""title"":""Responsible person is missing"",""cardLabel"":""Owner or manager missing"",""cardHint"":""Owned by or Managed by is empty: every CI needs an owner and a manager. Supported by has its own card."",""family"":""responsibility"",""dimension"":""completeness"",""severity"":""high"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""forEach"":[""owned_by"",""managed_by"",""supported_by""],""when"":{""op"":""isEmpty""},""forEachClasses"":{""supported_by"":[]}},""playbook"":{""path"":""service-request"",""audience"":[""managed_by"",""otherRoles"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""message"":{""subject"":""No {who}"",""intro"":""The role {role} is empty."",""ask"":""Could you tell us who it should be? You can {reply}, or raise the request {request}."",""why"":""Incidents, changes and approvals for these CIs have nobody to go to."",""request"":""role"",""askNoRequest"":""Could you tell us who it should be? Please {reply}, and we will update ServiceNow for you."",""askByClass"":{""service_offering"":""Could you tell us who it should be? You can {reply}, or raise the request {request:modify-service-offering}.""},""askByTeam"":{""process-management"":""Could you tell us who it should be? Please {reply} with the name of the person for each process, and we will update ServiceNow.""}},""routeBy"":""epo""}}},{""path"":""checks/packs/ci/resp-same-person.json"",""folder"":""ci"",""pack"":{""id"":""RESP-SAME-PERSON"",""status"":""proposed"",""title"":""Owned by and Managed by are the same person"",""cardLabel"":""Owner = Manager"",""cardHint"":""Owned by and Managed by name the same person. They should be two different people."",""family"":""responsibility"",""dimension"":""correctness"",""severity"":""medium"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""op"":""samePersonAs"",""field"":""owned_by"",""value"":""managed_by""}},""playbook"":{""path"":""service-request"",""audience"":[""managed_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""routeBy"":""epo"",""message"":{""subject"":""Same person as owner and manager"",""intro"":""The same person is Owned by and Managed by."",""ask"":""Could you name a second person for Managed by? You can reply, or raise the request {request:managed-by-update}."",""why"":""The two roles approve changes together. One person in both means there is no second check."",""epoAsk"":""Could you name a second person as Primary Responsible (Managed by) in EPO?"",""askByTeam"":{""process-management"":""Could you name a second person for Managed by? Please {reply} with the name for each process, and we will update ServiceNow.""}}}}},{""path"":""checks/packs/ci/support-group-inactive.json"",""folder"":""ci"",""pack"":{""id"":""SUPPORT-GROUP-INACTIVE"",""status"":""live"",""title"":""Support group of the CI is not active"",""cardLabel"":""Support group inactive"",""cardHint"":""The Support group is no longer active, so incidents on the CI reach nobody."",""cardText"":""The Service Offering or Service Instance has a Support group, but the group is no longer active, so incidents on the CI reach nobody (procedure 2.5). A CI with no Support group at all is on the card Support group."",""family"":""support"",""dimension"":""correctness"",""severity"":""high"",""scope"":{""classes"":[""service_offering"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""op"":""groupInactive"",""field"":""support_group""}},""playbook"":{""path"":""service-request"",""audience"":[""managed_by"",""owned_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""message"":{""subject"":""Inactive Support group"",""intro"":""Their Support group is no longer active."",""ask"":""Please raise the request {request:support-group-update} and name an active group."",""askByClass"":{""service_offering"":""Please raise the request {request:modify-service-offering} and name an active group.""},""why"":""Without an active Support group, incidents on these CIs are not assigned to a team.""}}}},{""path"":""checks/packs/ci/support-group-missing.json"",""folder"":""ci"",""pack"":{""id"":""SUPPORT-GROUP-MISSING"",""status"":""live"",""title"":""Service Offering or Service Instance has no support group"",""cardLabel"":""Support group"",""cardHint"":""A Service Offering or Service Instance has no Support group, so incidents on it reach nobody."",""family"":""support"",""dimension"":""completeness"",""severity"":""high"",""scope"":{""classes"":[""service_offering"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""op"":""isEmpty"",""field"":""support_group""}},""playbook"":{""path"":""service-request"",""audience"":[""managed_by"",""owned_by"",""supported_by"",""managerOf(owned_by)""],""message"":{""subject"":""No Support group"",""intro"":""These CIs have no Support group."",""ask"":""Please raise the request {request:support-group-update}. If the group does not exist yet, there is a request to create it."",""askByClass"":{""service_offering"":""Please raise the request {request:modify-service-offering}. If the group does not exist yet, there is a request to create it.""},""why"":""Without an active Support group, incidents on these CIs are not assigned to a team.""}}}},{""path"":""checks/packs/ci/supported-by.json"",""folder"":""ci"",""pack"":{""id"":""SUPPORTED-BY"",""status"":""live"",""title"":""Supported by is empty or an inactive user"",""cardLabel"":""Supported by"",""cardHint"":""Supported by is empty, or names a person who is no longer active. The owner or manager names the person."",""cardText"":""Supported by is important, but it comes after Owned by and Managed by. On a Service Instance the owner fills it in EPO (Secondary Responsible). On a Service Offering the owner or manager replies, or raises the request to modify the offering. Only these two classes are checked."",""family"":""responsibility"",""dimension"":""completeness"",""severity"":""medium"",""priority"":""later"",""scope"":{""classes"":[""service_offering"",""service_instance""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""forEach"":[""supported_by""],""when"":{""any"":[{""op"":""isEmpty""},{""op"":""refInactive""}]}},""playbook"":{""path"":""service-request"",""audience"":[""managed_by"",""owned_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""routeBy"":""epo"",""message"":{""subject"":""Supported by to fill"",""intro"":""The role Supported by is empty, or names a person who is no longer active."",""ask"":""Could you tell us who it should be? Please {reply}, and we will update ServiceNow for you."",""why"":""The support person is the second contact for incidents on these CIs."",""askByClass"":{""service_offering"":""Could you tell us who it should be? You can {reply}, or raise the request {request:modify-service-offering}.""}}}}},{""path"":""checks/packs/ci/tag-invalid.json"",""folder"":""ci"",""pack"":{""id"":""TAG-INVALID"",""status"":""off"",""title"":""Tag key or value is not allowed"",""cardLabel"":""Tag not allowed"",""family"":""tags"",""dimension"":""compliance"",""severity"":""low"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""op"":""tagsNotIn"",""ref"":""reference/allowed-tags"",""field"":""tags""}},""playbook"":{""path"":""self-fix"",""audience"":[""managed_by"",""managerOf(owned_by)""],""message"":{""subject"":""Tag not allowed"",""intro"":""These CIs carry a tag that is not in the agreed list."",""ask"":""Could you tell us the right tag for each CI, or confirm that we can remove it?"",""why"":""Reports and rules read the tags, so only the agreed tags can be used.""}}}},{""path"":""checks/packs/ci/tag-missing.json"",""folder"":""ci"",""pack"":{""id"":""TAG-MISSING"",""status"":""proposed"",""title"":""Mandatory tag is missing"",""cardLabel"":""Tag missing"",""cardHint"":""A tag the class must carry is missing (a process: customer facing or internal). SACM sets it, and asks Process Management when it cannot tell."",""family"":""tags"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_application"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""op"":""missingTags"",""ref"":""reference/mandatory-tags"",""field"":""tags""}},""playbook"":{""path"":""sacm-fix"",""audience"":[""managed_by"",""owned_by"",""managerOf(owned_by)""],""askWhenUnsure"":""Cannot tell which type: ask Process Management"",""message"":{""subject"":""Missing tag"",""intro"":""A mandatory tag is missing on these CIs."",""ask"":""Could you tell us the right value for each CI? We will update ServiceNow for you."",""why"":""The mandatory tags say what kind of CI it is. Reports and rules depend on them."",""askByTeam"":{""process-management"":""Is each process customer facing or internal? Please {reply}, and we will set the tag in ServiceNow.""}}}}},{""path"":""checks/packs/ci/tag-status-conflict.json"",""folder"":""ci"",""pack"":{""id"":""TAG-STATUS-CONFLICT"",""status"":""proposed"",""title"":""Tagged To be deleted, but still Operational"",""cardLabel"":""Deleted but operational"",""cardHint"":""The CI is tagged To be deleted and is still Operational. The owner gives the planned retirement date."",""cardText"":""The CI is tagged To be deleted and is still Operational. Some are kept on purpose, for example to keep their data for some years. The owner is asked for the planned retirement date. Write it on the case (Planned retirement date): the CI then waits until that date. Business Applications are not on this card: they are decided in the mapping of their system."",""family"":""tags"",""dimension"":""compliance"",""severity"":""medium"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""rule"",""when"":{""all"":[{""op"":""tagMatchesAny"",""field"":""tags"",""value"":[""to be deleted""]},{""op"":""equals"",""field"":""operational_status"",""value"":""Operational""}]}},""playbook"":{""path"":""self-fix"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)""],""routeBy"":""epo"",""retirementDate"":true,""message"":{""subject"":""Tagged for deletion but still Operational"",""intro"":""These CIs are tagged To be deleted, but they are still Operational."",""ask"":""When will they be retired? Please reply with the planned retirement date of each CI. It is fine to keep a CI for some years, for example to keep its data: we only need the date."",""why"":""A CI tagged To be deleted needs a planned date: on that date it is retired, so it no longer receives incidents or changes."",""epoAsk"":""When will they be retired? Please reply with the planned retirement date of each CI, and retire them in EPO on that date. It is fine to keep a CI for some years, for example to keep its data: we only need the date.""}}}},{""path"":""checks/packs/lifecycle/under-retirement-long.json"",""folder"":""lifecycle"",""pack"":{""id"":""UNDER-RETIREMENT-LONG"",""status"":""proposed"",""title"":""CI is Under retirement for too long"",""cardLabel"":""Under retirement too long"",""cardHint"":""The CI has been Under retirement for months without a change. The owner says if and when it is retired."",""cardText"":""The CI is in status Under retirement and its record did not change for more than the number of days in Settings (90 at first). The owner is asked if it is still going to be retired, and when. Write the date the owner gives on the case (Planned retirement date): the CI then waits until that date. Clarify it when there is time. Business Applications are not on this card: they follow their Service Instance."",""family"":""lifecycle"",""dimension"":""compliance"",""severity"":""medium"",""priority"":""later"",""scope"":{""classes"":[""business_capability"",""business_process"",""business_service"",""service_offering"",""service_instance"",""api"",""application"",""technology_management_service""],""exclude"":{""operational_status"":[""retired""]}},""detector"":{""type"":""code"",""module"":""ci/status-age"",""ref"":""reference/lifecycle"",""rules"":[""under-retirement""]},""playbook"":{""path"":""email"",""audience"":[""owned_by"",""managed_by"",""managerOf(owned_by)"",""departmentHeadOf(owned_by)""],""retirementDate"":true,""message"":{""subject"":""Under retirement for a long time"",""intro"":""They are in status Under retirement, and nothing changed on them for a long time."",""ask"":""Is this CI still going to be retired, and when? Please {reply}. If it is no longer in use, please retire it."",""askByClass"":{""service_instance"":""Is this system still going to be retired, and when? Please {reply}. If it is no longer in use, please retire it in EPO.""},""why"":""A CI that stays Under retirement keeps its relationships and its criticality, and nobody knows if it is still used."",""askByTeam"":{""process-management"":""Is this process still going to be retired, and when? Please {reply}. If it is no longer in use, we will retire it in ServiceNow.""}}}}}]"
	queryGroup: Packed

