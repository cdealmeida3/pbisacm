/// One line per case of the newest report (D292): its status, how it is listed, who has it, the messages and replies, the decision to stop following it. From the journal and the replies of the team.
table CaseLines

	/// Every case of the newest report.
	measure Cases = COUNTROWS ( CaseLines ) + 0
		formatString: #,0

	/// The cases that are not closed (not Verified, not Not followed up).
	measure 'Open cases' = CALCULATE ( COUNTROWS ( CaseLines ), NOT CaseLines[Status] IN { "Verified", "Not followed up" } ) + 0
		formatString: #,0

	/// Cases on a daily card that were asked, did not answer, and whose working days to the reminder have passed (D39, D182); counted from Today, so right between two refreshes.
	measure 'Reminders due' =
			VAR asOf = [Today]
			RETURN CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Remind] = "reminder", CaseLines[ReminderFrom] <= asOf, KEEPFILTERS ( Checks[Priority] <> "later" ) ) + 0
		formatString: #,0

	/// Cases on a daily card that got every reminder and still no answer (D40).
	measure 'To escalate' =
			VAR asOf = [Today]
			RETURN CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Remind] = "escalation", CaseLines[ReminderFrom] <= asOf, KEEPFILTERS ( Checks[Priority] <> "later" ) ) + 0
		formatString: #,0

	/// The open cases assigned to the manager who opens the report (the measure Me).
	measure Mine =
			VAR me = [Me]
			RETURN CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[AssignedTo] = me, NOT CaseLines[Status] IN { "Verified", "Not followed up" } ) + 0
		formatString: #,0

	/// On a line of the box Reminders due: its CIs with a reminder due; blank hides the line.
	measure 'Reminder mark' =
			VAR asOf = [Today]
			VAR n = CALCULATE ( DISTINCTCOUNT ( CaseLines[CiKey] ), CaseLines[Remind] = "reminder", CaseLines[ReminderFrom] <= asOf, KEEPFILTERS ( Checks[Priority] <> "later" ) )
			RETURN IF ( n > 0, n )
		formatString: #,0

	/// On a line of the box To escalate: its CIs to escalate; blank hides the line.
	measure 'Escalation mark' =
			VAR asOf = [Today]
			VAR n = CALCULATE ( DISTINCTCOUNT ( CaseLines[CiKey] ), CaseLines[Remind] = "escalation", CaseLines[ReminderFrom] <= asOf, KEEPFILTERS ( Checks[Priority] <> "later" ) )
			RETURN IF ( n > 0, n )
		formatString: #,0

	/// On a line of My work: the open CIs assigned to me; blank hides the line.
	measure 'My CIs' =
			VAR me = [Me]
			VAR n = CALCULATE ( DISTINCTCOUNT ( CaseLines[CiKey] ), CaseLines[AssignedTo] = me, NOT CaseLines[Status] IN { "Verified", "Not followed up" } )
			RETURN IF ( n > 0, n )
		formatString: #,0

	/// The memory of a line: "Asked 3 times · last 4 Nov · no reply", or "Not asked yet" (D226); blank with no case, so a table shows no line that has none.
	measure 'Follow-up' =
			VAR n = MAX ( CaseLines[Messages] )
			VAR answered = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Status] = "Answered" )
			RETURN
			    SWITCH (
			        TRUE (),
			        COUNTROWS ( CaseLines ) = 0,
			        BLANK (),
			        n = 0,
			        "Not asked yet",
			        "Asked " & n & IF ( n = 1, " time", " times" ) & " · last " & FORMAT ( MAX ( CaseLines[SentOn] ), "d mmm" ) & IF ( answered > 0, " · answered", " · no reply" )
			    )

	/// The next step of a line of My work, as the group on the card says it: Reply, Escalate, Remind, Wait for the answer, Email. The button comes with build B7.
	measure 'Next step' =
			VAR asOf = [Today]
			VAR answered = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Status] = "Answered" )
			VAR escalate = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Remind] = "escalation", CaseLines[ReminderFrom] <= asOf )
			VAR remind = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Remind] = "reminder", CaseLines[ReminderFrom] <= asOf )
			VAR asked = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Status] = "Contacted" )
			VAR fresh = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[Status] = "New" )
			RETURN
			    IF ( answered > 0, "Reply", IF ( escalate > 0, "Escalate", IF ( remind > 0, "Remind", IF ( asked > 0, "Wait for the answer", IF ( fresh > 0, "Email" ) ) ) ) )

	/// On a line of Findings (the Card, Case and Person pages): the status of its case, as the pages say it (New, Asked, Answered, Marked fixed, …).
	measure 'Line status' = CALCULATE ( SELECTEDVALUE ( CaseLines[StatusLabel] ), TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ) )

	/// On a line of Findings: the memory of its case ("Asked 2 times · last 4 Nov · no reply", or "Not asked yet").
	measure 'Line follow-up' = CALCULATE ( [Follow-up], TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ) )

	/// On a line of Findings: who has its case (assigned or handed over), and who marked it fixed and when.
	measure 'Line who' =
			VAR keys = VALUES ( Findings[Key] )
			VAR assigned = CALCULATE ( SELECTEDVALUE ( CaseLines[AssignedTo] ), TREATAS ( keys, CaseLines[Key] ) )
			VAR fixedBy = CALCULATE ( SELECTEDVALUE ( CaseLines[FixedBy] ), TREATAS ( keys, CaseLines[Key] ) )
			VAR fixedOn = CALCULATE ( MAX ( CaseLines[FixedOn] ), TREATAS ( keys, CaseLines[Key] ) )
			VAR fixedText = IF ( fixedBy <> "", "Marked fixed by " & fixedBy & " on " & FORMAT ( fixedOn, "d mmm" ) )
			VAR who = assigned & IF ( assigned <> "" && fixedText <> "", " · " ) & fixedText
			RETURN IF ( who <> "", who )

	/// For the Power App visual (build B6): 1 on a line whose case is on the page (the drill through of the Card, Case and Person pages and the rows selected filter Findings), blank otherwise. Put it in the visual-level filter of the Power Apps visual as "is 1" (powerbi/README.md §6).
	measure 'For the app' =
			VAR shown = CALCULATE ( COUNTROWS ( Findings ), TREATAS ( VALUES ( CaseLines[Key] ), Findings[Key] ) )
			RETURN IF ( shown > 0, 1 )
		formatString: 0

	/// The first report date that showed the finding of a case.
	measure 'Case first seen' = CALCULATE ( MIN ( History[ReportDate] ), REMOVEFILTERS ( History ), TREATAS ( VALUES ( CaseLines[Key] ), History[Key] ) )
		formatString: d mmm yyyy

	/// Under the title of Reminders due (My day): the order, or why the box is empty.
	measure 'Reminders note' = IF ( [Reminders due] = 0, "Nobody to remind today.", "The oldest first: one line per person and card." )
		displayFolder: Page notes

	/// Under the title of To escalate (My day): what it means, or why the box is empty.
	measure 'Escalations note' = IF ( [To escalate] = 0, "Nobody to escalate today.", "Every reminder went out and no answer came: write to their manager." )
		displayFolder: Page notes

	/// Under the title of Assigned to me (My work): whose work it is, or why the box is empty.
	measure 'Assigned note' = IF ( NOT ISBLANK ( [Me] ) && [Mine] = 0, "Nothing is assigned to " & [Me] & ". Free lines are on the Card pages.", [My work line] )
		displayFolder: Page notes

	/// Under the title of Cases not followed up (Not followed): what to do, or why the box is empty.
	measure 'Not followed note' = IF ( COUNTROWS ( CaseLines ) + 0 = 0, "No case is set aside: the team follows every case.", "Select lines, then Follow again in the app." )
		displayFolder: Page notes

	/// The next step with the person of a line of the Work queue (the same steps as Person state, from the lines in view, every card, not only the daily ones): 1 a reply to read, 2 to escalate, 3 a reminder due, 4 new to ask, 5 asked, 6 marked fixed. The status chosen above the table keeps its lines only.
	measure 'Queue state' =
			VAR asOf = [Today]
			VAR answered = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( CaseLines[Status] = "Answered" ) )
			VAR escalation = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( CaseLines[Remind] = "escalation" ), KEEPFILTERS ( CaseLines[ReminderFrom] <= asOf ) )
			VAR reminder = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( CaseLines[Remind] = "reminder" ), KEEPFILTERS ( CaseLines[ReminderFrom] <= asOf ) )
			VAR fresh = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( CaseLines[Status] = "New" ), KEEPFILTERS ( CaseLines[State] = "open" ) )
			VAR asked = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( CaseLines[Status] = "Contacted" ) )
			VAR marked = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( CaseLines[Status] IN { "Fix in progress", "Fixed" } ) )
			RETURN
			    SWITCH ( TRUE (), answered > 0, 1, escalation > 0, 2, reminder > 0, 3, fresh > 0, 4, asked > 0, 5, marked > 0, 6 )
		formatString: 0
		displayFolder: Work queue

	/// On a line of the Work queue: the open lines with the person (not Verified, not Not followed up) in the status chosen; blank hides the line.
	measure 'Queue lines' =
			VAR n = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( NOT CaseLines[Status] IN { "Verified", "Not followed up" } ) )
			RETURN IF ( n > 0, n )
		formatString: #,0
		displayFolder: Work queue

	/// On a line of the Work queue: why the team asks the person and where the email goes ("Owned by · dee@example.com").
	measure 'Queue why' =
			VAR keys = VALUES ( CaseLines[Key] )
			VAR via = CALCULATE ( MAX ( Findings[ContactVia] ), TREATAS ( keys, Findings[Key] ) )
			VAR address = CALCULATE ( MAX ( Findings[ContactEmail] ), TREATAS ( keys, Findings[Key] ) )
			VAR said = UPPER ( LEFT ( via, 1 ) ) & MID ( via, 2, 200 )
			RETURN IF ( via <> "" || address <> "", said & IF ( via <> "" && address <> "", " · " ) & address )
		displayFolder: Work queue

	/// On a line of the Work queue: the cards of the open lines with the person, three at most.
	measure 'Queue cards' =
			VAR lines = CALCULATETABLE ( CaseLines, KEEPFILTERS ( NOT CaseLines[Status] IN { "Verified", "Not followed up" } ) )
			VAR cards = DISTINCT ( SELECTCOLUMNS ( lines, "@card", RELATED ( Checks[CardLabel] ) ) )
			VAR cardCount = COUNTROWS ( cards )
			RETURN IF ( cardCount > 0, CONCATENATEX ( TOPN ( 3, cards, [@card], ASC ), [@card], ", ", [@card], ASC ) & IF ( cardCount > 3, " and " & ( cardCount - 3 ) & " more" ) )
		displayFolder: Work queue

	/// On a line of the Work queue: the day of the last message to the person, or never.
	measure 'Queue asked' =
			VAR lastSent = MAX ( CaseLines[SentOn] )
			RETURN IF ( ISBLANK ( lastSent ), "never", FORMAT ( lastSent, "d mmm" ) )
		displayFolder: Work queue

	/// On a line of the Work queue: who in the team has the open lines with the person, or free.
	measure 'Queue has it' =
			VAR lines = CALCULATETABLE ( CaseLines, KEEPFILTERS ( NOT CaseLines[Status] IN { "Verified", "Not followed up" } ), KEEPFILTERS ( CaseLines[AssignedTo] <> "" ) )
			VAR names = DISTINCT ( SELECTCOLUMNS ( lines, "@name", CaseLines[AssignedTo] ) )
			RETURN IF ( COUNTROWS ( names ) > 0, CONCATENATEX ( names, [@name], ", ", [@name], ASC ), "free" )
		displayFolder: Work queue

	/// The people with open lines in the status chosen (Work queue).
	measure 'Queue people' =
			COUNTROWS ( FILTER ( VALUES ( CaseLines[ContactName] ), CaseLines[ContactName] <> "" && NOT ISBLANK ( [Queue lines] ) ) ) + 0
		formatString: #,0
		displayFolder: Work queue

	/// Under the title of the people to ask (Work queue): how many lines with how many people, or why the box is empty.
	measure 'Queue note' =
			VAR people = [Queue people]
			VAR open = CALCULATE ( COUNTROWS ( CaseLines ), KEEPFILTERS ( NOT CaseLines[Status] IN { "Verified", "Not followed up" } ), KEEPFILTERS ( CaseLines[ContactName] <> "" ) ) + 0
			RETURN
			    IF (
			        people = 0,
			        "Nobody to ask in the status chosen: choose another status, or none.",
			        open & IF ( open = 1, " open line", " open lines" ) & " with " & people & IF ( people = 1, " person", " people" ) & ", in the order of the team's rules. Select lines for the app at the right."
			    )
		displayFolder: Page notes

	column Key
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Key]

	column CheckId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CheckId]

	column CiKey
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CiKey]

	column CiName
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CiName]

	column ClassLabel
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ClassLabel]

	column Field
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Field]

	column ContactName
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ContactName]

	column InLatest
		dataType: boolean
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [InLatest]

	column Untested
		dataType: boolean
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Untested]

	column CiMissing
		dataType: boolean
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [CiMissing]

	column State
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [State]

	column StateLabel
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [StateLabel]

	column Status
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Status]

	column StatusLabel
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [StatusLabel]

	column AssignedTo
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [AssignedTo]

	column HandoverNote
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [HandoverNote]

	column Request
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Request]

	column Messages
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Messages]

	column SentOn
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [SentOn]

	column LastMessageTo
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [LastMessageTo]

	column LastRef
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [LastRef]

	column ReminderFrom
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [ReminderFrom]

	column Remind
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Remind]

	column Replies
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Replies]

	column LastReplyOn
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [LastReplyOn]

	column ExceptionReason
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ExceptionReason]

	column ReviewOn
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [ReviewOn]

	column ExceptionEnded
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [ExceptionEnded]

	column RetireOn
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [RetireOn]

	column VerifiedOn
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [VerifiedOn]

	/// Who marked the case fixed, when its status is Fixed (the name, else the email of the journal event).
	column FixedBy
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [FixedBy]

	/// The day the case was marked fixed, when its status is Fixed.
	column FixedOn
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [FixedOn]

	column Events
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Events]

	/// Who the case is about: the user ID of the person asked, else the email in lower case ("" for a case the newest report no longer shows). The Power App writes it on a note about the person.
	column Person
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Person]

	/// What the Power App offers on the case (build B6, D294): "id=Label|id=Label", in the order of powerbi/apps/actions.json. The app offers an action when every selected line has it.
	column Actions
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Actions]

	/// The labels of Actions, as the Case page shows them: "Note · Status · Assign".
	column ActionWords
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ActionWords]

	/// For a case of the mapping backlog: the stages of its class, "id=Label|id=Label" (the Power App offers them); "" otherwise.
	column Stages
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Stages]

	/// For a case of the mapping backlog: the id of its stage (the last one a manager set, else the first of its class).
	column StageId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [StageId]

	/// Share out (build B7, D24): the manager this line goes to when its card is shared out (a free group, the biggest first, to who has least); "" when its group is taken or there are fewer than two managers.
	column ShareTo
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ShareTo]

	partition CaseLines = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "CaseLines" ),
					"Key", Run[CaseLines.Key],
					"CheckId", Run[CaseLines.CheckId],
					"CiKey", Run[CaseLines.CiKey],
					"CiName", Run[CaseLines.CiName],
					"ClassLabel", Run[CaseLines.ClassLabel],
					"Field", Run[CaseLines.Field],
					"ContactName", Run[CaseLines.ContactName],
					"InLatest", Run[CaseLines.InLatest],
					"Untested", Run[CaseLines.Untested],
					"CiMissing", Run[CaseLines.CiMissing],
					"State", Run[CaseLines.State],
					"StateLabel", Run[CaseLines.StateLabel],
					"Status", Run[CaseLines.Status],
					"StatusLabel", Run[CaseLines.StatusLabel],
					"AssignedTo", Run[CaseLines.AssignedTo],
					"HandoverNote", Run[CaseLines.HandoverNote],
					"Request", Run[CaseLines.Request],
					"Messages", Run[CaseLines.Messages],
					"SentOn", Run[CaseLines.SentOn],
					"LastMessageTo", Run[CaseLines.LastMessageTo],
					"LastRef", Run[CaseLines.LastRef],
					"ReminderFrom", Run[CaseLines.ReminderFrom],
					"Remind", Run[CaseLines.Remind],
					"Replies", Run[CaseLines.Replies],
					"LastReplyOn", Run[CaseLines.LastReplyOn],
					"ExceptionReason", Run[CaseLines.ExceptionReason],
					"ReviewOn", Run[CaseLines.ReviewOn],
					"ExceptionEnded", Run[CaseLines.ExceptionEnded],
					"RetireOn", Run[CaseLines.RetireOn],
					"VerifiedOn", Run[CaseLines.VerifiedOn],
					"FixedBy", Run[CaseLines.FixedBy],
					"FixedOn", Run[CaseLines.FixedOn],
					"Events", Run[CaseLines.Events],
					"Person", Run[CaseLines.Person],
					"Actions", Run[CaseLines.Actions],
					"ActionWords", Run[CaseLines.ActionWords],
					"Stages", Run[CaseLines.Stages],
					"StageId", Run[CaseLines.StageId],
					"ShareTo", Run[CaseLines.ShareTo]
				)
