/// The grey lines of the Cards page for the classes that are not checked yet (reference/parked-classes, D179).
table Parked

	column Line
		dataType: string
		isDataTypeInferred
		sortByColumn: Order
		isNameInferred
		sourceColumn: [Line]

	column Order
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order]

	partition Parked = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "Parked" ),
					"Line", Run[Parked.Line],
					"Order", Run[Parked.Order]
				)
