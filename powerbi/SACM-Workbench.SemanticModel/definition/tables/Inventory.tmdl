		dataType: boolean
		sourceColumn: AssignedToActive

	column AssignedToManager
		dataType: string
		sourceColumn: AssignedToManager

	column AssignedToManagerEmail
		dataType: string
		sourceColumn: AssignedToManagerEmail

	column AssignedToManagerActive
		dataType: boolean
		sourceColumn: AssignedToManagerActive

	column AssignedToManagerUserId
		dataType: string
		sourceColumn: AssignedToManagerUserId

	column AssignedToDepartmentHead
		dataType: string
		sourceColumn: AssignedToDepartmentHead

	column AssignedToDepartmentHeadEmail
		dataType: string
		sourceColumn: AssignedToDepartmentHeadEmail

	column AssignedToDepartmentHeadUserId
		dataType: string
		sourceColumn: AssignedToDepartmentHeadUserId

	column TargetConfidentiality
		dataType: int64
		summarizeBy: none
		sourceColumn: TargetConfidentiality

	column TargetIntegrity
		dataType: int64
		summarizeBy: none
		sourceColumn: TargetIntegrity

	column TargetAvailability
		dataType: int64
		summarizeBy: none
		sourceColumn: TargetAvailability

	column TargetAuthenticity
		dataType: int64
		summarizeBy: none
		sourceColumn: TargetAuthenticity

	column InheritedConfidentiality
		dataType: int64
		summarizeBy: none
		sourceColumn: InheritedConfidentiality

	column InheritedIntegrity
		dataType: int64
		summarizeBy: none
		sourceColumn: InheritedIntegrity

	column InheritedAvailability
		dataType: int64
		summarizeBy: none
		sourceColumn: InheritedAvailability

	column InheritedAuthenticity
		dataType: int64
		summarizeBy: none
		sourceColumn: InheritedAuthenticity

	column NameSpaces
		dataType: boolean
		sourceColumn: NameSpaces

	partition Inventory = m
		mode: import
		source = InventoryRows
