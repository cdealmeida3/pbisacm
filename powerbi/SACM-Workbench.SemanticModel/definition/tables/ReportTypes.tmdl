/// One row per report type, with its newest file (the Reports page).
table ReportTypes

	/// Days since the newest report of the type, counted from Today.
	measure 'Report age' =
			VAR newest = MAX ( ReportTypes[NewestDate] )
			RETURN IF ( ISBLANK ( newest ), BLANK (), DATEDIFF ( newest, [Today], DAY ) )
		formatString: 0

	/// The Reports line under the title of My day (src/app/view/tiles.ts, reportsLine): "5 reports · 11 Nov · fresh", or how many are loaded and which are missing, and a warning for each report that is too old.
	measure 'Reports line' =
			VAR asOf = [Today]
			VAR types = ALL ( ReportTypes )
			VAR total = COUNTROWS ( types )
			VAR loaded = COUNTROWS ( FILTER ( types, NOT ISBLANK ( ReportTypes[NewestDate] ) ) )
			VAR newest = MAXX ( types, ReportTypes[NewestDate] )
			VAR missing = CONCATENATEX ( FILTER ( types, ISBLANK ( ReportTypes[NewestDate] ) ), ReportTypes[Label], ", ", ReportTypes[Order], ASC )
			VAR stale = FILTER ( types, NOT ISBLANK ( ReportTypes[NewestDate] ) && DATEDIFF ( ReportTypes[NewestDate], asOf, DAY ) > ReportTypes[StaleAfter] )
			VAR old = CONCATENATEX ( stale, "the " & ReportTypes[Label] & " is " & DATEDIFF ( ReportTypes[NewestDate], asOf, DAY ) & " days old", ", ", ReportTypes[Order], ASC )
			VAR head = IF ( missing <> "", loaded & " of " & total & " reports", loaded & IF ( loaded = 1, " report", " reports" ) )
			VAR dayText = IF ( NOT ISBLANK ( newest ), " · " & FORMAT ( newest, "d mmm" ) )
			VAR tail = IF ( missing <> "", " · not loaded: " & missing, IF ( old = "", " · fresh" ) )
			VAR warning = IF ( old <> "", ". " & UPPER ( LEFT ( old, 1 ) ) & MID ( old, 2, 500 ) & ". Load a newer one before you write to people." )
			RETURN "Reports: " & head & dayText & tail & warning

	/// Missing, Old (older than its days, D14) or Up to date.
	measure 'Report state' =
			VAR newest = MAX ( ReportTypes[NewestDate] )
			RETURN
			    IF (
			        HASONEVALUE ( ReportTypes[Kind] ),
			        IF ( ISBLANK ( newest ), "Missing", IF ( [Report age] > MAX ( ReportTypes[StaleAfter] ), "Old", "Up to date" ) )
			    )

	/// How many rows the reader read from the newest file of the type: the Rows of that file in ReportFiles, so the file is read once (build B8, D307).
	measure 'Newest rows' =
			VAR file = SELECTEDVALUE ( ReportTypes[NewestFile] )
			RETURN IF ( NOT ISBLANK ( file ), LOOKUPVALUE ( ReportFiles[Rows], ReportFiles[FileName], file ) )
		formatString: #,0

	/// The text colour of the state (LOOK.md: red a problem, amber a warning, green OK).
	measure 'Report state colour' = SWITCH ( [Report state], "Missing", "#b42318", "Old", "#7d5700", "Up to date", "#067647" )

	/// The soft background of the state.
	measure 'Report state fill' = SWITCH ( [Report state], "Missing", "#fef3f2", "Old", "#fffaeb", "Up to date", "#ecfdf3" )

	column Kind
		dataType: string
		sourceColumn: Kind

	column Label
		dataType: string
		sortByColumn: Order
		sourceColumn: Label

	column Hint
		dataType: string
		sourceColumn: Hint

	column Order
		dataType: int64
		summarizeBy: none
		sourceColumn: Order

	column StaleAfter
		dataType: int64
		summarizeBy: none
		sourceColumn: StaleAfter

	column Files
		dataType: int64
		summarizeBy: none
		sourceColumn: Files

	column NewestFile
		dataType: string
		sourceColumn: NewestFile

	column NewestDate
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: NewestDate

	partition ReportTypes = m
		mode: import
		source = ReportTypesRows
