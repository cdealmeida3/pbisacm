/// One row per report type, with its newest file (the Reports page).
table ReportTypes

	/// Days since the newest report of the type, counted from Today.
	measure 'Report age' =
			VAR newest = MAX ( ReportTypes[NewestDate] )
			RETURN IF ( ISBLANK ( newest ), BLANK (), DATEDIFF ( newest, [Today], DAY ) )
		formatString: 0

	/// The Reports line under the title of My day (src/app/view/tiles.ts, reportsLine): "5 reports · 11 Nov · fresh", or how many are loaded and which are missing, and a warning for each report that is too old.
	measure 'Reports line' =
			VAR asOf = [Today]
			VAR types = ALL ( ReportTypes )
			VAR total = COUNTROWS ( types )
			VAR loaded = COUNTROWS ( FILTER ( types, NOT ISBLANK ( ReportTypes[NewestDate] ) ) )
			VAR newest = MAXX ( types, ReportTypes[NewestDate] )
			VAR missing = CONCATENATEX ( FILTER ( types, ISBLANK ( ReportTypes[NewestDate] ) ), ReportTypes[Label], ", ", ReportTypes[Order], ASC )
			VAR stale = FILTER ( types, NOT ISBLANK ( ReportTypes[NewestDate] ) && DATEDIFF ( ReportTypes[NewestDate], asOf, DAY ) > ReportTypes[StaleAfter] )
			VAR old = CONCATENATEX ( stale, "the " & ReportTypes[Label] & " is " & DATEDIFF ( ReportTypes[NewestDate], asOf, DAY ) & " days old", ", ", ReportTypes[Order], ASC )
			VAR head = IF ( missing <> "", loaded & " of " & total & " reports", loaded & IF ( loaded = 1, " report", " reports" ) )
			VAR dayText = IF ( NOT ISBLANK ( newest ), " · " & FORMAT ( newest, "d mmm" ) )
			VAR tail = IF ( missing <> "", " · not loaded: " & missing, IF ( old = "", " · fresh" ) )
			VAR warning = IF ( old <> "", ". " & UPPER ( LEFT ( old, 1 ) ) & MID ( old, 2, 500 ) & ". Load a newer one before you write to people." )
			RETURN "Reports: " & head & dayText & tail & warning

	/// Missing, Old (older than its days, D14) or Up to date.
	measure 'Report state' =
			VAR newest = MAX ( ReportTypes[NewestDate] )
			RETURN
			    IF (
			        HASONEVALUE ( ReportTypes[Kind] ),
			        IF ( ISBLANK ( newest ), "Missing", IF ( [Report age] > MAX ( ReportTypes[StaleAfter] ), "Old", "Up to date" ) )
			    )

	/// How many rows the reader read from the newest file of the type: the Rows of that file in ReportFiles, so the file is read once (build B8, D307).
	measure 'Newest rows' =
			VAR file = SELECTEDVALUE ( ReportTypes[NewestFile] )
			RETURN IF ( NOT ISBLANK ( file ), LOOKUPVALUE ( ReportFiles[Rows], ReportFiles[FileName], file ) )
		formatString: #,0

	/// The text colour of the state (LOOK.md: red a problem, amber a warning, green OK).
	measure 'Report state colour' = SWITCH ( [Report state], "Missing", "#b42318", "Old", "#7d5700", "Up to date", "#067647" )

	/// The soft background of the state.
	measure 'Report state fill' = SWITCH ( [Report state], "Missing", "#fef3f2", "Old", "#fffaeb", "Up to date", "#ecfdf3" )

	/// Under the title of the report types (Reports).
	measure 'Report types note' = [Reports line]
		displayFolder: Page notes

	/// The chip at the top right of My day: the Reports line with a tick when every report is there and fresh, a ! otherwise.
	measure 'Reports chip' =
			VAR words = SUBSTITUTE ( [Reports line], "Reports: ", "" )
			VAR fine = RIGHT ( words, 8 ) = " · fresh"
			VAR cut = SEARCH ( ". ", words, 1, 0 )
			VAR short = IF ( cut > 0, LEFT ( words, cut - 1 ) & " · one is too old", words )
			RETURN IF ( fine, "✓ " & SUBSTITUTE ( words, " · fresh", " · up to date" ), "! " & short )
		displayFolder: My day

	/// The colour of the words of the Reports chip: green when every report is fresh, amber otherwise.
	measure 'Reports colour' =
			IF ( LEFT ( [Reports chip], 1 ) = "!", "#7d5700", "#067647" )
		displayFolder: My day

	/// The fill of the Reports chip: soft green when every report is fresh, soft amber otherwise.
	measure 'Reports fill' =
			IF ( LEFT ( [Reports chip], 1 ) = "!", "#fffaeb", "#ecfdf3" )
		displayFolder: My day

	/// The reports of Overview as chips: each type with a tick when its newest file is up to date, an alert when it is old or missing, in its colour (green, amber, red). The chips flow over two lines of 300 × 56.
	measure 'Reports tile' =
			VAR asOf = [Today]
			VAR chips =
			    ADDCOLUMNS (
			        ALL ( ReportTypes[Kind], ReportTypes[Label], ReportTypes[Order], ReportTypes[NewestDate], ReportTypes[StaleAfter] ),
			        "@word", IF ( ReportTypes[Kind] = "contract", "Contracts", LEFT ( ReportTypes[Label], SEARCH ( " ", ReportTypes[Label] & " ", 1, 0 ) - 1 ) ),
			        "@kind", IF ( ISBLANK ( ReportTypes[NewestDate] ), 3, IF ( DATEDIFF ( ReportTypes[NewestDate], asOf, DAY ) > ReportTypes[StaleAfter], 2, 1 ) )
			    )
			VAR sized = ADDCOLUMNS ( chips, "@w", LEN ( [@word] ) * 7 + 30 )
			VAR placed = ADDCOLUMNS ( sized, "@start", VAR orderAt = ReportTypes[Order] RETURN SUMX ( FILTER ( sized, ReportTypes[Order] < orderAt ), [@w] + 6 ) + 0 )
			VAR lined = ADDCOLUMNS ( placed, "@line", IF ( [@start] + [@w] > 300, 1, 0 ) )
			VAR shift = MINX ( FILTER ( lined, [@line] = 1 ), [@start] ) + 0
			VAR drawn =
			    CONCATENATEX (
			        lined,
			        VAR x = [@start] - IF ( [@line] = 1, shift, 0 )
			        VAR y = 2 + [@line] * 28
			        VAR ink = SWITCH ( [@kind], 1, "#067647", 2, "#7d5700", "#b42318" )
			        VAR paper = SWITCH ( [@kind], 1, "#ecfdf3", 2, "#fffaeb", "#fef3f2" )
			        VAR mark = IF ( [@kind] = 1, "<path d='M" & x + 9 & " " & y + 12 & "l3 3 6-6' fill='none' stroke='" & ink & "' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/>", "<path d='M" & x + 12 & " " & y + 6 & "v6M" & x + 12 & " " & y + 16 & "v.5' stroke='" & ink & "' stroke-width='2' stroke-linecap='round'/>" )
			        RETURN
			            "<rect x='" & x & "' y='" & y & "' width='" & [@w] & "' height='22' rx='11' fill='" & paper & "'/>" & mark
			                & "<text x='" & x + 22 & "' y='" & y + 15.5 & "' font-family='Segoe UI, sans-serif' font-size='12' font-weight='600' fill='" & ink & "'>" & [@word] & "</text>",
			        "",
			        ReportTypes[Order], ASC
			    )
			VAR picture = "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='56' viewBox='0 0 300 56'>" & drawn & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// The words of the reports chip at the top right of every page, without its mark: under the chips of Overview.
	measure 'Reports tile line' = MID ( [Reports chip], 3, 500 )
		displayFolder: Overview

	column Kind
		dataType: string
		sourceColumn: Kind

	column Label
		dataType: string
		sortByColumn: Order
		sourceColumn: Label

	column Hint
		dataType: string
		sourceColumn: Hint

	column Order
		dataType: int64
		summarizeBy: none
		sourceColumn: Order

	column StaleAfter
		dataType: int64
		summarizeBy: none
		sourceColumn: StaleAfter

	column Files
		dataType: int64
		summarizeBy: none
		sourceColumn: Files

	column NewestFile
		dataType: string
		sourceColumn: NewestFile

	column NewestDate
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: NewestDate

	partition ReportTypes = m
		mode: import
		source = ReportTypesRows
