/// One row per finding of the newest CI report: what was found, who is asked, how it is listed, where it is fixed (DATA-MODEL §3, a fact).
table Findings

	/// Findings to solve (listed as To solve).
	measure 'To solve' = CALCULATE ( COUNTROWS ( Findings ), Findings[State] = "open" ) + 0
		formatString: #,0

	/// Findings to check first (a review: never red).
	measure 'To check' = CALCULATE ( COUNTROWS ( Findings ), Findings[State] = "review" ) + 0
		formatString: #,0

	/// Findings that wait (a CI not live yet, or EPO already names another person).
	measure Waiting = CALCULATE ( COUNTROWS ( Findings ), Findings[State] = "waiting" ) + 0
		formatString: #,0

	/// Findings a tag of the team explains.
	measure Known = CALCULATE ( COUNTROWS ( Findings ), Findings[State] = "known" ) + 0
		formatString: #,0

	/// Distinct CIs of the findings in the filter.
	measure 'Finding CIs' = DISTINCTCOUNT ( Findings[CiKey] ) + 0
		formatString: #,0

	/// The state of one finding as a colour (LOOK.md): red to solve, blue to check, grey waiting or known.
	measure 'Finding colour' = SWITCH ( SELECTEDVALUE ( Findings[State] ), "open", "#b42318", "review", "#175cd3", "#475467" )

	/// Under the title of the lines of a card (Card): the order, or why the box is empty. Opened from its tab, the page says how to choose a card.
	measure 'Lines note' = SWITCH ( TRUE (), NOT HASONEVALUE ( Checks[CheckId] ), "No card chosen: on All cards, select a card, then Open card.", COUNTROWS ( Findings ) + 0 = 0, "No line: the newest report finds nothing on this card.", "Who is asked about which CI. Owned by, Managed by and Tags are in the export." )
		displayFolder: Page notes

	/// Under the title of the SACM fix list (Card): only a card SACM fixes itself has lines.
	measure 'Fix list note' = IF ( COUNTROWS ( Findings ) + 0 = 0, "No fix list: on this card the person asked fixes the CI.", "The change to make in ServiceNow, line by line." )
		displayFolder: Page notes

	/// Under the title of the lines by kind of problem (Card): only the contract cards have them.
	measure 'Problems note' = IF ( COUNTROWS ( Findings ) + 0 = 0, "No kinds of problem: only the contract cards have them.", "One table per kind in the email to Procurement." )
		displayFolder: Page notes

	/// Under the title of the export (Card): how to get the file.
	measure 'Export note' = IF ( COUNTROWS ( Findings ) + 0 = 0, "Nothing to export.", "The columns of the SACM template: More options, Export data." )
		displayFolder: Page notes

	/// Under the title of the CI (Case).
	measure 'CI note' = IF ( NOT ISFILTERED ( Findings[CiName] ), "No CI chosen: on a card or a person, select a line, then Open CI.", "As the newest CI report shows it." )
		displayFolder: Page notes

	/// Under the title of the problems of a CI (Case).
	measure 'Case problems note' = IF ( COUNTROWS ( Findings ) + 0 = 0, "No problem: the newest report finds nothing on this CI.", "Each problem of the newest report, its state and who is asked." )
		displayFolder: Page notes

	/// Under the title of the people of a CI (Case).
	measure 'People note' = IF ( COUNTROWS ( Findings ) + 0 = 0, "Nobody is asked about this CI.", "Who is asked, who is copied, and who gets an escalation." )
		displayFolder: Page notes

	/// Under the title of the person (Person). Opened from its tab, the page says how to choose a person.
	measure 'Person note' = IF ( NOT ISFILTERED ( Findings[ContactName] ), "No person chosen: on My day, People or Overview, select a name, then Open person.", "Who they are and why the team asks them." )
		displayFolder: Page notes

	/// Under the title of what is open with a person (Person).
	measure 'Open with note' = IF ( COUNTROWS ( Findings ) + 0 = 0, "Nothing is open with them.", "Everything one email to them covers." )
		displayFolder: Page notes

	/// The next step with the person in view (My day, Work queue, D2): 1 a reply to read (RepliesToRead, from their address), 2 to escalate, 3 a reminder due, 4 new to ask, 5 asked and not due yet, 6 marked fixed; blank when nothing is open with them. Replies, reminders, escalations and new lines count on the daily cards only (D182), from Today, so right between two refreshes. The order is the one of nextStep in src/app/view/groups.ts.
	measure 'Person state' =
			VAR asOf = [Today]
			VAR keys = VALUES ( Findings[Key] )
			VAR mails = CALCULATETABLE ( VALUES ( Findings[ContactEmail] ), Findings[ContactEmail] <> "" )
			VAR answered = CALCULATE ( COUNTROWS ( RepliesToRead ), TREATAS ( mails, RepliesToRead[From] ), RepliesToRead[Daily] = TRUE () )
			VAR escalation = CALCULATE ( COUNTROWS ( CaseLines ), TREATAS ( keys, CaseLines[Key] ), CaseLines[Remind] = "escalation", CaseLines[ReminderFrom] <= asOf, KEEPFILTERS ( Checks[Priority] <> "later" ) )
			VAR reminder = CALCULATE ( COUNTROWS ( CaseLines ), TREATAS ( keys, CaseLines[Key] ), CaseLines[Remind] = "reminder", CaseLines[ReminderFrom] <= asOf, KEEPFILTERS ( Checks[Priority] <> "later" ) )
			VAR fresh = CALCULATE ( COUNTROWS ( CaseLines ), TREATAS ( keys, CaseLines[Key] ), CaseLines[Status] = "New", CaseLines[State] = "open", KEEPFILTERS ( Checks[Priority] <> "later" ) )
			VAR asked = CALCULATE ( COUNTROWS ( CaseLines ), TREATAS ( keys, CaseLines[Key] ), CaseLines[Status] = "Contacted" )
			VAR marked = CALCULATE ( COUNTROWS ( CaseLines ), TREATAS ( keys, CaseLines[Key] ), CaseLines[Status] IN { "Fix in progress", "Fixed" } )
			RETURN
			    SWITCH ( TRUE (), answered > 0, 1, escalation > 0, 2, reminder > 0, 3, fresh > 0, 4, asked > 0, 5, marked > 0, 6 )
		formatString: 0
		displayFolder: My day

	/// 1 on a person with a next step today (Person state 1 to 4): the visual filter of Your next steps (My day).
	measure 'Step mark' =
			VAR kind = [Person state]
			RETURN IF ( NOT ISBLANK ( kind ) && kind <= 4, 1 )
		formatString: 0
		displayFolder: My day

	/// 1 on a person the team waits for (Person state 5 or 6): the visual filter of Waiting on others (My day).
	measure 'Wait mark' =
			VAR kind = [Person state]
			RETURN IF ( kind >= 5, 1 )
		formatString: 0
		displayFolder: My day

	/// The CIs of the next step with the person in view: the CIs of their replies to read, or of the lines to escalate, to remind or to ask about.
	measure 'Step CIs' =
			VAR kind = [Person state]
			VAR asOf = [Today]
			VAR mails = CALCULATETABLE ( VALUES ( Findings[ContactEmail] ), Findings[ContactEmail] <> "" )
			VAR mine = CALCULATETABLE ( CaseLines, TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ) )
			VAR lines =
			    FILTER (
			        mine,
			        SWITCH (
			            kind,
			            2, CaseLines[Remind] = "escalation" && CaseLines[ReminderFrom] <= asOf && RELATED ( Checks[Priority] ) <> "later",
			            3, CaseLines[Remind] = "reminder" && CaseLines[ReminderFrom] <= asOf && RELATED ( Checks[Priority] ) <> "later",
			            4, CaseLines[Status] = "New" && CaseLines[State] = "open" && RELATED ( Checks[Priority] ) <> "later"
			        )
			    )
			RETURN
			    IF (
			        kind = 1,
			        CALCULATE ( SUM ( RepliesToRead[CIs] ), TREATAS ( mails, RepliesToRead[From] ), RepliesToRead[Daily] = TRUE () ),
			        IF ( kind <= 4, COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( lines, "@ci", CaseLines[CiKey] ) ) ) )
			    )
		formatString: #,0
		displayFolder: My day

	/// On a line of Your next steps: what to do with the person and why, in a few words ("Read the reply of 6 Nov · 2 CIs").
	measure Step =
			VAR kind = [Person state]
			VAR asOf = [Today]
			VAR keys = VALUES ( Findings[Key] )
			VAR mine = CALCULATETABLE ( CaseLines, TREATAS ( keys, CaseLines[Key] ) )
			VAR lines =
			    FILTER (
			        mine,
			        SWITCH (
			            kind,
			            1, CaseLines[Status] = "Answered",
			            2, CaseLines[Remind] = "escalation" && CaseLines[ReminderFrom] <= asOf && RELATED ( Checks[Priority] ) <> "later",
			            3, CaseLines[Remind] = "reminder" && CaseLines[ReminderFrom] <= asOf && RELATED ( Checks[Priority] ) <> "later",
			            CaseLines[Status] = "New" && CaseLines[State] = "open" && RELATED ( Checks[Priority] ) <> "later"
			        )
			    )
			VAR cis = [Step CIs] + 0
			VAR replyOn = CALCULATE ( MAX ( RepliesToRead[Received] ), TREATAS ( CALCULATETABLE ( VALUES ( Findings[ContactEmail] ), Findings[ContactEmail] <> "" ), RepliesToRead[From] ), RepliesToRead[Daily] = TRUE () )
			VAR cards = DISTINCT ( SELECTCOLUMNS ( lines, "@card", RELATED ( Checks[CardLabel] ) ) )
			VAR cardCount = COUNTROWS ( cards )
			VAR named = CONCATENATEX ( TOPN ( 2, cards, [@card], ASC ), [@card], ", ", [@card], ASC ) & IF ( cardCount > 2, " and " & ( cardCount - 2 ) & " more" )
			VAR times = MAXX ( lines, CaseLines[Messages] )
			VAR lastSent = MAXX ( lines, CaseLines[SentOn] )
			VAR manager = CALCULATE ( MAX ( Findings[EscalateName] ), TREATAS ( SELECTCOLUMNS ( lines, "@key", CaseLines[Key] ), Findings[Key] ) )
			VAR ciWords = cis & IF ( cis = 1, " CI", " CIs" )
			RETURN
			    SWITCH (
			        kind,
			        1, "Read the reply of " & FORMAT ( replyOn, "d mmm" ) & " · " & ciWords,
			        2, "Escalate" & IF ( manager <> "", " to " & manager ) & " · asked " & times & IF ( times = 1, " time", " times" ) & ", last " & FORMAT ( lastSent, "d mmm" ),
			        3, "Send a reminder · asked " & FORMAT ( lastSent, "d mmm" ) & " · " & ciWords,
			        4, "Ask them · " & ciWords & " · " & cardCount & IF ( cardCount = 1, " kind of problem", " kinds of problem" )
			    )
		displayFolder: My day

	/// On a line of Waiting on others: what the team waits for ("Asked 5 Nov · 2 CIs · reminder from 10 Nov").
	measure 'Person waits' =
			VAR kind = [Person state]
			VAR keys = VALUES ( Findings[Key] )
			VAR asked = CALCULATETABLE ( CaseLines, TREATAS ( keys, CaseLines[Key] ), CaseLines[Status] = "Contacted" )
			VAR marked = CALCULATETABLE ( CaseLines, TREATAS ( keys, CaseLines[Key] ), CaseLines[Status] IN { "Fix in progress", "Fixed" } )
			VAR askedCis = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( asked, "@ci", CaseLines[CiKey] ) ) )
			VAR markedCis = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( marked, "@ci", CaseLines[CiKey] ) ) )
			VAR due = MINX ( asked, CaseLines[ReminderFrom] )
			RETURN
			    SWITCH (
			        kind,
			        5, "Asked " & FORMAT ( MAXX ( asked, CaseLines[SentOn] ), "d mmm" ) & " · " & askedCis & IF ( askedCis = 1, " CI", " CIs" ) & IF ( NOT ISBLANK ( due ), " · reminder from " & FORMAT ( due, "d mmm" ) ),
			        6, markedCis & IF ( markedCis = 1, " CI", " CIs" ) & " marked fixed · the next report checks"
			    )
		displayFolder: My day

	/// Open lines of the daily cards that SACM fixes itself in ServiceNow: nobody to ask, a change on the SACM fix list, not marked fixed yet.
	measure 'SACM fix lines' =
			VAR keys = CALCULATETABLE ( VALUES ( Findings[Key] ), Findings[ContactName] = "", Findings[FixChange] <> "", Findings[State] = "open" )
			RETURN CALCULATE ( COUNTROWS ( CaseLines ), TREATAS ( keys, CaseLines[Key] ), NOT CaseLines[Status] IN { "Fix in progress", "Fixed", "Verified", "Not followed up" }, KEEPFILTERS ( Checks[Priority] <> "later" ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// The words of the button under the next steps of My day (LOOK rule 4: two words and a number): the lines SACM fixes itself in ServiceNow. The button opens All cards, where each card has its SACM fix list.
	measure 'SACM fix line' =
			VAR n = [SACM fix lines]
			RETURN IF ( n = 0, "Nothing to fix", "Fix " & n & IF ( n = 1, " line", " lines" ) )
		displayFolder: My day

	/// The people with a next step today (My day): the lines of Your next steps.
	measure Steps =
			COUNTROWS ( FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Step mark] = 1 ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// Under the title of Your next steps (My day): how many, for whom and in what order, or why the box is empty.
	measure 'Steps note' =
			VAR n = [Steps]
			VAR me = [Me]
			VAR fixes = IF ( [SACM fix lines] > 0, " The lines SACM fixes itself are below." )
			RETURN
			    IF (
			        n = 0,
			        "Nobody to write to today: no reply to read, no reminder due and nobody new to ask." & fixes,
			        n & IF ( n = 1, " step", " steps" ) & " for " & FORMAT ( [Today], "dddd d mmmm" ) & IF ( NOT ISBLANK ( me ), " · " & me ) & ", in the order of the team's rules. Select one, then Open person." & fixes
			    )
		displayFolder: Page notes

	/// The people the team waits for (Person state 5 or 6).
	measure 'Waiting people' =
			COUNTROWS ( FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Wait mark] = 1 ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// Under the title of Waiting on others (My day).
	measure 'Waiting note' =
			IF ( [Waiting people] = 0, "Nobody to wait for: nobody was asked and has still to answer.", "Asked, or marked fixed: nothing to do until a reminder is due." )
		displayFolder: Page notes

	/// A number of My day: the people whose reply is to read (Person state 1).
	measure 'Replies tile' =
			COUNTROWS ( FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Person state] = 1 ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// A number of My day: the people to escalate (Person state 2).
	measure 'Escalations tile' =
			COUNTROWS ( FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Person state] = 2 ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// A number of My day: the people to remind (Person state 3).
	measure 'Reminders tile' =
			COUNTROWS ( FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Person state] = 3 ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// A number of My day: the people never asked who have new lines (Person state 4).
	measure 'People to ask' =
			COUNTROWS ( FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Person state] = 4 ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// Under a number of My day: who, and how many CIs ("Dee Owner · 2 CIs").
	measure 'Replies tile line' =
			VAR people = FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Person state] = 1 )
			VAR n = COUNTROWS ( people )
			VAR who = CONCATENATEX ( TOPN ( 1, people, Findings[ContactName], ASC ), Findings[ContactName] )
			VAR cis = SUMX ( people, [Step CIs] )
			RETURN IF ( n = 0, "No reply to read", who & IF ( n > 1, " and " & ( n - 1 ) & " more" ) & " · " & cis & IF ( cis = 1, " CI", " CIs" ) )
		displayFolder: My day

	/// Under a number of My day: who, and how many CIs ("Dee Owner · 2 CIs").
	measure 'Escalations tile line' =
			VAR people = FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Person state] = 2 )
			VAR n = COUNTROWS ( people )
			VAR who = CONCATENATEX ( TOPN ( 1, people, Findings[ContactName], ASC ), Findings[ContactName] )
			VAR cis = SUMX ( people, [Step CIs] )
			RETURN IF ( n = 0, "Nobody to escalate", who & IF ( n > 1, " and " & ( n - 1 ) & " more" ) & " · " & cis & IF ( cis = 1, " CI", " CIs" ) )
		displayFolder: My day

	/// Under a number of My day: who, and how many CIs ("Dee Owner · 2 CIs").
	measure 'Reminders tile line' =
			VAR people = FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && [Person state] = 3 )
			VAR n = COUNTROWS ( people )
			VAR who = CONCATENATEX ( TOPN ( 1, people, Findings[ContactName], ASC ), Findings[ContactName] )
			VAR cis = SUMX ( people, [Step CIs] )
			RETURN IF ( n = 0, "Nobody to remind", who & IF ( n > 1, " and " & ( n - 1 ) & " more" ) & " · " & cis & IF ( cis = 1, " CI", " CIs" ) )
		displayFolder: My day

	/// The fourth number of My day: new findings on the daily cards since the report before (0 when none).
	measure 'New tile' =
			[New (daily)] + 0
		formatString: #,0
		displayFolder: My day

	/// Under the fourth number of My day: solved since the report before, and the people to ask.
	measure 'New tile line' =
			VAR solved = [Solved (daily)] + 0
			VAR ask = [People to ask]
			RETURN solved & " solved · " & ask & IF ( ask = 1, " person to ask", " people to ask" )
		displayFolder: My day

	/// The step or state of the person in view (My day) or of the line (Work queue) as a chip: word, icon and colour (LOOK rule 5), one meaning per colour. The picture is 128 × 24 (a table gives all its pictures one size), the chip at its left. Its class starts with the step and the name, so a table sorted on it keeps the order of the team's rules.
	measure 'State chip' =
			VAR byLine = ISINSCOPE ( CaseLines[ContactName] )
			VAR kind = IF ( byLine, [Queue state], [Person state] )
			VAR word = SWITCH ( kind, 1, "Reply to read", 2, "Escalate", 3, "Reminder due", 4, "New", 5, "Asked", 6, "Marked fixed" )
			VAR ink = SWITCH ( kind, 1, "#5925dc", 2, "#b42318", 3, "#7d5700", 5, "#475467", 6, "#107569", "#175cd3" )
			VAR paper = SWITCH ( kind, 1, "#f4f3ff", 2, "#fef3f2", 3, "#fffaeb", 5, "#f2f4f7", 6, "#f0fdf9", "#eff8ff" )
			VAR glyph = SWITCH ( kind, 1, "<path d='M9 14L4 9l5-5'/><path d='M4 9h11a5 5 0 0 1 5 5v5'/>", 2, "<path d='M12 19V5'/><path d='M5 12l7-7 7 7'/>", 3, "<path d='M6 16V11a6 6 0 1 1 12 0v5l2 2H4z'/><path d='M10 20a2 2 0 0 0 4 0'/>", 5, "<rect x='3' y='5' width='18' height='14' rx='2'/><path d='M3.5 6.5L12 13l8.5-6.5'/>", 6, "<path d='M5 12.5l4.5 4.5L19 7'/>", "<circle cx='12' cy='12' r='4'/>" )
			VAR wide = MIN ( ROUND ( LEN ( word ) * 7 + 34, 0 ), 128 )
			VAR person = IF ( byLine, SELECTEDVALUE ( CaseLines[ContactName] ), SELECTEDVALUE ( Findings[ContactName] ) )
			VAR who = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( person, "&", "and" ), "<", "" ), "'", "" )
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' class='k" & kind & " " & who & "' width='128' height='24' viewBox='0 0 128 24'>"
			        & "<rect x='0' y='2' width='" & wide & "' height='20' rx='10' fill='" & paper & "'/>"
			        & "<g transform='translate(8 6) scale(0.5)' fill='none' stroke='" & ink & "' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'>" & glyph & "</g>"
			        & "<text x='24' y='16.5' font-family='Segoe UI, sans-serif' font-size='12' font-weight='600' fill='" & ink & "'>" & word & "</text></svg>"
			RETURN IF ( NOT ISBLANK ( kind ), "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" ) )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// The initials of the person in view in a navy circle (Waiting on others).
	measure 'Person avatar' =
			VAR who = SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( Findings[ContactName] ), "&", "" ), "<", "" )
			VAR gap = SEARCH ( " ", who, 1, 0 )
			VAR letters = UPPER ( LEFT ( who, 1 ) & IF ( gap > 0, MID ( who, gap + 1, 1 ) ) )
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24'><circle cx='12' cy='12' r='12' fill='#e6e9f4'/>"
			        & "<text x='12' y='16.5' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='12' font-weight='700' fill='#0c1c49'>" & letters & "</text></svg>"
			RETURN IF ( who <> "", "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" ) )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// On the rail, beside its page: the next steps of today (the people, and the SACM fixes as one) in a small pill, the same on every page (no filter of the page counts).
	measure 'Rail badge my day' =
			VAR n = CALCULATE ( [Steps] + IF ( [SACM fix lines] > 0, 1, 0 ), REMOVEFILTERS () ) + 0
			VAR words = FORMAT ( n, "0" )
			VAR wide = LEN ( words ) * 7 + 14
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='24' viewBox='0 0 32 24'>"
			        & "<rect x='" & ( 32 - wide ) & "' y='3' width='" & wide & "' height='18' rx='9' fill='#ffffff' fill-opacity='0.16'/>"
			        & "<text x='" & ( 32 - wide / 2 ) & "' y='16' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='12' font-weight='600' fill='#ffffff'>" & words & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & IF ( n = 0, "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='24'/>", SUBSTITUTE ( picture, "#", "%23" ) )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// On the rail, beside its page: the open lines with a person to ask in a small pill, the same on every page (no filter of the page counts).
	measure 'Rail badge work queue' =
			VAR n = CALCULATE ( COUNTROWS ( CaseLines ), REMOVEFILTERS (), NOT CaseLines[Status] IN { "Verified", "Not followed up" }, CaseLines[ContactName] <> "" ) + 0
			VAR words = FORMAT ( n, "0" )
			VAR wide = LEN ( words ) * 7 + 14
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='24' viewBox='0 0 32 24'>"
			        & "<rect x='" & ( 32 - wide ) & "' y='3' width='" & wide & "' height='18' rx='9' fill='#ffffff' fill-opacity='0.16'/>"
			        & "<text x='" & ( 32 - wide / 2 ) & "' y='16' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='12' font-weight='600' fill='#ffffff'>" & words & "</text></svg>"
			RETURN "data:image/svg+xml;utf8," & IF ( n = 0, "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='24'/>", SUBSTITUTE ( picture, "#", "%23" ) )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// The open lines with the person in view (People, Person, Overview): their lines of the newest report, not verified and not set aside; blank hides the person.
	measure 'Person lines' =
			VAR n = CALCULATE ( COUNTROWS ( CaseLines ), TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ), NOT CaseLines[Status] IN { "Verified", "Not followed up" } )
			RETURN IF ( n > 0, n )
		formatString: #,0
		displayFolder: People

	/// Under the number of open lines (Person): on how many CIs.
	measure 'Person lines line' =
			VAR n = CALCULATE ( DISTINCTCOUNT ( CaseLines[CiKey] ), TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ), NOT CaseLines[Status] IN { "Verified", "Not followed up" } ) + 0
			RETURN "on " & n & IF ( n = 1, " CI", " CIs" )
		displayFolder: People

	/// The kinds of problem (cards) of the open lines with the person in view (Person): one part each in the email.
	measure 'Person kinds' =
			CALCULATE ( DISTINCTCOUNT ( CaseLines[CheckId] ), TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ), NOT CaseLines[Status] IN { "Verified", "Not followed up" } ) + 0
		formatString: #,0
		displayFolder: People

	/// The cards of the open lines with the person in view (People): the first two by name, and how many more.
	measure 'Person cards' =
			VAR lines = CALCULATETABLE ( CaseLines, TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ), NOT CaseLines[Status] IN { "Verified", "Not followed up" } )
			VAR cards = DISTINCT ( SELECTCOLUMNS ( lines, "@card", RELATED ( Checks[CardLabel] ) ) )
			VAR cardCount = COUNTROWS ( cards )
			RETURN IF ( cardCount > 0, CONCATENATEX ( TOPN ( 2, cards, [@card], ASC ), [@card], ", ", [@card], ASC ) & IF ( cardCount > 2, " and " & ( cardCount - 2 ) & " more" ) )
		displayFolder: People

	/// The day the team last wrote to the person in view, or never (People, Person).
	measure 'Person last asked' =
			VAR lastSent = CALCULATE ( MAX ( CaseLines[SentOn] ), TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ) )
			RETURN IF ( ISBLANK ( lastSent ), "never", FORMAT ( lastSent, "d mmm" ) )
		displayFolder: People

	/// Under the last contact (Person): how many emails the team sent, or never asked.
	measure 'Person asked line' =
			VAR times = CALCULATE ( MAX ( CaseLines[Messages] ), TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ) ) + 0
			RETURN IF ( times = 0, "never asked", "asked " & times & IF ( times = 1, " time", " times" ) )
		displayFolder: People

	/// The name at the top of the Person page, or what to do when the page was opened from its tab.
	measure 'Person title' = IF ( HASONEVALUE ( Findings[ContactName] ), SELECTEDVALUE ( Findings[ContactName] ), "No person chosen" )
		displayFolder: People

	/// Under the name (Person): why the team asks them and where the email goes, or how to choose a person.
	measure 'Person line' =
			VAR via = CONCATENATEX ( TOPN ( 2, CALCULATETABLE ( VALUES ( Findings[ContactVia] ), Findings[ContactVia] <> "" ), Findings[ContactVia], ASC ), Findings[ContactVia], ", ", Findings[ContactVia], ASC )
			VAR mails = CONCATENATEX ( TOPN ( 2, CALCULATETABLE ( VALUES ( Findings[ContactEmail] ), Findings[ContactEmail] <> "" ), Findings[ContactEmail], ASC ), Findings[ContactEmail], "; ", Findings[ContactEmail], ASC )
			VAR both = via & IF ( via <> "" && mails <> "", " · " ) & mails
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( Findings[ContactName] ), "On My day, People or Overview, select a name, then Open person.",
			        both = "", "No address known: the team writes to them by hand.",
			        both
			    )
		displayFolder: People

	/// The open lines with the person in view as a bar of their next steps (People, Overview): the number, then one part per step in the colour of its chip (reply to read, escalate, reminder due, new, asked, marked fixed), as long as the lines on the scale of the person with the most. 128 × 24, the size of the state chip: a table gives all its pictures one size. The number comes first in the picture, so a table sorted on it has the most lines first.
	measure 'State bar' =
			VAR asOf = [Today]
			VAR mine = CALCULATETABLE ( CaseLines, TREATAS ( VALUES ( Findings[Key] ), CaseLines[Key] ), NOT CaseLines[Status] IN { "Verified", "Not followed up" } )
			VAR shown = COUNTROWS ( mine ) + 0
			VAR ranked =
			    ADDCOLUMNS (
			        mine,
			        "@step",
			            SWITCH (
			                TRUE (),
			                CaseLines[Status] = "Answered", 1,
			                CaseLines[Remind] = "escalation" && CaseLines[ReminderFrom] <= asOf, 2,
			                CaseLines[Remind] = "reminder" && CaseLines[ReminderFrom] <= asOf, 3,
			                CaseLines[Status] = "New", 4,
			                CaseLines[Status] IN { "Fix in progress", "Fixed" }, 6,
			                5
			            )
			    )
			VAR most =
			    MAXX (
			        CALCULATETABLE (
			            ADDCOLUMNS ( VALUES ( CaseLines[ContactName] ), "@n", CALCULATE ( COUNTROWS ( CaseLines ) ) ),
			            REMOVEFILTERS ( CaseLines ),
			            CaseLines[ContactName] <> "",
			            NOT CaseLines[Status] IN { "Verified", "Not followed up" }
			        ),
			        [@n]
			    )
			VAR unit = 92 / MAX ( most, 1 )
			VAR one = ROUND ( COUNTROWS ( FILTER ( ranked, [@step] = 1 ) ) * unit, 0 )
			VAR two = ROUND ( COUNTROWS ( FILTER ( ranked, [@step] = 2 ) ) * unit, 0 )
			VAR three = ROUND ( COUNTROWS ( FILTER ( ranked, [@step] = 3 ) ) * unit, 0 )
			VAR four = ROUND ( COUNTROWS ( FILTER ( ranked, [@step] = 4 ) ) * unit, 0 )
			VAR five = ROUND ( COUNTROWS ( FILTER ( ranked, [@step] = 5 ) ) * unit, 0 )
			VAR six = ROUND ( COUNTROWS ( FILTER ( ranked, [@step] = 6 ) ) * unit, 0 )
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' class='n" & FORMAT ( 99999 - MIN ( shown, 99999 ), "00000" ) & "' width='128' height='24' viewBox='0 0 128 24'>"
			        & "<text x='26' y='16.5' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='12' font-weight='600' fill='#2b2623'>" & shown & "</text>"
			        & "<rect x='32' y='7' width='92' height='10' rx='3' fill='#f2f4f7'/>"
			        & "<rect x='32' y='7' width='" & one & "' height='10' fill='#5925dc'/>"
			        & "<rect x='" & 32 + one & "' y='7' width='" & two & "' height='10' fill='#b42318'/>"
			        & "<rect x='" & 32 + one + two & "' y='7' width='" & three & "' height='10' fill='#7d5700'/>"
			        & "<rect x='" & 32 + one + two + three & "' y='7' width='" & four & "' height='10' fill='#175cd3'/>"
			        & "<rect x='" & 32 + one + two + three + four & "' y='7' width='" & five & "' height='10' fill='#d0d5dd'/>"
			        & "<rect x='" & 32 + one + two + three + four + five & "' y='7' width='" & six & "' height='10' fill='#107569'/></svg>"
			RETURN IF ( shown > 0, "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" ) )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// Under the title of People: how many people, or why the box is empty.
	measure 'People line' =
			VAR n = COUNTROWS ( FILTER ( VALUES ( Findings[ContactName] ), Findings[ContactName] <> "" && NOT ISBLANK ( [Person lines] ) ) ) + 0
			RETURN IF ( n = 0, "Nobody: no open line waits for a person.", n & IF ( n = 1, " person", " people" ) & ", in the order of the team's rules. Select one, then Open person." )
		displayFolder: Page notes

	/// Under the title of Who holds the most (Overview): the lines that wait for nobody.
	measure 'Holders line' =
			VAR sacm = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[ContactName] = "", CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), NOT CaseLines[Status] IN { "Verified", "Not followed up" } ) + 0
			RETURN IF ( sacm = 0, "The most open lines first. Every open line waits for a person.", "The most open lines first. " & sacm & IF ( sacm = 1, " line has", " lines have" ) & " no person: SACM fixes them, on the fix list of each card." )
		displayFolder: Page notes

	/// The CI at the top of the Case page, or what to do when the page was opened from its tab.
	measure 'Case title' = IF ( HASONEVALUE ( Findings[CiName] ), SELECTEDVALUE ( Findings[CiName] ), "No CI chosen" )
		displayFolder: Case

	/// Under the CI (Case): its class, EPO ID, status and support group, or how to choose a CI.
	measure 'Case line' =
			VAR kind = SELECTEDVALUE ( Findings[ClassLabel] )
			VAR epo = SELECTEDVALUE ( Findings[EpoId] )
			VAR partA = kind & IF ( kind <> "" && epo <> "", " · " ) & epo
			VAR life = SELECTEDVALUE ( Findings[Status] )
			VAR partB = partA & IF ( partA <> "" && life <> "", " · " ) & life
			VAR supportGroup = SELECTEDVALUE ( Findings[SupportGroup] )
			VAR said = partB & IF ( partB <> "" && supportGroup <> "", " · " ) & supportGroup
			RETURN IF ( NOT HASONEVALUE ( Findings[CiName] ), "On a card or a person, select a line, then Open CI.", IF ( said = "", "As the newest CI report shows it.", said ) )
		displayFolder: Case

	/// A field of the CI (Case): Owned by, or a dash.
	measure 'Case owned by' =
			VAR v = IF ( HASONEVALUE ( Findings[CiName] ), SELECTEDVALUE ( Findings[OwnedBy] ) )
			RETURN IF ( v = "", "–", v )
		displayFolder: Case

	/// A field of the CI (Case): Managed by, or a dash.
	measure 'Case managed by' =
			VAR v = IF ( HASONEVALUE ( Findings[CiName] ), SELECTEDVALUE ( Findings[ManagedBy] ) )
			RETURN IF ( v = "", "–", v )
		displayFolder: Case

	/// A field of the CI (Case): Supported by, or a dash.
	measure 'Case supported by' =
			VAR v = IF ( HASONEVALUE ( Findings[CiName] ), SELECTEDVALUE ( Findings[SupportedBy] ) )
			RETURN IF ( v = "", "–", v )
		displayFolder: Case

	/// A field of the CI (Case): its tags, or a dash.
	measure 'Case tags' =
			VAR v = IF ( HASONEVALUE ( Findings[CiName] ), SELECTEDVALUE ( Findings[Tags] ) )
			RETURN IF ( v = "", "–", v )
		displayFolder: Case

