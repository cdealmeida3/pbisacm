		isNameInferred
		sourceColumn: [Mapping]

	/// "EPO already has …": EPO names another person than ServiceNow for a fix made in EPO, so nobody needs to be asked.
	column EpoCorrection
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [EpoCorrection]

	/// The kind of problem a line is listed under: a problem of the contract data (For Procurement, Contracts to fix in ServiceNow) or a field of the upload check (D146). Empty for most checks.
	column Problem
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Problem]

	partition Findings = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "Findings" ),
					"ReportDate", Run[Findings.ReportDate],
					"Key", Run[Findings.Key],
					"CheckId", Run[Findings.CheckId],
					"CiKey", Run[Findings.CiKey],
					"CiName", Run[Findings.CiName],
					"Class", Run[Findings.Class],
					"ClassLabel", Run[Findings.ClassLabel],
					"Field", Run[Findings.Field],
					"Severity", Run[Findings.Severity],
					"Detail", Run[Findings.Detail],
					"Module", Run[Findings.Module],
					"Route", Run[Findings.Route],
					"State", Run[Findings.State],
					"StateLabel", Run[Findings.StateLabel],
					"StateWhy", Run[Findings.StateWhy],
					"Source", Run[Findings.Source],
					"Wait", Run[Findings.Wait],
					"Review", Run[Findings.Review],
					"ContactId", Run[Findings.ContactId],
					"ContactName", Run[Findings.ContactName],
					"ContactEmail", Run[Findings.ContactEmail],
					"ContactVia", Run[Findings.ContactVia],
					"AskWho", Run[Findings.AskWho],
					"Cc", Run[Findings.Cc],
					"EscalateName", Run[Findings.EscalateName],
					"EscalateEmail", Run[Findings.EscalateEmail],
					"EscalateVia", Run[Findings.EscalateVia],
					"FixChange", Run[Findings.FixChange],
					"FixCurrent", Run[Findings.FixCurrent],
					"FixSet", Run[Findings.FixSet],
					"FixValue", Run[Findings.FixValue],
					"FixRelatedTo", Run[Findings.FixRelatedTo],
					"FixNote", Run[Findings.FixNote],
					"Group", Run[Findings.Group],
					"EpoId", Run[Findings.EpoId],
					"Status", Run[Findings.Status],
					"SupportGroup", Run[Findings.SupportGroup],
					"OwnedBy", Run[Findings.OwnedBy],
					"ManagedBy", Run[Findings.ManagedBy],
					"SupportedBy", Run[Findings.SupportedBy],
					"Chips", Run[Findings.Chips],
					"Tags", Run[Findings.Tags],
					"ServiceNowLink", Run[Findings.ServiceNowLink],
					"Mapping", Run[Findings.Mapping],
					"EpoCorrection", Run[Findings.EpoCorrection],
					"Problem", Run[Findings.Problem]
				)
