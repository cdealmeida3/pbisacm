/// One row per CI report date, with the other reports its checks used (D290).
table Runs

	/// The CI report dates the history holds.
	measure 'Report dates' = COUNTROWS ( DISTINCT ( Runs[ReportDate] ) ) + 0
		formatString: #,0

	/// The first day of the period chosen on the Audit page (the slicer of the dates); the first day of the dates without one.
	measure 'Period from' = MIN ( 'Date'[Date] )
		formatString: d mmm yyyy

	/// The last day of the period chosen on the Audit page.
	measure 'Period to' = MAX ( 'Date'[Date] )
		formatString: d mmm yyyy

	/// The export of the Audit page, the CI reports loaded (loads.csv of the HTML app): the CIs of a report dated in the period; blank outside it.
	measure 'Load CIs' =
			VAR d = SELECTEDVALUE ( Runs[ReportDate] )
			RETURN IF ( NOT ISBLANK ( d ) && d >= [Period from] && d <= [Period to], MAX ( Runs[CIs] ) )
		formatString: #,0

	/// The findings to solve of a CI report dated in the period (loads.csv); blank outside it.
	measure 'Load to solve' =
			VAR d = SELECTEDVALUE ( Runs[ReportDate] )
			RETURN IF ( NOT ISBLANK ( d ) && d >= [Period from] && d <= [Period to], CALCULATE ( COUNTROWS ( History ), History[State] = "open" ) + 0 )
		formatString: #,0

	/// Under the title of the loads (Audit export).
	measure 'Loads note' = IF ( COUNTROWS ( DISTINCT ( Runs[ReportDate] ) ) + 0 = 0, "No CI report in the period chosen.", "The CI reports of the period chosen." )
		displayFolder: Page notes

	/// Under the title of the reports the cards were checked with (Reports).
	measure 'Runs note' = IF ( COUNTROWS ( DISTINCT ( Runs[ReportDate] ) ) + 0 = 0, "No CI report is loaded yet.", "The files of each CI report date." )
		displayFolder: Page notes

	/// A number of Audit: the CI report dates of the period chosen.
	measure 'Reports received' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			RETURN CALCULATE ( COUNTROWS ( Runs ), REMOVEFILTERS ( Runs ), Runs[ReportDate] >= fromDate, Runs[ReportDate] <= toDate ) + 0
		formatString: #,0
		displayFolder: Audit

	/// Under the CI reports of the period (Audit): the first and the last.
	measure 'Reports received line' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			VAR openingDate = CALCULATE ( MIN ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] >= fromDate, Runs[ReportDate] <= toDate )
			VAR closingDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] >= fromDate, Runs[ReportDate] <= toDate )
			RETURN IF ( ISBLANK ( openingDate ), "no CI report in the period", "from " & FORMAT ( openingDate, "d mmm" ) & " to " & FORMAT ( closingDate, "d mmm yyyy" ) )
		displayFolder: Audit

	/// Under a number of Audit: the findings found in the period that were new in it.
	measure 'Found line' =
			VAR fresh = [New in the period] + 0
			RETURN fresh & " new in the period"
		displayFolder: Audit

	column ReportDate
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [ReportDate]

	column FileName
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [FileName]

	column CIs
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [CIs]

	column RelationshipFile
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [RelationshipFile]

	column EpoFile
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [EpoFile]

	column SolusiFile
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [SolusiFile]

	column ContractFile
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ContractFile]

	/// The Monday of the week of the CI report date (Found and closed per week, Audit; build D3).
	column Week = Runs[ReportDate] - WEEKDAY ( Runs[ReportDate], 2 ) + 1
		dataType: dateTime
		formatString: d mmm
		summarizeBy: none

	partition Runs = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( HistoryRun, HistoryRun[Part] = "Runs" ),
					"ReportDate", HistoryRun[Runs.ReportDate],
					"FileName", HistoryRun[Runs.FileName],
					"CIs", HistoryRun[Runs.CIs],
					"RelationshipFile", HistoryRun[Runs.RelationshipFile],
					"EpoFile", HistoryRun[Runs.EpoFile],
					"SolusiFile", HistoryRun[Runs.SolusiFile],
					"ContractFile", HistoryRun[Runs.ContractFile]
				)
