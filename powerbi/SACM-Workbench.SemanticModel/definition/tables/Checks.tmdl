/// One row per check file that is not off: what the card shows, from the check files.
table Checks

	/// The state of one card (src/app/view/cards.ts, cardSummaries): Not tested when the newest report tested no part of the check (grey, never green: D15), To solve when a finding is to solve, To check when a finding is to check first, else OK. All marked as fixed (D168, from the team's journal): a SACM fix list whose every open line a manager marked as fixed; it waits for the next report and still counts as to solve.
	measure 'Card state' =
			VAR testedRows = CALCULATE ( COUNTROWS ( Tested ) ) > 0
			VAR openLines = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE () ) + 0
			VAR marked = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), CaseLines[Status] = "Fixed" ) + 0
			VAR allMarked = SELECTEDVALUE ( Checks[Kind] ) = "fix" && openLines > 0 && marked = openLines
			RETURN
			    IF (
			        NOT ISBLANK ( SELECTEDVALUE ( Checks[CheckId] ) ),
			        IF ( NOT testedRows, "Not tested", IF ( [To solve] > 0, IF ( allMarked, "All marked as fixed", "To solve" ), IF ( [To check] > 0, "To check", "OK" ) ) )
			    )

	/// The one number of a card and its word (D220): CIs on an owners card, lines on a SACM fix list or a review list, contracts on a contract card. OK says Nothing to do.
	measure 'Card number' =
			VAR state = [Card state]
			VAR kind = SELECTEDVALUE ( Checks[Kind] )
			VAR contracts = SELECTEDVALUE ( Checks[Counts] ) = "contracts"
			VAR shown = IF ( state = "To check", "review", "open" )
			VAR cis = CALCULATE ( DISTINCTCOUNT ( Findings[CiKey] ), Findings[State] = shown ) + 0
			VAR lines = CALCULATE ( COUNTROWS ( Findings ), Findings[State] = shown ) + 0
			VAR byLine = kind = "fix" || ( kind = "review" && state = "To check" )
			VAR cardTotal = IF ( byLine, lines, cis )
			VAR word =
			    IF ( byLine, IF ( cardTotal = 1, "line", "lines" ), IF ( contracts, IF ( cardTotal = 1, "contract", "contracts" ), IF ( cardTotal = 1, "CI", "CIs" ) ) )
			RETURN
			    IF ( state = "OK", "Nothing to do", IF ( state = "To solve" || state = "All marked as fixed" || state = "To check" || ( state = "Not tested" && cis > 0 ), FORMAT ( IF ( state = "Not tested", cis, cardTotal ), "#,0" ) & " " & IF ( state = "Not tested", IF ( contracts, IF ( cis = 1, "contract", "contracts" ), IF ( cis = 1, "CI", "CIs" ) ), word ) ) )

	/// The one fact of a card besides its number (D220, src/app/view/cards.ts cardLine), the first of: +N new since the report before, Partly tested, N reminders (due or over the limit), N answered, N of M marked as fixed (a SACM fix list), N free (contacts with open cases nobody has taken, on an owners or mapping card to solve), Not asked yet (the Procurement mailbox, to solve, never asked). Counted in CIs, as the app does.
	measure 'Card fact' =
			VAR testedRows = CALCULATE ( COUNTROWS ( Tested ) ) > 0
			VAR noteRows = CALCULATE ( COUNTROWS ( Notes ) ) + 0
			VAR kind = SELECTEDVALUE ( Checks[Kind] )
			VAR state = [Card state]
			VAR asOf = [Today]
			VAR added = CALCULATE ( [New], REMOVEFILTERS ( Runs ) ) + 0
			VAR due = CALCULATE ( DISTINCTCOUNT ( CaseLines[CiKey] ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), CaseLines[Remind] <> "", CaseLines[ReminderFrom] <= asOf ) + 0
			VAR answered = CALCULATE ( DISTINCTCOUNT ( CaseLines[CiKey] ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), CaseLines[Status] = "Answered" ) + 0
			VAR lines = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE () ) + 0
			VAR marked = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), CaseLines[Status] = "Fixed" ) + 0
			VAR contacts = CALCULATETABLE ( VALUES ( CaseLines[ContactName] ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), CaseLines[ContactName] <> "" )
			VAR taken = CALCULATETABLE ( VALUES ( CaseLines[ContactName] ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), CaseLines[AssignedTo] <> "" )
			VAR free = COUNTROWS ( EXCEPT ( contacts, taken ) ) + 0
			VAR contacted = CALCULATE ( COUNTROWS ( CaseLines ), CaseLines[State] = "open", CaseLines[InLatest] = TRUE (), CaseLines[Messages] > 0 ) + 0
			RETURN
			    IF (
			        NOT ISBLANK ( SELECTEDVALUE ( Checks[CheckId] ) ),
			        IF ( added > 0, "+" & FORMAT ( added, "#,0" ) & " new",
			        IF ( testedRows && noteRows > 0, "Partly tested",
			        IF ( kind <> "fix" && due > 0, due & IF ( due = 1, " reminder", " reminders" ),
			        IF ( kind <> "fix" && answered > 0, answered & " answered",
			        IF ( kind = "fix" && marked > 0 && marked < lines, marked & " of " & FORMAT ( lines, "#,0" ) & " marked as fixed",
			        IF ( ( kind = "owners" || kind = "mapping" ) && state = "To solve" && free > 0, free & " free",
			        IF ( kind = "mailbox" && state = "To solve" && contacted = 0, "Not asked yet" ) ) ) ) ) ) )
			    )

	/// What the card says when it is not tested or only partly tested: its notes, in the order of the run.
	measure 'Card note' = IF ( NOT ISBLANK ( SELECTEDVALUE ( Checks[CheckId] ) ), CONCATENATEX ( Notes, Notes[Reason], " ", Notes[Order], ASC ) )

	/// The title of the lines by kind of problem on a card page: one email to Procurement with the memory of the message ("Asked 2 times · last 4 Nov · no reply", or "Not asked yet", D226), one table per kind of problem (plan §6.1, build B7), or a SACM list grouped by problem or field (D146).
	measure 'Problems title' =
			VAR memory = CALCULATE ( [Follow-up], TREATAS ( VALUES ( Checks[CheckId] ), CaseLines[CheckId] ), CaseLines[InLatest] = TRUE (), CaseLines[State] = "open" )
			RETURN
			    IF (
			        SELECTEDVALUE ( Checks[Kind] ) = "mailbox",
			        "One email to the Procurement mailbox · " & memory & " · the email has one table per kind of problem",
			        "By kind of problem"
			    )

	/// The text colour of the state (LOOK.md, one meaning per colour).
	measure 'Card colour' = SWITCH ( [Card state], "To solve", "#b42318", "All marked as fixed", "#107569", "To check", "#175cd3", "OK", "#067647", "#475467" )

	/// The soft background of the state.
	measure 'Card fill' = SWITCH ( [Card state], "To solve", "#fef3f2", "All marked as fixed", "#f0fdf9", "To check", "#eff8ff", "OK", "#ecfdf3", "#f2f4f7" )

	/// The order of the cards inside a section (D172): To solve first, then To check, OK, Not tested last.
	measure 'Card rank' = SWITCH ( [Card state], "To solve", 1, "All marked as fixed", 1, "To check", 2, "OK", 3, 4 )
		formatString: 0

	/// "When there is time" on a card that is not daily work (priority later, D182): it is never in the count to solve.
	measure 'Card time' = IF ( SELECTEDVALUE ( Checks[Priority] ) = "later", "When there is time" )

	/// The order of the cards (D172, src/app/view/cards.ts orderCards): by section, daily work before the cards for when there is time, then To solve, To check, OK, Not tested, the biggest first, then the order of the check files.
	measure 'Card order' =
			VAR state = [Card state]
			VAR size = IF ( state IN { "To solve", "All marked as fixed" }, [To solve], IF ( state = "To check", [To check], 0 ) )
			RETURN
			    IF (
			        NOT ISBLANK ( SELECTEDVALUE ( Checks[CheckId] ) ),
			        SELECTEDVALUE ( Checks[SectionOrder] ) * 1000000000
			            + IF ( SELECTEDVALUE ( Checks[Priority] ) = "later", 100000000, 0 )
			            + [Card rank] * 10000000 + ( 99999 - MIN ( size, 99999 ) ) * 100 + SELECTEDVALUE ( Checks[FileOrder] )
			    )
		formatString: 0

	/// The place of the card in the order of Card order, 1 for the first: the first column (#) of All cards, so the table keeps the order of the app without showing its key (design D1).
	measure 'Card place' = IF ( ISBLANK ( [Card order] ), BLANK (), RANKX ( FILTER ( ALLSELECTED ( Checks ), NOT ISBLANK ( [Card order] ) ), [Card order], , ASC, DENSE ) )
		formatString: 0

	/// Checks that are not off.
	measure 'Checks in use' = COUNTROWS ( Checks ) + 0
		formatString: 0

	/// What the card page says to do: the hint of the check file.
	measure 'Card hint' = IF ( NOT ISBLANK ( SELECTEDVALUE ( Checks[CheckId] ) ), SELECTEDVALUE ( Checks[CardHint] ), "On All cards, right-click a line, then Drill through, Card. Until then the page shows every card." )

	/// The name of the check on its card page.
	measure 'Card title' = IF ( NOT ISBLANK ( SELECTEDVALUE ( Checks[CheckId] ) ), SELECTEDVALUE ( Checks[CardLabel] ) & " · " & [Card state], "No card chosen" )

	/// The line of the section Completeness (D219, src/app/view/cards.ts sectionText): it counts cards, not findings. A card to solve that is not daily work (priority later, D182) counts as when there is time.
	measure Completeness =
			VAR checkRows = CALCULATETABLE ( VALUES ( Checks[CheckId] ), Checks[Dimension] = "completeness" )
			VAR toSolve = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) IN { "To solve", "All marked as fixed" } && CALCULATE ( SELECTEDVALUE ( Checks[Priority] ) ) <> "later", 1 ) ) + 0
			VAR toCheck = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) = "To check", 1 ) ) + 0
			VAR later = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) IN { "To solve", "All marked as fixed" } && CALCULATE ( SELECTEDVALUE ( Checks[Priority] ) ) = "later", 1 ) ) + 0
			VAR notTested = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) = "Not tested", 1 ) ) + 0
			VAR solveText = IF ( toSolve > 0, toSolve & " to solve" )
			VAR checkText = IF ( toCheck > 0, toCheck & " to check" )
			VAR laterText = IF ( later > 0, later & " when there is time" )
			VAR greyText = IF ( notTested > 0, notTested & " not tested" )
			VAR both = solveText & IF ( solveText <> "" && checkText <> "", " · " ) & checkText
			VAR three = both & IF ( both <> "" && laterText <> "", " · " ) & laterText
			VAR words = three & IF ( three <> "" && greyText <> "", " · " ) & greyText
			RETURN "Completeness: " & IF ( words = "", "All OK", words )

	/// The line of the section Correctness (D219, src/app/view/cards.ts sectionText): it counts cards, not findings. A card to solve that is not daily work (priority later, D182) counts as when there is time.
	measure Correctness =
			VAR checkRows = CALCULATETABLE ( VALUES ( Checks[CheckId] ), Checks[Dimension] = "correctness" )
			VAR toSolve = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) IN { "To solve", "All marked as fixed" } && CALCULATE ( SELECTEDVALUE ( Checks[Priority] ) ) <> "later", 1 ) ) + 0
			VAR toCheck = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) = "To check", 1 ) ) + 0
			VAR later = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) IN { "To solve", "All marked as fixed" } && CALCULATE ( SELECTEDVALUE ( Checks[Priority] ) ) = "later", 1 ) ) + 0
			VAR notTested = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) = "Not tested", 1 ) ) + 0
			VAR solveText = IF ( toSolve > 0, toSolve & " to solve" )
			VAR checkText = IF ( toCheck > 0, toCheck & " to check" )
			VAR laterText = IF ( later > 0, later & " when there is time" )
			VAR greyText = IF ( notTested > 0, notTested & " not tested" )
			VAR both = solveText & IF ( solveText <> "" && checkText <> "", " · " ) & checkText
			VAR three = both & IF ( both <> "" && laterText <> "", " · " ) & laterText
			VAR words = three & IF ( three <> "" && greyText <> "", " · " ) & greyText
			RETURN "Correctness: " & IF ( words = "", "All OK", words )

	/// The line of the section Compliance (D219, src/app/view/cards.ts sectionText): it counts cards, not findings. A card to solve that is not daily work (priority later, D182) counts as when there is time.
	measure Compliance =
			VAR checkRows = CALCULATETABLE ( VALUES ( Checks[CheckId] ), Checks[Dimension] = "compliance" )
			VAR toSolve = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) IN { "To solve", "All marked as fixed" } && CALCULATE ( SELECTEDVALUE ( Checks[Priority] ) ) <> "later", 1 ) ) + 0
			VAR toCheck = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) = "To check", 1 ) ) + 0
			VAR later = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) IN { "To solve", "All marked as fixed" } && CALCULATE ( SELECTEDVALUE ( Checks[Priority] ) ) = "later", 1 ) ) + 0
			VAR notTested = SUMX ( checkRows, IF ( CALCULATE ( [Card state] ) = "Not tested", 1 ) ) + 0
			VAR solveText = IF ( toSolve > 0, toSolve & " to solve" )
			VAR checkText = IF ( toCheck > 0, toCheck & " to check" )
			VAR laterText = IF ( later > 0, later & " when there is time" )
			VAR greyText = IF ( notTested > 0, notTested & " not tested" )
			VAR both = solveText & IF ( solveText <> "" && checkText <> "", " · " ) & checkText
			VAR three = both & IF ( both <> "" && laterText <> "", " · " ) & laterText
			VAR words = three & IF ( three <> "" && greyText <> "", " · " ) & greyText
			RETURN "Compliance: " & IF ( words = "", "All OK", words )

	/// Under the title of the table of cards (All cards).
	measure 'Cards note' = IF ( COUNTROWS ( Checks ) + 0 = 0, "No card is about this: choose another subject.", "Red: to solve. Blue: to check. Green: OK. Grey: not tested. Right-click, Drill through, Card." )
		displayFolder: Page notes

	column CheckId
		dataType: string
		sourceColumn: CheckId

	column Status
		dataType: string
		sourceColumn: Status

	column Title
		dataType: string
		sourceColumn: Title

	column CardLabel
		dataType: string
		sortByColumn: SortKey
		sourceColumn: CardLabel

	column CardHint
		dataType: string
		sourceColumn: CardHint

	column CardText
		dataType: string
		sourceColumn: CardText

	column Family
		dataType: string
		sourceColumn: Family

	column Dimension
		dataType: string
		sourceColumn: Dimension

	column Section
		dataType: string
		sortByColumn: SectionOrder
		sourceColumn: Section

	column SectionOrder
		dataType: int64
		summarizeBy: none
		sourceColumn: SectionOrder

	column Severity
		dataType: string
		sourceColumn: Severity

	column Topic
		dataType: string
		sortByColumn: TopicOrder
		sourceColumn: Topic

	column TopicOrder
		dataType: int64
		summarizeBy: none
		sourceColumn: TopicOrder

	column Priority
		dataType: string
		sourceColumn: Priority

	column ReviewOnly
		dataType: boolean
		sourceColumn: ReviewOnly

	column DetectorType
		dataType: string
		sourceColumn: DetectorType

	column Module
		dataType: string
		sourceColumn: Module

	column Path
		dataType: string
		sourceColumn: Path

	column Counts
		dataType: string
		sourceColumn: Counts

	column FileOrder
		dataType: int64
		summarizeBy: none
		sourceColumn: FileOrder

	column SortKey
		dataType: int64
		summarizeBy: none
		sourceColumn: SortKey

	column FileName
		dataType: string
		sourceColumn: FileName

	column Built
		dataType: boolean
		sourceColumn: Built

	column Kind
		dataType: string
		sourceColumn: Kind

	partition Checks = m
		mode: import
		source = ChecksRows
