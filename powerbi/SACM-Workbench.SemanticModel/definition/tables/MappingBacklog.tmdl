/// One line per CI to map (D200 to D204): owner, why, stage, criticality lines of the same CI and the next step.
table MappingBacklog

	/// Lines of the mapping backlog to solve.
	measure 'CIs to map' = CALCULATE ( COUNTROWS ( MappingBacklog ), MappingBacklog[State] = "open" ) + 0
		formatString: #,0

	/// Owners of the lines to solve.
	measure 'Owners to invite' = CALCULATE ( DISTINCTCOUNT ( MappingBacklog[Owner] ), MappingBacklog[State] = "open" ) + 0
		formatString: #,0

	/// "N CIs to map for M owners" for the head of the page.
	measure 'Backlog line' = [CIs to map] & IF ( [CIs to map] = 1, " CI", " CIs" ) & " to map for " & [Owners to invite] & IF ( [Owners to invite] = 1, " owner", " owners" )

	column Key
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Key]

	column CiKey
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CiKey]

	column CiName
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CiName]

	column ClassLabel
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ClassLabel]

	/// Owned by, else who is asked.
	column Owner
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Owner]

	/// Why it is on the list, one reason per line.
	column Reasons
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Reasons]

	/// 1 To solve, 2 To check, 3 Waiting, 4 Planned: the order of the page.
	column StateOrder
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [StateOrder]

	/// The rules of the reasons (reference/mapping-backlog).
	column ReasonIds
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ReasonIds]

	/// The stage of the case (the first one until the journal is read, build B5).
	column Stage
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Stage]

	column StageNumber
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [StageNumber]

	/// The stages its class goes through.
	column Steps
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Steps]

	column State
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [State]

	/// To solve, Waiting (in Ready) or Planned (tagged).
	column StateLabel
		dataType: string
		isDataTypeInferred
		sortByColumn: StateOrder
		isNameInferred
		sourceColumn: [StateLabel]

	column StateWhy
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [StateWhy]

	/// The criticality lines of the same CI (Above parent, No criticality reaches the CI).
	column Criticality
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Criticality]

	/// The case can be marked The process does not exist (stage 2).
	column CanMarkProcessMissing
		dataType: boolean
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CanMarkProcessMissing]

	column NextStep
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [NextStep]

	column Order
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order]

	partition MappingBacklog = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "MappingBacklog" ),
					"Key", Run[MappingBacklog.Key],
					"CiKey", Run[MappingBacklog.CiKey],
					"CiName", Run[MappingBacklog.CiName],
					"ClassLabel", Run[MappingBacklog.ClassLabel],
					"Owner", Run[MappingBacklog.Owner],
					"Reasons", Run[MappingBacklog.Reasons],
					"StateOrder", Run[MappingBacklog.StateOrder],
					"ReasonIds", Run[MappingBacklog.ReasonIds],
					"Stage", Run[MappingBacklog.Stage],
					"StageNumber", Run[MappingBacklog.StageNumber],
					"Steps", Run[MappingBacklog.Steps],
					"State", Run[MappingBacklog.State],
					"StateLabel", Run[MappingBacklog.StateLabel],
					"StateWhy", Run[MappingBacklog.StateWhy],
					"Criticality", Run[MappingBacklog.Criticality],
					"CanMarkProcessMissing", Run[MappingBacklog.CanMarkProcessMissing],
					"NextStep", Run[MappingBacklog.NextStep],
					"Order", Run[MappingBacklog.Order]
				)
