/// Every reply of the list SACM Replies (D291), newest first. Matched: a message of the journal has its reference.
table Replies

	/// On a line of the replies of the Case and Person pages: the reference of the message it answers, when that message is about a finding of the page; blank hides the line.
	measure 'Reply mark' =
			VAR keys = VALUES ( Findings[Key] )
			VAR ids = CALCULATETABLE ( VALUES ( JournalKeys[EventId] ), REMOVEFILTERS ( Journal ), TREATAS ( keys, JournalKeys[Key] ) )
			VAR refs = CALCULATETABLE ( VALUES ( Journal[Ref] ), REMOVEFILTERS ( Journal ), TREATAS ( ids, Journal[Id] ), Journal[Type] = "message" )
			VAR here = SELECTEDVALUE ( Replies[Ref] )
			RETURN IF ( NOT ISBLANK ( here ) && here IN refs, here )

	/// Under the title of the replies (Case, Person).
	measure 'Replies list note' = IF ( COUNTROWS ( Replies ) + 0 = 0, "No reply yet.", "Every reply filed from the shared mailbox." )
		displayFolder: Page notes

	/// A number of Audit: the median days from the first email of a case to its reply, for the replies of the period chosen; blank with no reply.
	measure 'Days to an answer' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			VAR answers = FILTER ( ALL ( Replies[Ref], Replies[Received] ), Replies[Ref] <> "" && Replies[Received] >= fromDate && Replies[Received] < toDate + 1 )
			VAR waits =
			    ADDCOLUMNS (
			        answers,
			        "@asked",
			            VAR ref = Replies[Ref]
			            RETURN CALCULATE ( MIN ( Journal[At] ), REMOVEFILTERS ( Journal ), REMOVEFILTERS ( 'Date' ), Journal[Ref] = ref, Journal[Type] = "message" )
			    )
			VAR known = FILTER ( waits, NOT ISBLANK ( [@asked] ) && [@asked] <= Replies[Received] )
			RETURN IF ( COUNTROWS ( known ) > 0, MEDIANX ( known, DATEDIFF ( [@asked], Replies[Received], DAY ) ) )
		formatString: 0.0
		displayFolder: Audit

	column Ref
		dataType: string
		sourceColumn: Ref

	column From
		dataType: string
		sourceColumn: From

	column Received
		dataType: dateTime
		formatString: d mmm yyyy hh:nn
		summarizeBy: none
		sourceColumn: Received

	column Subject
		dataType: string
		sourceColumn: Subject

	column Body
		dataType: string
		sourceColumn: Body

	column Matched
		dataType: boolean
		summarizeBy: none
		sourceColumn: Matched

	partition Replies = m
		mode: import
		source = RepliesRows
