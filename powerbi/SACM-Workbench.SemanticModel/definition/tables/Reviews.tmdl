/// The marks of the lifecycle review in the list SACM Reviews (D291; the tab Lifecycle of the Audit page, read-only until build B8).
table Reviews

	column ReviewDate
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: ReviewDate

	column CiKey
		dataType: string
		sourceColumn: CiKey

	column CiName
		dataType: string
		sourceColumn: CiName

	column Class
		dataType: string
		sourceColumn: Class

	column StatusInEpo
		dataType: string
		sourceColumn: StatusInEpo

	column Answer
		dataType: string
		sourceColumn: Answer

	column AnswerLabel
		dataType: string
		sourceColumn: AnswerLabel

	column Note
		dataType: string
		sourceColumn: Note

	column By
		dataType: string
		sourceColumn: By

	column At
		dataType: dateTime
		formatString: d mmm yyyy hh:nn
		summarizeBy: none
		sourceColumn: At

	partition Reviews = m
		mode: import
		source = ReviewsRows
