/// The relationships of each CI of the newest CI report, from both ends, as the checks match them: for the Case page.
table RelationshipLinks

	/// 1 for the relationships of the CI of the case (the CIs the Findings filter leaves), so the Case page shows only them.
	measure 'On the case' = IF ( SELECTEDVALUE ( RelationshipLinks[CiKey] ) IN VALUES ( Findings[CiKey] ), 1 )

	/// The CI the line belongs to.
	column CiKey
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CiKey]

	/// Parent: the other CI is above it. Child: below it.
	column Relation
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Relation]

	column Other
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Other]

	column OtherClass
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [OtherClass]

	column OtherStatus
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [OtherStatus]

	column Type
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Type]

	/// No when one end is Retired: the checks do not count it.
	column Counts
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Counts]

	/// Yes: excluded from calculation, so it passes no criticality (D131).
	column Excluded
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Excluded]

	column Order
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order]

	partition RelationshipLinks = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "RelationshipLinks" ),
					"CiKey", Run[RelationshipLinks.CiKey],
					"Relation", Run[RelationshipLinks.Relation],
					"Other", Run[RelationshipLinks.Other],
					"OtherClass", Run[RelationshipLinks.OtherClass],
					"OtherStatus", Run[RelationshipLinks.OtherStatus],
					"Type", Run[RelationshipLinks.Type],
					"Counts", Run[RelationshipLinks.Counts],
					"Excluded", Run[RelationshipLinks.Excluded],
					"Order", Run[RelationshipLinks.Order]
				)
