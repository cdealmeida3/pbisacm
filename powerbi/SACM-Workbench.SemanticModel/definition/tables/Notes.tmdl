/// Why a check could not be evaluated, or only in part, on the newest report. A card with a note and nothing tested is grey (D15).
table Notes

	column CheckId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CheckId]

	column ReportDate
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [ReportDate]

	column Reason
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Reason]

	column Order
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order]

	partition Notes = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "Notes" ),
					"CheckId", Run[Notes.CheckId],
					"ReportDate", Run[Notes.ReportDate],
					"Reason", Run[Notes.Reason],
					"Order", Run[Notes.Order]
				)
