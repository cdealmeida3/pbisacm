/// The files of no known type, with what each type is missing.
table NotRead

	/// Under the title of the files not read (Reports).
	measure 'Not read note' = IF ( COUNTROWS ( NotRead ) + 0 = 0, "Every file in the folder was read.", "A file is known by its columns: these were not." )
		displayFolder: Page notes

	column FileName
		dataType: string
		sourceColumn: FileName

	column ReportDate
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: ReportDate

	column Message
		dataType: string
		sourceColumn: Message

	partition NotRead = m
		mode: import
		source = NotReadRows
