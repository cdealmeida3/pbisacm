/// The messages ready to send (build B7, D300): one row per draft, one per person across the cards (D34), a long one in parts (D36). Built by Power Query at each refresh (fnDrafts); the Power App "SACM messages" shows them and sends one when a manager presses Send (D301).
table Drafts

	/// Every message ready to send.
	measure 'Messages ready' = COUNTROWS ( Drafts ) + 0
		formatString: #,0

	/// The first messages ready to send.
	measure 'Emails ready' = CALCULATE ( COUNTROWS ( Drafts ), Drafts[Kind] = "first" ) + 0
		formatString: #,0

	/// The reminders ready to send (the working days to the reminder passed at the refresh).
	measure 'Reminders ready' = CALCULATE ( COUNTROWS ( Drafts ), Drafts[Kind] = "reminder" ) + 0
		formatString: #,0

	/// The escalations ready to send.
	measure 'Escalations ready' = CALCULATE ( COUNTROWS ( Drafts ), Drafts[Kind] = "escalation" ) + 0
		formatString: #,0

	/// The line at the top of the page Messages: how many messages are ready, of each kind.
	measure 'Messages line' =
			VAR n = [Messages ready]
			VAR firstSeen = [Emails ready]
			VAR reminders = [Reminders ready]
			VAR escalations = [Escalations ready]
			RETURN
				IF (
					n = 0,
					"No message is ready to send. After the next report, or when a reminder is due, it is listed here.",
					n & IF ( n = 1, " message", " messages" ) & " ready to send: "
						& firstSeen & IF ( firstSeen = 1, " first message, ", " first messages, " )
						& reminders & IF ( reminders = 1, " reminder and ", " reminders and " )
						& escalations & IF ( escalations = 1, " escalation.", " escalations." )
				)

	/// On a line of the page Messages: Mine when the cases of the draft are assigned to me, Free when nobody has them.
	measure 'Draft who' =
			VAR me = [Me]
			VAR who = SELECTEDVALUE ( Drafts[AssignedTo] )
			RETURN IF ( HASONEVALUE ( Drafts[DraftId] ), IF ( NOT ISBLANK ( me ) && who = me, "Mine", IF ( who = "", "Free", who ) ) )

	/// The subject on a line of the page Messages: a reminder shows the reference it answers; a new message gets its reference when a manager opens it in the app SACM messages, so the line says so instead of the token %%REF%%.
	measure 'Subject line' =
			VAR subjectText = SELECTEDVALUE ( Drafts[Subject] )
			VAR ref = SELECTEDVALUE ( Drafts[Ref] )
			RETURN IF ( HASONEVALUE ( Drafts[DraftId] ), SUBSTITUTE ( subjectText, "%%REF%%", IF ( ref <> "", ref, "reference given at Send" ) ) )

	/// Build R4 (D361, D362): the email the right side of Messages shows, and the one the app SACM messages gets (build R6, AppEmail[Selected email]): the email chosen in the list; with none chosen, the first email to (or about) the person of Prepare email (a drill-through on Findings[ContactName], which Power BI keeps until the next drill); else the first of the list (by name). Its EmailId; blank when no email is ready.
	measure 'Chosen email' =
			VAR emails = CALCULATETABLE ( FILTER ( Drafts, Drafts[DraftId] = Drafts[EmailId] ), ALLSELECTED ( Drafts ) )
			VAR every = CALCULATE ( COUNTROWS ( FILTER ( Drafts, Drafts[DraftId] = Drafts[EmailId] ) ), REMOVEFILTERS ( Drafts ) )
			VAR picked = COUNTROWS ( emails ) < every
			VAR drilled = ISFILTERED ( Findings[ContactName] )
			VAR people = VALUES ( Findings[ContactName] )
			VAR theirs = COUNTROWS ( FILTER ( emails, Drafts[ToName] IN people || Drafts[About] IN people ) ) + 0
			VAR onlyTheirs = drilled && NOT picked && theirs > 0
			VAR shown = FILTER ( emails, NOT onlyTheirs || Drafts[ToName] IN people || Drafts[About] IN people )
			VAR firstName = MINX ( shown, Drafts[ToName] )
			RETURN MINX ( FILTER ( shown, Drafts[ToName] = firstName ), Drafts[EmailId] )

	/// The CIs of the email on a line of the list of Messages: every part of it.
	measure 'Email CIs' =
			VAR ids = VALUES ( Drafts[EmailId] )
			RETURN CALCULATE ( SUM ( Drafts[CiCount] ), REMOVEFILTERS ( Drafts ), TREATAS ( ids, Drafts[EmailId] ) )
		formatString: #,0

	/// The state of the email on a line of the list of Messages: Ready, or No address when the report knows nobody to send it to (the app then asks for To).
	measure 'Email state' =
			VAR ids = VALUES ( Drafts[EmailId] )
			VAR noAddress = CALCULATE ( COUNTROWS ( Drafts ), REMOVEFILTERS ( Drafts ), TREATAS ( ids, Drafts[EmailId] ), Drafts[To] = "" )
			RETURN IF ( COUNTROWS ( ids ) > 0, IF ( noAddress > 0, "No address", "Ready" ) )

	/// The line under the title of the list of Messages: how many emails, which one the right side shows first, and (build R6, D373) the settings that would give an address to the emails that have none.
	measure 'Email list note' =
			VAR n = CALCULATE ( COUNTROWS ( FILTER ( Drafts, Drafts[DraftId] = Drafts[EmailId] ) ), REMOVEFILTERS ( Drafts ) ) + 0
			VAR who = IF ( ISFILTERED ( Findings[ContactName] ), SELECTEDVALUE ( Findings[ContactName] ) )
			VAR chosen = [Chosen email]
			VAR theirs = who <> "" && CALCULATE ( COUNTROWS ( Drafts ), REMOVEFILTERS ( Drafts ), Drafts[DraftId] = chosen, Drafts[ToName] = who || Drafts[About] = who ) > 0
			VAR noAddress = CALCULATE ( COUNTROWS ( FILTER ( Drafts, Drafts[DraftId] = Drafts[EmailId] && Drafts[To] = "" ) ), REMOVEFILTERS ( Drafts ) ) + 0
			VAR titles = CONCATENATEX ( SUMMARIZE ( FILTER ( ALL ( Drafts ), Drafts[DraftId] = Drafts[EmailId] && Drafts[AddressSetting] <> "" ), Drafts[AddressSetting] ), Drafts[AddressSetting], ", ", Drafts[AddressSetting], ASC )
			VAR addressText =
			    IF (
			        noAddress > 0,
			        " " & noAddress & IF ( noAddress = 1, " has no address", " have no address" )
			            & IF ( titles <> "", ": add " & titles & " to SACM Settings (Data check lists them).", ": the app says why." )
			    )
			RETURN
				SWITCH (
					TRUE (),
					n = 0, "No email is ready to send. After the next report, or when a reminder is due, it is listed here.",
					theirs, n & IF ( n = 1, " email", " emails" ) & ". At the right: the email to " & who & " (Prepare email), until you choose another." & addressText,
					n & IF ( n = 1, " email", " emails" ) & ". Choose one: it shows on the right as it will arrive." & addressText
				)

	/// A field of the chosen email, for the email Desktop shows under the app (build R4): To with the name, Cc, Subject.
	measure 'Chosen to' =
			VAR chosen = [Chosen email]
			VAR toName = CALCULATE ( MAX ( Drafts[ToName] ), REMOVEFILTERS ( Drafts ), Drafts[DraftId] = chosen )
			VAR toAddress = CALCULATE ( MAX ( Drafts[To] ), REMOVEFILTERS ( Drafts ), Drafts[DraftId] = chosen )
			VAR why = CALCULATE ( MAX ( Drafts[AddressWhy] ), REMOVEFILTERS ( Drafts ), Drafts[DraftId] = chosen )
			RETURN IF ( NOT ISBLANK ( chosen ), IF ( toAddress = "", toName & ". " & why, toName & " <" & toAddress & ">" ) )

	/// The Cc of the chosen email.
	measure 'Chosen cc' =
			VAR chosen = [Chosen email]
			VAR copyTo = CALCULATE ( MAX ( Drafts[Cc] ), REMOVEFILTERS ( Drafts ), Drafts[DraftId] = chosen )
			RETURN IF ( NOT ISBLANK ( chosen ), IF ( copyTo = "", "Nobody", copyTo ) )

	/// The subject of the chosen email.
	measure 'Chosen subject' =
			VAR chosen = [Chosen email]
			RETURN IF ( NOT ISBLANK ( chosen ), CALCULATE ( MAX ( Drafts[ListSubject] ), REMOVEFILTERS ( Drafts ), Drafts[DraftId] = chosen ) )

	/// The start of the chosen email as text (its first part), with your name and its reference as words, for Desktop.
	measure 'Chosen start' =
			VAR chosen = [Chosen email]
			VAR plainText = CALCULATE ( MAX ( Drafts[Plain] ), REMOVEFILTERS ( Drafts ), Drafts[DraftId] = chosen )
			VAR filled = SUBSTITUTE ( SUBSTITUTE ( plainText, "%%SENDER%%", "your name" ), "%%REF%%", "the reference" )
			VAR shortText = LEFT ( filled, 1200 )
			RETURN IF ( NOT ISBLANK ( chosen ), IF ( LEN ( filled ) > 1200, shortText & " [The email goes on: the app shows all of it.]", filled ) )

	/// The line under the title of the start of the email Desktop shows on Messages.
	measure 'Chosen body note' =
			VAR chosen = [Chosen email]
			RETURN IF ( ISBLANK ( chosen ), "No email to show.", "Your name and the reference go in when you send." )

	/// The line under the title of the email Desktop shows on Messages.
	measure 'Chosen note' =
			VAR chosen = [Chosen email]
			RETURN IF ( ISBLANK ( chosen ), "No email to show.", "The email chosen in the list, as text. The published report shows the app here." )

	/// The draft, D0001 first: by person in the order the newest report first names them (one refresh only: the next refresh numbers them again).
	column DraftId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [DraftId]

	/// The reference of the message a reminder answers (the same thread, D5); "" for a new message: the Power App makes one when it sends.
	column Ref
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Ref]

	/// first, reminder or escalation.
	column Kind
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Kind]

	/// Email, Reminder or Escalation.
	column KindLabel
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [KindLabel]
		sortByColumn: KindOrder

	/// Build R6 (D371): the order of the kind buttons of Messages, the order of the work: Email, Reminder, Escalation. From Kind, the source of KindLabel (a sort column may not use the column it sorts).
	column KindOrder = SWITCH ( Drafts[Kind], "first", 1, "reminder", 2, "escalation", 3, 4 )
		dataType: int64
		formatString: 0
		summarizeBy: none

	/// The address the message goes to; "" for an escalation nobody is known for (the manager types it, D160).
	column To
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [To]

	/// The name of who gets it.
	column ToName
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ToName]

	/// The addresses in copy, "a; b".
	column Cc
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Cc]

	/// The subject, with %%REF%% where the reference goes.
	column Subject
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Subject]

	/// The message as HTML, with %%REF%% and %%SENDER%% (the manager who sends).
	column Body
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Body]

	/// The same message as text, for Outlook.
	column Plain
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Plain]

	/// The first message of a Teams chat with the person asked (D163).
	column Chat
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Chat]

	/// The keys of the cases of the message, one per line.
	column Keys
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Keys]

	/// The keys of the second part of a reminder, "New since then" (D161), one per line.
	column NewKeys
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [NewKeys]

	/// The checks of the message, "A, B".
	column CheckIds
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CheckIds]

	/// The CIs (or contracts) of the message.
	column CiCount
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [CiCount]

	/// The part of a long message (D36).
	column PartIndex
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [PartIndex]

	/// How many parts the message has.
	column PartCount
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [PartCount]

	/// For an escalation: who did not answer.
	column About
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [About]

	/// An escalation for which nobody is known (D160).
	column NobodyAbove
		dataType: boolean
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [NobodyAbove]

	/// To the Procurement mailbox (D98).
	column Mailbox
		dataType: boolean
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mailbox]

	/// To the people of a team (D195).
	column Team
		dataType: boolean
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Team]

	/// Who the message is about: the user ID of the person asked, else the address in lower case.
	column Person
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Person]

	/// Who has the cases: a manager, Several, or "" when nobody has them.
	column AssignedTo
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [AssignedTo]

	/// The keys of the draft nobody has, one per line: they become the sender's when the message goes (D164).
	column FreeKeys
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [FreeKeys]

	/// The email (D313): the message laid out for Outlook by fnEmailTemplate, with %%REF%% and %%SENDER%%. The parts of a long message are one email (D314): it is on the first part, and the other parts hold "".
	column Html
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Html]

	/// The file the email carries when a table is longer than rowsInEmail lines (D314): every line of the email as CSV, UTF-8 with a BOM, named after the reference. "" for a short email.
	column Csv
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Csv]

	/// "In this email" as text: one line per part of the email, with its number of lines.
	column Summary
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Summary]

	/// The subject of the email: the Subject, or for the parts of a long message joined into one email, the subject of all its CIs.
	column EmailSubject
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [EmailSubject]

	/// The draft that holds the email of this one: its own DraftId on the first part of a message, the first part's on the others.
	column EmailId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [EmailId]

	/// Build R6 (D373): the Title of SACM Settings that would give this draft its To, when it has none: procurementEmail (the Procurement mailbox), team.<id>.people (a team), epoOwnerEmail (the EPO inventory owner); "" when it has an address or the address is not a setting (a person, an escalation nobody is known for).
	column AddressSetting
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [AddressSetting]

	/// Build R6 (D373): why the draft has no To, and what fixes it, in words; "" when it has an address. The app SACM messages and the email Desktop shows say it in place of To.
	column AddressWhy
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [AddressWhy]

	/// Build R4 (D361): the subject of the email of this draft as the list of Messages shows it: the subject of its first part, with its reference, or the words that say when it gets one. One value per email (the subject names the person, the reference or who did not answer), so the list shows each email on one line.
	column ListSubject =
			VAR firstSubject = LOOKUPVALUE ( Drafts[EmailSubject], Drafts[DraftId], Drafts[EmailId] )
			VAR ref = LOOKUPVALUE ( Drafts[Ref], Drafts[DraftId], Drafts[EmailId] )
			RETURN SUBSTITUTE ( firstSubject, "%%REF%%", IF ( ref <> "", ref, "reference given at Send" ) )
		dataType: string
		summarizeBy: none

	/// The length of Html, for the app SACM messages (build D5): the Power Apps visual may pass a long text cut, so the app compares what it got with this and does not send a cut email.
	column HtmlLength = LEN ( Drafts[Html] )
		dataType: int64
		formatString: 0
		summarizeBy: none

	/// The length of Csv, for the same check of the app.
	column CsvLength = LEN ( Drafts[Csv] )
		dataType: int64
		formatString: 0
		summarizeBy: none

	partition Drafts = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "Drafts" ),
					"DraftId", Run[Drafts.DraftId],
					"Ref", Run[Drafts.Ref],
					"Kind", Run[Drafts.Kind],
					"KindLabel", Run[Drafts.KindLabel],
					"To", Run[Drafts.To],
					"ToName", Run[Drafts.ToName],
					"Cc", Run[Drafts.Cc],
					"Subject", Run[Drafts.Subject],
					"Body", Run[Drafts.Body],
					"Plain", Run[Drafts.Plain],
					"Chat", Run[Drafts.Chat],
					"Keys", Run[Drafts.Keys],
					"NewKeys", Run[Drafts.NewKeys],
					"CheckIds", Run[Drafts.CheckIds],
					"CiCount", Run[Drafts.CiCount],
					"PartIndex", Run[Drafts.PartIndex],
					"PartCount", Run[Drafts.PartCount],
					"About", Run[Drafts.About],
					"NobodyAbove", Run[Drafts.NobodyAbove],
					"Mailbox", Run[Drafts.Mailbox],
					"Team", Run[Drafts.Team],
					"Person", Run[Drafts.Person],
					"AssignedTo", Run[Drafts.AssignedTo],
					"FreeKeys", Run[Drafts.FreeKeys],
					"Html", Run[Drafts.Html],
					"Csv", Run[Drafts.Csv],
					"Summary", Run[Drafts.Summary],
					"EmailSubject", Run[Drafts.EmailSubject],
					"EmailId", Run[Drafts.EmailId],
					"AddressSetting", Run[Drafts.AddressSetting],
					"AddressWhy", Run[Drafts.AddressWhy]
				)
