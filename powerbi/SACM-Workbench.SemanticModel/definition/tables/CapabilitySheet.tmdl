/// Every Business Capability of the newest CI report with the capabilities above and below, the processes below and its people (D205), for Enterprise Architecture.
table CapabilitySheet

	/// How many Business Capabilities the sheet holds, or why it is empty (it needs the Relationship report).
	measure 'Capability line' = VAR n = COUNTROWS ( CapabilitySheet ) + 0 RETURN IF ( n = 0, "No capability sheet: it needs the Relationship report and the relationship model.", FORMAT ( n, "#,0" ) & IF ( n = 1, " Business Capability", " Business Capabilities" ) )

	column Name
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Name]

	column Status
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Status]

	column CapabilitiesAbove
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CapabilitiesAbove]

	column CapabilitiesBelow
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CapabilitiesBelow]

	column ProcessesBelow
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ProcessesBelow]

	column Description
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Description]

	column Tags
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Tags]

	column OwnedBy
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [OwnedBy]

	column ManagedBy
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ManagedBy]

	column HiddenCharacters
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [HiddenCharacters]

	column Order
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order]

	/// The asset tag (EPO ID) of the capability (build R5).
	column AssetTag
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [AssetTag]

	/// The name as the page shows it (build R5, D367): with the asset tag in brackets when another capability has the same name, so two lines of one name do not look like one line twice.
	column NameShown =
			VAR named = CapabilitySheet[Name]
			VAR same = CALCULATE ( COUNTROWS ( CapabilitySheet ), ALL ( CapabilitySheet ), CapabilitySheet[Name] = named )
			RETURN IF ( same > 1 && CapabilitySheet[AssetTag] <> "", named & " (" & CapabilitySheet[AssetTag] & ")", named )
		dataType: string
		summarizeBy: none

	partition CapabilitySheet = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "CapabilitySheet" ),
					"Name", Run[CapabilitySheet.Name],
					"Status", Run[CapabilitySheet.Status],
					"CapabilitiesAbove", Run[CapabilitySheet.CapabilitiesAbove],
					"CapabilitiesBelow", Run[CapabilitySheet.CapabilitiesBelow],
					"ProcessesBelow", Run[CapabilitySheet.ProcessesBelow],
					"Description", Run[CapabilitySheet.Description],
					"Tags", Run[CapabilitySheet.Tags],
					"OwnedBy", Run[CapabilitySheet.OwnedBy],
					"ManagedBy", Run[CapabilitySheet.ManagedBy],
					"HiddenCharacters", Run[CapabilitySheet.HiddenCharacters],
					"Order", Run[CapabilitySheet.Order],
					"AssetTag", Run[CapabilitySheet.AssetTag]
				)
