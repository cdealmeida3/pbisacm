/// Per check: what the HTML app finds on the samples, and what this model finds.
table SelfCheck

	/// How many checks give the result the HTML app records for the samples. Only for the sample data.
	measure 'Self-check result' =
			VAR total = COUNTROWS ( SelfCheck )
			VAR matching = CALCULATE ( COUNTROWS ( SelfCheck ), SelfCheck[Match] = TRUE () ) + 0
			RETURN
			    IF (
			        SELECTEDVALUE ( About[SourceMode] ) = "Sample",
			        matching & " of " & total & " checks give the recorded result",
			        "The self-check runs on the sample data only (SourceMode = Sample)"
			    )

	column CheckId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CheckId]

	column ExpectedState
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ExpectedState]

	column ExpectedTested
		dataType: boolean
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ExpectedTested]

	column ExpectedToSolve
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [ExpectedToSolve]

	column ExpectedToCheck
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [ExpectedToCheck]

	column ExpectedWaiting
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [ExpectedWaiting]

	column ExpectedKnown
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [ExpectedKnown]

	column ExpectedCis
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [ExpectedCis]

	column Found
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Found]

	column FoundState
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [FoundState]

	column FoundTested
		dataType: boolean
		isDataTypeInferred
		isNameInferred
		sourceColumn: [FoundTested]

	column FoundToSolve
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [FoundToSolve]

	column FoundToCheck
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [FoundToCheck]

	column FoundWaiting
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [FoundWaiting]

	column FoundKnown
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [FoundKnown]

	column FoundCis
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [FoundCis]

	column Match
		dataType: boolean
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Match]

	column Why
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Why]

	partition SelfCheck = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "SelfCheck" ),
					"CheckId", Run[SelfCheck.CheckId],
					"ExpectedState", Run[SelfCheck.ExpectedState],
					"ExpectedTested", Run[SelfCheck.ExpectedTested],
					"ExpectedToSolve", Run[SelfCheck.ExpectedToSolve],
					"ExpectedToCheck", Run[SelfCheck.ExpectedToCheck],
					"ExpectedWaiting", Run[SelfCheck.ExpectedWaiting],
					"ExpectedKnown", Run[SelfCheck.ExpectedKnown],
					"ExpectedCis", Run[SelfCheck.ExpectedCis],
					"Found", Run[SelfCheck.Found],
					"FoundState", Run[SelfCheck.FoundState],
					"FoundTested", Run[SelfCheck.FoundTested],
					"FoundToSolve", Run[SelfCheck.FoundToSolve],
					"FoundToCheck", Run[SelfCheck.FoundToCheck],
					"FoundWaiting", Run[SelfCheck.FoundWaiting],
					"FoundKnown", Run[SelfCheck.FoundKnown],
					"FoundCis", Run[SelfCheck.FoundCis],
					"Match", Run[SelfCheck.Match],
					"Why", Run[SelfCheck.Why]
				)
