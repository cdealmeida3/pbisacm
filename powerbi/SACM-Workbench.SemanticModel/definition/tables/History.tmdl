/// Every finding of every CI report date (D290), from the table HistoryRun: the trends per card, team and class, new and solved between two reports, the days to fix.
table History

	/// The findings of the report dates in view (one date: that report).
	measure 'History findings' = COUNTROWS ( History ) + 0
		formatString: #,0

	/// The findings to solve of the report dates in view.
	measure 'History to solve' = CALCULATE ( COUNTROWS ( History ), History[State] = "open" ) + 0
		formatString: #,0

	/// The date of the newest CI report.
	measure 'Newest report date' = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ) )
		formatString: d mmm yyyy

	/// The findings of the newest CI report.
	measure 'Findings at the newest report' =
			VAR d = [Newest report date]
			RETURN CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d ) + 0
		formatString: #,0

	/// The findings of the CI report before the newest.
	measure 'Findings at the report before' =
			VAR d = [Newest report date]
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			RETURN CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = priorDate ) + 0
		formatString: #,0

	/// New since the report before (D172): findings to solve of the report date in view (the newest when none is chosen) that the CI report before did not show. Blank for the first report date.
	measure New =
			VAR d = MAX ( Runs[ReportDate] )
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			VAR shown = CALCULATETABLE ( VALUES ( History[Key] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, History[State] = "open" )
			VAR shownBefore = CALCULATETABLE ( VALUES ( History[Key] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = priorDate )
			RETURN IF ( NOT ISBLANK ( priorDate ), COUNTROWS ( EXCEPT ( shown, shownBefore ) ) + 0 )
		formatString: #,0

	/// Solved since the report before (D59, D174): findings of the CI report before that the report date in view (the newest when none is chosen) no longer shows, where it contains the CI and tested that part of the check. Blank for the first report date.
	measure Solved =
			VAR d = MAX ( Runs[ReportDate] )
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			VAR shown = CALCULATETABLE ( VALUES ( History[Key] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d )
			VAR parts = CALCULATETABLE ( VALUES ( HistoryChecked[Id] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, HistoryChecked[Kind] = "part" )
			VAR cis = CALCULATETABLE ( VALUES ( HistoryChecked[Id] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, HistoryChecked[Kind] = "ci" )
			VAR solved =
			    FILTER (
			        CALCULATETABLE ( History, REMOVEFILTERS ( Runs ), Runs[ReportDate] = priorDate ),
			        NOT ( History[Key] IN shown ) && ( History[CheckId] & ":" & History[Field] ) IN parts && History[CiKey] IN cis
			    )
			RETURN IF ( NOT ISBLANK ( priorDate ), COUNTROWS ( solved ) + 0 )
		formatString: #,0

	/// The average days from the first report that showed a finding to the report that solved it, for the findings solved at the report date in view.
	measure 'Days to fix' =
			VAR d = MAX ( Runs[ReportDate] )
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			VAR shown = CALCULATETABLE ( VALUES ( History[Key] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d )
			VAR parts = CALCULATETABLE ( VALUES ( HistoryChecked[Id] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, HistoryChecked[Kind] = "part" )
			VAR cis = CALCULATETABLE ( VALUES ( HistoryChecked[Id] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, HistoryChecked[Kind] = "ci" )
			VAR solved =
			    FILTER (
			        CALCULATETABLE ( History, REMOVEFILTERS ( Runs ), Runs[ReportDate] = priorDate ),
			        NOT ( History[Key] IN shown ) && ( History[CheckId] & ":" & History[Field] ) IN parts && History[CiKey] IN cis
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( priorDate ),
			        AVERAGEX ( solved, DATEDIFF ( CALCULATE ( MIN ( History[ReportDate] ), REMOVEFILTERS ( Runs ), ALLEXCEPT ( History, History[Key] ) ), d, DAY ) )
			    )
		formatString: 0

	/// New since the report before on a daily card (My day, D182); blank when none.
	measure 'New (daily)' =
			VAR n = CALCULATE ( [New], KEEPFILTERS ( Checks[Priority] <> "later" ) )
			RETURN IF ( n > 0, n )
		formatString: #,0

	/// Solved since the report before on a daily card; blank when none.
	measure 'Solved (daily)' =
			VAR n = CALCULATE ( [Solved], KEEPFILTERS ( Checks[Priority] <> "later" ) )
			RETURN IF ( n > 0, n )
		formatString: #,0

	/// The line of My day: "Since the report of 4 Nov: 23 new, 2 solved."
	measure 'Since line' =
			VAR d = [Newest report date]
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			RETURN
			    IF (
			        ISBLANK ( priorDate ),
			        "One CI report so far: new and solved show from the second report.",
			        "Since the report of " & FORMAT ( priorDate, "d mmm" ) & ": " & FORMAT ( CALCULATE ( [New], REMOVEFILTERS ( Runs ) ), "#,0" ) & " new, "
			            & FORMAT ( CALCULATE ( [Solved], REMOVEFILTERS ( Runs ) ), "#,0" ) & " solved."
			    )

	/// The first report date that showed the finding.
	measure 'First seen' = CALCULATE ( MIN ( History[ReportDate] ), ALLEXCEPT ( History, History[Key] ) )
		formatString: d mmm yyyy

	/// On a line of one finding and one report date: the next report date, when that report contains the CI, tested the part and no longer shows the finding (the export of the Audit page); blank otherwise.
	measure 'Verified on' =
			VAR shownOn = SELECTEDVALUE ( History[ReportDate] )
			VAR findingKey = SELECTEDVALUE ( History[Key] )
			VAR part = SELECTEDVALUE ( History[CheckId] ) & ":" & SELECTEDVALUE ( History[Field] )
			VAR ciKey = SELECTEDVALUE ( History[CiKey] )
			VAR d = CALCULATE ( MIN ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] > shownOn )
			VAR shownNext = CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), REMOVEFILTERS ( History ), History[Key] = findingKey, Runs[ReportDate] = d )
			VAR testedRows = CALCULATE ( COUNTROWS ( HistoryChecked ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, HistoryChecked[Kind] = "part", HistoryChecked[Id] = part )
			VAR checked = CALCULATE ( COUNTROWS ( HistoryChecked ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, HistoryChecked[Kind] = "ci", HistoryChecked[Id] = ciKey )
			RETURN IF ( NOT ISBLANK ( findingKey ) && NOT ISBLANK ( d ) && ISBLANK ( shownNext ) && testedRows > 0 && checked > 0, d )
		formatString: d mmm yyyy

	/// The first report date of a finding that a later report verified (the export of the Audit page); blank otherwise.
	measure 'First seen (verified)' = IF ( NOT ISBLANK ( [Verified on] ), [First seen] )
		formatString: d mmm yyyy

	/// The verification record (Audit): the findings to solve of the report date in view.
	measure 'Record to solve' =
			VAR d = MAX ( Runs[ReportDate] )
			RETURN CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, History[State] = "open" ) + 0
		formatString: #,0

	/// The verification record: the CIs to solve of the report date in view.
	measure 'Record CIs to solve' =
			VAR d = MAX ( Runs[ReportDate] )
			RETURN CALCULATE ( DISTINCTCOUNT ( History[CiKey] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, History[State] = "open" ) + 0
		formatString: #,0

	/// The verification record: the other findings (waiting, known, to check) of the report date in view.
	measure 'Record other' =
			VAR d = MAX ( Runs[ReportDate] )
			RETURN CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, History[State] <> "open" ) + 0
		formatString: #,0

	/// The export of the Audit page, the findings per check (findings.csv of the HTML app): the findings to solve on the CI reports dated in the period; blank when none.
	measure 'Period findings' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			VAR n = CALCULATE ( DISTINCTCOUNT ( History[Key] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] >= fromDate, Runs[ReportDate] <= toDate, History[State] = "open" )
			RETURN IF ( n > 0, n )
		formatString: #,0

	/// The CIs with a finding to solve on the CI reports dated in the period (findings.csv).
	measure 'Period CIs' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			VAR n = CALCULATE ( DISTINCTCOUNT ( History[CiKey] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] >= fromDate, Runs[ReportDate] <= toDate, History[State] = "open" )
			RETURN IF ( n > 0, n )
		formatString: #,0

	/// Of the findings of the period, those first seen in it (findings.csv, "New in the period").
	measure 'New in the period' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			VAR keys = CALCULATETABLE ( VALUES ( History[Key] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] >= fromDate, Runs[ReportDate] <= toDate, History[State] = "open" )
			VAR fresh = FILTER ( keys, VAR firstSeen = CALCULATE ( MIN ( History[ReportDate] ), REMOVEFILTERS ( Runs ), ALLEXCEPT ( History, History[Key] ) ) RETURN firstSeen >= fromDate && firstSeen <= toDate )
			RETURN IF ( NOT ISEMPTY ( keys ), COUNTROWS ( fresh ) + 0 )
		formatString: #,0

	/// The newest CI report dated on or before the end of the period: the report of "Open at the end".
	measure 'End report date' =
			VAR toDate = [Period to]
			RETURN CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] <= toDate )
		formatString: d mmm yyyy

	/// The export of the Audit page, open at the end (open.csv of the HTML app): the first report date of a finding the report of the end of the period still shows; blank for the others.
	measure 'Open first seen' =
			VAR d = [End report date]
			VAR shown = CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d )
			RETURN IF ( NOT ISBLANK ( d ) && shown > 0, [First seen] )
		formatString: d mmm yyyy

	/// The age in days of a finding open at the end of the period: from its first report to the report of the end.
	measure 'Open age' =
			VAR firstSeen = [Open first seen]
			RETURN IF ( NOT ISBLANK ( firstSeen ), DATEDIFF ( firstSeen, [End report date], DAY ) )
		formatString: 0

	/// On a line of the verified findings: the days from the first report that showed it to the report that verified it (verified.csv, "Days").
	measure 'Days to verify' =
			VAR verified = [Verified on]
			RETURN IF ( NOT ISBLANK ( verified ), DATEDIFF ( [First seen], verified, DAY ) )
		formatString: 0

	/// The line over the verified findings: how many a report of the period verified, the average and the longest days to verify.
	measure 'Verified line' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < fromDate )
			VAR candidates = CALCULATETABLE ( SUMMARIZE ( History, History[Key], History[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < toDate, Runs[ReportDate] >= COALESCE ( priorDate, fromDate ) )
			VAR verified = FILTER ( ADDCOLUMNS ( candidates, "@on", [Verified on], "@days", [Days to verify] ), NOT ISBLANK ( [@on] ) && [@on] >= fromDate && [@on] <= toDate )
			VAR n = COUNTROWS ( verified ) + 0
			RETURN
			    IF (
			        n = 0,
			        "No finding was verified by a CI report of the period.",
			        FORMAT ( n, "#,0" ) & IF ( n = 1, " finding", " findings" ) & " verified by a CI report of the period · on average "
			            & FORMAT ( AVERAGEX ( verified, [@days] ), "0" ) & " days from the first report · the longest " & FORMAT ( MAXX ( verified, [@days] ), "0" ) & " days."
			    )

	/// Under the title of the trend (History).
	measure 'Trend note' = IF ( [Report dates] + 0 < 2, "One CI report so far: the trend shows from the second.", "Each CI report date, for 24 months." )
		displayFolder: Page notes

	/// Under the title of the days to fix (History).
	measure 'Days to fix note' = IF ( [Report dates] + 0 < 2, "One CI report so far: the days show from the second.", "Average days from the first report that showed a finding to the one that no longer did." )
		displayFolder: Page notes

	/// Under the title of the per group and per class tables (History).
	measure 'Per group note' = IF ( [History to solve] = 0, "Nothing to solve on the report dates chosen.", "To solve on each CI report date." )
		displayFolder: Page notes

	/// Under the title of To solve per support group (History): the table leaves out the findings with no support group.
	measure 'Per team note' = IF ( [History to solve] = 0, "Nothing to solve on the report dates chosen.", "To solve on each CI report date. A contract or a CI with no support group is not in this table." )
		displayFolder: Page notes

	/// Under the title of the record (Audit).
	measure 'Record note' = "Per check, on " & FORMAT ( COALESCE ( MAX ( Runs[ReportDate] ), [Newest report date] ), "d mmm yyyy" ) & ": the newest report date when none is chosen."
		displayFolder: Page notes

	/// Under the title of found per check (Audit export).
	measure 'Found note' = IF ( ISBLANK ( [Period findings] ), "Nothing found in the period chosen.", "Each check with what it found in the period chosen." )
		displayFolder: Page notes

	/// Under the title of open at the end of the period (Audit export).
	measure 'Open at end note' = "Open on the newest CI report on or before " & FORMAT ( [Period to], "d mmm yyyy" ) & "."
		displayFolder: Page notes

	/// Under the title of the box Since the last report (My day): the report it compares with: what the bars mean, or why there are none.
	measure 'Since note' =
			VAR d = [Newest report date]
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), "No CI report is loaded yet.",
			        ISBLANK ( priorDate ), "One CI report so far: new and solved show from the second report.",
			        "Since the report of " & FORMAT ( priorDate, "d mmm" ) & ", the daily cards: open before in navy, new in coral."
			    )
		displayFolder: Page notes

	/// To solve on the newest CI report, on the daily cards (one section of My day).
	measure 'Section open' =
			VAR d = [Newest report date]
			RETURN CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, History[State] = "open", KEEPFILTERS ( Checks[Priority] <> "later" ) ) + 0
		formatString: #,0
		displayFolder: My day

	/// On a section of My day: the words new, solved and open, a bar of what is open (open before in navy, new in coral) on the scale of the biggest section, and at the right a small line of what was open on each CI report date, oldest first, the newest a coral dot. One picture of 240 × 32: a table gives all its pictures one size.
	measure 'Section bar' =
			VAR openNow = [Section open]
			VAR fresh = [New (daily)] + 0
			VAR solved = [Solved (daily)] + 0
			VAR most = MAXX ( ALL ( Checks[Section] ), [Section open] )
			VAR unit = 160 / MAX ( most, 1 )
			VAR older = ROUND ( MAX ( openNow - fresh, 0 ) * unit, 0 )
			VAR added = ROUND ( MIN ( fresh, openNow ) * unit, 0 )
			VAR words = "+" & fresh & " new · " & solved & " solved · " & openNow & " open"
			VAR points =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ) ),
			        "@open", CALCULATE ( COUNTROWS ( History ), History[State] = "open", KEEPFILTERS ( Checks[Priority] <> "later" ) ) + 0
			    )
			VAR n = COUNTROWS ( points )
			VAR highest = MAX ( MAXX ( points, [@open] ), 1 )
			VAR placed = ADDCOLUMNS ( points, "@x", ROUND ( 180 + ( RANKX ( points, Runs[ReportDate], , ASC, DENSE ) - 1 ) * 54 / MAX ( n - 1, 1 ), 0 ), "@y", ROUND ( 28 - [@open] * 22 / highest, 0 ) )
			VAR newest = TOPN ( 1, placed, Runs[ReportDate], DESC )
			VAR trace = CONCATENATEX ( placed, [@x] & "," & [@y], " ", Runs[ReportDate], ASC )
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='240' height='32' viewBox='0 0 240 32'>"
			        & "<text x='0' y='12' font-family='Segoe UI, sans-serif' font-size='12' fill='#655a52'>" & words & "</text>"
			        & "<rect x='0' y='20' width='160' height='8' rx='4' fill='#f2f4f7'/>"
			        & "<rect x='0' y='20' width='" & older & "' height='8' fill='#0c1c49'/>"
			        & "<rect x='" & older & "' y='20' width='" & added & "' height='8' fill='#fd472c'/>"
			        & IF ( n > 1, "<polyline points='" & trace & "' fill='none' stroke='#0c1c49' stroke-width='1.6' stroke-linejoin='round'/>" )
			        & IF ( n > 0, "<circle cx='" & MAXX ( newest, [@x] ) & "' cy='" & MAXX ( newest, [@y] ) & "' r='2.5' fill='#fd472c'/>" )
			        & "</svg>"
			RETURN IF ( NOT ISBLANK ( [Newest report date] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" ) )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// A number of Overview: what the newest CI report has to solve, on every card.
	measure 'Open now' =
			VAR d = [Newest report date]
			RETURN CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, History[State] = "open" ) + 0
		formatString: #,0
		displayFolder: Overview

	/// Under the number of open lines (Overview): how it moved since the report before.
	measure 'Open now line' =
			VAR d = [Newest report date]
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			VAR openBefore = CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = priorDate, History[State] = "open" ) + 0
			VAR delta = [Open now] - openBefore
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), "No CI report yet",
			        ISBLANK ( priorDate ), "One CI report so far",
			        delta = 0, "the same as on " & FORMAT ( priorDate, "d mmm" ),
			        delta < 0, FORMAT ( -delta, "#,0" ) & " fewer than on " & FORMAT ( priorDate, "d mmm" ),
			        FORMAT ( delta, "#,0" ) & " more than on " & FORMAT ( priorDate, "d mmm" )
			    )
		displayFolder: Overview

	/// A number of Overview: the lines of the newest CI report that wait for a person (a person or a team is named).
	measure 'Waiting now' =
			VAR d = [Newest report date]
			RETURN CALCULATE ( COUNTROWS ( History ), REMOVEFILTERS ( Runs ), Runs[ReportDate] = d, History[State] = "open", History[ContactName] <> "" ) + 0
		formatString: #,0
		displayFolder: Overview

	/// Under the lines that wait for a person (Overview): what is due today.
	measure 'Waiting now line' =
			VAR up = [To escalate]
			VAR due = [Reminders due]
			RETURN up & " to escalate · " & due & IF ( due = 1, " reminder due", " reminders due" )
		displayFolder: Overview

	/// A number of Overview: the findings the newest CI report verified as solved (gone from a tested part of a CI it still has).
	measure 'Solved now' = CALCULATE ( [Solved], REMOVEFILTERS ( Runs ) ) + 0
		formatString: #,0
		displayFolder: Overview

	/// Under the solved findings (Overview): which reports it compares.
	measure 'Solved now line' =
			VAR d = [Newest report date]
			VAR priorDate = CALCULATE ( MAX ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] < d )
			RETURN IF ( ISBLANK ( priorDate ), "from the second CI report on", "since " & FORMAT ( priorDate, "d mmm" ) & ", verified by the report of " & FORMAT ( d, "d mmm" ) )
		displayFolder: Overview

	/// The open lines of each of the last 12 CI report dates as a small line, the newest a dot (Overview, Open lines). 120 × 36.
	measure 'Open trend' =
			VAR points =
			    ADDCOLUMNS (
			        TOPN ( 12, CALCULATETABLE ( VALUES ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ) ), Runs[ReportDate], DESC ),
			        "@v", CALCULATE ( COUNTROWS ( History ), History[State] = "open" ) + 0
			    )
			VAR n = COUNTROWS ( points )
			VAR highest = MAXX ( points, [@v] )
			VAR lowest = MINX ( points, [@v] )
			VAR span = MAX ( highest - lowest, 1 )
			VAR placed = ADDCOLUMNS ( points, "@x", ROUND ( 4 + ( RANKX ( points, Runs[ReportDate], , ASC, DENSE ) - 1 ) * 112 / MAX ( n - 1, 1 ), 0 ), "@y", ROUND ( 31 - ( [@v] - lowest ) * 26 / span, 0 ) )
			VAR newest = TOPN ( 1, placed, Runs[ReportDate], DESC )
			VAR trace = CONCATENATEX ( placed, [@x] & "," & [@y], " ", Runs[ReportDate], ASC )
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='36' viewBox='0 0 120 36'>"
			        & IF ( n > 1, "<polyline points='" & trace & "' fill='none' stroke='#0c1c49' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>" )
			        & IF ( n > 0, "<circle cx='" & MAXX ( newest, [@x] ) & "' cy='" & MAXX ( newest, [@y] ) & "' r='3' fill='#0c1c49'/>" )
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// The lines that waited for a person on each of the last 12 CI report dates as a small line (Overview). 120 × 36.
	measure 'Waiting trend' =
			VAR points =
			    ADDCOLUMNS (
			        TOPN ( 12, CALCULATETABLE ( VALUES ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ) ), Runs[ReportDate], DESC ),
			        "@v", CALCULATE ( COUNTROWS ( History ), History[State] = "open", History[ContactName] <> "" ) + 0
			    )
			VAR n = COUNTROWS ( points )
			VAR highest = MAXX ( points, [@v] )
			VAR lowest = MINX ( points, [@v] )
			VAR span = MAX ( highest - lowest, 1 )
			VAR placed = ADDCOLUMNS ( points, "@x", ROUND ( 4 + ( RANKX ( points, Runs[ReportDate], , ASC, DENSE ) - 1 ) * 112 / MAX ( n - 1, 1 ), 0 ), "@y", ROUND ( 31 - ( [@v] - lowest ) * 26 / span, 0 ) )
			VAR newest = TOPN ( 1, placed, Runs[ReportDate], DESC )
			VAR trace = CONCATENATEX ( placed, [@x] & "," & [@y], " ", Runs[ReportDate], ASC )
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='36' viewBox='0 0 120 36'>"
			        & IF ( n > 1, "<polyline points='" & trace & "' fill='none' stroke='#0c1c49' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>" )
			        & IF ( n > 0, "<circle cx='" & MAXX ( newest, [@x] ) & "' cy='" & MAXX ( newest, [@y] ) & "' r='3' fill='#0c1c49'/>" )
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// The findings verified as solved on each of the last 12 CI report dates as a small line in teal (Overview). 120 × 36.
	measure 'Solved trend' =
			VAR points =
			    ADDCOLUMNS (
			        TOPN ( 12, CALCULATETABLE ( VALUES ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ) ), Runs[ReportDate], DESC ),
			        "@v", CALCULATE ( [Solved] ) + 0
			    )
			VAR n = COUNTROWS ( points )
			VAR highest = MAXX ( points, [@v] )
			VAR lowest = MINX ( points, [@v] )
			VAR span = MAX ( highest - lowest, 1 )
			VAR placed = ADDCOLUMNS ( points, "@x", ROUND ( 4 + ( RANKX ( points, Runs[ReportDate], , ASC, DENSE ) - 1 ) * 112 / MAX ( n - 1, 1 ), 0 ), "@y", ROUND ( 31 - ( [@v] - lowest ) * 26 / span, 0 ) )
			VAR newest = TOPN ( 1, placed, Runs[ReportDate], DESC )
			VAR trace = CONCATENATEX ( placed, [@x] & "," & [@y], " ", Runs[ReportDate], ASC )
			VAR picture =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='36' viewBox='0 0 120 36'>"
			        & IF ( n > 1, "<polyline points='" & trace & "' fill='none' stroke='#107569' stroke-width='2' stroke-linejoin='round' stroke-linecap='round'/>" )
			        & IF ( n > 0, "<circle cx='" & MAXX ( newest, [@x] ) & "' cy='" & MAXX ( newest, [@y] ) & "' r='3' fill='#107569'/>" )
			        & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( picture, "#", "%23" )
		displayFolder: Pictures
		dataCategory: ImageUrl

	/// A line of Open lines per report (Overview): the lines of a CI report date that wait for a person.
	measure 'With a person' = CALCULATE ( COUNTROWS ( History ), History[State] = "open", History[ContactName] <> "" ) + 0
		formatString: #,0
		displayFolder: Overview

	/// A line of Open lines per report (Overview): the lines of a CI report date that SACM fixes itself (no person is named).
	measure 'SACM fixes' = CALCULATE ( COUNTROWS ( History ), History[State] = "open", History[ContactName] = "" ) + 0
		formatString: #,0
		displayFolder: Overview

	/// Under the title of Open lines per report (Overview).
	measure 'Overview trend note' = IF ( [Report dates] + 0 < 2, "One CI report so far: the lines show from the second.", "Each CI report date: the lines that wait for a person, and the ones SACM fixes itself." )
		displayFolder: Page notes

	/// A column of Found and closed (Audit): the new findings of a CI report date in the period chosen.
	measure 'Found in the period' =
			VAR d = MAX ( Runs[ReportDate] )
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			RETURN IF ( d >= fromDate && d <= toDate, [New] )
		formatString: #,0
		displayFolder: Audit

	/// A column of Found and closed (Audit): the findings a CI report date of the period verified as solved.
	measure 'Closed in the period' =
			VAR d = MAX ( Runs[ReportDate] )
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			RETURN IF ( d >= fromDate && d <= toDate, [Solved] )
		formatString: #,0
		displayFolder: Audit

	/// A number of Audit: the findings the CI reports of the period verified as solved.
	measure 'Closed and verified' =
			VAR fromDate = [Period from]
			VAR toDate = [Period to]
			VAR dates = CALCULATETABLE ( VALUES ( Runs[ReportDate] ), REMOVEFILTERS ( Runs ), Runs[ReportDate] >= fromDate, Runs[ReportDate] <= toDate )
			RETURN SUMX ( dates, CALCULATE ( [Solved] ) ) + 0
		formatString: #,0
		displayFolder: Audit

	/// Under the number closed and verified (Audit): its share of the findings of the period.
	measure 'Closed line' =
			VAR found = [Period findings] + 0
			RETURN IF ( found = 0, "nothing was found in the period", FORMAT ( DIVIDE ( [Closed and verified], found ), "0 %" ) & " of the findings of the period" )
		displayFolder: Audit

	/// Under the title of Found and closed (Audit).
	measure 'Found closed note' = IF ( [Report dates] + 0 < 2, "One CI report so far: found and closed show from the second.", "Each CI report date of the period: the new findings, and the ones it verified as solved." )
		displayFolder: Page notes

	column ReportDate
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [ReportDate]

	column Key
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Key]

	column CheckId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CheckId]

	column CiKey
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CiKey]

	column CiName
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CiName]

	column Class
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Class]

	column ClassLabel
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ClassLabel]

	column Field
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Field]

	column State
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [State]

	column SupportGroup
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [SupportGroup]

	column ContactName
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [ContactName]

	partition History = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( HistoryRun, HistoryRun[Part] = "History" ),
					"ReportDate", HistoryRun[History.ReportDate],
					"Key", HistoryRun[History.Key],
					"CheckId", HistoryRun[History.CheckId],
					"CiKey", HistoryRun[History.CiKey],
					"CiName", HistoryRun[History.CiName],
					"Class", HistoryRun[History.Class],
					"ClassLabel", HistoryRun[History.ClassLabel],
					"Field", HistoryRun[History.Field],
					"State", HistoryRun[History.State],
					"SupportGroup", HistoryRun[History.SupportGroup],
					"ContactName", HistoryRun[History.ContactName]
				)
