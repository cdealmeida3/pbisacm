/// Each part of a check the newest CI report could test, and the CIs it evaluated (D15). A card with no row here is grey, never green.
table Tested

	/// How many CIs the newest report tested for a check: the biggest number over its parts.
	measure 'Tested CIs' = MAX ( Tested[Evaluated] ) + 0
		formatString: #,0

	column CheckId
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [CheckId]

	column Part
		dataType: string
		isDataTypeInferred
		isNameInferred
		sourceColumn: [Part]

	column ReportDate
		dataType: dateTime
		isDataTypeInferred
		formatString: d mmm yyyy
		summarizeBy: none
		isNameInferred
		sourceColumn: [ReportDate]

	column Evaluated
		dataType: int64
		isDataTypeInferred
		summarizeBy: none
		isNameInferred
		sourceColumn: [Evaluated]

	partition Tested = calculated
		mode: import
		source =
				SELECTCOLUMNS (
					FILTER ( Run, Run[Part] = "Tested" ),
					"CheckId", Run[Tested.CheckId],
					"Part", Run[Tested.Part],
					"ReportDate", Run[Tested.ReportDate],
					"Evaluated", Run[Tested.Evaluated]
				)
