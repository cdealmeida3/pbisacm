// GENERATED by npm run powerbi:generate from powerbi/apps/actions.json, src/core/ and powerbi/apps/sacm-actions/formulas.fx.
// Paste all of it into App → Formulas in Power Apps Studio (powerbi/README.md §6). Change formulas.fx or actions.json, never this file.

// The look (D317): the colours and the font of the report (tools/powerbi/tokens.ts).
ColourNavy = ColorValue("#0c1c49"); // the main button, the selected line, the band
ColourNavySoft = ColorValue("#e6e9f4"); // the selected line of a list
ColourDeco = ColorValue("#fd472c"); // decoration only, never a meaning (LOOK rule 5)
ColourInk = ColorValue("#2b2623"); // text
ColourMuted = ColorValue("#655a52"); // the second line, a label (4.5:1 on white, LOOK rule 8)
ColourLine = ColorValue("#e8dfd3"); // borders and lines
ColourPage = ColorValue("#faf6f1"); // behind the panels
ColourSurface = ColorValue("#ffffff"); // a panel
ColourMailPage = ColorValue("#f4f1ec"); // behind the email
ColourBlue = ColorValue("#175cd3"); // asked: a first message, an email sent; information (LOOK §2)
ColourBlueSoft = ColorValue("#eff8ff");
ColourAmber = ColorValue("#7d5700"); // a reminder, a warning
ColourAmberSoft = ColorValue("#fffaeb");
ColourRed = ColorValue("#b42318"); // an escalation, a problem, a value that cannot be saved
ColourRedSoft = ColorValue("#fef3f2");
ColourViolet = ColorValue("#5925dc"); // a reply
ColourVioletSoft = ColorValue("#f4f3ff");
ColourGreen = ColorValue("#067647"); // OK, saved
ColourGreenSoft = ColorValue("#ecfdf3");
ColourGrey = ColorValue("#475467"); // nothing to do, not yet
ColourGreySoft = ColorValue("#f2f4f7");
AppFont = "Segoe UI";

ActionCatalog = Table(
    { Id: "note", Label: "Note", Type: "note", Text: "", Asks: "text", Scope: "line", Order: 1 },
    { Id: "status", Label: "Status", Type: "status", Text: "", Asks: "status", Scope: "line", Order: 2 },
    { Id: "request", Label: "Request number", Type: "request", Text: "", Asks: "request", Scope: "line", Order: 3 },
    { Id: "assign", Label: "Assign", Type: "assign", Text: "", Asks: "member", Scope: "line", Order: 4 },
    { Id: "stop", Label: "Stop following", Type: "exception", Text: "", Asks: "reason,reviewOn,text", Scope: "line", Order: 5 },
    { Id: "follow-again", Label: "Follow again", Type: "exception", Text: "Ended by hand", Asks: "", Scope: "line", Order: 6 },
    { Id: "fixed", Label: "Fixed", Type: "status", Text: "Fixed", Asks: "", Scope: "line", Order: 7 },
    { Id: "undo-fixed", Label: "Undo the mark", Type: "status", Text: "New", Asks: "", Scope: "line", Order: 8 },
    { Id: "ask-owner", Label: "Ask the owner", Type: "reviewed", Text: "Ask the owner", Asks: "", Scope: "line", Order: 9 },
    { Id: "back-to-sacm", Label: "Back to SACM", Type: "reviewed", Text: "Back to review", Asks: "", Scope: "line", Order: 10 },
    { Id: "retirement", Label: "Retirement date", Type: "retirement", Text: "", Asks: "retireOn", Scope: "line", Order: 11 },
    { Id: "stage", Label: "Stage", Type: "stage", Text: "", Asks: "stage", Scope: "line", Order: 12 },
    { Id: "no-process", Label: "The process does not exist", Type: "no-process", Text: "yes", Asks: "", Scope: "line", Order: 13 },
    { Id: "no-process-undo", Label: "Undo: the process does not exist", Type: "no-process", Text: "no", Asks: "", Scope: "line", Order: 14 },
    { Id: "handover", Label: "Hand over my work", Type: "handover", Text: "", Asks: "member,text", Scope: "mine", Order: 15 },
    { Id: "person-note", Label: "Note about the person", Type: "person-note", Text: "", Asks: "text", Scope: "person", Order: 16 },
    { Id: "share-out", Label: "Share out", Type: "assign", Text: "", Asks: "", Scope: "card", Order: 17 }
);
StatusChoices = Table(
    { Value: "New", Status: "New" },
    { Value: "Asked", Status: "Contacted" },
    { Value: "Answered", Status: "Answered" },
    { Value: "In progress", Status: "Fix in progress" },
    { Value: "Marked fixed", Status: "Fixed" }
);
ExceptionReasons = ["Agreed with the owner", "Known and tagged", "Not a CI", "Duplicate record", "Other"];
// The months to the review date of a decision to stop following: the last row of exceptionMonths in SACM Settings (the
// Settings screen of the app SACM audit, build B8, D308), a whole number in its range (D158), else the default.
ExceptionMonths = With({ raw: Trim(Last(Filter('SACM Settings', Title = "exceptionMonths")).Value) }, If(IsMatch(raw, "\d+") && Value(raw) >= 1 && Value(raw) <= 36, Value(raw), 6));

// The named formulas of the Power App "SACM actions" (builds B6 and D5, D294 to D296, D317), written by hand. npm run powerbi:generate
// puts them after the catalogue of powerbi/apps/actions.json into App-Formulas.fx (to paste into App → Formulas) and
// Src/App.pa.yaml. Words of the app: plain English, as in the report.
//
// Lines: the rows the Power Apps visual of the page gives (the fields of CaseLines, README §6.4): the lines of the page,
// or the ones selected in the report. Me: the person signed in, found by their email in the list SACM Team.

Lines = PowerBIIntegration.Data;
LineCount = CountRows(Lines);
// The Power Apps visual gives the app 1,000 rows at most (Microsoft's limit). At 1,000 the app cannot tell whether there
// are more, so it acts on none: Save is off until fewer lines are selected or filtered.
TooManyLines = LineCount >= 1000;
Me = LookUp('SACM Team', Lower(Email) = Lower(User().Email));
MeName = Coalesce(Me.Title, User().FullName);
// The managers a line can be given to: the active members of the list SACM Team (a menu shows the column Value), and
// Nobody, which makes the lines free again (an assign event with no name, as in the HTML app).
Nobody = "Nobody (free)";
TeamNames = Table({ Value: Nobody }, ForAll(Sort(Filter('SACM Team', Active = true), Title), { Value: Title }));

// My open work: the lines assigned to me that can still be assigned (open, to solve or to check).
MyOpenLines = Filter(Lines As line, line.AssignedTo = MeName && (StartsWith(line.Actions, "assign=") || ("|assign=") in line.Actions));

// The people of the lines: a note about a person needs every line to be about the same person.
LinePeople = Distinct(Filter(Lines, Person <> ""), Person);

// Share out (D24, build B7): the lines of a free group, each with the member the refresh gave it (the column ShareTo of
// CaseLines: the biggest group first, to the active member with the fewest CIs so far). Save adds one assign row per member.
ShareLines = Filter(Lines, ShareTo <> "");
ShareMembers = Distinct(ShareLines, ShareTo);

// The actions every selected line has (scope line). Value is what the menu shows: the words of the first line
// (its Actions, "id=Label|id=Label"). Then Hand over when I have open work among the lines, and a note about the person
// when every line is about one person.
LineActions = ForAll(
    Filter(ActionCatalog As action, action.Scope = "line" && LineCount > 0 &&
        CountRows(Filter(Lines As line, !(StartsWith(line.Actions, action.Id & "=") || ("|" & action.Id & "=") in line.Actions))) = 0) As chosen,
    {
        Id: chosen.Id, Type: chosen.Type, Text: chosen.Text, Asks: chosen.Asks, Scope: chosen.Scope, Order: chosen.Order,
        Value: Coalesce(
            Last(Split(LookUp(Split(First(Lines).Actions, "|") As pair, StartsWith(pair.Value, chosen.Id & "=")).Value, "=")).Value,
            chosen.Label)
    });
OtherActions = ForAll(
    Filter(ActionCatalog As action,
        (action.Scope = "mine" && CountRows(MyOpenLines) > 0) ||
        (action.Scope = "card" && CountRows(ShareLines) > 0) ||
        (action.Scope = "person" && LineCount > 0 && CountRows(LinePeople) = 1 && CountRows(Filter(Lines, Person = "")) = 0)) As chosen,
    { Id: chosen.Id, Type: chosen.Type, Text: chosen.Text, Asks: chosen.Asks, Scope: chosen.Scope, Order: chosen.Order, Value: chosen.Label });
AvailableActions = Sort(Table(LineActions, OtherActions), Order);

// The stages a case of the mapping backlog can be set to: those of the first line, when every line has the same.
StageChoices = If(
    CountRows(Distinct(Lines, Stages)) = 1 && First(Lines).Stages <> "",
    ForAll(Split(First(Lines).Stages, "|") As pair, { Id: First(Split(pair.Value, "=")).Value, Value: Last(Split(pair.Value, "=")).Value }),
    Table({ Id: "", Value: "" }));

// The keys an action is about: my open lines for Hand over, none for a note about a person, else every line.
KeysFor = { mine: Concat(MyOpenLines, Key, Char(10)), lines: Concat(Lines, Key, Char(10)) };

// The reason of the decision to stop following that Follow again ends: the reason of the first line, else Other.
FollowAgainReason = If(
    IsBlank(First(Lines).ExceptionReason) || StartsWith(First(Lines).ExceptionReason, "Set before"),
    "Other",
    First(Lines).ExceptionReason);

// What the team did lately on these lines, before the next refresh shows it: the journal of the last 60 days, newest
// first (the date test and the sort run in SharePoint, so they are delegated), then the events that name one of the
// keys. The second filter runs in the app on the newest rows only, as many as the data row limit of the app (set it to
// 2,000, README §6.4).
SelectedKeys = ForAll(Lines, Key);
RecentEvents = Filter(
    Sort(Filter('SACM Journal', At >= DateAdd(Today(), -60, TimeUnit.Days)), At, SortOrder.Descending) As event,
    CountRows(Filter(Split(event.Keys, Char(10)) As key, Trim(key.Value) in SelectedKeys.Value)) > 0);

// The reply reader (build D5, design pass §7): the tab Reply shows what a person wrote next to the lines it is about.
// A reply is filed by flow F3 in the list SACM Replies under the reference of the message it answers (its Title). The
// app reads the newest reply of each reference of the lines (Title and Received are tested and sorted in SharePoint, so
// they are delegated), newest first; the report shows the same replies after the refresh. A reply is read once a
// manager acts on one of its lines: Mark answered (status Answered), Waiting until (status Fix in progress and a note
// with the date) or a status of the tab Actions (RepliesToRead of the report).
// One SharePoint query per reference, so at most ReplyRefLimit of them: the references of the lines with a reply to
// read when there are any, else those of every line (the Work queue may give the app hundreds).
ReplyRefLimit = 25;
ReplyRefs = FirstN(
    Distinct(Filter(Lines, !IsBlank(LastRef) && (ToReadCount = 0 || Step = "Reply to read")), LastRef),
    ReplyRefLimit);
LineReplies = Sort(
    Filter(
        ForAll(ReplyRefs As reference, First(Sort(Filter('SACM Replies', Title = reference.Value), Received, SortOrder.Descending))),
        !IsBlank(Title)),
    Received, SortOrder.Descending);
// The lines that wait for a reply to be read (the step Reply to read of the report).
ToReadCount = CountRows(Filter(Lines, Step = "Reply to read"));
