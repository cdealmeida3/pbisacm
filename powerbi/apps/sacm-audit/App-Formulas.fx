// GENERATED by npm run powerbi:generate from src/app/state/store.ts, tools/powerbi/email.ts, checks/reference/lifecycle.json, powerbi/apps/refresh.json and powerbi/apps/sacm-audit/formulas.fx.
// Paste all of it into App → Formulas in Power Apps Studio (powerbi/README.md §6.8). Change formulas.fx, never this file.

// The look (D317): the colours and the font of the report (tools/powerbi/tokens.ts).
ColourNavy = ColorValue("#0c1c49"); // the main button, the selected line, the band
ColourNavySoft = ColorValue("#e6e9f4"); // the selected line of a list
ColourDeco = ColorValue("#fd472c"); // decoration only, never a meaning (LOOK rule 5)
ColourInk = ColorValue("#2b2623"); // text
ColourMuted = ColorValue("#655a52"); // the second line, a label (4.5:1 on white, LOOK rule 8)
ColourLine = ColorValue("#e8dfd3"); // borders and lines
ColourPage = ColorValue("#faf6f1"); // behind the panels
ColourSurface = ColorValue("#ffffff"); // a panel
ColourMailPage = ColorValue("#f4f1ec"); // behind the email
ColourBlue = ColorValue("#175cd3"); // asked: a first message, an email sent; information (LOOK §2)
ColourBlueSoft = ColorValue("#eff8ff");
ColourAmber = ColorValue("#7d5700"); // a reminder, a warning
ColourAmberSoft = ColorValue("#fffaeb");
ColourRed = ColorValue("#b42318"); // an escalation, a problem, a value that cannot be saved
ColourRedSoft = ColorValue("#fef3f2");
ColourViolet = ColorValue("#5925dc"); // a reply
ColourVioletSoft = ColorValue("#f4f3ff");
ColourGreen = ColorValue("#067647"); // OK, saved
ColourGreenSoft = ColorValue("#ecfdf3");
ColourGrey = ColorValue("#475467"); // nothing to do, not yet
ColourGreySoft = ColorValue("#f2f4f7");
AppFont = "Segoe UI";

// The refresh rule (D333, powerbi/apps/refresh.json): one refresh on demand in each window, from RefreshFrom to RefreshTo,
// and the scheduled refresh in the morning. The times are the team's (the browser's time of the managers).
RefreshWindowMinutes = 120;
RefreshFromMinutes = 480;
RefreshToMinutes = 1080;
RefreshFrom = "08:00";
RefreshTo = "18:00";
RefreshScheduled = "07:00";
RefreshWindowWords = "2 hours";
RefreshRuleText = "Refresh now: once every 2 hours, 08:00 to 18:00. The report refreshes at 07:00.";
// The time of the report's data: the field Report at of the visual (About[Report at], the refresh time in UTC as
// yyyy-mm-ddThh:nn:ssZ), in the browser's time. Blank when the visual gives no row. A journal row from ReportSince on
// is not in the report yet: the refresh reads the journal while it runs, so the 5 minutes before count too.
ReportAt = If(IsBlank(First(PowerBIIntegration.Data).'Report at'), Blank(), DateTimeValue(First(PowerBIIntegration.Data).'Report at'));
ReportSince = If(IsBlank(ReportAt), Blank(), DateAdd(ReportAt, -5, TimeUnit.Minutes));
// The same as a time to compare in SharePoint: tomorrow when the time is not known, so no row counts.
PendingSince = Coalesce(ReportSince, DateAdd(Now(), 1, TimeUnit.Days));
ReportAtText = If(IsBlank(ReportAt), "", IsToday(ReportAt), Text(ReportAt, "hh:mm"), Text(ReportAt, "d mmm hh:mm"));
// The start of the next window after now, in words: the answer when the window of now is taken.
RefreshNextText = With(
    { clock: Hour(Now()) * 60 + Minute(Now()) },
    With(
        { following: If(clock < RefreshFromMinutes, RefreshFromMinutes, RefreshFromMinutes + (RoundDown((clock - RefreshFromMinutes) / RefreshWindowMinutes, 0) + 1) * RefreshWindowMinutes) },
        If(following >= RefreshToMinutes, "the next is the morning refresh at " & RefreshScheduled, "the next from " & Text(Time(RoundDown(following / 60, 0), Mod(following, 60), 0), "hh:mm"))));
// The header line of the app (D334): the time of the report's data and the changes saved since then (PendingWhere: where
// the app counts them, " on these lines" or nothing).
// No time with lines: the visual lacks the field Report at (README §6.4); then nothing counts as not in the report yet.
ReportLine = If(
    IsBlank(ReportAt) && !IsEmpty(PowerBIIntegration.Data), "Add the field Report at to this visual (README §6.4).",
    IsBlank(ReportAt), ReportUnknownText,
    "Report data from " & ReportAtText & ". " &
    If(
        PendingCount = 0, "Everything saved" & PendingWhere & " is in it.",
        PendingCount & If(PendingCount = 1, " change", " changes") & PendingWhere & " since then " & If(PendingCount = 1, "is", "are") & " not in it yet."));
// What the button Refresh now says after the flow SACMRefresh answers (F5: started, taken, closed, refused, error).
RefreshStartedText = "The report refreshes now. In about 2 minutes, press Refresh in the report's top bar to see it.";
RefreshClosedText = "Refresh now works from 08:00 to 18:00. The report refreshes at 07:00.";
RefreshErrorText = "The refresh could not be asked. Your work is saved. Tell the owner of the report if it happens again.";

SettingCatalog = Table(
    { Key: "reminderDays", Label: "Working days before a reminder is due", Min: 1, Max: 30, Default: 3, Order: 1 },
    { Key: "maxReminders", Label: "Reminders before Escalate", Min: 0, Max: 10, Default: 2, Order: 2 },
    { Key: "exceptionMonths", Label: "Months until ""Not followed up"" is reviewed", Min: 1, Max: 36, Default: 6, Order: 3 },
    { Key: "staleDays", Label: "Days before a report counts as old", Min: 1, Max: 60, Default: 3, Order: 4 },
    { Key: "underRetirementDays", Label: "Days before Under retirement is too long", Min: 1, Max: 730, Default: 90, Order: 5 },
    { Key: "readyDays", Label: "Days before Ready is too long", Min: 1, Max: 730, Default: 90, Order: 6 },
    { Key: "rowsInEmail", Label: "Lines a table of an email shows before the attached file", Min: 1, Max: 100, Default: 10, Order: 7 }
);
ReviewResults = Table(
    { Id: "same", Label: "Same in EPO" },
    { Id: "different", Label: "Not the same" },
    { Id: "not-in-epo", Label: "Not in EPO" }
);

// The named formulas of the Power App "SACM audit" (builds B8 and 0.52.0, D306, D308, D334), written by hand. npm run powerbi:generate puts
// them after the settings and the results of the review (SettingCatalog, ReviewResults) into App-Formulas.fx (to paste
// into App → Formulas) and Src/App.pa.yaml. Words of the app: plain English, as in the report.
//
// Lines: the rows the Power Apps visual of the page Lifecycle review gives (the fields of the table ReviewLines, README §6.8): each CI
// of each lifecycle review, then the CIs a new review would draw from the newest CI report (Review "next"). The app only
// adds rows to the lists SACM Journal and SACM Settings (D272); it changes or removes none, and sends nothing.

// Build A1 (D377, D379): every field of the visual is text, because the visual sends no data to the app when a field is
// a number or a true/false, and a banner for a blank date. npm run powerbi:generate writes here the typed rows: the rows
// of the visual read once, each field turned back into a number, true/false or a date (APP_FIELDS of
// tools/powerbi/tokens.ts). Every other formula reads Lines, never PowerBIIntegration.Data.
Lines = ForAll(
    PowerBIIntegration.Data,
    {
        Review: ThisRecord.Review,
        IsNext: ThisRecord.IsNextText = "true",
        IsCurrent: ThisRecord.IsCurrentText = "true",
        ReviewDate: If(IsBlank(ThisRecord.ReviewDateText), Blank(), Date(Value(Mid(ThisRecord.ReviewDateText, 1, 4)), Value(Mid(ThisRecord.ReviewDateText, 6, 2)), Value(Mid(ThisRecord.ReviewDateText, 9, 2)))),
        Report: ThisRecord.Report,
        ReportDate: If(IsBlank(ThisRecord.ReportDateText), Blank(), Date(Value(Mid(ThisRecord.ReportDateText, 1, 4)), Value(Mid(ThisRecord.ReportDateText, 6, 2)), Value(Mid(ThisRecord.ReportDateText, 9, 2)))),
        Group: ThisRecord.Group,
        CiKey: ThisRecord.CiKey,
        CiName: ThisRecord.CiName,
        ClassLabel: ThisRecord.ClassLabel,
        ClassName: ThisRecord.ClassName,
        EpoId: ThisRecord.EpoId,
        Status: ThisRecord.Status,
        EpoStatus: ThisRecord.EpoStatus,
        Agrees: ThisRecord.AgreesText = "true",
        Result: ThisRecord.Result,
        ResultLabel: ThisRecord.ResultLabel,
        EpoDate: If(IsBlank(ThisRecord.EpoDateText), Blank(), Date(Value(Mid(ThisRecord.EpoDateText, 1, 4)), Value(Mid(ThisRecord.EpoDateText, 6, 2)), Value(Mid(ThisRecord.EpoDateText, 9, 2)))),
        Order: If(IsBlank(ThisRecord.OrderText), Blank(), Value(ThisRecord.OrderText))
    }
);
LineCount = CountRows(Lines);
// The Power Apps visual gives the app 1,000 rows at most (Microsoft's limit).
TooManyLines = LineCount >= 1000;
Me = LookUp('SACM Team', Lower(Email) = Lower(User().Email));
MeName = Coalesce(Me.Title, User().FullName);
MeEmail = Lower(User().Email);

// The lifecycle review (D192, D306). ReportCurrentLines: the CIs of the newest review in the report; NextLines: the CIs
// a new review draws from the newest CI report (fnReviewDraw of the report: the same report always draws the same CIs),
// in their order.
ReportCurrentLines = Sort(Filter(Lines, IsCurrent), Order);
NextLines = Sort(Filter(Lines, IsNext), Order);
// A review is known by the day it starts: "2026-11-12_lifecycle" (reviewId of the HTML app).
TodayId = Text(Today(), "yyyy-mm-dd") & "_lifecycle";
// The review of today is in the journal (EntryType and Ref are tested in SharePoint, so they are delegated).
TodayInJournal = !IsEmpty(Filter('SACM Journal', EntryType = "review" && Ref = TodayId));
// A review started today is never started again: it is in the report, or in the journal before the refresh shows it.
StartedToday = First(ReportCurrentLines).Review = TodayId || TodayInJournal;
// The review of today before the refresh shows it (build 0.52.0, D334): the journal has it, the report's newest review is
// older. Then the review to mark is today's: its CIs are NextLines (New review saved exactly them in Items) and its id
// TodayId, so a mark never goes to the previous review while the refresh is hours away.
ReviewPending = TodayInJournal && First(ReportCurrentLines).Review <> TodayId;
CurrentLines = If(ReviewPending, NextLines, ReportCurrentLines);
CurrentId = If(ReviewPending, TodayId, First(ReportCurrentLines).Review);
// The marks saved on the review since the report's data, by anyone (D334): the report shows them after the next
// refresh. ForAll keeps them in the app (EntryType, Ref and At are tested in SharePoint, so they are delegated).
MarksSince = ForAll(
    Filter('SACM Journal', EntryType = "review" && Ref = CurrentId && At >= PendingSince) As row,
    { CiKey: row.CiKey, Reason: row.Reason, At: row.At, ByName: Coalesce(row.ByName, row.By) });
MarkedSince = Filter(MarksSince, !IsBlank(CiKey));
// The header line (D334): every journal row of the team saved since the report's data.
PendingCount = CountRows(Filter('SACM Journal', At >= PendingSince));
PendingWhere = "";
ReportUnknownText = "The report gave the app no line.";
// The sample as the journal keeps it (the column Items of SACM Journal, read by LifecycleReviews): the report, its date
// and the CIs, as the HTML app saves a review in data/reviews/.
NewReviewItems = JSON(
    {
        report: First(NextLines).Report,
        reportDate: Text(First(NextLines).ReportDate, "yyyy-mm-dd"),
        items: ForAll(NextLines As line, { ciKey: line.CiKey, name: line.CiName, classLabel: line.ClassLabel, className: line.ClassName, status: line.Status, epoId: line.EpoId, group: line.Group })
    },
    JSONFormat.Compact);
NewReviewText = "Started the lifecycle review of " & Text(Today(), "yyyy-mm-dd") & ": " & CountRows(NextLines) & " CIs drawn from " &
    First(NextLines).Report & " (report of " & Text(First(NextLines).ReportDate, "yyyy-mm-dd") & ")";
MarkedCount = CountRows(Filter(CurrentLines As line, !IsBlank(line.Result) || line.CiKey in MarkedSince.CiKey));
// The CIs not marked yet whose status EPO shows the same: one press marks them all "same" (markSameAsEpo of the HTML app).
// Not those marked since the report's data.
AgreeingLines = Filter(CurrentLines As line, line.Agrees && !(line.CiKey in MarkedSince.CiKey));
AgreeNote = "Same status in the EPO systems report of " & Text(First(CurrentLines).EpoDate, "d mmm yyyy", "en-US");

// The settings (D158; rowsInEmail, D314): each number with the value that counts now: the last row of its key in SACM Settings when it is a
// whole number in its range, else the default (CaseRules of the report reads the same).
SettingRows = ForAll(
    SettingCatalog As setting,
    With(
        { raw: Trim(Last(Filter('SACM Settings', Title = setting.Key)).Value) },
        {
            Key: setting.Key, Label: setting.Label, Min: setting.Min, Max: setting.Max, Default: setting.Default, Order: setting.Order,
            Current: If(IsMatch(raw, "\d+") && Value(raw) >= setting.Min && Value(raw) <= setting.Max, Value(raw), setting.Default),
            // A saved value that is not used (D158: "Settings says so").
            Unused: If(!IsBlank(raw) && !(IsMatch(raw, "\d+") && Value(raw) >= setting.Min && Value(raw) <= setting.Max), raw, "")
        }));
